# .env.example - Environment Configuration for K-Sync Malaysia

# Application Port & Base URL
PORT=8000
APP_BASE_URL=http://localhost:8000

# -------------------------------------------------------------
# REAL EMAIL DELIVERY CONFIGURATION (Nodemailer SMTP)
# -------------------------------------------------------------
# Option A: Using Hostinger Webmail SMTP (Recommended for ksync.my)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@ksync.my
# SMTP_PASS=YourHostingerEmailPasswordHere
# EMAIL_FROM="K-Sync Malaysia" <noreply@ksync.my>

# Option B: Using Gmail SMTP (Free with Google App Password)
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" / "K-Sync" (16 characters)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_personal_email@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="K-Sync Malaysia" <your_personal_email@gmail.com>

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
# Leave empty for Local SQLite (database/ksync.db)
# Or configure for Hostinger Cloud MySQL in production:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=u123456789_ksync
# DB_USER=u123456789_admin
# DB_PASSWORD=YourDatabasePassword
