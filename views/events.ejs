<%- include('partials/header', { title: 'Discover K-Pop Events | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Banner -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200/80 pb-6">
        <div>
            <div class="flex items-center space-x-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200">
                    <i class="fas fa-compass me-1 text-pink-500"></i> Event Discovery Directory
                </span>
            </div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight flex items-center">
                Discover K-Pop Events
            </h1>
            <p class="text-slate-600 text-sm mt-1 font-medium">Search, filter, and track verified concerts, fan meetings, and cupsleeve gatherings in Malaysia.</p>
        </div>
        <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-slate-900 text-white shadow-sm flex items-center shrink-0 self-start md:self-auto">
            <i class="fas fa-calendar-check me-2 text-pink-400"></i> <%= events.length %> Verified Event(s)
        </span>
    </div>

    <!-- Quick Artist Filters -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Quick Filter by Artist:</span>
            <% if (selectedArtist || selectedCategory || searchKeyword) { %>
                <a href="/events" class="text-xs font-bold text-pink-600 hover:text-pink-700">Clear All Filters</a>
            <% } %>
        </div>
        <div class="flex items-center space-x-2 overflow-x-auto pb-2 scrollbar-none">
            <a href="/events" class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 <%= !selectedArtist ? 'bg-slate-900 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
                All Artists
            </a>
            <% all_artists.forEach(function(art) { %>
                <a href="/events?artist=<%= art.id %>" class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 flex items-center space-x-1.5 <%= selectedArtist == art.id ? 'bg-pink-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50' %>">
                    <% if (art.image_url) { %>
                        <img src="<%= art.image_url %>" alt="" class="w-4 h-4 rounded-full object-cover">
                    <% } %>
                    <span><%= art.name %></span>
                </a>
            <% }); %>
        </div>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200 mb-8">
        <form action="/events" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <!-- Search Text -->
            <div class="relative lg:col-span-2">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="search" value="<%= searchKeyword || '' %>" placeholder="Search event, artist, venue..." 
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300">
            </div>

            <!-- Category Select -->
            <div>
                <select name="category" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-300">
                    <option value="">All Categories</option>
                    <% all_categories.forEach(function(c) { %>
                        <option value="<%= c.slug %>" <%= selectedCategory === c.slug ? 'selected' : '' %>><%= c.name %></option>
                    <% }); %>
                </select>
            </div>

            <!-- Location Select -->
            <div>
                <select name="location" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-300">
                    <option value="">All Locations</option>
                    <% all_locations.forEach(function(loc) { %>
                        <option value="<%= loc %>" <%= selectedLocation === loc ? 'selected' : '' %>><%= loc %></option>
                    <% }); %>
                </select>
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit" class="w-full py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center justify-center">
                    <i class="fas fa-filter me-1.5"></i> Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Events Grid -->
    <% if (events.length === 0) { %>
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 shadow-sm">
            <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-4">
                <i class="fas fa-magnifying-glass"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800">No events found matching your criteria</h3>
            <p class="text-xs text-slate-500 mt-1 mb-6">Try clearing filters or search for another artist or keyword.</p>
            <a href="/events" class="px-6 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs shadow-sm hover:bg-slate-800 transition-all">
                Clear Filters
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% events.forEach(function(event) { %>
                <% 
                    const calcStatus = helpers.getCalculatedEventStatus(event);
                    const isSaved = savedEventIds.includes(event.id);
                %>
                <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden flex flex-col group transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                    <!-- Poster Banner -->
                    <div class="relative h-48 overflow-hidden bg-slate-100">
                        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-black/20"></div>
                        
                        <!-- Category Badge -->
                        <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
                            <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-bold bg-white text-slate-900 shadow">
                                <%= event.category_name || 'Event' %>
                            </span>
                            <%- helpers.getStatusBadge(calcStatus) %>
                        </div>

                        <!-- Date Overlay -->
                        <div class="absolute bottom-3 left-3 bg-white/95 rounded-xl px-2.5 py-1 text-center shadow-md">
                            <span class="block text-[10px] font-bold text-pink-600 uppercase"><%= new Date(event.event_date).toLocaleDateString('en-MY', { month: 'short' }) %></span>
                            <span class="block text-base font-extrabold text-slate-900 leading-none"><%= new Date(event.event_date).getDate() %></span>
                        </div>

                        <!-- Save Button -->
                        <div class="absolute top-3 right-3 z-10">
                            <button onclick="toggleSaveEvent(<%= event.id %>, this)" 
                                    title="Save Event"
                                    class="w-8 h-8 rounded-full <%= isSaved ? 'bg-rose-500 text-white' : 'bg-white/90 text-slate-700 hover:text-rose-500' %> border border-slate-200 flex items-center justify-center text-xs shadow transition-all cursor-pointer hover:scale-110">
                                <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                        <div>
                            <div class="flex items-center text-xs font-bold text-purple-600 mb-1.5">
                                <i class="fas fa-microphone-lines me-1 text-purple-500"></i>
                                <span><%= event.artist_name || 'Various Artists' %></span>
                            </div>
                            <h3 class="text-base font-bold text-slate-900 group-hover:text-pink-600 transition-colors line-clamp-2 leading-snug">
                                <a href="/events/<%= event.id %>">
                                    <%= event.event_name %>
                                </a>
                            </h3>
                        </div>

                        <div class="space-y-1.5 border-t border-slate-100 pt-3 text-xs text-slate-600 font-medium">
                            <div class="flex items-center">
                                <i class="far fa-clock w-4 me-1.5 text-pink-500"></i>
                                <span><%= helpers.formatTime(event.start_time) %></span>
                            </div>
                            <div class="flex items-center truncate">
                                <i class="fas fa-location-dot w-4 me-1.5 text-rose-500"></i>
                                <span class="truncate"><%= event.venue_name %>, <%= event.city %></span>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-[11px] text-emerald-700 font-bold flex items-center"><i class="fas fa-circle-check me-1 text-emerald-600"></i> Verified</span>
                            <a href="/events/<%= event.id %>" 
                               class="px-4 py-1.5 rounded-xl bg-pink-50 hover:bg-pink-600 text-pink-700 hover:text-white text-xs font-bold transition-all shadow-sm">
                                View Details &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                const icon = btn.querySelector('i');
                if (data.saved) {
                    btn.classList.add('bg-rose-500', 'text-white');
                    btn.classList.remove('bg-white/90', 'text-slate-700');
                    icon.classList.remove('far');
                    icon.classList.add('fas');
                } else {
                    btn.classList.remove('bg-rose-500', 'text-white');
                    btn.classList.add('bg-white/90', 'text-slate-700');
                    icon.classList.remove('fas');
                    icon.classList.add('far');
                }
            }
        } catch (e) {
            console.error('Error toggling save:', e);
        }
    }
</script>

<%- include('partials/footer') %>
