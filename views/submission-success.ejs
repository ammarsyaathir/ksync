<%- include('partials/header', { title: 'Submission Confirmation | K-Sync Malaysia' }) %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Success Banner Card -->
    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-emerald-200 shadow-xl text-center relative overflow-hidden">
        <div class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-white flex items-center justify-center text-3xl shadow-lg shadow-emerald-500/20 mb-6">
            <i class="fas fa-circle-check"></i>
        </div>

        <span class="px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">
            Submission Received (Pending Review)
        </span>

        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-4">
            Thank You for Submitting!
        </h1>
        <p class="text-slate-600 text-sm mt-2 max-w-lg mx-auto font-medium">
            Your K-Pop event details have been submitted and queued for administrative review. To ensure fan safety, our team verifies all official links and posters before publishing.
        </p>

        <% if (event) { %>
            <!-- Tracking Reference Code Box -->
            <div class="mt-8 p-6 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-800 text-white text-left relative overflow-hidden shadow-2xl border border-slate-700">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
                    <div>
                        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-widest flex items-center">
                            <i class="fas fa-barcode text-pink-400 me-2"></i> Official Reference Code
                        </div>
                        <div class="text-2xl sm:text-3xl font-mono font-black text-pink-400 tracking-wider mt-1 select-all" id="ref-code">
                            <%= event.tracking_code %>
                        </div>
                        <p class="text-xs text-slate-300 font-medium mt-1">
                            Save this code to check your verification status or make corrections.
                        </p>
                    </div>

                    <div class="flex items-center space-x-2 shrink-0">
                        <button type="button" onclick="copyRefCode()" id="btn-copy-code"
                                class="px-4 py-2.5 rounded-xl bg-pink-600 hover:bg-pink-500 text-white text-xs font-bold transition-all flex items-center shadow cursor-pointer">
                            <i class="far fa-copy me-1.5"></i> Copy Code
                        </button>
                    </div>
                </div>

                <div class="mt-6 pt-5 border-t border-slate-700/80 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300">
                    <div>
                        <span class="text-slate-400 font-bold">Event:</span> <%= event.event_name %>
                    </div>
                    <div>
                        <span class="text-slate-400 font-bold">Date:</span> <%= helpers.formatDate(event.event_date) %>
                    </div>
                    <div>
                        <span class="text-slate-400 font-bold">Venue:</span> <%= event.venue_name %>, <%= event.city %>
                    </div>
                    <div>
                        <span class="text-slate-400 font-bold">Submitted By:</span> <%= event.submitter_name %> (<%= event.submitter_email %>)
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href="/check-submission?code=<%= encodeURIComponent(event.tracking_code) %>" 
                   class="px-6 py-3 rounded-xl bg-slate-900 text-white text-xs font-bold shadow hover:bg-slate-800 transition-all flex items-center">
                    <i class="fas fa-magnifying-glass me-2 text-pink-400"></i> Track Status Now
                </a>
                <a href="/submit-event" 
                   class="px-6 py-3 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all">
                    Submit Another Event
                </a>
                <a href="/" 
                   class="px-6 py-3 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all">
                    Back to Home
                </a>
            </div>
        <% } %>
    </div>
</div>

<script>
    function copyRefCode() {
        const text = document.getElementById('ref-code').innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const btn = document.getElementById('btn-copy-code');
            btn.innerHTML = '<i class="fas fa-check me-1.5"></i> Copied!';
            setTimeout(() => {
                btn.innerHTML = '<i class="far fa-copy me-1.5"></i> Copy Code';
            }, 2000);
        });
    }
</script>

<%- include('partials/footer') %>
