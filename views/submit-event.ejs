<%- include('partials/header', { title: 'Submit K-Pop Event | K-Sync Malaysia' }) %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Card -->
    <div class="bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 rounded-3xl p-8 text-white shadow-xl mb-8 relative overflow-hidden">
        <div class="relative z-10">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/20 backdrop-blur-md mb-3 border border-white/30">
                <i class="fas fa-shield-check me-1.5 text-pink-300"></i> Open Event Submission (Model 2)
            </span>
            <h1 class="text-3xl font-extrabold tracking-tight">Submit a K-Pop Event</h1>
            <p class="text-xs sm:text-sm text-pink-100 mt-2 max-w-xl font-medium leading-relaxed">
                Hosting a concert, fan meeting, cupsleeve cafe, or fan party in Malaysia? Submit event details below. All submissions are cross-verified by our admin team before being published to protect fans from fake listings.
            </p>
        </div>
    </div>

    <!-- Form Container -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
        <form action="/submit-event" method="POST" enctype="multipart/form-data" class="space-y-10">
            
            <!-- SECTION A: Event Identity -->
            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-pink-100 text-pink-700 flex items-center justify-center text-xs me-2 font-black">A</span>
                        Section A: Event Identity
                    </h3>
                    <span class="text-[11px] text-rose-500 font-bold">* Required fields</span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Event Title <span class="text-rose-500">*</span></label>
                    <input type="text" name="event_name" required placeholder="e.g. SEVENTEEN [RIGHT HERE] WORLD TOUR IN KUALA LUMPUR"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    <span class="text-[10px] text-slate-400">The primary title fans search for and how duplicate events are spotted.</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Event Category <span class="text-rose-500">*</span></label>
                        <select name="category_id" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-pink-300">
                            <option value="">Select Category</option>
                            <% categories.forEach(function(c) { %>
                                <option value="<%= c.id %>"><%= c.name %></option>
                            <% }); %>
                        </select>
                        <span class="text-[10px] text-slate-400">Concert, Fan Meeting, Cupsleeve, Birthday Cafe, etc.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">K-Pop Artist / Group</label>
                        <select name="artist_id" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-pink-300">
                            <option value="">Select Artist / Group (or leave empty if multiple / festival)</option>
                            <% artists.forEach(function(a) { %>
                                <option value="<%= a.id %>"><%= a.name %> (<%= a.group_type %>)</option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Event Description <span class="text-rose-500">*</span></label>
                    <textarea name="description" rows="4" required placeholder="Provide an overview of the event, what it offers, itinerary, admission guidelines, fan projects, etc."
                              class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300"></textarea>
                    <span class="text-[10px] text-slate-400">Gives fans full details and allows administrators to judge authenticity.</span>
                </div>
            </div>

            <!-- SECTION B: Date and Time -->
            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center text-xs me-2 font-black">B</span>
                        Section B: Date and Time
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Event Date <span class="text-rose-500">*</span></label>
                        <input type="date" name="event_date" required 
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Start Time <span class="text-rose-500">*</span></label>
                        <input type="time" name="start_time" required 
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">End Time (Optional)</label>
                        <input type="time" name="end_time" 
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                </div>
            </div>

            <!-- SECTION C: Location -->
            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs me-2 font-black">C</span>
                        Section C: Location (Malaysia)
                    </h3>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Preset Malaysian Venue (Quick Fill)</label>
                    <select id="preset-venue" onchange="fillVenue(this)" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <option value="">-- Choose Venue Preset (or type custom below) --</option>
                        <option value="1" data-name="Axiata Arena Bukit Jalil" data-address="Jalan Jalil Perkasa 3, Bukit Jalil" data-city="Kuala Lumpur" data-state="Wilayah Persekutuan Kuala Lumpur">Axiata Arena Bukit Jalil (Kuala Lumpur)</option>
                        <option value="2" data-name="Zepp Kuala Lumpur" data-address="B2-01-02, Level B2, Mitsui Shopping Park LaLaport BBCC, 2, Jalan Hang Tuah" data-city="Kuala Lumpur" data-state="Wilayah Persekutuan Kuala Lumpur">Zepp Kuala Lumpur (Bukit Bintang)</option>
                        <option value="3" data-name="Mega Star Arena KL" data-address="1 Vista Mutiara, 1, Jalan Kepong, Kepong Baru" data-city="Kuala Lumpur" data-state="Wilayah Persekutuan Kuala Lumpur">Mega Star Arena (Kuala Lumpur)</option>
                        <option value="4" data-name="Stadium Nasional Bukit Jalil" data-address="Jalan Barat, Bukit Jalil" data-city="Kuala Lumpur" data-state="Wilayah Persekutuan Kuala Lumpur">Stadium Nasional Bukit Jalil (Kuala Lumpur)</option>
                        <option value="5" data-name="Idea Convention Centre (IDCC)" data-address="Jalan Pahat L 15/L, Seksyen 15" data-city="Shah Alam" data-state="Selangor">Idea Convention Centre - IDCC (Shah Alam)</option>
                        <option value="6" data-name="Sunway Lagoon Surf Beach" data-address="3, Jalan PJS 11/11, Bandar Sunway" data-city="Subang Jaya" data-state="Selangor">Sunway Lagoon Surf Beach (Selangor)</option>
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Venue Name <span class="text-rose-500">*</span></label>
                        <input type="text" id="venue_name" name="venue_name" required placeholder="e.g. Axiata Arena Bukit Jalil"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">City <span class="text-rose-500">*</span></label>
                        <input type="text" id="city" name="city" required placeholder="e.g. Kuala Lumpur"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Street Address <span class="text-rose-500">*</span></label>
                        <input type="text" id="address" name="address" required placeholder="e.g. Bukit Jalil National Sports Complex"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">State <span class="text-rose-500">*</span></label>
                        <input type="text" id="state" name="state" required placeholder="e.g. Wilayah Persekutuan Kuala Lumpur"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                </div>
            </div>

            <!-- SECTION D: Tickets and Rules (Information Only) -->
            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs me-2 font-black">D</span>
                        Section D: Tickets & Rules (Information Only)
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Official Ticketing / Event URL</label>
                        <input type="url" name="official_url" placeholder="https://ticket2u.com.my or official organizer post"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <span class="text-[10px] text-slate-400">Directs fans to the official seller. K-Sync does not sell tickets.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Ticket Information & Pricing</label>
                        <input type="text" name="ticket_info" placeholder="e.g. Free Entry / VIP RM888, CAT1 RM688"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Event Rules & Entry Guidelines</label>
                    <textarea name="event_rules" rows="3" placeholder="Bag rules, camera policies, lightstick guidelines, queue timing, age limits."
                              class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300"></textarea>
                </div>
            </div>

            <!-- SECTION E: Media (Posters & Visual Graphics) -->
            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-xs me-2 font-black">E</span>
                        Section E: Event Posters & Visuals (1 to 4 Images)
                    </h3>
                    <p class="text-xs text-slate-500 mt-1">Upload 1 to 4 official graphics (Main Poster, Seating Chart, Fan Benefits, Schedule). Supports portrait, square, or landscape sizes.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Upload Posters (1 to 4 Images)</label>
                        <input type="file" name="poster_files" multiple accept="image/png, image/jpeg, image/jpg, image/webp"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-600 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-pink-50 file:text-pink-700 hover:file:bg-pink-100">
                        <span class="text-[10px] text-slate-400 block mt-1">PNG, JPG, WebP up to 5MB each. You can select up to 4 images at once.</span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">OR Poster Image URL(s)</label>
                        <input type="text" name="poster_url" placeholder="https://example.com/poster.jpg (or comma-separated)"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <span class="text-[10px] text-slate-400 block mt-1">For multiple URLs, separate with a comma.</span>
                    </div>
                </div>
            </div>

            <!-- SECTION F: Proof of Authenticity -->
            <div class="space-y-4 p-5 rounded-2xl bg-pink-50/50 border border-pink-200">
                <div class="border-b border-pink-200 pb-3 flex items-center justify-between">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-pink-900 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-pink-600 text-white flex items-center justify-center text-xs me-2 font-black">F</span>
                        Section F: Proof of Authenticity (Anti-Fake Trust Verification)
                    </h3>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-pink-200 text-pink-800 uppercase">Crucial</span>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed font-medium">
                    To prevent fake event listings, our administrators verify every submission against independent official sources. Submissions without verifiable evidence will be rejected.
                </p>

                <div>
                    <label class="block text-xs font-bold text-slate-800 mb-1">
                        Official Evidence Link (Announcement URL) <span class="text-rose-500">*</span>
                    </label>
                    <input type="url" name="evidence_link" required placeholder="https://weverse.io/... or https://x.com/... or https://instagram.com/..."
                           class="w-full bg-white border border-pink-300 rounded-xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-400">
                    <span class="text-[10px] text-slate-500">The official announcement link on Weverse, artist X/Twitter, Instagram, promoter page, or ticketing platform.</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1">Organizer / Fanclub Name <span class="text-rose-500">*</span></label>
                        <input type="text" name="organizer_name" required placeholder="e.g. Starline Events or MY CARAT Fanclub"
                               class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1">Organizer Official Social Profile Link <span class="text-rose-500">*</span></label>
                        <input type="url" name="organizer_social_url" required placeholder="https://instagram.com/organizer_handle"
                               class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <span class="text-[10px] text-slate-400">Allows admin to check account history & legitimacy.</span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1">Organizer Type <span class="text-rose-500">*</span></label>
                        <select name="organizer_type" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-pink-300">
                            <option value="Fanclub">Fanclub / Community Group</option>
                            <option value="Event Company">Official Event Promoter / Company</option>
                            <option value="Venue">Venue Management</option>
                            <option value="Agency">Artist Agency / Entertainment Label</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- SECTION G: Submitter Contact -->
            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center text-xs me-2 font-black">G</span>
                        Section G: Submitter Contact
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Submitter Contact Name <span class="text-rose-500">*</span></label>
                        <input type="text" name="submitter_name" required value="<%= currentUser ? currentUser.full_name : '' %>"
                               placeholder="e.g. Aiman Danial"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Submitter Email Address <span class="text-rose-500">*</span></label>
                        <input type="email" name="submitter_email" required value="<%= currentUser ? currentUser.email : '' %>"
                               placeholder="e.g. organizer@ksync.my"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <span class="text-[10px] text-slate-400">Tracking code and verification decision emails are delivered here.</span>
                    </div>
                </div>
            </div>

            <!-- SECTION H: Declaration -->
            <div class="space-y-4 p-5 rounded-2xl bg-slate-50 border border-slate-200">
                <div class="border-b border-slate-200 pb-3">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center">
                        <span class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-xs me-2 font-black">H</span>
                        Section H: Submitter Declaration
                    </h3>
                </div>

                <label class="flex items-start gap-3 cursor-pointer">
                    <input type="checkbox" name="declaration_confirmed" required value="1"
                           class="mt-1 h-4 w-4 rounded border-slate-300 text-pink-600 focus:ring-pink-500 cursor-pointer">
                    <span class="text-xs text-slate-700 font-medium leading-relaxed">
                        I confirm that the information submitted above is accurate, truthful, and that I am authorized to submit this event listing to K-Sync Malaysia. I understand that submitting false, misleading, or deceptive events will result in immediate rejection and permanent blacklisting.
                    </span>
                </label>
            </div>

            <!-- Submit Button -->
            <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="text-xs text-slate-500 font-medium">
                    <i class="fas fa-shield-halved text-emerald-500 me-1"></i> Admin reviews typically take 1–6 hours.
                </div>
                <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs shadow-md transition-all flex items-center justify-center cursor-pointer">
                    <i class="fas fa-check-circle me-2 text-pink-400"></i> Submit Event for Verification
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function fillVenue(select) {
        const opt = select.selectedOptions[0];
        if (opt && opt.dataset.name) {
            document.getElementById('venue_name').value = opt.dataset.name;
            document.getElementById('address').value = opt.dataset.address || '';
            document.getElementById('city').value = opt.dataset.city || '';
            document.getElementById('state').value = opt.dataset.state || '';
        }
    }
</script>

<%- include('partials/footer') %>
