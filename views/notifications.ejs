<%- include('partials/header', { title: 'Notifications | K-Sync Malaysia' }) %>
<%
    const activeFilter = (typeof currentFilter !== 'undefined') ? currentFilter : 'all';
    const unreadTotal = (typeof totalUnread !== 'undefined') ? totalUnread : 0;
%>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center">
                <span>Notification Center</span>
                <% if (typeof totalUnread !== 'undefined' && totalUnread > 0) { %>
                    <span class="ms-3 px-2.5 py-0.5 rounded-full text-xs font-black bg-pink-100 text-pink-700 border border-pink-200 animate-pulse">
                        <%= totalUnread %> New
                    </span>
                <% } %>
            </h1>
            <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Real-time alerts for your saved concerts, D-Day countdowns, submission statuses, and organizer announcements.</p>
        </div>
        
        <div class="flex items-center space-x-2">
            <% if (typeof totalUnread !== 'undefined' && totalUnread > 0) { %>
                <form action="/notifications/mark-all-read" method="POST">
                    <button type="submit" class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-bold shadow-xs cursor-pointer flex items-center">
                        <i class="fas fa-check-double me-1.5 text-pink-500"></i> Mark All as Read
                    </button>
                </form>
            <% } %>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="flex items-center space-x-2 mb-6">
        <a href="/notifications?filter=all" class="px-4 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer <%= activeFilter === 'all' ? 'bg-slate-900 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
            All Alerts
        </a>
        <a href="/notifications?filter=unread" class="px-4 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center space-x-1.5 <%= activeFilter === 'unread' ? 'bg-slate-900 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
            <span>Unread Only</span>
            <% if (unreadTotal > 0) { %>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= activeFilter === 'unread' ? 'bg-pink-500 text-white' : 'bg-pink-100 text-pink-700' %>">
                    <%= unreadTotal %>
                </span>
            <% } %>
        </a>
    </div>

    <% if (notifications.length === 0) { %>
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
            <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-3">
                <i class="far fa-bell-slash"></i>
            </div>
            <h3 class="text-base font-bold text-slate-800">
                <%= activeFilter === 'unread' ? 'No unread notifications' : 'No notifications yet' %>
            </h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                <%= activeFilter === 'unread' ? 'You have caught up with all your concert notices and updates!' : 'Save your favorite concerts to receive D-7, D-1, and D-Day reminders, gate opening alerts, and organizer updates.' %>
            </p>
            <% if (activeFilter === 'unread') { %>
                <div class="mt-4">
                    <a href="/notifications?filter=all" class="text-xs font-bold text-pink-600 hover:underline">View All Notifications &rarr;</a>
                </div>
            <% } else { %>
                <div class="mt-4">
                    <a href="/events" class="inline-flex items-center px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold shadow hover:bg-slate-800 transition-all">
                        <i class="fas fa-compass me-1.5 text-pink-400"></i> Explore Concerts
                    </a>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div class="space-y-3">
            <% notifications.forEach(function(n) { 
                const msg = n.message || '';
                let iconClass = 'fa-bell text-purple-600';
                let iconBg = 'bg-purple-100 border-purple-200';
                let categoryLabel = 'Notice';

                if (msg.includes('D-Day') || msg.includes('D-1') || msg.includes('D-') || msg.includes('Reminder')) {
                    iconClass = 'fa-hourglass-half text-rose-600';
                    iconBg = 'bg-rose-100 border-rose-200';
                    categoryLabel = 'Concert Countdown';
                } else if (msg.includes('APPROVED') || msg.includes('verified') || msg.includes('Congratulations')) {
                    iconClass = 'fa-circle-check text-emerald-600';
                    iconBg = 'bg-emerald-100 border-emerald-200';
                    categoryLabel = 'Verification Approved';
                } else if (msg.includes('rejected') || msg.includes('Action Required') || msg.includes('warning')) {
                    iconClass = 'fa-triangle-exclamation text-amber-600';
                    iconBg = 'bg-amber-100 border-amber-200';
                    categoryLabel = 'Action Required';
                } else if (msg.includes('Status Update') || msg.includes('marked as')) {
                    iconClass = 'fa-bullhorn text-indigo-600';
                    iconBg = 'bg-indigo-100 border-indigo-200';
                    categoryLabel = 'Status Update';
                }
            %>
                <div class="p-4 sm:p-5 rounded-2xl border transition-all <%= n.is_read ? 'bg-white border-slate-200 hover:border-slate-300' : 'bg-pink-50/50 border-pink-200 shadow-xs ring-1 ring-pink-100' %> flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-start space-x-3.5 min-w-0">
                        <div class="w-10 h-10 rounded-xl <%= iconBg %> border flex items-center justify-center shrink-0 text-base shadow-xs mt-0.5 sm:mt-0">
                            <i class="fas <%= iconClass %>"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center space-x-2">
                                <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md <%= n.is_read ? 'bg-slate-100 text-slate-500' : 'bg-pink-100 text-pink-700' %>">
                                    <%= categoryLabel %>
                                </span>
                                <% if (!n.is_read) { %>
                                    <span class="w-2 h-2 rounded-full bg-pink-500 animate-pulse"></span>
                                <% } %>
                                <span class="text-[11px] text-slate-400 font-medium">
                                    <%= helpers.formatDate(n.created_at) %>
                                </span>
                            </div>
                            <p class="text-xs sm:text-sm font-semibold text-slate-900 mt-1.5 leading-relaxed">
                                <%= n.message %>
                            </p>
                        </div>
                    </div>

                    <!-- Action Controls -->
                    <div class="flex items-center space-x-2 shrink-0 self-end sm:self-center mt-2 sm:mt-0">
                        <% if (n.event_id) { %>
                            <a href="/events/<%= n.event_id %>" class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-xs flex items-center">
                                <span>View Event</span>
                                <i class="fas fa-arrow-right text-[10px] ms-1.5"></i>
                            </a>
                        <% } %>

                        <% if (!n.is_read) { %>
                            <form action="/notifications/<%= n.id %>/read" method="POST" class="inline">
                                <button type="submit" class="w-8 h-8 rounded-xl bg-white border border-slate-200 hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200 text-slate-400 flex items-center justify-center text-xs transition-colors cursor-pointer" title="Mark as Read">
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>
                        <% } %>

                        <form action="/notifications/<%= n.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Remove this notification?');">
                            <button type="submit" class="w-8 h-8 rounded-xl bg-white border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-400 flex items-center justify-center text-xs transition-colors cursor-pointer" title="Delete">
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
