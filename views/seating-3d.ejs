<%- include('partials/header', { title: title || '3D Stadium & Seating POV Simulator | K-Sync Malaysia' }) %>

<!-- Include Three.js & OrbitControls via CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

<div class="relative w-full h-[calc(100vh-4rem)] bg-slate-950 overflow-hidden select-none font-sans text-white">

    <!-- 1. Top HUD Control Bar -->
    <div class="absolute top-0 left-0 right-0 z-30 flex flex-wrap items-center justify-between gap-3 px-4 py-3 bg-gradient-to-b from-slate-950/95 via-slate-950/80 to-transparent pointer-events-auto">
        <div class="flex items-center gap-3">
            <a href="/events" class="px-3 py-1.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700/80 text-xs font-bold flex items-center gap-1.5 transition-all press-tactile">
                <i class="fas fa-arrow-left text-[10px]"></i>
                <span>Events</span>
            </a>
            <% if (selectedEvent) { %>
                <a href="/events/<%= selectedEvent.id %>" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-pink-950/40 border border-pink-500/30 text-pink-300 text-xs font-bold hover:bg-pink-900/40 transition-all">
                    <i class="fas fa-ticket text-[10px] text-pink-400"></i>
                    <span class="truncate max-w-[200px]"><%= selectedEvent.artist_name || selectedEvent.event_name %></span>
                </a>
            <% } %>
            <div class="h-4 w-px bg-slate-800 hidden sm:block"></div>
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-xs font-mono font-bold tracking-wider text-emerald-400 uppercase">3D ARENA POV ENGINE</span>
            </div>
        </div>

        <!-- Venue Selector & Concert Context -->
        <div class="flex items-center gap-2">
            <div class="flex items-center gap-1.5 bg-slate-900/90 border border-slate-700/80 rounded-xl px-2.5 py-1 text-xs">
                <i class="fas fa-building text-pink-400 text-xs"></i>
                <select id="venue-select" onchange="switchVenue(this.value)" class="bg-transparent text-white font-bold text-xs focus:outline-none cursor-pointer">
                    <option value="1" <%= selectedVenue.id === 1 ? 'selected' : '' %>>Axiata Arena Bukit Jalil (16k Indoor)</option>
                    <option value="2" <%= selectedVenue.id === 2 ? 'selected' : '' %>>National Stadium Bukit Jalil (87k Open-Air)</option>
                    <option value="3" <%= selectedVenue.id === 3 ? 'selected' : '' %>>Zepp Kuala Lumpur (2.5k Live Hall)</option>
                </select>
            </div>

            <!-- Free Orbit Reset -->
            <button onclick="resetCameraOverview()" class="px-3 py-1.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/80 text-xs font-bold text-slate-300 hover:text-white flex items-center gap-1.5 transition-all press-tactile" title="Reset to Full Arena Overview">
                <i class="fas fa-rotate text-xs text-cyan-400"></i>
                <span class="hidden md:inline">Reset Overview</span>
            </button>
        </div>
    </div>

    <!-- 2. WebGL 3D Canvas Viewport -->
    <div id="webgl-container" class="w-full h-full cursor-grab active:cursor-grabbing"></div>

    <!-- 3. Dynamic Floating Hover Tooltip -->
    <div id="tier-tooltip" class="absolute pointer-events-none hidden z-40 px-3 py-1.5 rounded-xl bg-slate-900/95 border border-pink-500/50 shadow-xl text-xs font-bold text-white transition-opacity duration-150">
        <div id="tooltip-title" class="text-pink-400 text-[11px] font-mono uppercase">VIP Soundcheck Pit</div>
        <div id="tooltip-sub" class="text-[10px] text-slate-300">Click to Fly to Seat POV</div>
    </div>

    <!-- 4. Left Action Dock: Seat Quick POVs & Concert Atmosphere -->
    <div class="absolute bottom-4 left-4 z-30 flex flex-col gap-2.5 max-w-[280px] sm:max-w-xs pointer-events-auto">
        <!-- Seat POV Quick Selector -->
        <div class="p-3 rounded-2xl bg-slate-950/85 backdrop-blur-md border border-slate-800/80 shadow-2xl space-y-2">
            <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 font-bold uppercase tracking-wider">
                <span><i class="fas fa-crosshairs text-pink-400 me-1"></i> Sightline POVs</span>
                <span class="text-[9px] text-pink-400 bg-pink-950/60 px-1.5 py-0.5 rounded border border-pink-500/30">Raycast Active</span>
            </div>
            
            <div class="grid grid-cols-2 gap-1.5">
                <button onclick="flyToSeat('vip')" id="btn-pov-vip" class="pov-btn px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-[11px] font-bold text-left flex items-center gap-1.5 transition-all">
                    <span class="w-2 h-2 rounded-full bg-pink-500"></span>
                    <span class="truncate">VIP Rock Pit</span>
                </button>
                <button onclick="flyToSeat('barricade')" id="btn-pov-barricade" class="pov-btn px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-[11px] font-bold text-left flex items-center gap-1.5 transition-all">
                    <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                    <span class="truncate">Stage Barricade</span>
                </button>
                <button onclick="flyToSeat('cat1')" id="btn-pov-cat1" class="pov-btn px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-[11px] font-bold text-left flex items-center gap-1.5 transition-all">
                    <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                    <span class="truncate">CAT 1 Sec 108</span>
                </button>
                <button onclick="flyToSeat('cat2')" id="btn-pov-cat2" class="pov-btn px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-[11px] font-bold text-left flex items-center gap-1.5 transition-all">
                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                    <span class="truncate">CAT 2 Mid Bowl</span>
                </button>
                <button onclick="flyToSeat('cat3')" id="btn-pov-cat3" class="pov-btn px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-[11px] font-bold text-left flex items-center gap-1.5 transition-all">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span class="truncate">CAT 3 Sec 314</span>
                </button>
                <button onclick="resetCameraOverview()" id="btn-pov-overview" class="pov-btn px-2.5 py-1.5 rounded-xl bg-pink-600/30 hover:bg-pink-600/40 border border-pink-500/50 text-[11px] font-bold text-left flex items-center gap-1.5 transition-all text-pink-300">
                    <i class="fas fa-globe text-[10px]"></i>
                    <span class="truncate">Full Arena 360°</span>
                </button>
            </div>
        </div>

        <!-- Concert Ambience & Lightstick Ocean Controls -->
        <div class="p-3 rounded-2xl bg-slate-950/85 backdrop-blur-md border border-slate-800/80 shadow-2xl flex items-center justify-between gap-2">
            <!-- Lightstick Ocean Toggle -->
            <button onclick="toggleLightsticks()" id="btn-lightstick" class="flex-1 px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all text-pink-400" title="Toggle 2,500 pulsating lightsticks in audience">
                <i class="fas fa-wand-sparkles text-xs"></i>
                <span id="lightstick-label">Lightstick: ON</span>
            </button>

            <!-- Fandom Color Switcher -->
            <div class="flex items-center gap-1">
                <button onclick="setFandomColor('pink')" class="w-6 h-6 rounded-full bg-pink-500 ring-1 ring-white/30 hover:scale-110 transition-transform" title="Cyber Pink (BABYMONSTER/Blackpink)"></button>
                <button onclick="setFandomColor('rosequartz')" class="w-6 h-6 rounded-full bg-[#f7cac9] ring-1 ring-white/30 hover:scale-110 transition-transform" title="Rose Quartz (SEVENTEEN)"></button>
                <button onclick="setFandomColor('cyan')" class="w-6 h-6 rounded-full bg-cyan-400 ring-1 ring-white/30 hover:scale-110 transition-transform" title="Neon Cyan (wave to earth)"></button>
                <button onclick="setFandomColor('gold')" class="w-6 h-6 rounded-full bg-amber-400 ring-1 ring-white/30 hover:scale-110 transition-transform" title="Golden Solar"></button>
            </div>

            <!-- Screenshot Capture Tool -->
            <button onclick="captureSightlineSnapshot()" class="w-8 h-8 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all press-tactile" title="Capture High-Res Sightline Screenshot">
                <i class="fas fa-camera text-xs"></i>
            </button>
        </div>
    </div>

    <!-- 5. Right Side Glassmorphism Sightline Dossier HUD -->
    <div class="absolute top-16 right-4 z-30 w-72 sm:w-80 pointer-events-auto">
        <div class="p-4 rounded-3xl bg-slate-950/85 backdrop-blur-xl border border-slate-800/90 shadow-2xl space-y-3.5">
            <!-- Header Section Info -->
            <div class="flex items-start justify-between gap-2 border-b border-slate-800/80 pb-3">
                <div>
                    <div class="flex items-center gap-1.5">
                        <span id="dossier-tier-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-pink-500/20 text-pink-400 border border-pink-500/40">VIP Soundcheck</span>
                        <span id="dossier-block" class="text-xs font-mono text-slate-400">Block 108</span>
                    </div>
                    <h2 id="dossier-title" class="text-base font-black text-white tracking-tight mt-1">VIP Standing Pit (Catwalk Barricade)</h2>
                </div>
                <div class="text-right">
                    <div id="dossier-price" class="text-sm font-black text-pink-400 font-mono">RM 888</div>
                    <div class="text-[10px] text-slate-400">Est. Tier Price</div>
                </div>
            </div>

            <!-- Sightline Metrics Grid -->
            <div class="grid grid-cols-2 gap-2 text-xs">
                <div class="p-2.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-0.5">
                    <div class="text-[10px] text-slate-400 font-mono uppercase flex items-center gap-1">
                        <i class="fas fa-ruler-horizontal text-cyan-400"></i> Stage Distance
                    </div>
                    <div id="dossier-distance" class="text-sm font-black text-white font-mono">14 meters</div>
                    <div class="text-[9px] text-emerald-400 font-medium">Clear Eye-Level Line</div>
                </div>

                <div class="p-2.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-0.5">
                    <div class="text-[10px] text-slate-400 font-mono uppercase flex items-center gap-1">
                        <i class="fas fa-eye text-pink-400"></i> Sightline Rating
                    </div>
                    <div id="dossier-rating" class="text-sm font-black text-white font-mono">4.9 / 5.0</div>
                    <div class="text-[9px] text-slate-400 font-medium">Zero Pillar Block</div>
                </div>

                <div class="p-2.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-0.5">
                    <div class="text-[10px] text-slate-400 font-mono uppercase flex items-center gap-1">
                        <i class="fas fa-volume-high text-purple-400"></i> Acoustics Quality
                    </div>
                    <div id="dossier-sound" class="text-sm font-black text-white">Dolby Live Sub</div>
                    <div class="text-[9px] text-slate-400 font-medium">Earplugs Advised</div>
                </div>

                <div class="p-2.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-0.5">
                    <div class="text-[10px] text-slate-400 font-mono uppercase flex items-center gap-1">
                        <i class="fas fa-chart-line text-amber-400"></i> Incline Angle
                    </div>
                    <div id="dossier-angle" class="text-sm font-black text-white font-mono">+12° Incline</div>
                    <div class="text-[9px] text-slate-400 font-medium">Head-Clear Row</div>
                </div>
            </div>

            <!-- Fan Community Field Advice -->
            <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 space-y-1">
                <div class="flex items-center gap-1.5 text-[10px] font-mono font-bold text-pink-400 uppercase">
                    <i class="fas fa-comment-dots"></i> Fan Community Field Tip
                </div>
                <p id="dossier-tip" class="text-[11px] text-slate-300 leading-relaxed">
                    "Axiata Section 108 is the holy grail for extended catwalk stages! Members stop right in front of this railing for encore tracks. Bring a portable neck fan."
                </p>
            </div>

            <!-- Tour Anthem 30s Preview Player inside 3D HUD -->
            <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                    <div class="text-[10px] font-mono text-slate-400 flex items-center gap-1.5">
                        <i class="fab fa-apple text-pink-400"></i>
                        <span>Tour Anthem Acoustics Test</span>
                    </div>
                    <div id="hud-audio-bars" class="flex items-end gap-0.5 h-3 opacity-40">
                        <span class="w-1 bg-pink-400 rounded-full h-1"></span>
                        <span class="w-1 bg-pink-500 rounded-full h-2.5"></span>
                        <span class="w-1 bg-pink-400 rounded-full h-1.5"></span>
                    </div>
                </div>
                <div class="flex items-center gap-2.5">
                    <button type="button" onclick="toggleSimAudio()" class="w-8 h-8 rounded-full bg-pink-600 hover:bg-pink-500 text-white flex items-center justify-center shrink-0 shadow-md press-tactile transition-all">
                        <i class="fas fa-play text-[10px] ps-0.5" id="sim-audio-icon"></i>
                    </button>
                    <div class="min-w-0 flex-grow">
                        <div id="sim-song-title" class="text-xs font-black text-white truncate">SEVENTEEN - MAESTRO</div>
                        <div class="text-[10px] text-slate-400 truncate">Official Tour Preview Audio</div>
                    </div>
                </div>
                <audio id="sim-audio-player" preload="none"></audio>
            </div>

            <!-- Booking / Outbound Action -->
            <% if (selectedEvent && selectedEvent.official_ticket_url) { %>
                <a href="<%= selectedEvent.official_ticket_url %>" target="_blank" rel="noopener noreferrer" class="w-full py-2.5 rounded-2xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-black text-xs flex items-center justify-center gap-2 shadow-lg shadow-pink-500/25 press-tactile transition-all">
                    <span>Secure Tickets for this Section</span>
                    <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
                </a>
            <% } else { %>
                <a href="/events" class="w-full py-2.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center gap-2 press-tactile transition-all">
                    <span>Explore Verified Concerts</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </a>
            <% } %>
        </div>
    </div>

</div>

<!-- 6. 3D WebGL Engine & Raycasting Script -->
<script>
    // -------------------------------------------------------------------------
    // Global Three.js State & Configurations
    // -------------------------------------------------------------------------
    let scene, camera, renderer, controls;
    let interactiveMeshes = [];
    let hoveredMesh = null;
    let lightstickParticles = null;
    let areLightsticksVisible = true;
    let currentFandomColor = 0xec4899; // Cyber Pink
    let movingSpotlights = [];
    let ledCanvas, ledCtx, ledTexture;
    let currentVenueId = <%= selectedVenue.id || 1 %>;

    // Camera Interpolation State (LERP)
    let isCameraAnimating = false;
    let targetCameraPos = new THREE.Vector3(0, 45, 75);
    let targetLookAt = new THREE.Vector3(0, 5, 0);
    let currentLookAt = new THREE.Vector3(0, 5, 0);

    // Seat POVs Data Definition
    const SEAT_DATA = {
        vip: {
