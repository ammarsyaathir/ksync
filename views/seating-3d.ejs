            lookAt: new THREE.Vector3(0, 4.0, -26)
        },
        cat1: {
            title: "CAT 1 Lower Bowl (Tier 1)",
            badge: "CAT 1 Reserved",
            block: "Section 108 (Row J)",
            price: "RM 688",
            distance: "32 meters",
            rating: "4.8 / 5.0",
            sound: "Balanced Stereo",
            angle: "+18° Elevated",
            tip: "The fan-favorite sweet spot at Axiata Arena! Elevated above the floor standing crowd with clear sightlines over the catwalk and sound towers.",
            cameraPos: new THREE.Vector3(-24, 11, 16),
            lookAt: new THREE.Vector3(0, 4.0, -5)
        },
        cat2: {
            title: "CAT 2 Mid Tier Bowl",
            badge: "CAT 2 Seated",
            block: "Section 215",
            price: "RM 588",
            distance: "54 meters",
            rating: "4.5 / 5.0",
            sound: "Optimal Delay Mix",
            angle: "+28° Stadium Slope",
            tip: "Excellent panoramic sightline of the entire stage lighting design, lightstick ocean patterns, and synchronised stadium choreo.",
            cameraPos: new THREE.Vector3(32, 19, 32),
            lookAt: new THREE.Vector3(0, 5.0, -10)
        },
        cat3: {
            title: "CAT 3 Upper Tier (Panoramic)",
            badge: "CAT 3 Value",
            block: "Section 314 (Upper)",
            price: "RM 388",
            distance: "76 meters",
            rating: "4.2 / 5.0",
            sound: "Acoustic Surround",
            angle: "+42° Bird's-Eye",
            tip: "Steep upper deck with full birds-eye visibility of stage formations. Bring 10x binoculars for artist closeups; crystal clear sound relay.",
            cameraPos: new THREE.Vector3(0, 36, 52),
            lookAt: new THREE.Vector3(0, 4.0, -15)
        },
        overview: {
            title: "360° Grand Arena Overview",
            badge: "Architectural 3D",
            block: "Free Orbit Camera",
            price: "All Tiers",
            distance: "75m Altitude",
            rating: "Full Venue",
            sound: "Arena Ambient",
            angle: "Free Orbit",
            tip: "Drag with left mouse or touch to orbit 360°. Scroll or pinch to zoom. Click any glowing tier mesh to teleport directly into that seat!",
            cameraPos: new THREE.Vector3(0, 45, 75),
            lookAt: new THREE.Vector3(0, 5, 0)
        }
    };

    // -------------------------------------------------------------------------
    // Initialize Three.js Scene
    // -------------------------------------------------------------------------
    function init3DScene() {
        const container = document.getElementById('webgl-container');
        if (!container) return;

        // 1. Scene & Background
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x060911); // Deep Stage Obsidian
        scene.fog = new THREE.FogExp2(0x060911, 0.009);

        // 2. Camera Setup
        camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.5, 1000);
        camera.position.set(0, 45, 75);

        // 3. Renderer Setup
        renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true, powerPreference: "high-performance" });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // 4. OrbitControls Setup
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.02; // Keep above floor
        controls.minDistance = 5;
        controls.maxDistance = 160;
        controls.target.set(0, 5, 0);

        // 5. Build Venue Elements
        buildArenaEnvironment();

        // 6. Setup Raycaster for Mouse Interactivity
        setupRaycasting();

        // 7. Event Listeners
        window.addEventListener('resize', onWindowResize);

        // 8. Load Tour Anthem if available
        initAnthemAudio();

        // 9. Begin Animation Loop
        animate();
    }

    // -------------------------------------------------------------------------
    // Procedural Arena Geometry & Concert Construction
    // -------------------------------------------------------------------------
    function buildArenaEnvironment() {
        // Clear previous meshes
        interactiveMeshes = [];
        movingSpotlights = [];

        // Ambient Light
        const ambientLight = new THREE.AmbientLight(0x22263a, 1.2);
        scene.add(ambientLight);

        // Main Stage Directional Key Light
        const dirLight = new THREE.DirectionalLight(0xfff5ea, 1.5);
        dirLight.position.set(0, 40, -10);
        dirLight.castShadow = true;
        scene.add(dirLight);

        // Ground Floor / Turf
        const floorGeo = new THREE.PlaneGeometry(160, 160);
        const floorMat = new THREE.MeshStandardMaterial({ 
            color: 0x0a0f1d, 
            roughness: 0.85, 
            metalness: 0.2 
        });
        const floor = new THREE.Mesh(floorGeo, floorMat);
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        scene.add(floor);

        // Grid Floor Lines
        const gridHelper = new THREE.GridHelper(160, 40, 0x1e293b, 0x0f172a);
        gridHelper.position.y = 0.02;
        scene.add(gridHelper);

        // ---------------------------------------------------------------------
        // 1. Stage Construction (Main Stage + Catwalk + B-Stage)
        // ---------------------------------------------------------------------
        const stageGroup = new THREE.Group();

        // Main Stage Platform (Back)
        const mainStageGeo = new THREE.BoxGeometry(42, 2.2, 18);
        const stageMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.4, metalness: 0.6 });
        const mainStage = new THREE.Mesh(mainStageGeo, stageMat);
        mainStage.position.set(0, 1.1, -26);
        mainStage.castShadow = true;
        mainStage.receiveShadow = true;
        stageGroup.add(mainStage);

        // Extended Catwalk Runway
        const catwalkGeo = new THREE.BoxGeometry(6, 2.0, 26);
        const catwalk = new THREE.Mesh(catwalkGeo, stageMat);
        catwalk.position.set(0, 1.0, -4);
        catwalk.castShadow = true;
        catwalk.receiveShadow = true;
        stageGroup.add(catwalk);

        // Extended Thrust B-Stage Platform
        const bStageGeo = new THREE.CylinderGeometry(8.5, 8.5, 2.0, 32);
        const bStage = new THREE.Mesh(bStageGeo, stageMat);
        bStage.position.set(0, 1.0, 8);
        bStage.castShadow = true;
        bStage.receiveShadow = true;
        stageGroup.add(bStage);

        // Stage Edge Neon Glow Strips
        const glowStripMat = new THREE.MeshBasicMaterial({ color: 0xec4899 });
        const bStageRingGeo = new THREE.RingGeometry(8.4, 8.6, 32);
        const bStageRing = new THREE.Mesh(bStageRingGeo, glowStripMat);
        bStageRing.rotation.x = -Math.PI / 2;
        bStageRing.position.set(0, 2.02, 8);
        stageGroup.add(bStageRing);

        // Dynamic Animated LED Video Wall (Canvas Texture)
        initLedScreen(stageGroup);

        // Overhead Truss Rig
        buildTrussAndSpotlights(stageGroup);

        scene.add(stageGroup);

        // ---------------------------------------------------------------------
        // 2. Seating Tiers (Interactive Raycast Meshes)
        // ---------------------------------------------------------------------
        buildInteractiveSeating();

        // ---------------------------------------------------------------------
        // 3. Audience Lightstick Ocean (2,500 Instanced Particles)
        // ---------------------------------------------------------------------
        buildLightstickOcean();
    }

    // Dynamic LED Video Wall with Animated Visualizer Texture
    function initLedScreen(parentGroup) {
        ledCanvas = document.createElement('canvas');
        ledCanvas.width = 512;
        ledCanvas.height = 256;
        ledCtx = ledCanvas.getContext('2d');

        ledTexture = new THREE.CanvasTexture(ledCanvas);
        const ledMat = new THREE.MeshBasicMaterial({ map: ledTexture });
        const ledGeo = new THREE.PlaneGeometry(38, 14);
        const ledMesh = new THREE.Mesh(ledGeo, ledMat);
        ledMesh.position.set(0, 9.5, -34.8);
        parentGroup.add(ledMesh);
    }

    function updateLedScreen(time) {
        if (!ledCtx) return;
        // Background gradient
        const grad = ledCtx.createLinearGradient(0, 0, 512, 256);
        grad.addColorStop(0, '#090d16');
        grad.addColorStop(0.5, '#4a044e');
        grad.addColorStop(1, '#090d16');
        ledCtx.fillStyle = grad;
        ledCtx.fillRect(0, 0, 512, 256);

        // Soundwave Graphic Bars
        ledCtx.fillStyle = '#ec4899';
        const numBars = 24;
        const barWidth = 14;
        const spacing = 7;
        for (let i = 0; i < numBars; i++) {
            const h = Math.abs(Math.sin(time * 3 + i * 0.4)) * 90 + 20;
            ledCtx.fillRect(30 + i * (barWidth + spacing), 180 - h, barWidth, h);
        }

        // Concert Text
        ledCtx.fillStyle = '#ffffff';
        ledCtx.font = 'bold 28px "Outfit", sans-serif';
        ledCtx.textAlign = 'center';
        const artist = <%- JSON.stringify((selectedEvent && selectedEvent.artist_name) ? selectedEvent.artist_name : 'K-SYNC TOUR LIVE') %>;
        ledCtx.fillText(String(artist).toUpperCase(), 256, 75);

        ledCtx.font = 'bold 14px "JetBrains Mono", monospace';
        ledCtx.fillStyle = '#f472b6';
        ledCtx.fillText('AXIATA ARENA · KUALA LUMPUR', 256, 105);

        if (ledTexture) ledTexture.needsUpdate = true;
    }

    // Overhead Truss & Moving Spotlights
    function buildTrussAndSpotlights(parentGroup) {
        const trussMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.8, roughness: 0.3 });
        const trussGeo = new THREE.BoxGeometry(46, 1.2, 1.2);
        const truss = new THREE.Mesh(trussGeo, trussMat);
        truss.position.set(0, 24, -18);
        parentGroup.add(truss);

        // 4 Dynamic Spotlight Cones
        const spotColors = [0xec4899, 0x06b6d4, 0x8b5cf6, 0xf59e0b];
        const spotPositions = [-16, -6, 6, 16];

        spotPositions.forEach((xPos, idx) => {
            const spotLight = new THREE.SpotLight(spotColors[idx], 3.5, 80, Math.PI / 7, 0.4, 1);
            spotLight.position.set(xPos, 24, -18);
            spotLight.castShadow = true;
            parentGroup.add(spotLight);

            // Spotlight target helper
            const target = new THREE.Object3D();
            target.position.set(xPos * 0.5, 0, 8);
            scene.add(target);
            spotLight.target = target;

            movingSpotlights.push({ light: spotLight, target: target, baseOffset: idx * 1.5 });
        });
    }

    // Build Raycastable Tier Meshes
    function buildInteractiveSeating() {
        // 1. VIP Rock Zone / Standing Pit
        const vipMat = new THREE.MeshStandardMaterial({ 
            color: 0xdb2777, 
            roughness: 0.6, 
            transparent: true, 
            opacity: 0.85 
        });
        const vipGeo = new THREE.BoxGeometry(26, 0.4, 28);
        const vipMesh = new THREE.Mesh(vipGeo, vipMat);
        vipMesh.position.set(0, 0.2, 8);
        vipMesh.userData = { 
            tierKey: 'vip', 
            name: 'VIP Standing Pit (Catwalk Barricade)', 
            color: 0xdb2777 
        };
        scene.add(vipMesh);
        interactiveMeshes.push(vipMesh);

        // 2. CAT 1 Lower Bowl Tiers (Curved horseshoe sections)
        const cat1Mat = new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.5 });
        const cat1Sections = [
            { pos: [-30, 4, 12], rot: [0, Math.PI / 8, 0], key: 'cat1', name: 'CAT 1 Sec 108 (Lower West)' },
            { pos: [30, 4, 12], rot: [0, -Math.PI / 8, 0], key: 'cat1', name: 'CAT 1 Sec 112 (Lower East)' },
            { pos: [0, 5.5, 34], rot: [0, 0, 0], key: 'cat1', name: 'CAT 1 Sec 101 (Lower Center)' }
        ];

        cat1Sections.forEach(s => {
            const m = new THREE.Mesh(new THREE.BoxGeometry(22, 6, 12), cat1Mat.clone());
            m.position.set(...s.pos);
            m.rotation.set(...s.rot);
            m.userData = { tierKey: s.key, name: s.name, color: 0x0284c7 };
            scene.add(m);
            interactiveMeshes.push(m);
        });

        // 3. CAT 2 Mid Bowl Tiers
        const cat2Mat = new THREE.MeshStandardMaterial({ color: 0x7c3aed, roughness: 0.5 });
        const cat2Sections = [
            { pos: [-46, 10, 16], rot: [0, Math.PI / 6, 0], key: 'cat2', name: 'CAT 2 Sec 215 (Mid West)' },
            { pos: [46, 10, 16], rot: [0, -Math.PI / 6, 0], key: 'cat2', name: 'CAT 2 Sec 220 (Mid East)' },
            { pos: [0, 13, 50], rot: [0, 0, 0], key: 'cat2', name: 'CAT 2 Sec 205 (Mid Center)' }
        ];

        cat2Sections.forEach(s => {
            const m = new THREE.Mesh(new THREE.BoxGeometry(28, 9, 14), cat2Mat.clone());
            m.position.set(...s.pos);
            m.rotation.set(...s.rot);
            m.userData = { tierKey: s.key, name: s.name, color: 0x7c3aed };
            scene.add(m);
            interactiveMeshes.push(m);
        });

        // 4. CAT 3 Upper Tier Panoramic Deck
        const cat3Mat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.6 });
        const cat3Sections = [
            { pos: [-58, 18, 20], rot: [0, Math.PI / 5, 0], key: 'cat3', name: 'CAT 3 Sec 314 (Upper West)' },
            { pos: [58, 18, 20], rot: [0, -Math.PI / 5, 0], key: 'cat3', name: 'CAT 3 Sec 322 (Upper East)' },
            { pos: [0, 22, 68], rot: [0, 0, 0], key: 'cat3', name: 'CAT 3 Sec 301 (Upper Center)' }
        ];

        cat3Sections.forEach(s => {
            const m = new THREE.Mesh(new THREE.BoxGeometry(34, 12, 16), cat3Mat.clone());
            m.position.set(...s.pos);
            m.rotation.set(...s.rot);
            m.userData = { tierKey: s.key, name: s.name, color: 0xd97706 };
            scene.add(m);
            interactiveMeshes.push(m);
        });
    }

    // 2,500 Pulsating Audience Lightsticks (Particle Ocean)
    function buildLightstickOcean() {
        const particleCount = 2200;
        const positions = new Float32Array(particleCount * 3);
        const colors = new Float32Array(particleCount * 3);
        const baseColor = new THREE.Color(currentFandomColor);

        for (let i = 0; i < particleCount; i++) {
            // Distribute across stadium bowl geometry
            const angle = (Math.random() * Math.PI) - Math.PI / 2; // Front half
            const radius = 18 + Math.random() * 58;
            const x = Math.sin(angle) * radius;
            const z = Math.cos(angle) * radius + (radius > 30 ? 10 : 0);
            const y = (radius / 65) * 26 + (Math.random() * 2.5);

            positions[i * 3] = x;
            positions[i * 3 + 1] = y;
            positions[i * 3 + 2] = z;

            // Subtle color variance
            const c = baseColor.clone().offsetHSL((Math.random() - 0.5) * 0.05, 0, (Math.random() - 0.5) * 0.1);
            colors[i * 3] = c.r;
            colors[i * 3 + 1] = c.g;
            colors[i * 3 + 2] = c.b;
        }

        const particleGeo = new THREE.BufferGeometry();
        particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        particleGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        const particleMat = new THREE.PointsMaterial({
            size: 1.1,
            vertexColors: true,
            transparent: true,
            opacity: 0.85,
            blending: THREE.AdditiveBlending
        });

        lightstickParticles = new THREE.Points(particleGeo, particleMat);
        scene.add(lightstickParticles);
    }

    // -------------------------------------------------------------------------
    // Raycasting & Mouse Interaction Setup
    // -------------------------------------------------------------------------
    function setupRaycasting() {
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        const container = document.getElementById('webgl-container');
        const tooltip = document.getElementById('tier-tooltip');
        const tooltipTitle = document.getElementById('tooltip-title');

        container.addEventListener('mousemove', (e) => {
            const rect = container.getBoundingClientRect();
            mouse.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
            mouse.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveMeshes);

            if (intersects.length > 0) {
                const hit = intersects[0].object;
                container.style.cursor = 'pointer';

                if (hoveredMesh !== hit) {
                    if (hoveredMesh) hoveredMesh.material.emissive?.setHex(0x000000);
                    hoveredMesh = hit;
                    if (hoveredMesh.material.emissive) {
                        hoveredMesh.material.emissive.setHex(0xec4899);
                    }
                }

                if (tooltip && tooltipTitle) {
                    tooltip.style.display = 'block';
                    tooltip.style.left = `${e.clientX + 16}px`;
                    tooltip.style.top = `${e.clientY + 16}px`;
                    tooltipTitle.textContent = hit.userData.name || 'Concert Seating Tier';
                }
            } else {
                container.style.cursor = 'grab';
                if (hoveredMesh) {
                    if (hoveredMesh.material.emissive) hoveredMesh.material.emissive.setHex(0x000000);
                    hoveredMesh = null;
                }
                if (tooltip) tooltip.style.display = 'none';
            }
        });

        container.addEventListener('click', (e) => {
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveMeshes);
            if (intersects.length > 0) {
                const hit = intersects[0].object;
                if (hit.userData && hit.userData.tierKey) {
                    flyToSeat(hit.userData.tierKey);
                }
            }
        });
    }

    // -------------------------------------------------------------------------
    // Seat POV Fly-To Animation Controller (LERP)
    // -------------------------------------------------------------------------
    function flyToSeat(tierKey) {
        const data = SEAT_DATA[tierKey];
        if (!data) return;

        // Update Dossier Card
        document.getElementById('dossier-title').textContent = data.title;
        document.getElementById('dossier-tier-badge').textContent = data.badge;
        document.getElementById('dossier-block').textContent = data.block;
        document.getElementById('dossier-price').textContent = data.price;
        document.getElementById('dossier-distance').textContent = data.distance;
        document.getElementById('dossier-rating').textContent = data.rating;
        document.getElementById('dossier-sound').textContent = data.sound;
        document.getElementById('dossier-angle').textContent = data.angle;
        document.getElementById('dossier-tip').textContent = `"${data.tip}"`;

        // Highlight active POV button
        document.querySelectorAll('.pov-btn').forEach(btn => {
            btn.classList.remove('ring-2', 'ring-pink-500', 'bg-slate-800');
        });
        const activeBtn = document.getElementById(`btn-pov-${tierKey}`);
        if (activeBtn) activeBtn.classList.add('ring-2', 'ring-pink-500', 'bg-slate-800');

        // Setup smooth camera interpolation target
        targetCameraPos.copy(data.cameraPos);
        targetLookAt.copy(data.lookAt);
        isCameraAnimating = true;
    }

    function resetCameraOverview() {
        flyToSeat('overview');
    }

    // -------------------------------------------------------------------------
    // Ambience & Fandom Color Controllers
    // -------------------------------------------------------------------------
    function toggleLightsticks() {
        if (!lightstickParticles) return;
        areLightsticksVisible = !areLightsticksVisible;
        lightstickParticles.visible = areLightsticksVisible;
        const label = document.getElementById('lightstick-label');
        if (label) label.textContent = areLightsticksVisible ? 'Lightstick: ON' : 'Lightstick: OFF';
    }

    function setFandomColor(scheme) {
        let hexColor = 0xec4899; // Cyber pink default
        if (scheme === 'rosequartz') hexColor = 0xf7cac9; // SEVENTEEN
        if (scheme === 'cyan') hexColor = 0x06b6d4; // wave to earth
        if (scheme === 'gold') hexColor = 0xf59e0b; // Gold Solar

        currentFandomColor = hexColor;

        if (lightstickParticles) {
            const colors = lightstickParticles.geometry.attributes.color.array;
            const targetC = new THREE.Color(hexColor);
            for (let i = 0; i < colors.length / 3; i++) {
                const c = targetC.clone().offsetHSL((Math.random() - 0.5) * 0.05, 0, (Math.random() - 0.5) * 0.1);
                colors[i * 3] = c.r;
                colors[i * 3 + 1] = c.g;
                colors[i * 3 + 2] = c.b;
            }
            lightstickParticles.geometry.attributes.color.needsUpdate = true;
        }
    }

    function captureSightlineSnapshot() {
        renderer.render(scene, camera);
        const dataURL = renderer.domElement.toDataURL('image/png');
        const link = document.createElement('a');
        link.download = `KSync_Sightline_${currentVenueId}_POV.png`;
        link.href = dataURL;
        link.click();
    }

    function switchVenue(venueId) {
        window.location.href = `/venues/seating-3d?venue=${venueId}<%= selectedEvent ? '&event=' + selectedEvent.id : '' %>`;
    }

    // -------------------------------------------------------------------------
    // Tour Anthem Audio Integration in 3D Simulator
    // -------------------------------------------------------------------------
    let isSimAudioPlaying = false;
    async function initAnthemAudio() {
        const audio = document.getElementById('sim-audio-player');
        const titleEl = document.getElementById('sim-song-title');
        const artist = <%- JSON.stringify((selectedEvent && selectedEvent.artist_name) ? selectedEvent.artist_name : 'SEVENTEEN') %>;
        const tour = <%- JSON.stringify((selectedEvent && selectedEvent.event_name) ? selectedEvent.event_name : 'RIGHT HERE WORLD TOUR') %>;

        try {
            const res = await fetch(`/api/music/preview?artist=${encodeURIComponent(artist)}&title=${encodeURIComponent(tour)}`);
            const json = await res.json();
            if (json.status === 'success' && json.data) {
                audio.src = json.data.previewUrl;
                if (titleEl) titleEl.textContent = `${json.data.artistName} - ${json.data.trackName}`;
            }
        } catch (e) {
            console.warn('Sim anthem failed:', e);
        }
    }

    function toggleSimAudio() {
        const audio = document.getElementById('sim-audio-player');
        const icon = document.getElementById('sim-audio-icon');
        const bars = document.getElementById('hud-audio-bars');
        if (!audio || !audio.src) return;

        if (isSimAudioPlaying) {
            audio.pause();
            isSimAudioPlaying = false;
            if (icon) icon.className = 'fas fa-play text-[10px] ps-0.5';
            if (bars) bars.classList.add('opacity-40');
        } else {
            audio.play().then(() => {
                isSimAudioPlaying = true;
                if (icon) icon.className = 'fas fa-pause text-[10px]';
                if (bars) bars.classList.remove('opacity-40');
            }).catch(e => console.warn('Audio play error:', e));
        }
    }

    // -------------------------------------------------------------------------
    // Render & Animation Loop
    // -------------------------------------------------------------------------
    function onWindowResize() {
        const container = document.getElementById('webgl-container');
        if (!container || !camera || !renderer) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    }

    function animate(timestamp) {
        requestAnimationFrame(animate);

        const time = (timestamp || 0) * 0.001;

        // 1. Smooth Camera Fly-To Interpolation (LERP)
        if (isCameraAnimating) {
            camera.position.lerp(targetCameraPos, 0.05);
            currentLookAt.lerp(targetLookAt, 0.05);
            controls.target.copy(currentLookAt);

            if (camera.position.distanceTo(targetCameraPos) < 0.2) {
                isCameraAnimating = false;
            }
        } else {
            controls.update();
        }

        // 2. Animated LED Screen Texture
        updateLedScreen(time);

        // 3. Moving Spotlights Sweep across Audience
        movingSpotlights.forEach(item => {
            const sweepX = Math.sin(time * 1.8 + item.baseOffset) * 16;
            const sweepZ = Math.cos(time * 1.4 + item.baseOffset) * 12 + 6;
            item.target.position.set(sweepX, 0, sweepZ);
        });

        // 4. Lightstick Wave Shimmer
        if (lightstickParticles && areLightsticksVisible) {
            const count = lightstickParticles.geometry.attributes.position.count;
            const positions = lightstickParticles.geometry.attributes.position.array;
            // Subtle breathing scale
            lightstickParticles.material.size = 1.0 + Math.sin(time * 4) * 0.25;
        }

        renderer.render(scene, camera);
    }

    // Initialize on DOM Ready
    document.addEventListener('DOMContentLoaded', init3DScene);
</script>

