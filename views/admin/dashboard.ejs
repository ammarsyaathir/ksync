<%- include('../partials/header', { title: 'Admin Dashboard | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <div class="flex items-center space-x-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white shadow-sm">
                    <i class="fas fa-shield-halved me-1 text-purple-400"></i> Admin Portal
                </span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">System Administrator Dashboard</h1>
            <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Platform oversight, event approval queue, user verification & audit trails.</p>
        </div>
        <% if (pendingSubmissionsCount > 0) { %>
            <a href="/admin/verifications" class="px-5 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shadow flex items-center shrink-0">
                <i class="fas fa-bell me-2"></i> <%= pendingSubmissionsCount %> Pending Event(s)
            </a>
        <% } %>
    </div>

    <!-- Admin Nav -->
    <%- include('./admin-nav', { activePath: '/admin', pendingCount: pendingSubmissionsCount }) %>

    <!-- Metric Stat Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="p-5 rounded-3xl bg-pink-50 border border-pink-200">
            <div class="text-xs font-bold text-pink-700 uppercase tracking-wider mb-1">Total Events</div>
            <div class="text-3xl font-black text-pink-950"><%= totalEvents %></div>
            <div class="text-[11px] text-pink-700 font-medium mt-1">Concerts & Fan Meetings</div>
        </div>
        <div class="p-5 rounded-3xl bg-amber-50 border border-amber-200">
            <div class="text-xs font-bold text-amber-700 uppercase tracking-wider mb-1">Pending Approval</div>
            <div class="text-3xl font-black text-amber-950"><%= pendingSubmissionsCount %></div>
            <div class="text-[11px] text-amber-700 font-medium mt-1">Awaiting verification</div>
        </div>
        <div class="p-5 rounded-3xl bg-purple-50 border border-purple-200">
            <div class="text-xs font-bold text-purple-700 uppercase tracking-wider mb-1">Registered Users</div>
            <div class="text-3xl font-black text-purple-950"><%= totalUsers %></div>
            <div class="text-[11px] text-purple-700 font-medium mt-1">Fans & Organizers</div>
        </div>
        <div class="p-5 rounded-3xl bg-emerald-50 border border-emerald-200">
            <div class="text-xs font-bold text-emerald-700 uppercase tracking-wider mb-1">Verified Fanclubs</div>
            <div class="text-3xl font-black text-emerald-950"><%= verifiedFanclubs %></div>
            <div class="text-[11px] text-emerald-700 font-medium mt-1">Trusted community organizers</div>
        </div>
    </div>

    <!-- Two-Column Review & Logs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Pending Submissions Preview -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900 flex items-center">
                    <i class="fas fa-clock text-amber-500 me-2"></i> Submissions Awaiting Approval
                </h3>
                <a href="/admin/verifications" class="text-xs font-bold text-pink-600 hover:underline">View All &rarr;</a>
            </div>

            <% if (pendingList.length === 0) { %>
                <div class="text-center py-8 text-slate-400 text-xs">
                    <i class="fas fa-circle-check text-emerald-500 text-2xl mb-2"></i>
                    <div>All event submissions have been reviewed!</div>
                </div>
            <% } else { %>
                <div class="space-y-3">
                    <% pendingList.forEach(function(ev) { %>
                        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <div class="text-[10px] font-mono text-pink-600 font-bold"><%= ev.tracking_code %></div>
                                <div class="text-xs font-bold text-slate-900 truncate"><%= ev.event_name %></div>
                                <div class="text-[10px] text-slate-500">By <%= ev.submitter_name %> (<%= ev.submitter_email %>)</div>
                            </div>
                            <a href="/admin/verifications" class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-bold shadow shrink-0">
                                Review &rarr;
                            </a>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <!-- Recent Audit Trail Logs -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900 flex items-center">
                    <i class="fas fa-list-check text-purple-600 me-2"></i> Recent Audit Activity Logs
                </h3>
                <a href="/admin/logs" class="text-xs font-bold text-slate-600 hover:underline">View Logs &rarr;</a>
            </div>

            <div class="space-y-2.5">
                <% recentLogs.forEach(function(l) { %>
                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 flex items-start justify-between text-xs">
                        <div>
                            <span class="font-bold text-slate-800"><%= l.action %></span>
                            <span class="text-slate-500 ms-1 text-[11px]"><%= l.description %></span>
                            <div class="text-[10px] text-slate-400 mt-0.5"><%= l.username ? '@' + l.username : 'System' %> &bull; <%= helpers.formatDate(l.created_at) %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
