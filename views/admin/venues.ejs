<%- include('../partials/header', { title: 'Manage Venues | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-6">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Malaysian Event Venues</h1>
        <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Manage preset concert arenas, convention centres, and public transport directions.</p>
    </div>

    <!-- Admin Nav -->
    <%- include('./admin-nav', { activePath: '/admin/venues' }) %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Add Venue Form -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm h-fit space-y-4">
            <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-3">Add New Venue</h3>
            <form action="/admin/venues/add" method="POST" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Venue Name</label>
                    <input type="text" name="name" required placeholder="e.g. Zepp Kuala Lumpur"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Address</label>
                    <input type="text" name="address" required placeholder="e.g. BBCC, Bukit Bintang"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">City</label>
                        <input type="text" name="city" required value="Kuala Lumpur"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">State</label>
                        <input type="text" name="state" required value="KL"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Transit / LRT / MRT Info</label>
                    <input type="text" name="transit_info" placeholder="e.g. LRT Hang Tuah (Sri Petaling Line)"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Google Maps Link</label>
                    <input type="url" name="map_link" placeholder="https://maps.google.com/..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                </div>
                <button type="submit" class="w-full py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs shadow hover:bg-slate-800">
                    Add Venue
                </button>
            </form>
        </div>

        <!-- Venues List -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
            <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-3">Venues Directory</h3>
            <div class="space-y-3">
                <% venues.forEach(function(v) { %>
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-start justify-between gap-3">
                        <div>
                            <h4 class="font-bold text-xs text-slate-900"><%= v.name %></h4>
                            <div class="text-[11px] text-slate-500 mt-0.5"><i class="fas fa-location-dot text-rose-500 me-1"></i> <%= v.address %>, <%= v.city %>, <%= v.state %></div>
                            <% if (v.transit_info) { %>
                                <div class="text-[10px] text-purple-700 font-medium mt-1"><i class="fas fa-train me-1"></i> <%= v.transit_info %></div>
                            <% } %>
                        </div>
                        <form action="/admin/venues/delete" method="POST" onsubmit="return confirm('Delete venue?')" class="inline">
                            <input type="hidden" name="id" value="<%= v.id %>">
                            <button type="submit" class="p-1.5 text-rose-500 hover:text-rose-700">
                                <i class="fas fa-trash-can text-xs"></i>
                            </button>
                        </form>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
