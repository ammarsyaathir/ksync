<%- include('../partials/header', { title: 'Manage Venues | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center space-x-2 mb-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white shadow-sm border border-slate-700">
                <i class="fas fa-location-dot me-1.5 text-emerald-400"></i> Venues & Transit
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <%= venues.length %> Venues Recorded
            </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Malaysian Concert & Event Venues</h1>
        <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Manage preset concert arenas, stadiums, and public transit navigation (LRT, MRT, Monorail, KTM).</p>
    </div>

    <!-- Admin Nav -->
    <%- include('./admin-nav', { activePath: '/admin/venues' }) %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Add Venue Form Card -->
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-xs h-fit space-y-4">
            <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
                <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">
                    <i class="fas fa-plus"></i>
                </div>
                <h3 class="text-sm font-bold text-slate-900">Add New Venue</h3>
            </div>
            <form action="/admin/venues/add" method="POST" class="space-y-3.5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Venue Name <span class="text-rose-500">*</span></label>
                    <input type="text" name="name" required placeholder="e.g. Zepp Kuala Lumpur"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Street Address <span class="text-rose-500">*</span></label>
                    <input type="text" name="address" required placeholder="e.g. BBCC, Jalan Hang Tuah"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">City <span class="text-rose-500">*</span></label>
                        <input type="text" name="city" required value="Kuala Lumpur"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">State <span class="text-rose-500">*</span></label>
                        <input type="text" name="state" required value="W.P. Kuala Lumpur"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Seat Capacity</label>
                    <input type="number" name="capacity" placeholder="e.g. 2500"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Transit / LRT / MRT Guide</label>
                    <input type="text" name="transit_info" placeholder="e.g. LRT Sri Petaling / Monorail Hang Tuah Station"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Google Maps URL</label>
                    <input type="url" name="map_link" placeholder="https://maps.google.com/?q=..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                </div>
                <button type="submit" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md transition-all cursor-pointer">
                    <i class="fas fa-plus me-1 text-emerald-400"></i> Add Venue
                </button>
            </form>
        </div>

        <!-- Venues List Directory -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-sm font-bold text-slate-900 flex items-center">
                    <i class="fas fa-map-location-dot text-emerald-500 me-2"></i> Venues Directory (<%= venues.length %>)
                </h3>
            </div>
            <div class="space-y-3">
                <% if (venues.length === 0) { %>
                    <div class="text-center py-10 text-slate-400 text-xs">
                        <i class="fas fa-map-pin text-2xl text-slate-300 mb-2"></i>
                        <div>No venues added yet. Use the form to register arenas and cafes.</div>
                    </div>
                <% } else { %>
                    <% venues.forEach(function(v) { %>
                        <div class="p-4 rounded-2xl bg-slate-50/80 hover:bg-slate-50 border border-slate-200/80 flex flex-col sm:flex-row sm:items-start justify-between gap-3 transition-colors">
                            <div class="space-y-1 min-w-0 flex-1">
                                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                                    <h4 class="font-bold text-sm text-slate-900"><%= v.name %></h4>
                                    <% if (v.capacity && v.capacity > 0) { %>
                                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
                                            <i class="fas fa-users me-1"></i><%= v.capacity.toLocaleString() %> Cap
                                        </span>
                                    <% } %>
                                </div>
                                <div class="text-[11px] text-slate-500 flex items-center">
                                    <i class="fas fa-location-dot text-rose-500 me-1.5 shrink-0"></i>
                                    <span class="truncate"><%= v.address %>, <%= v.city %>, <%= v.state %></span>
                                </div>
                                <% if (v.transit_info) { %>
                                    <div class="text-[11px] text-purple-700 font-medium bg-purple-50/80 px-2.5 py-1 rounded-lg border border-purple-100/60 inline-flex items-center mt-1">
                                        <i class="fas fa-train me-1.5 text-purple-500 shrink-0"></i> <%= v.transit_info %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="flex items-center space-x-1.5 self-end sm:self-start shrink-0">
                                <% if (v.map_link) { %>
                                    <a href="<%= v.map_link %>" target="_blank" class="p-2 text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition-colors" title="Open Map">
                                        <i class="fas fa-map text-xs"></i>
                                    </a>
                                <% } %>
                                <form action="/admin/venues/delete" method="POST" onsubmit="return confirm('Permanently remove this venue?')" class="inline">
                                    <input type="hidden" name="id" value="<%= v.id %>">
                                    <button type="submit" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Delete Venue">
                                        <i class="fas fa-trash-can text-xs"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
