<%- include('../partials/header', { title: 'Verification Center | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/flash') %>
    <!-- Header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center space-x-2 mb-2">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white shadow-sm border border-slate-700">
                    <i class="fas fa-check-double me-1.5 text-pink-400"></i> Verification Central
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-pink-50 text-pink-700 border border-pink-200">
                    <%= pendingEvents.length %> Pending Submissions
                </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Event Submissions & Fanclub Verifications</h1>
            <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Review open event submissions (Model 2), examine official ticketing proof, and grant official fanclub verification badges.</p>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-auto">
            <a href="#fanclubs-section" class="px-3.5 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs shadow-xs transition-all flex items-center">
                <i class="fas fa-certificate text-pink-500 me-1.5"></i> Fanclub Badges
            </a>
            <a href="#submissions-section" class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-xs transition-all flex items-center">
                <i class="fas fa-hourglass-half text-amber-400 me-1.5"></i> Review Queue (<%= pendingEvents.length %>)
            </a>
        </div>
    </div>

    <!-- Admin Nav -->
    <%- include('./admin-nav', { activePath: '/admin/verifications', pendingCount: pendingEvents.length }) %>

    <!-- 4-Step Organizer Legitimacy Verification Protocol -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-5 sm:p-8 text-white shadow-lg mb-8 border border-white/10">
        <div class="flex items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-pink-500/20 text-pink-300 border border-pink-500/30">
                <i class="fas fa-shield-halved me-1"></i> Anti-Scam Standard Operating Procedure (SOP)
            </span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">How Admins Verify Authentic Organizers vs Fake Accounts</h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-3xl leading-relaxed">
            Because K-Sync Malaysia allows frictionless public submissions (Model 2), platform moderators enforce this 4-step forensic audit before approving any event live:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mt-6">
            <div class="bg-white/10 rounded-2xl p-4 border border-white/10 backdrop-blur-xs">
                <div class="w-8 h-8 rounded-xl bg-pink-500/30 text-pink-300 font-black flex items-center justify-center text-xs mb-3">01</div>
                <h4 class="font-bold text-xs text-white">Social Channel Proof</h4>
                <p class="text-[11px] text-slate-300 mt-1 leading-normal">
                    Inspect Twitter/IG handle (@Carat_MY). Check account age (&gt;3 months), follower count (&gt;500), and past cupsleeve/project history.
                </p>
            </div>

            <div class="bg-white/10 rounded-2xl p-4 border border-white/10 backdrop-blur-xs">
                <div class="w-8 h-8 rounded-xl bg-purple-500/30 text-purple-300 font-black flex items-center justify-center text-xs mb-3">02</div>
                <h4 class="font-bold text-xs text-white">Venue Booking Check</h4>
                <p class="text-[11px] text-slate-300 mt-1 leading-normal">
                    Cross-reference cafe/hall reservation (e.g. After Black Cafe). Admin verifies booking announcement on the cafe's social channels.
                </p>
            </div>

            <div class="bg-white/10 rounded-2xl p-4 border border-white/10 backdrop-blur-xs">
                <div class="w-8 h-8 rounded-xl bg-emerald-500/30 text-emerald-300 font-black flex items-center justify-center text-xs mb-3">03</div>
                <h4 class="font-bold text-xs text-white">Ticketing Whitelist</h4>
                <p class="text-[11px] text-slate-300 mt-1 leading-normal">
                    System automatically verifies domain against whitelisted Malaysian ticketing platforms (GoLive, Ticket2U, BookMyShow). Flags suspicious bank DMs.
                </p>
            </div>

            <div class="bg-white/10 rounded-2xl p-4 border border-white/10 backdrop-blur-xs">
                <div class="w-8 h-8 rounded-xl bg-sky-500/30 text-sky-300 font-black flex items-center justify-center text-xs mb-3">04</div>
                <h4 class="font-bold text-xs text-white">One-Click Inquiry</h4>
                <p class="text-[11px] text-slate-300 mt-1 leading-normal">
                    If suspicious, Admin uses "Request Booking Proof" to email submitter for cafe receipt / promoter permit before publishing.
                </p>
            </div>
        </div>
    </div>

    <!-- SECTION 1: Model 2 Event Submissions Verification Queue -->
    <div id="submissions-section" class="bg-white rounded-3xl p-4 sm:p-6 lg:p-8 border border-slate-200/80 shadow-xs mb-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
            <div>
                <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center">
                    <i class="fas fa-hourglass-half text-amber-500 me-2"></i> Pending Event Submissions Queue (Model 2)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Submitted by organizers/guests without account. Verify evidence and publish live.</p>
            </div>
            <span class="px-3.5 py-1 rounded-full text-xs font-bold <%= pendingEvents.length > 0 ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200' %> self-start sm:self-auto">
                <%= pendingEvents.length %> Pending
            </span>
        </div>

        <% if (pendingEvents.length === 0) { %>
            <div class="text-center py-12 text-slate-400 text-xs">
                <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-500 flex items-center justify-center text-xl mx-auto mb-2">
                    <i class="fas fa-check"></i>
                </div>
                <div class="font-bold text-slate-700">All submissions verified!</div>
                <div class="text-slate-500 mt-0.5">No events currently waiting in the approval queue.</div>
            </div>
        <% } else { %>
            <!-- Client-Side Quick Search Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2">
                <div class="relative flex-1 max-w-md">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="submissionSearchInput" onkeyup="filterSubmissionsTable()" placeholder="Filter by event name, artist, organizer, or tracking code..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-300">
                </div>
                <div class="text-[11px] text-slate-500 font-medium">
                    Showing <strong id="visibleSubmissionCount" class="text-slate-800"><%= pendingEvents.length %></strong> submission(s)
                </div>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-slate-100">
                <table class="w-full text-left text-xs text-slate-700 min-w-[860px]" id="submissionsTable">
                    <thead class="bg-slate-50/80 text-slate-500 uppercase font-bold text-[10px] border-b border-slate-200">
                        <tr>
                            <th class="p-3.5">Ref Code</th>
                            <th class="p-3.5">Event & Artist</th>
                            <th class="p-3.5">Date & Venue</th>
                            <th class="p-3.5">Organizer & Proof</th>
                            <th class="p-3.5">Official Evidence</th>
                            <th class="p-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% pendingEvents.forEach(function(ev) { %>
                            <tr class="hover:bg-slate-50/60 transition-colors submission-row">
                                <td class="p-3.5 font-mono font-bold text-pink-600"><%= ev.tracking_code %></td>
                                <td class="p-3.5 max-w-[220px]">
                                    <div class="font-bold text-slate-900 leading-snug"><%= ev.event_name %></div>
                                    <div class="text-[10px] text-purple-600 font-semibold mt-0.5"><%= ev.artist_name || 'Multiple / Various Artists' %></div>
                                    <% if (ev.description) { %>
                                        <div class="text-[10px] text-slate-400 truncate max-w-[200px] mt-0.5"><%= ev.description %></div>
                                    <% } %>
                                </td>
                                <td class="p-3.5">
                                    <div class="font-bold text-slate-800"><%= helpers.formatDate(ev.event_date) %></div>
                                    <div class="text-[10px] text-slate-500"><%= ev.venue_name %>, <%= ev.city %></div>
                                    <div class="text-[9px] text-slate-400"><%= ev.start_time ? ev.start_time.substring(0, 5) : '' %> <% if (ev.end_time) { %>– <%= ev.end_time.substring(0, 5) %><% } %></div>
                                </td>
                                <td class="p-3.5">
                                    <div class="font-bold text-slate-900"><%= ev.organizer_name || ev.submitter_name %></div>
                                    <div class="inline-block text-[9px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-bold mb-1">
                                        <%= ev.organizer_type || 'Fanclub' %>
                                    </div>
                                    <div class="text-[10px] text-slate-400"><%= ev.submitter_email %></div>
                                    <% if (ev.organizer_social_url) { %>
                                        <a href="<%= ev.organizer_social_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[10px] text-pink-600 font-bold hover:underline mt-0.5">
                                            <i class="fas fa-arrow-up-right-from-square text-[9px] me-1"></i> Organizer Profile
                                        </a>
                                    <% } else if (ev.submitter_social) { %>
                                        <% const handleClean = ev.submitter_social.replace(/^@/, ''); %>
                                        <a href="https://x.com/<%= handleClean %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[10px] text-pink-600 font-bold hover:underline mt-0.5">
                                            <i class="fab fa-x-twitter me-1"></i> <%= ev.submitter_social %>
                                        </a>
                                    <% } %>
                                </td>
                                <td class="p-3.5 space-y-1">
                                    <% if (ev.evidence_link) { %>
                                        <a href="<%= ev.evidence_link %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-2 py-1 rounded-lg bg-pink-50 border border-pink-200 text-pink-700 font-bold text-[10px] hover:bg-pink-100 transition-all">
                                            <i class="fas fa-shield-check me-1.5 text-pink-600"></i> Check Official Evidence &rarr;
                                        </a>
                                    <% } else { %>
                                        <span class="inline-block text-[10px] text-amber-600 font-bold bg-amber-50 px-2 py-0.5 rounded">No evidence link</span>
                                    <% } %>
                                    <% if (ev.official_url) { %>
                                        <a href="<%= ev.official_url %>" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline block text-[10px] font-semibold truncate max-w-[150px]">
                                            <i class="fas fa-ticket me-1"></i> Ticketing Link
                                        </a>
                                    <% } %>
                                    <% if (ev.poster_image) { %>
                                        <a href="<%= ev.poster_image %>" target="_blank" class="text-slate-500 hover:underline block text-[10px]">
                                            <i class="far fa-image me-1"></i> View Poster Image
                                        </a>
                                    <% } %>
                                </td>
                                <td class="p-3.5 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a href="mailto:<%= ev.submitter_email %>?subject=K-Sync%20Verification:%20<%= encodeURIComponent(ev.event_name) %>&body=Hi%20<%= encodeURIComponent(ev.submitter_name) %>,%20please%20provide%20proof%20of%20venue%20reservation%20or%20official%20announcement%20for%20event%20<%= ev.tracking_code %>." 
                                           class="px-2.5 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs inline-flex items-center transition-all" 
                                           title="Inquire / Request Booking Proof">
                                            <i class="far fa-envelope me-1 text-slate-400"></i> Inquire
                                        </a>
                                        <button type="button" 
                                                data-id="<%= ev.id %>"
                                                data-code="<%= ev.tracking_code %>"
                                                data-name="<%= ev.event_name %>"
                                                data-orgtype="<%= ev.organizer_type || 'Fanclub' %>"
                                                onclick="handleApproveClick(this)"
                                                class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-xs transition-all inline-flex items-center cursor-pointer">
                                            <i class="fas fa-check me-1"></i> Approve
                                        </button>
                                        <button type="button" 
                                                data-id="<%= ev.id %>"
                                                data-code="<%= ev.tracking_code %>"
                                                onclick="handleRejectClick(this)"
                                                class="px-2.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs transition-all inline-flex items-center cursor-pointer">
                                            <i class="fas fa-xmark me-1"></i> Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- SECTION 2: Fanclub & Organizer Verification Center -->
    <div id="fanclubs-section" class="bg-white rounded-3xl p-4 sm:p-6 lg:p-8 border border-slate-200/80 shadow-xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
            <div>
                <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center">
                    <i class="fas fa-certificate text-pink-600 me-2"></i> Verified Fanclub Badge Management
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Review social handles and grant the [✓ Verified Fanclub] badge to authentic Malaysian fan clubs.</p>
            </div>
            <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-pink-50 text-pink-700 border border-pink-200 self-start sm:self-auto">
                <%= organizers.length %> Registered Accounts
            </span>
        </div>

        <!-- Quick Search Bar for Organizers -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2">
            <div class="relative flex-1 max-w-md">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="organizerSearchInput" onkeyup="filterOrganizersTable()" placeholder="Filter by organization name, username, email, or status..."
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300">
            </div>
            <div class="text-[11px] text-slate-500 font-medium">
                Showing <strong id="visibleOrganizerCount" class="text-slate-800"><%= organizers.length %></strong> fanclub(s)
            </div>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-100">
            <table class="w-full text-left text-xs text-slate-700 min-w-[720px]" id="organizersTable">
                <thead class="bg-slate-50/80 text-slate-500 uppercase font-bold text-[10px] border-b border-slate-200">
                    <tr>
                        <th class="p-3.5">Organizer / Fanclub</th>
                        <th class="p-3.5">Handle & Link</th>
                        <th class="p-3.5">Current Status</th>
                        <th class="p-3.5 text-right">Verification Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% organizers.forEach(function(org) { %>
                        <tr class="hover:bg-slate-50/60 transition-colors organizer-row">
                            <td class="p-3.5">
                                <div class="font-bold text-slate-900"><%= org.organization_name || org.full_name %></div>
                                <div class="text-[10px] text-slate-400">@<%= org.username %> &bull; <%= org.email %></div>
                            </td>
                            <td class="p-3.5">
                                <% if (org.social_url) { %>
                                    <a href="<%= org.social_url %>" target="_blank" rel="noopener noreferrer" class="text-pink-600 font-bold hover:underline inline-flex items-center">
                                        <i class="fas fa-arrow-up-right-from-square text-[9px] me-1"></i>
                                        <%= org.social_handle || org.social_url %>
                                    </a>
                                <% } else { %>
                                    <span class="text-slate-400">None provided</span>
                                <% } %>
                            </td>
                            <td class="p-3.5">
                                <%- helpers.getOrganizerBadge(org) %>
                            </td>
                            <td class="p-3.5 text-right whitespace-nowrap">
                                <% if (Number(org.is_verified_organizer) === 1) { %>
                                    <form action="/admin/verifications/revoke-organizer" method="POST" class="inline">
                                        <input type="hidden" name="user_id" value="<%= org.id %>">
                                        <button type="submit" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-all inline-flex items-center cursor-pointer">
                                            <i class="fas fa-user-xmark me-1 text-slate-500"></i> Revoke Badge
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/admin/verifications/verify-organizer" method="POST" class="inline">
                                        <input type="hidden" name="user_id" value="<%= org.id %>">
                                        <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-xs transition-all inline-flex items-center cursor-pointer">
                                            <i class="fas fa-certificate me-1 text-emerald-200"></i> Grant Badge
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Approval Modal with Trust Level & Verification Notes -->
<div id="approve-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-5 sm:p-7 max-w-md w-full shadow-2xl space-y-4 border border-slate-100">
        <div class="flex items-center space-x-3 text-emerald-600 border-b border-slate-100 pb-3">
            <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-shield-check"></i>
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900">Verify & Publish Event Live</h3>
                <p class="text-[11px] text-slate-500 font-mono" id="approve-event-title">Event Title</p>
            </div>
        </div>
        <form action="/admin/verifications/approve-event" method="POST" class="space-y-4">
            <input type="hidden" name="event_id" id="approve-event-id">

            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">Assign Public Trust Level Badge</label>
                <div class="space-y-2">
                    <label class="flex items-start gap-2.5 p-3 rounded-xl border border-slate-200 hover:border-emerald-400 bg-slate-50/50 cursor-pointer transition-all">
                        <input type="radio" name="trust_level" id="trust-official" value="OFFICIAL" checked class="mt-0.5 text-emerald-600 focus:ring-emerald-500">
                        <div class="text-xs">
                            <div class="font-bold text-emerald-800 flex items-center">
                                <span>👑 Verified – Official Source</span>
                            </div>
                            <div class="text-[10px] text-slate-500 mt-0.5">Matched with 2+ independent sources (artist agency, promoter, or venue schedule).</div>
                        </div>
                    </label>

                    <label class="flex items-start gap-2.5 p-3 rounded-xl border border-slate-200 hover:border-purple-400 bg-slate-50/50 cursor-pointer transition-all">
                        <input type="radio" name="trust_level" id="trust-community" value="COMMUNITY" class="mt-0.5 text-purple-600 focus:ring-purple-500">
                        <div class="text-xs">
                            <div class="font-bold text-purple-800 flex items-center">
                                <span>🎪 Verified – Community Event</span>
                            </div>
                            <div class="text-[10px] text-slate-500 mt-0.5">Authentic fanclub-organized gathering, cafe event, or cupsleeve project.</div>
                        </div>
                    </label>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Admin Verification Audit Notes</label>
                <textarea name="verification_notes" id="approve-notes" rows="2.5" required
                          placeholder="e.g. Verified with artist Weverse announcement and Axiata Arena schedule."
                          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-300"></textarea>
                <span class="text-[10px] text-slate-400">Records which independent sources were cross-checked for audit defense.</span>
            </div>

            <div class="flex justify-end space-x-2 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeApproveModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold transition-all cursor-pointer">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-sm transition-all cursor-pointer">Confirm & Publish</button>
            </div>
        </form>
    </div>
</div>

<!-- Rejection Modal -->
<div id="reject-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-5 sm:p-7 max-w-md w-full shadow-2xl space-y-4 border border-slate-100">
        <div class="flex items-center space-x-3 text-rose-600 border-b border-slate-100 pb-3">
            <div class="w-10 h-10 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg shrink-0">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900">Reject Event Submission</h3>
                <p class="text-[11px] text-slate-500">Provide rejection reason for submitter notification</p>
            </div>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
            Please specify why this submission is being rejected. The submitter will receive this reason in their tracking portal and email to resubmit corrections.
        </p>
        <form action="/admin/verifications/reject-event" method="POST" class="space-y-4">
            <input type="hidden" name="event_id" id="reject-event-id">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Rejection Reason</label>
                <textarea name="reason" rows="3" required placeholder="e.g. Official evidence link does not match Malaysian date, brand-new suspicious account, or duplicate event."
                          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-300"></textarea>
            </div>
            <div class="flex justify-end space-x-2 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeRejectModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold transition-all cursor-pointer">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow-sm transition-all cursor-pointer">Confirm Rejection</button>
            </div>
        </form>
    </div>
</div>

<script>
    function handleApproveClick(btn) {
        const id = btn.dataset.id;
        const code = btn.dataset.code;
        const name = btn.dataset.name;
        const orgType = btn.dataset.orgtype || 'Fanclub';
        openApproveModal(id, code, name, orgType);
    }

    function handleRejectClick(btn) {
        const id = btn.dataset.id;
        const code = btn.dataset.code;
        openRejectModal(id, code);
    }

    function openApproveModal(id, code, name, orgType) {
        document.getElementById('approve-event-id').value = id;
        document.getElementById('approve-event-title').textContent = '[' + code + '] ' + name;
        const notes = document.getElementById('approve-notes');
        const isCommunity = (orgType || '').toLowerCase().includes('fanclub');
        if (isCommunity) {
            document.getElementById('trust-community').checked = true;
            notes.value = 'Cross-referenced with organizer social media channel and cafe/venue announcement.';
        } else {
            document.getElementById('trust-official').checked = true;
            notes.value = 'Verified with official artist tour notice and promoter/ticketing schedule.';
        }
        document.getElementById('approve-modal').classList.remove('hidden');
    }
    function closeApproveModal() {
        document.getElementById('approve-modal').classList.add('hidden');
    }
    function openRejectModal(id, code) {
        document.getElementById('reject-event-id').value = id;
        document.getElementById('reject-modal').classList.remove('hidden');
    }
    function closeRejectModal() {
        document.getElementById('reject-modal').classList.add('hidden');
    }

    function filterSubmissionsTable() {
        const query = (document.getElementById('submissionSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#submissionsTable tbody tr.submission-row');
        let visible = 0;
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (!query || text.includes(query)) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });
        const countEl = document.getElementById('visibleSubmissionCount');
        if (countEl) countEl.innerText = visible;
    }

    function filterOrganizersTable() {
        const query = (document.getElementById('organizerSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#organizersTable tbody tr.organizer-row');
        let visible = 0;
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (!query || text.includes(query)) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });
        const countEl = document.getElementById('visibleOrganizerCount');
        if (countEl) countEl.innerText = visible;
    }
</script>

