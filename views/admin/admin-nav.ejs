<!-- K-Sync Malaysia Admin Command Center Header & Tab Bar -->
<div class="mb-8 bg-slate-950 text-white rounded-3xl p-5 sm:p-6 border border-slate-800 shadow-xl relative overflow-hidden">
  <!-- Subtle ambient glow matching K-Pop concert lighting -->
  <div class="absolute -right-20 -top-20 w-72 h-72 bg-gradient-to-br from-purple-600/20 via-pink-600/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 -bottom-20 w-72 h-72 bg-gradient-to-tr from-cyan-600/15 via-emerald-600/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>

  <!-- Top Ribbon: System Badge, Malaysian Time, and Quick Actions -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-800/80 relative z-10">
    <div class="flex items-center gap-3.5 flex-wrap">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-500 via-pink-500 to-rose-500 p-0.5 shadow-lg shadow-purple-500/20 shrink-0">
        <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center text-pink-400">
          <i class="fas fa-shield-halved text-lg"></i>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-[11px] font-black tracking-widest uppercase text-slate-400">Platform Command Center</span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Sentinel Live &bull; Kuala Lumpur Hub
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2 mt-0.5">
          <%= typeof pageTitle !== 'undefined' ? pageTitle : 'System Administration' %>
        </h1>
      </div>
    </div>

    <!-- Quick Utilities -->
    <div class="flex items-center gap-2 flex-wrap self-start md:self-auto shrink-0">
      <a href="/events/submit" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-bold text-xs shadow-md shadow-purple-900/30 transition-all flex items-center gap-1.5 active:scale-95 cursor-pointer">
        <i class="fas fa-plus"></i> Submit Event
      </a>
      <a href="/admin/verifications" class="relative px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 font-bold text-xs transition-all flex items-center gap-1.5 active:scale-95 cursor-pointer">
        <i class="fas fa-check-double text-pink-400"></i> Review Queue
        <% if (typeof adminPendingVerifications !== 'undefined' && adminPendingVerifications > 0) { %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-pink-500 text-white animate-pulse"><%= adminPendingVerifications %></span>
        <% } %>
      </a>
      <a href="/admin/reports" class="relative px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 font-bold text-xs transition-all flex items-center gap-1.5 active:scale-95 cursor-pointer">
        <i class="fas fa-shield-virus text-rose-400"></i> Fraud Reports
        <% if (typeof adminPendingReports !== 'undefined' && adminPendingReports > 0) { %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-500 text-white animate-pulse"><%= adminPendingReports %></span>
        <% } %>
      </a>
      <a href="/events" target="_blank" class="px-3 py-2 rounded-xl bg-slate-900/60 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800 font-bold text-xs transition-all flex items-center gap-1.5 cursor-pointer" title="Preview Public Portal">
        <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
      </a>
    </div>
  </div>

  <!-- Bottom Navigation Tabs: Highly Crafted Pill Switcher with Active Highlighting -->
  <div class="mt-4 pt-1 flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 text-xs font-bold relative z-10">
    <!-- 1. Overview Dashboard -->
    <a href="/admin" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-chart-pie text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') ? 'text-purple-600' : 'text-slate-400' %>"></i>
      <span>Overview</span>
    </a>

    <!-- 2. Verifications Queue -->
    <a href="/admin/verifications" class="relative px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'verifications') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-check-double text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'verifications') ? 'text-pink-600' : 'text-pink-400' %>"></i>
      <span>Verifications</span>
      <% if (typeof adminPendingVerifications !== 'undefined' && adminPendingVerifications > 0) { %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-black <%= (typeof activeTab !== 'undefined' && activeTab === 'verifications') ? 'bg-pink-600 text-white' : 'bg-pink-500 text-white' %>"><%= adminPendingVerifications %></span>
      <% } %>
    </a>

    <!-- 3. Events Catalog -->
    <a href="/admin/events" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'events') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-calendar-days text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'events') ? 'text-purple-600' : 'text-purple-400' %>"></i>
      <span>Events Catalog</span>
    </a>

    <!-- 4. Artists & Lineup -->
    <a href="/admin/artists" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'artists') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-microphone-lines text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'artists') ? 'text-indigo-600' : 'text-indigo-400' %>"></i>
      <span>Artists & Lineup</span>
    </a>

    <!-- 5. Venues & Transit -->
    <a href="/admin/venues" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'venues') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-location-dot text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'venues') ? 'text-emerald-600' : 'text-emerald-400' %>"></i>
      <span>Venues & Transit</span>
    </a>

    <!-- 6. Categories -->
    <a href="/admin/categories" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'categories') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-layer-group text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'categories') ? 'text-pink-600' : 'text-pink-400' %>"></i>
      <span>Categories</span>
    </a>

    <!-- 7. Users & Roles -->
    <a href="/admin/users" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'users') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-users-gear text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'users') ? 'text-indigo-600' : 'text-indigo-400' %>"></i>
      <span>Users & Access</span>
    </a>

    <!-- 8. Scam Reports -->
    <a href="/admin/reports" class="relative px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'reports') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-shield-virus text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'reports') ? 'text-rose-600' : 'text-rose-400' %>"></i>
      <span>Reports & Fraud</span>
      <% if (typeof adminPendingReports !== 'undefined' && adminPendingReports > 0) { %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-black <%= (typeof activeTab !== 'undefined' && activeTab === 'reports') ? 'bg-rose-600 text-white' : 'bg-rose-500 text-white' %>"><%= adminPendingReports %></span>
      <% } %>
    </a>

    <!-- 9. Audit Logs -->
    <a href="/admin/logs" class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 shrink-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? 'bg-white text-slate-950 shadow-sm font-extrabold' : 'text-slate-400 hover:text-white hover:bg-slate-900/80' %>">
      <i class="fas fa-clock-rotate-left text-xs <%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? 'text-amber-600' : 'text-amber-400' %>"></i>
      <span>Audit Trail</span>
    </a>
  </div>
</div>
