<div class="bg-white rounded-2xl p-2 border border-slate-200 shadow-sm mb-8 flex items-center space-x-1 overflow-x-auto text-xs font-bold scrollbar-none">
    <a href="/admin" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-chart-line text-[11px]"></i>
        <span>Dashboard</span>
    </a>
    <a href="/admin/verifications" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/verifications' ? 'bg-pink-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-check-double text-[11px]"></i>
        <span>Verification Queue</span>
        <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-rose-500 text-white font-black"><%= pendingCount %></span>
        <% } %>
    </a>
    <a href="/admin/events" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/events' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-calendar-days text-[11px]"></i>
        <span>All Events</span>
    </a>
    <a href="/admin/categories" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/categories' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-layer-group text-[11px]"></i>
        <span>Categories</span>
    </a>
    <a href="/admin/artists" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/artists' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-microphone-lines text-[11px]"></i>
        <span>Artists</span>
    </a>
    <a href="/admin/venues" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/venues' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-location-dot text-[11px]"></i>
        <span>Venues</span>
    </a>
    <a href="/admin/users" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/users' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-users-gear text-[11px]"></i>
        <span>Users</span>
    </a>
    <a href="/admin/logs" class="px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/logs' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
        <i class="fas fa-clock-rotate-left text-[11px]"></i>
        <span>Audit Logs</span>
    </a>
</div>
