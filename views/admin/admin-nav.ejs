<div class="bg-white/90 backdrop-blur-md rounded-2xl p-1.5 sm:p-2 border border-slate-200/80 shadow-xs mb-8">
    <div class="flex items-center space-x-1 sm:space-x-1.5 overflow-x-auto text-xs font-bold scrollbar-none py-0.5">
        <a href="/admin" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin' ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-sm shadow-purple-500/20' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-chart-line text-[11px] <%= activePath === '/admin' ? 'text-purple-200' : 'text-slate-400' %>"></i>
            <span>Dashboard</span>
        </a>

        <a href="/admin/verifications" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/verifications' ? 'bg-gradient-to-r from-pink-600 to-rose-600 text-white shadow-sm shadow-pink-500/20' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-check-double text-[11px] <%= activePath === '/admin/verifications' ? 'text-pink-200' : 'text-slate-400' %>"></i>
            <span>Verifications</span>
            <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
                <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-rose-500 text-white font-black animate-pulse"><%= pendingCount %></span>
            <% } %>
        </a>

        <a href="/admin/events" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/events' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-calendar-days text-[11px] <%= activePath === '/admin/events' ? 'text-purple-400' : 'text-slate-400' %>"></i>
            <span>All Events</span>
        </a>

        <a href="/admin/categories" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/categories' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-layer-group text-[11px] <%= activePath === '/admin/categories' ? 'text-pink-400' : 'text-slate-400' %>"></i>
            <span>Categories</span>
        </a>

        <a href="/admin/artists" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/artists' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-microphone-lines text-[11px] <%= activePath === '/admin/artists' ? 'text-purple-400' : 'text-slate-400' %>"></i>
            <span>Artists</span>
        </a>

        <a href="/admin/venues" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/venues' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-location-dot text-[11px] <%= activePath === '/admin/venues' ? 'text-emerald-400' : 'text-slate-400' %>"></i>
            <span>Venues</span>
        </a>

        <a href="/admin/reports" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/reports' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-flag text-[11px] <%= activePath === '/admin/reports' ? 'text-rose-400' : 'text-slate-400' %>"></i>
            <span>Reports</span>
        </a>

        <a href="/admin/users" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/users' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-users-gear text-[11px] <%= activePath === '/admin/users' ? 'text-indigo-400' : 'text-slate-400' %>"></i>
            <span>Users</span>
        </a>

        <a href="/admin/logs" class="px-3 sm:px-3.5 py-2 rounded-xl transition-all flex items-center space-x-1.5 shrink-0 <%= activePath === '/admin/logs' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80' %>">
            <i class="fas fa-clock-rotate-left text-[11px] <%= activePath === '/admin/logs' ? 'text-amber-400' : 'text-slate-400' %>"></i>
            <span>Audit Logs</span>
        </a>
    </div>
</div>
