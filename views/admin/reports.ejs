<%- include('../partials/header', { title: 'Content & Event Reports | K-Sync Admin' }) %>
<%- include('../partials/navbar', { activePath: '/admin/reports' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center">
            <i class="fas fa-flag text-amber-500 me-3"></i> Content & Listing Reports
        </h1>
        <p class="text-xs text-slate-500 mt-1">
            Review user reports on inaccurate event listings or inappropriate community content (Chapter 1 Solution 1.3.3 & Scope 1.6.1).
        </p>
    </div>

    <%- include('admin-nav', { activePath: '/admin/reports' }) %>
    <%- include('../partials/flash') %>

    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900">Submitted Reports (<%= reports.length %>)</h2>
        </div>

        <% if (!reports || reports.length === 0) { %>
            <div class="py-16 text-center text-slate-400">
                <i class="fas fa-shield-check text-4xl mb-3 text-emerald-400"></i>
                <div class="font-bold text-sm text-slate-600">No Pending Reports</div>
                <div class="text-xs text-slate-400 mt-1">All event listings and discussions are currently in good standing.</div>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 text-[11px] uppercase font-bold text-slate-400 border-b border-slate-200">
                        <tr>
                            <th class="p-4">Report ID</th>
                            <th class="p-4">Reported Event / Target</th>
                            <th class="p-4">Reason</th>
                            <th class="p-4">Submitted By</th>
                            <th class="p-4">Date</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% reports.forEach(function(r) { %>
                            <tr class="hover:bg-slate-50/50">
                                <td class="p-4 font-mono font-bold text-slate-900">#<%= r.id %></td>
                                <td class="p-4">
                                    <% if (r.event_name) { %>
                                        <a href="/events/<%= r.event_id %>" target="_blank" class="font-bold text-slate-900 hover:text-pink-600 flex items-center">
                                            <span><%= r.event_name %></span>
                                            <i class="fas fa-arrow-up-right-from-square text-[10px] ms-1 text-slate-400"></i>
                                        </a>
                                        <span class="text-[10px] text-slate-400 font-mono">Ref: <%= r.tracking_code %></span>
                                    <% } else { %>
                                        <span class="text-slate-400 italic">General Content</span>
                                    <% } %>
                                </td>
                                <td class="p-4">
                                    <div class="font-semibold text-slate-800"><%= r.reason %></div>
                                    <% if (r.details) { %>
                                        <div class="text-[11px] text-slate-500 mt-0.5"><%= r.details %></div>
                                    <% } %>
                                </td>
                                <td class="p-4 font-medium text-slate-700">
                                    <%= r.username ? '@' + r.username : 'Anonymous Visitor' %>
                                </td>
                                <td class="p-4 font-mono text-slate-500">
                                    <%= r.created_at.substring(0, 10) %>
                                </td>
                                <td class="p-4">
                                    <% if (r.status === 'RESOLVED') { %>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">RESOLVED</span>
                                    <% } else { %>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">PENDING REVIEW</span>
                                    <% } %>
                                </td>
                                <td class="p-4 text-right">
                                    <% if (r.status !== 'RESOLVED') { %>
                                        <form action="/admin/reports/resolve" method="POST" class="inline">
                                            <input type="hidden" name="id" value="<%= r.id %>">
                                            <button type="submit" class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm">
                                                Resolve
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-xs text-slate-400">Completed</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
