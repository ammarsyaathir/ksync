<%- include('../partials/header', { title: 'Audit Trail Logs | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-6">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">System Audit Trail Logs</h1>
        <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Immutable audit trail of administrator verification actions, event submissions, and security events.</p>
    </div>

    <!-- Admin Nav -->
    <%- include('./admin-nav', { activePath: '/admin/logs' }) %>

    <!-- Filter Bar -->
    <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-xs mb-6">
        <form action="/admin/logs" method="GET" class="flex flex-col md:flex-row items-center gap-3">
            <div class="w-full md:w-64">
                <select name="action" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-300">
                    <option value="">All Action Types (<%= actionTypes ? actionTypes.length : 0 %>)</option>
                    <% if (typeof actionTypes !== 'undefined' && actionTypes) { %>
                        <% actionTypes.forEach(function(act) { %>
                            <option value="<%= act %>" <%= selectedAction === act ? 'selected' : '' %>><%= act %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="w-full md:flex-1 relative">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="Search by description, username, or IP address..."
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300">
            </div>

            <div class="flex items-center space-x-2 w-full md:w-auto">
                <button type="submit" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer">
                    <i class="fas fa-filter me-1.5 text-pink-400"></i> Apply Filter
                </button>
                <% if (selectedAction || searchQuery) { %>
                    <a href="/admin/logs" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-bold transition-colors">
                        Clear
                    </a>
                <% } %>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
            <span class="text-xs font-bold text-slate-500">Showing <%= logs.length %> recorded audit logs</span>
            <span class="text-[10px] text-slate-400 uppercase font-black tracking-wider">Immutable Security Trail</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700">
                <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] border-b border-slate-200">
                    <tr>
                        <th class="p-3">Log ID</th>
                        <th class="p-3">Timestamp</th>
                        <th class="p-3">Actor / User</th>
                        <th class="p-3">Action Type</th>
                        <th class="p-3">Target Entity</th>
                        <th class="p-3">Description & Context</th>
                        <th class="p-3">IP Address</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-mono text-[11px]">
                    <% if (logs.length === 0) { %>
                        <tr>
                            <td colspan="7" class="p-8 text-center text-slate-400 font-sans">
                                <i class="fas fa-inbox text-2xl mb-2 block"></i>
                                No audit logs match your filter criteria.
                            </td>
                        </tr>
                    <% } %>
                    <% logs.forEach(function(l) { 
                        const act = l.action || '';
                        let badgeStyle = 'bg-slate-100 text-slate-700 border-slate-200';
                        if (act.includes('APPROVE') || act.includes('VERIFY')) {
                            badgeStyle = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                        } else if (act.includes('REJECT') || act.includes('DELETE') || act.includes('REVOKE') || act.includes('SCAM')) {
                            badgeStyle = 'bg-rose-50 text-rose-700 border-rose-200';
                        } else if (act.includes('UPDATE') || act.includes('FREEZE')) {
                            badgeStyle = 'bg-amber-50 text-amber-700 border-amber-200';
                        } else if (act.includes('LOGIN') || act.includes('REGISTER')) {
                            badgeStyle = 'bg-sky-50 text-sky-700 border-sky-200';
                        } else if (act.includes('SUBMIT')) {
                            badgeStyle = 'bg-purple-50 text-purple-700 border-purple-200';
                        }
                    %>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="p-3 text-slate-400 font-bold">#<%= l.id %></td>
                            <td class="p-3 text-slate-500 font-sans whitespace-nowrap"><%= helpers.formatDate(l.created_at) %></td>
                            <td class="p-3 font-sans font-bold text-slate-900">
                                <% if (l.username) { %>
                                    <span class="text-pink-600 font-extrabold">@<%= l.username %></span>
                                <% } else { %>
                                    <span class="text-slate-400 italic">Guest / System</span>
                                <% } %>
                            </td>
                            <td class="p-3 whitespace-nowrap">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border <%= badgeStyle %>">
                                    <%= l.action %>
                                </span>
                            </td>
                            <td class="p-3 text-purple-600 font-sans whitespace-nowrap">
                                <%= l.entity_type ? l.entity_type + ' #' + l.entity_id : '-' %>
                            </td>
                            <td class="p-3 font-sans text-slate-700 font-medium max-w-md truncate" title="<%= l.description %>">
                                <%= l.description %>
                            </td>
                            <td class="p-3 text-slate-400 font-mono text-[10px]"><%= l.ip_address || '127.0.0.1' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
