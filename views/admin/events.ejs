<%- include('../partials/header', { title: 'Manage Events | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/flash') %>

    <!-- Standard Header with Breadcrumbs & Action -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <div class="flex items-center space-x-2 mb-2 flex-wrap gap-y-1">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white shadow-sm border border-slate-700">
                    <i class="fas fa-calendar-days me-1.5 text-purple-400"></i> Event Directory
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
                    <%= events.length %> Listings Total
                </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Manage Events Catalog</h1>
            <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Update concert live statuses (Upcoming, Ongoing, Postponed, Cancelled), preview live pages, or remove listings.</p>
        </div>
        <div class="flex items-center space-x-2 self-start md:self-auto shrink-0">
            <a href="/admin/reports" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-all flex items-center cursor-pointer">
                <i class="fas fa-shield-virus me-1.5 text-rose-500"></i> Scam Reports
            </a>
        </div>
    </div>


    <!-- Filter & Table Card -->
    <div class="bg-white rounded-3xl p-4 sm:p-6 lg:p-8 border border-slate-200/80 shadow-xs space-y-4">
        <!-- Interactive Multi-Filter Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 flex-1 max-w-2xl">
                <!-- Text Search -->
                <div class="relative flex-1">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="eventSearchInput" onkeyup="filterEventsTable()" placeholder="Filter by event name, artist, venue, or reference code..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-300">
                </div>

                <!-- Status Filter Selector -->
                <div class="w-full sm:w-44 shrink-0">
                    <select id="eventStatusFilter" onchange="filterEventsTable()" 
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-300 cursor-pointer">
                        <option value="">All Statuses</option>
                        <option value="UPCOMING">Upcoming</option>
                        <option value="ONGOING">Ongoing (Live)</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="POSTPONED">Postponed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>
            </div>

            <div class="text-[11px] text-slate-500 font-medium self-end sm:self-auto">
                Showing <strong id="visibleEventCount" class="text-slate-900"><%= events.length %></strong> of <%= events.length %> events
            </div>
        </div>

        <!-- Table Container with Horizontal Scroll on Mobile -->
        <div class="overflow-x-auto rounded-2xl border border-slate-100">
            <table class="w-full text-left text-xs text-slate-700 min-w-[780px]" id="eventsTable">
                <thead class="bg-slate-50/80 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="p-3.5">ID</th>
                        <th class="p-3.5">Event Title & Ref</th>
                        <th class="p-3.5">Artist & Category</th>
                        <th class="p-3.5">Date & Venue</th>
                        <th class="p-3.5">Verification</th>
                        <th class="p-3.5">Live Schedule Status</th>
                        <th class="p-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (events.length === 0) { %>
                        <tr>
                            <td colspan="7" class="p-10 text-center text-slate-400">
                                <i class="fas fa-calendar-xmark text-3xl text-slate-300 mb-2"></i>
                                <div class="font-bold text-slate-700">No events found in catalog</div>
                                <p class="text-[11px] text-slate-400 mt-1">Submit your first K-Pop concert or fan meeting.</p>
                            </td>
                        </tr>
                    <% } %>
                    <% events.forEach(function(ev) { %>
                        <tr class="hover:bg-slate-50/60 transition-colors event-row" 
                            data-name="<%= (ev.event_name || '').toLowerCase() %>"
                            data-artist="<%= (ev.artist_name || '').toLowerCase() %>"
                            data-venue="<%= (ev.venue_name || ev.city || '').toLowerCase() %>"
                            data-code="<%= (ev.tracking_code || '').toLowerCase() %>"
                            data-status="<%= (ev.event_status || 'UPCOMING').toUpperCase() %>">
                            <td class="p-3.5 font-mono font-bold text-slate-400">#<%= ev.id %></td>
                            <td class="p-3.5 max-w-[240px]">
                                <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="font-bold text-slate-900 hover:text-purple-600 transition-colors block truncate" title="<%= ev.event_name %>">
                                    <%= ev.event_name %>
                                </a>
                                <div class="text-[10px] text-slate-400 flex items-center space-x-1.5 mt-0.5">
                                    <% if (ev.tracking_code) { %>
                                        <span class="font-mono text-purple-600 font-bold bg-purple-50 px-1.5 py-0.2 rounded border border-purple-100"><%= ev.tracking_code %></span>
                                    <% } %>
                                </div>
                            </td>
                            <td class="p-3.5">
                                <div class="font-bold text-purple-600 truncate max-w-[160px]"><%= ev.artist_name || 'Multiple / Festival' %></div>
                                <div class="text-[10px] text-slate-500 truncate max-w-[160px]"><%= ev.category_name || 'Event' %></div>
                            </td>
                            <td class="p-3.5">
                                <div class="font-bold text-slate-800"><%= helpers.formatDate(ev.event_date) %></div>
                                <div class="text-[10px] text-slate-500 truncate max-w-[180px]"><%= ev.venue_name || 'Venue TBA' %>, <%= ev.city || 'Malaysia' %></div>
                            </td>
                            <td class="p-3.5">
                                <%- helpers.getVerificationBadge(ev.verification_status) %>
                            </td>
                            <td class="p-3.5">
                                <form action="/admin/events/update-status" method="POST" class="inline">
                                    <input type="hidden" name="event_id" value="<%= ev.id %>">
                                    <select name="event_status" onchange="this.form.submit()" 
                                            class="bg-slate-50 border border-slate-200/90 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-200 cursor-pointer">
                                        <option value="UPCOMING" <%= ev.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                        <option value="ONGOING" <%= ev.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing (Live)</option>
                                        <option value="COMPLETED" <%= ev.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                        <option value="POSTPONED" <%= ev.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                        <option value="CANCELLED" <%= ev.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                                    </select>
                                </form>
                            </td>
                            <td class="p-3.5 text-right whitespace-nowrap">
                                <div class="flex items-center justify-end space-x-1.5">
                                    <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-colors" title="View Public Page">
                                        <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                                    </a>
                                    <form action="/admin/events/delete" method="POST" onsubmit="return confirm('Permanently delete this event listing?')" class="inline">
                                        <input type="hidden" name="event_id" value="<%= ev.id %>">
                                        <button type="submit" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer" title="Delete Listing">
                                            <i class="fas fa-trash-can text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterEventsTable() {
    const q = (document.getElementById('eventSearchInput').value || '').toLowerCase().trim();
    const status = (document.getElementById('eventStatusFilter').value || '').toUpperCase().trim();
    const rows = document.querySelectorAll('.event-row');
    let visible = 0;

    rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const artist = row.getAttribute('data-artist') || '';
        const venue = row.getAttribute('data-venue') || '';
        const code = row.getAttribute('data-code') || '';
        const rowStatus = row.getAttribute('data-status') || '';

        const matchesText = !q || name.includes(q) || artist.includes(q) || venue.includes(q) || code.includes(q);
        const matchesStatus = !status || rowStatus === status;

        if (matchesText && matchesStatus) {
            row.style.display = '';
            visible++;
        } else {
            row.style.display = 'none';
        }
    });

    document.getElementById('visibleEventCount').innerText = visible;
}
</script>

<%- include('../partials/footer') %>
