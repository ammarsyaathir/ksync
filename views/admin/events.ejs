<%- include('../partials/header', { title: 'Manage Events | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10">
    <%- include('../partials/flash') %>

    <!-- Standard Header with Breadcrumbs & Responsive Action Buttons -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <div class="flex items-center space-x-2 mb-2 flex-wrap gap-y-1">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white shadow-sm border border-slate-700">
                    <i class="fas fa-calendar-days me-1.5 text-purple-400"></i> Event Directory
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
                    <%= events.length %> Listings Total
                </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Manage Events Catalog</h1>
            <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Update concert live statuses (Upcoming, Ongoing, Postponed, Cancelled), preview live pages, or remove listings.</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap self-stretch sm:self-auto">
            <a href="/events/submit" class="flex-1 sm:flex-initial px-3.5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-xs transition-all flex items-center justify-center cursor-pointer">
                <i class="fas fa-plus me-1.5"></i> Submit Event
            </a>
            <a href="/admin/verifications" class="flex-1 sm:flex-initial px-3.5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs shadow-xs transition-all flex items-center justify-center cursor-pointer">
                <i class="fas fa-check-double text-purple-600 me-1.5"></i> Verifications
            </a>
            <a href="/admin/reports" class="flex-1 sm:flex-initial px-3.5 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs shadow-xs transition-all flex items-center justify-center cursor-pointer">
                <i class="fas fa-shield-virus text-rose-500 me-1.5"></i> Scam Reports
            </a>
        </div>
    </div>

    <!-- Filter & Listings Card -->
    <div class="bg-white rounded-3xl p-4 sm:p-6 lg:p-8 border border-slate-200/80 shadow-xs space-y-5">
        <!-- Interactive Multi-Filter Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-1 max-w-2xl">
                <!-- Text Search -->
                <div class="relative flex-1">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="eventSearchInput" onkeyup="filterEventsTable()" placeholder="Search by event name, artist, venue, or tracking code..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-300 transition-all">
                    <button type="button" id="clearSearchBtn" onclick="clearEventSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>

                <!-- Status Filter Selector -->
                <div class="w-full sm:w-48 shrink-0">
                    <select id="eventStatusFilter" onchange="filterEventsTable()" 
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-300 cursor-pointer transition-all">
                        <option value="">All Statuses (<%= events.length %>)</option>
                        <option value="UPCOMING">Upcoming</option>
                        <option value="ONGOING">Ongoing (Live)</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="POSTPONED">Postponed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-between sm:justify-end gap-2 text-[11px] text-slate-500 font-medium">
                <span>Showing <strong id="visibleEventCount" class="text-purple-600 font-bold"><%= events.length %></strong> of <%= events.length %> listings</span>
            </div>
        </div>

        <!-- Zero results dynamic state -->
        <div id="noEventsMatchNotice" class="hidden text-center py-12 px-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50/50">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-xl mx-auto mb-3">
                <i class="fas fa-filter-circle-xmark"></i>
            </div>
            <div class="font-bold text-slate-800 text-sm">No matching events found</div>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Try adjusting your search terms or clearing the status filter.</p>
            <button type="button" onclick="resetAllFilters()" class="mt-4 px-4 py-2 rounded-xl bg-purple-100 hover:bg-purple-200 text-purple-700 font-bold text-xs transition-colors cursor-pointer">
                Reset All Filters
            </button>
        </div>

        <% if (events.length === 0) { %>
            <div class="text-center py-14 text-slate-400">
                <div class="w-14 h-14 rounded-2xl bg-purple-50 text-purple-400 flex items-center justify-center text-2xl mx-auto mb-3">
                    <i class="fas fa-calendar-xmark"></i>
                </div>
                <div class="font-bold text-slate-700 text-base">No events found in catalog</div>
                <p class="text-xs text-slate-500 mt-1">Submit your first K-Pop concert or fan meeting.</p>
                <a href="/events/submit" class="mt-4 inline-flex items-center px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-xs transition-all">
                    <i class="fas fa-plus me-1.5"></i> Submit New Event
                </a>
            </div>
        <% } else { %>

            <!-- ======================================================== -->
            <!-- 1. MOBILE RESPONSIVE CARDS VIEW (< md screens) -->
            <!-- ======================================================== -->
            <div class="block md:hidden space-y-3.5" id="eventsMobileList">
                <% events.forEach(function(ev) { %>
                    <div class="bg-white rounded-2xl p-4 border border-slate-200/90 shadow-2xs space-y-3 event-filter-item event-mobile-card hover:border-purple-200 transition-all"
                         data-name="<%= (ev.event_name || '').toLowerCase() %>"
                         data-artist="<%= (ev.artist_name || '').toLowerCase() %>"
                         data-venue="<%= (ev.venue_name || ev.city || '').toLowerCase() %>"
                         data-code="<%= (ev.tracking_code || '').toLowerCase() %>"
                         data-status="<%= (ev.event_status || 'UPCOMING').toUpperCase() %>">
                        
                        <!-- Top Meta Row: ID, Ref Code & Verification Badge -->
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="font-mono text-[11px] font-bold text-slate-400">#<%= ev.id %></span>
                                <% if (ev.tracking_code) { %>
                                    <span class="font-mono text-[11px] font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded-md border border-purple-200">
                                        <%= ev.tracking_code %>
                                    </span>
                                <% } %>
                            </div>
                            <div class="shrink-0">
                                <%- helpers.getVerificationBadge(ev.verification_status) %>
                            </div>
                        </div>

                        <!-- Main Body: Thumbnail & Details -->
                        <div class="flex items-start gap-3">
                            <% if (ev.poster_image) { %>
                                <img src="<%= ev.poster_image %>" alt="<%= ev.event_name %>" class="w-14 h-14 rounded-xl object-cover shrink-0 border border-slate-100 shadow-2xs" onerror="this.style.display='none'">
                            <% } else { %>
                                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-100 flex items-center justify-center text-purple-400 shrink-0 shadow-2xs">
                                    <i class="fas fa-compact-disc text-xl"></i>
                                </div>
                            <% } %>
                            <div class="flex-1 min-w-0">
                                <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="font-extrabold text-slate-900 text-sm hover:text-purple-600 transition-colors leading-snug line-clamp-2" title="<%= ev.event_name %>">
                                    <%= ev.event_name %>
                                </a>
                                <div class="flex items-center gap-1.5 flex-wrap text-xs mt-1">
                                    <span class="font-bold text-purple-700">
                                        <i class="fas fa-microphone-lines text-purple-400 me-1"></i><%= ev.artist_name || 'Multiple / Festival' %>
                                    </span>
                                    <span class="text-slate-300">•</span>
                                    <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-1.5 py-0.2 rounded">
                                        <%= ev.category_name || 'Event' %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Date & Venue Info -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pt-2 border-t border-slate-100 text-xs">
                            <div class="flex items-center text-slate-700 font-semibold">
                                <i class="far fa-calendar-alt text-slate-400 w-4 me-1.5 shrink-0 text-center"></i>
                                <span><%= helpers.formatDate(ev.event_date) %></span>
                            </div>
                            <div class="flex items-center text-slate-500 truncate">
                                <i class="fas fa-location-dot text-slate-400 w-4 me-1.5 shrink-0 text-center"></i>
                                <span class="truncate"><%= ev.venue_name || 'Venue TBA' %>, <%= ev.city || 'Malaysia' %></span>
                            </div>
                        </div>

                        <!-- Schedule Status Form & Actions Row -->
                        <div class="pt-2 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                            <!-- In-line status change form -->
                            <form action="/admin/events/update-status" method="POST" class="flex items-center gap-2 flex-1">
                                <input type="hidden" name="event_id" value="<%= ev.id %>">
                                <label class="text-[11px] font-bold text-slate-500 shrink-0">Status:</label>
                                <select name="event_status" onchange="this.form.submit()" 
                                        class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-300 cursor-pointer">
                                    <option value="UPCOMING" <%= ev.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                    <option value="ONGOING" <%= ev.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing (Live)</option>
                                    <option value="COMPLETED" <%= ev.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                    <option value="POSTPONED" <%= ev.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                    <option value="CANCELLED" <%= ev.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </form>

                            <!-- Quick Action Buttons -->
                            <div class="flex items-center justify-end gap-1.5 shrink-0">
                                <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs inline-flex items-center gap-1 transition-all" title="View Public Page">
                                    <i class="fas fa-arrow-up-right-from-square text-[10px]"></i> View
                                </a>
                                <form action="/admin/events/delete" method="POST" onsubmit="return confirm('Permanently delete this event listing?')" class="inline">
                                    <input type="hidden" name="event_id" value="<%= ev.id %>">
                                    <button type="submit" class="px-3 py-1.5 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs inline-flex items-center gap-1 transition-all cursor-pointer" title="Delete Listing">
                                        <i class="fas fa-trash-can text-[10px]"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- ======================================================== -->
            <!-- 2. DESKTOP / TABLET EXPANDED TABLE VIEW (>= md screens) -->
            <!-- ======================================================== -->
            <div class="hidden md:block overflow-x-auto rounded-2xl border border-slate-100" id="eventsTableContainer">
                <table class="w-full text-left text-xs text-slate-700" id="eventsTable">
                    <thead class="bg-slate-50/80 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="p-3.5 w-14">ID</th>
                            <th class="p-3.5">Event Title & Ref</th>
                            <th class="p-3.5 w-44">Artist & Category</th>
                            <th class="p-3.5 w-44">Date & Venue</th>
                            <th class="p-3.5 w-36">Verification</th>
                            <th class="p-3.5 w-44">Live Schedule Status</th>
                            <th class="p-3.5 w-24 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% events.forEach(function(ev) { %>
                            <tr class="hover:bg-purple-50/20 transition-colors event-filter-item event-desktop-row" 
                                data-name="<%= (ev.event_name || '').toLowerCase() %>"
                                data-artist="<%= (ev.artist_name || '').toLowerCase() %>"
                                data-venue="<%= (ev.venue_name || ev.city || '').toLowerCase() %>"
                                data-code="<%= (ev.tracking_code || '').toLowerCase() %>"
                                data-status="<%= (ev.event_status || 'UPCOMING').toUpperCase() %>">
                                <td class="p-3.5 font-mono font-bold text-slate-400">#<%= ev.id %></td>
                                <td class="p-3.5">
                                    <div class="flex items-start gap-2.5">
                                        <% if (ev.poster_image) { %>
                                            <img src="<%= ev.poster_image %>" alt="<%= ev.event_name %>" class="w-10 h-10 rounded-lg object-cover shrink-0 border border-slate-100 shadow-2xs" onerror="this.style.display='none'">
                                        <% } %>
                                        <div class="min-w-0 flex-1">
                                            <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="font-bold text-slate-900 hover:text-purple-600 transition-colors block leading-snug line-clamp-2" title="<%= ev.event_name %>">
                                                <%= ev.event_name %>
                                            </a>
                                            <div class="text-[10px] text-slate-400 flex items-center space-x-1.5 mt-0.5">
                                                <% if (ev.tracking_code) { %>
                                                    <span class="font-mono text-purple-600 font-bold bg-purple-50 px-1.5 py-0.2 rounded border border-purple-100"><%= ev.tracking_code %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-3.5">
                                    <div class="font-bold text-purple-600 truncate max-w-[170px]"><%= ev.artist_name || 'Multiple / Festival' %></div>
                                    <div class="text-[10px] text-slate-500 truncate max-w-[170px]"><%= ev.category_name || 'Event' %></div>
                                </td>
                                <td class="p-3.5">
                                    <div class="font-bold text-slate-800"><%= helpers.formatDate(ev.event_date) %></div>
                                    <div class="text-[10px] text-slate-500 truncate max-w-[170px]"><%= ev.venue_name || 'Venue TBA' %>, <%= ev.city || 'Malaysia' %></div>
                                </td>
                                <td class="p-3.5">
                                    <%- helpers.getVerificationBadge(ev.verification_status) %>
                                </td>
                                <td class="p-3.5">
                                    <form action="/admin/events/update-status" method="POST" class="inline">
                                        <input type="hidden" name="event_id" value="<%= ev.id %>">
                                        <select name="event_status" onchange="this.form.submit()" 
                                                class="bg-slate-50 border border-slate-200/90 rounded-xl px-2.5 py-1.5 text-[11px] font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-200 cursor-pointer">
                                            <option value="UPCOMING" <%= ev.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                            <option value="ONGOING" <%= ev.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing (Live)</option>
                                            <option value="COMPLETED" <%= ev.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                            <option value="POSTPONED" <%= ev.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                            <option value="CANCELLED" <%= ev.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="p-3.5 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end space-x-1.5">
                                        <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-colors" title="View Public Page">
                                            <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                                        </a>
                                        <form action="/admin/events/delete" method="POST" onsubmit="return confirm('Permanently delete this event listing?')" class="inline">
                                            <input type="hidden" name="event_id" value="<%= ev.id %>">
                                            <button type="submit" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer" title="Delete Listing">
                                                <i class="fas fa-trash-can text-xs"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script>
function filterEventsTable() {
    const q = (document.getElementById('eventSearchInput').value || '').toLowerCase().trim();
    const status = (document.getElementById('eventStatusFilter').value || '').toUpperCase().trim();
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
        clearBtn.classList.toggle('hidden', !q);
    }

    const items = document.querySelectorAll('.event-filter-item');
    let visibleCount = 0;

    items.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const artist = item.getAttribute('data-artist') || '';
        const venue = item.getAttribute('data-venue') || '';
        const code = item.getAttribute('data-code') || '';
        const itemStatus = item.getAttribute('data-status') || '';

        const matchesText = !q || name.includes(q) || artist.includes(q) || venue.includes(q) || code.includes(q);
        const matchesStatus = !status || itemStatus === status;

        if (matchesText && matchesStatus) {
            item.style.display = '';
            if (item.classList.contains('event-mobile-card')) {
                visibleCount++;
            }
        } else {
            item.style.display = 'none';
        }
    });

    const countEl = document.getElementById('visibleEventCount');
    if (countEl) countEl.innerText = visibleCount;

    const noEventsNotice = document.getElementById('noEventsMatchNotice');
    if (noEventsNotice) {
        noEventsNotice.classList.toggle('hidden', visibleCount > 0);
    }
}

function clearEventSearch() {
    const input = document.getElementById('eventSearchInput');
    if (input) {
        input.value = '';
        input.focus();
    }
    filterEventsTable();
}

function resetAllFilters() {
    const input = document.getElementById('eventSearchInput');
    const select = document.getElementById('eventStatusFilter');
    if (input) input.value = '';
    if (select) select.value = '';
    filterEventsTable();
}
</script>

<%- include('../partials/footer') %>
