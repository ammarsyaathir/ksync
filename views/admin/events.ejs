<%- include('../partials/header', { title: 'Manage Events Catalog | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('admin-nav', { activeTab: 'events', pageTitle: 'Events Master Catalog' }) %>

    <!-- Filter & Listings Container -->
    <div class="bg-white rounded-3xl p-5 sm:p-7 lg:p-8 border border-slate-200/80 shadow-xs space-y-6">
        <!-- Interactive Multi-Filter Toolbar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-1 max-w-2xl">
                <!-- Text Search -->
                <div class="relative flex-1">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="eventSearchInput" onkeyup="filterEventsTable()" placeholder="Search title, artist, venue, or tracking code..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-8 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-300 transition-all font-medium">
                    <button type="button" id="clearSearchBtn" onclick="clearEventSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs cursor-pointer">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>

                <!-- Status Filter Dropdown -->
                <div class="w-full sm:w-52 shrink-0">
                    <select id="eventStatusFilter" onchange="filterEventsTable()" 
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-300 cursor-pointer transition-all">
                        <option value="">All Statuses (<%= events.length %>)</option>
                        <option value="UPCOMING">Upcoming</option>
                        <option value="ONGOING">Ongoing (Live Today)</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="POSTPONED">Postponed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>
            </div>

            <!-- Total Results Live Counter -->
            <div class="flex items-center justify-between sm:justify-end gap-2 text-xs text-slate-500 font-medium shrink-0">
                <span>Showing <strong id="visibleEventCount" class="text-purple-600 font-black"><%= events.length %></strong> of <%= events.length %> listings</span>
            </div>
        </div>

        <!-- Zero Results Notice (Client-side dynamic) -->
        <div id="noEventsMatchNotice" class="hidden text-center py-14 px-4 rounded-3xl border border-dashed border-slate-200 bg-slate-50/50">
            <div class="w-14 h-14 rounded-2xl bg-purple-50 text-purple-400 flex items-center justify-center text-xl mx-auto mb-3">
                <i class="fas fa-filter-circle-xmark"></i>
            </div>
            <div class="font-extrabold text-slate-800 text-sm">No matching events found</div>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Try refining your search keyword or clearing the status filter.</p>
            <button type="button" onclick="resetAllFilters()" class="mt-4 px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs transition-all shadow-xs cursor-pointer">
                Reset All Filters
            </button>
        </div>

        <% if (events.length === 0) { %>
            <div class="text-center py-16 text-slate-400">
                <div class="w-16 h-16 rounded-3xl bg-purple-50 text-purple-400 flex items-center justify-center text-2xl mx-auto mb-3.5">
                    <i class="fas fa-calendar-xmark"></i>
                </div>
                <div class="font-black text-slate-800 text-base">No events in catalog</div>
                <p class="text-xs text-slate-500 mt-1">Submit your first Malaysian K-Pop concert or fan gathering.</p>
                <a href="/events/submit" class="mt-4 inline-flex items-center px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-xs transition-all">
                    <i class="fas fa-plus me-1.5"></i> Submit New Event
                </a>
            </div>
        <% } else { %>

            <!-- ======================================================== -->
            <!-- 1. MOBILE RESPONSIVE CARDS VIEW (< md screens) -->
            <!-- ======================================================== -->
            <div class="block md:hidden space-y-4" id="eventsMobileList">
                <% events.forEach(function(ev) { %>
                    <div class="bg-white rounded-3xl p-4.5 border border-slate-200/90 shadow-2xs space-y-3.5 event-filter-item event-mobile-card hover:border-purple-300 transition-all"
                         data-name="<%= (ev.event_name || '').toLowerCase() %>"
                         data-artist="<%= (ev.artist_name || '').toLowerCase() %>"
                         data-venue="<%= (ev.venue_name || ev.city || '').toLowerCase() %>"
                         data-code="<%= (ev.tracking_code || '').toLowerCase() %>"
                         data-status="<%= (ev.event_status || 'UPCOMING').toUpperCase() %>">
                        
                        <!-- Top Meta Row: ID, Ref Code & Verification Badge -->
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="font-mono text-xs font-bold text-slate-400">#<%= ev.id %></span>
                                <% if (ev.tracking_code) { %>
                                    <span class="font-mono text-[11px] font-black text-purple-700 bg-purple-50 px-2.5 py-0.5 rounded-md border border-purple-200">
                                        <%= ev.tracking_code %>
                                    </span>
                                <% } %>
                            </div>
                            <div class="shrink-0">
                                <%- helpers.getVerificationBadge(ev.verification_status) %>
                            </div>
                        </div>

                        <!-- Main Body: Thumbnail & Details -->
                        <div class="flex items-start gap-3.5">
                            <% if (ev.poster_image) { %>
                                <img src="<%= ev.poster_image %>" alt="<%= ev.event_name %>" class="w-16 h-16 rounded-2xl object-cover shrink-0 border border-slate-200 shadow-2xs" onerror="this.style.display='none'">
                            <% } else { %>
                                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-100 flex items-center justify-center text-purple-400 shrink-0 shadow-2xs">
                                    <i class="fas fa-compact-disc text-2xl"></i>
                                </div>
                            <% } %>
                            <div class="flex-1 min-w-0">
                                <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="font-black text-slate-900 text-sm hover:text-purple-600 transition-colors leading-snug line-clamp-2" title="<%= ev.event_name %>">
                                    <%= ev.event_name %>
                                </a>
                                <div class="flex items-center gap-1.5 flex-wrap text-xs mt-1.5">
                                    <span class="font-bold text-purple-700">
                                        <i class="fas fa-microphone-lines text-purple-400 me-1"></i><%= ev.artist_name || 'Multiple / Festival' %>
                                    </span>
                                    <span class="text-slate-300">•</span>
                                    <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md">
                                        <%= ev.category_name || 'Event' %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Date & Venue Info -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2.5 border-t border-slate-100 text-xs font-medium">
                            <div class="flex items-center text-slate-800 font-bold">
                                <i class="far fa-calendar-alt text-purple-500 w-4 me-1.5 shrink-0 text-center"></i>
                                <span><%= helpers.formatDate(ev.event_date) %></span>
                            </div>
                            <div class="flex items-center text-slate-500 truncate">
                                <i class="fas fa-location-dot text-slate-400 w-4 me-1.5 shrink-0 text-center"></i>
                                <span class="truncate"><%= ev.venue_name || 'Venue TBA' %>, <%= ev.city || 'Malaysia' %></span>
                            </div>
                        </div>

                        <!-- Schedule Status Form & Actions Row -->
                        <div class="pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <!-- In-line status change form -->
                            <form action="/admin/events/update-status" method="POST" class="flex items-center gap-2 flex-1">
                                <input type="hidden" name="event_id" value="<%= ev.id %>">
                                <label class="text-xs font-bold text-slate-500 shrink-0">Status:</label>
                                <select name="event_status" onchange="this.form.submit()" 
                                        class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-300 cursor-pointer">
                                    <option value="UPCOMING" <%= ev.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                    <option value="ONGOING" <%= ev.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing (Live)</option>
                                    <option value="COMPLETED" <%= ev.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                    <option value="POSTPONED" <%= ev.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                    <option value="CANCELLED" <%= ev.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </form>

                            <!-- Quick Action Buttons -->
                            <div class="flex items-center justify-end gap-2 shrink-0">
                                <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs inline-flex items-center gap-1.5 transition-all" title="View Public Page">
                                    <i class="fas fa-arrow-up-right-from-square text-[10px]"></i> View
                                </a>
                                <form action="/admin/events/delete" method="POST" 
                                      data-confirm="Permanently delete this event listing? All attendee bookmarks and comments will be removed."
                                      data-confirm-title="Delete Event Listing"
                                      data-confirm-button="Delete Event"
                                      class="inline">
                                    <input type="hidden" name="event_id" value="<%= ev.id %>">
                                    <button type="submit" class="px-3 py-1.5 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs inline-flex items-center gap-1.5 transition-all cursor-pointer" title="Delete Listing">
                                        <i class="fas fa-trash-can text-[10px]"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- ======================================================== -->
            <!-- 2. DESKTOP / TABLET EXPANDED TABLE VIEW (>= md screens) -->
            <!-- ======================================================== -->
            <div class="hidden md:block overflow-x-auto rounded-2xl border border-slate-200/80 shadow-2xs" id="eventsTableContainer">
                <table class="w-full text-left text-xs text-slate-700" id="eventsTable">
                    <thead class="bg-slate-900 text-white uppercase font-black text-[10px] tracking-wider">
                        <tr>
                            <th class="p-4 w-14">ID</th>
                            <th class="p-4">Event Title & Reference</th>
                            <th class="p-4 w-44">Artist & Type</th>
                            <th class="p-4 w-48">Date & Venue</th>
                            <th class="p-4 w-36">Verification</th>
                            <th class="p-4 w-44">Schedule Status</th>
                            <th class="p-4 w-28 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% events.forEach(function(ev) { %>
                            <tr class="hover:bg-purple-50/30 transition-colors event-filter-item event-desktop-row" 
                                data-name="<%= (ev.event_name || '').toLowerCase() %>"
                                data-artist="<%= (ev.artist_name || '').toLowerCase() %>"
                                data-venue="<%= (ev.venue_name || ev.city || '').toLowerCase() %>"
                                data-code="<%= (ev.tracking_code || '').toLowerCase() %>"
                                data-status="<%= (ev.event_status || 'UPCOMING').toUpperCase() %>">
                                <td class="p-4 font-mono font-bold text-slate-400">#<%= ev.id %></td>
                                <td class="p-4">
                                    <div class="flex items-start gap-3">
                                        <% if (ev.poster_image) { %>
                                            <img src="<%= ev.poster_image %>" alt="<%= ev.event_name %>" class="w-12 h-12 rounded-xl object-cover shrink-0 border border-slate-200 shadow-2xs" onerror="this.style.display='none'">
                                        <% } else { %>
                                            <div class="w-12 h-12 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center text-purple-400 shrink-0">
                                                <i class="fas fa-compact-disc text-lg"></i>
                                            </div>
                                        <% } %>
                                        <div class="min-w-0 flex-1">
                                            <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="font-extrabold text-slate-900 hover:text-purple-600 transition-colors block leading-snug line-clamp-2" title="<%= ev.event_name %>">
                                                <%= ev.event_name %>
                                            </a>
                                            <div class="text-[10px] text-slate-400 flex items-center space-x-2 mt-1">
                                                <% if (ev.tracking_code) { %>
                                                    <span class="font-mono text-purple-700 font-black bg-purple-50 px-2 py-0.5 rounded-md border border-purple-200"><%= ev.tracking_code %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="font-bold text-purple-700 truncate max-w-[170px]"><%= ev.artist_name || 'Multiple / Festival' %></div>
                                    <div class="text-[11px] text-slate-500 font-medium truncate max-w-[170px]"><%= ev.category_name || 'Event' %></div>
                                </td>
                                <td class="p-4">
                                    <div class="font-extrabold text-slate-800"><%= helpers.formatDate(ev.event_date) %></div>
                                    <div class="text-[11px] text-slate-500 truncate max-w-[170px] mt-0.5"><%= ev.venue_name || 'Venue TBA' %>, <%= ev.city || 'Malaysia' %></div>
                                </td>
                                <td class="p-4">
                                    <%- helpers.getVerificationBadge(ev.verification_status) %>
                                </td>
                                <td class="p-4">
                                    <form action="/admin/events/update-status" method="POST" class="inline">
                                        <input type="hidden" name="event_id" value="<%= ev.id %>">
                                        <select name="event_status" onchange="this.form.submit()" 
                                                class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-200 cursor-pointer transition-all">
                                            <option value="UPCOMING" <%= ev.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                            <option value="ONGOING" <%= ev.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing (Live)</option>
                                            <option value="COMPLETED" <%= ev.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                            <option value="POSTPONED" <%= ev.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                            <option value="CANCELLED" <%= ev.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="p-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end space-x-1.5">
                                        <a href="<%= helpers.getEventUrl(ev) %>" target="_blank" class="p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-all" title="View Public Page">
                                            <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                                        </a>
                                        <form action="/admin/events/delete" method="POST" 
                                              data-confirm="Permanently delete this event listing? All attendee bookmarks and comments will be removed."
                                              data-confirm-title="Delete Event Listing"
                                              data-confirm-button="Delete Event"
                                              class="inline">
                                            <input type="hidden" name="event_id" value="<%= ev.id %>">
                                            <button type="submit" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-xl transition-all cursor-pointer" title="Delete Listing">
                                                <i class="fas fa-trash-can text-xs"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script>
function filterEventsTable() {
    const q = (document.getElementById('eventSearchInput').value || '').toLowerCase().trim();
    const status = (document.getElementById('eventStatusFilter').value || '').toUpperCase().trim();
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
        clearBtn.classList.toggle('hidden', !q);
    }

    const items = document.querySelectorAll('.event-filter-item');
    let visibleCount = 0;

    items.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const artist = item.getAttribute('data-artist') || '';
        const venue = item.getAttribute('data-venue') || '';
        const code = item.getAttribute('data-code') || '';
        const itemStatus = item.getAttribute('data-status') || '';

        const matchesText = !q || name.includes(q) || artist.includes(q) || venue.includes(q) || code.includes(q);
        const matchesStatus = !status || itemStatus === status;

        if (matchesText && matchesStatus) {
            item.style.display = '';
            if (item.classList.contains('event-mobile-card') || item.classList.contains('event-desktop-row')) {
                visibleCount++;
            }
        } else {
            item.style.display = 'none';
        }
    });

    const totalVisible = window.innerWidth < 768 
        ? document.querySelectorAll('.event-mobile-card:not([style*="display: none"])').length
        : document.querySelectorAll('.event-desktop-row:not([style*="display: none"])').length;

    const countEl = document.getElementById('visibleEventCount');
    if (countEl) countEl.innerText = totalVisible;

    const noEventsNotice = document.getElementById('noEventsMatchNotice');
    if (noEventsNotice) {
        noEventsNotice.classList.toggle('hidden', totalVisible > 0);
    }
}

function clearEventSearch() {
    const input = document.getElementById('eventSearchInput');
    if (input) {
        input.value = '';
        input.focus();
    }
    filterEventsTable();
}

function resetAllFilters() {
    const input = document.getElementById('eventSearchInput');
    const select = document.getElementById('eventStatusFilter');
    if (input) input.value = '';
    if (select) select.value = '';
    filterEventsTable();
}
</script>

<%- include('../partials/footer') %>
