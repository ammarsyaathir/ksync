<%- include('../partials/header', { title: 'Manage Categories | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('admin-nav', { activeTab: 'categories', pageTitle: 'Taxonomy & Event Categories' }) %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Add Category Form Card -->
        <div class="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200/80 shadow-xs h-fit space-y-4">
            <div class="flex items-center space-x-2.5 border-b border-slate-100 pb-3.5">
                <div class="w-9 h-9 rounded-2xl bg-pink-50 text-pink-600 flex items-center justify-center text-sm font-black border border-pink-100">
                    <i class="fas fa-plus"></i>
                </div>
                <div>
                    <h3 class="text-sm font-black text-slate-900">Add New Category</h3>
                    <p class="text-[11px] text-slate-500 font-medium">Define a new event classification.</p>
                </div>
            </div>

            <form action="/admin/categories/add" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Category Name <span class="text-rose-500">*</span></label>
                    <input type="text" name="name" id="categoryNameInput" required placeholder="e.g. Pop-up Store & Cafe"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300 font-medium">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">URL Slug <span class="text-rose-500">*</span></label>
                    <input type="text" name="slug" id="categorySlugInput" required placeholder="e.g. pop-up-store"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-pink-300 font-bold">
                    <span class="text-[10px] text-slate-400 font-medium mt-1 block">Used in filters e.g. /events?category=pop-up-store</span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Badge Color Theme</label>
                    <select name="badge_color" id="badgeColorSelect" onchange="updateBadgePreview()"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300 cursor-pointer">
                        <option value="purple">Purple (Concerts / Arena World Tours)</option>
                        <option value="pink">Pink (Fan Meetings & Showcases)</option>
                        <option value="rose">Rose (Cupsleeve / Cafe Gatherings)</option>
                        <option value="amber">Amber (Birthday Celebrations)</option>
                        <option value="indigo">Indigo (Fan Gatherings & Lightstick Projects)</option>
                        <option value="emerald">Emerald (Pop-ups & Exhibitions)</option>
                    </select>
                </div>

                <!-- Live Badge Preview -->
                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                    <span class="text-[11px] font-bold text-slate-500">Live Preview:</span>
                    <span id="badgePreviewPill" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200">
                        Preview
                    </span>
                </div>

                <button type="submit" class="w-full py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs shadow-md transition-all cursor-pointer active:scale-95 flex items-center justify-center gap-1.5">
                    <i class="fas fa-plus text-pink-400"></i> Add Category
                </button>
            </form>
        </div>

        <!-- Categories Table Card -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-5 sm:p-7 border border-slate-200/80 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div>
                    <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                        <i class="fas fa-tags text-pink-500"></i> Active Taxonomies (<%= categories.length %>)
                    </h3>
                    <p class="text-[11px] text-slate-500 font-medium">Standard event categories available in filters.</p>
                </div>
                <div class="relative w-full sm:w-64">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="categorySearchInput" onkeyup="filterCategories()" placeholder="Search name or slug..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3.5 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300 font-medium">
                </div>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-slate-200/80 shadow-2xs">
                <table class="w-full text-left text-xs text-slate-700 min-w-[500px]" id="categoriesTable">
                    <thead class="bg-slate-900 text-white uppercase font-black text-[10px] tracking-wider">
                        <tr>
                            <th class="p-3.5 w-14">ID</th>
                            <th class="p-3.5">Category Name</th>
                            <th class="p-3.5">URL Slug</th>
                            <th class="p-3.5">Badge Style</th>
                            <th class="p-3.5 text-center">Events</th>
                            <th class="p-3.5 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (categories.length === 0) { %>
                            <tr>
                                <td colspan="6" class="p-10 text-center text-slate-400">
                                    No categories registered yet.
                                </td>
                            </tr>
                        <% } %>
                        <% categories.forEach(function(c) { %>
                            <tr class="hover:bg-purple-50/20 transition-colors category-row"
                                data-name="<%= (c.name || '').toLowerCase() %>"
                                data-slug="<%= (c.slug || '').toLowerCase() %>">
                                <td class="p-3.5 font-mono font-bold text-slate-400">#<%= c.id %></td>
                                <td class="p-3.5 font-extrabold text-slate-900"><%= c.name %></td>
                                <td class="p-3.5 font-mono text-[11px] font-bold text-slate-500"><%= c.slug %></td>
                                <td class="p-3.5">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider border
                                        <%= c.badge_color === 'pink' ? 'bg-pink-50 text-pink-700 border-pink-200' :
                                           (c.badge_color === 'purple' ? 'bg-purple-50 text-purple-700 border-purple-200' :
                                           (c.badge_color === 'rose' ? 'bg-rose-50 text-rose-700 border-rose-200' :
                                           (c.badge_color === 'amber' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                           (c.badge_color === 'emerald' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                           'bg-indigo-50 text-indigo-700 border-indigo-200')))) %>">
                                        <%= c.badge_color || 'purple' %>
                                    </span>
                                </td>
                                <td class="p-3.5 text-center">
                                    <span class="px-2.5 py-0.5 rounded-md font-black text-xs bg-slate-100 text-slate-800">
                                        <%= c.event_count || 0 %>
                                    </span>
                                </td>
                                <td class="p-3.5 text-right">
                                    <form action="/admin/categories/delete" method="POST" 
                                          data-confirm="Delete this category? Events linked to it will remain intact."
                                          data-confirm-title="Delete Category"
                                          data-confirm-button="Delete Category"
                                          class="inline">
                                        <input type="hidden" name="id" value="<%= c.id %>">
                                        <button type="submit" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-xl transition-all cursor-pointer" title="Delete Category">
                                            <i class="fas fa-trash-can text-xs"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
function filterCategories() {
    const q = (document.getElementById('categorySearchInput').value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.category-row');
    rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const slug = row.getAttribute('data-slug') || '';
        if (!q || name.includes(q) || slug.includes(q)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}

function updateBadgePreview() {
    const nameInput = document.getElementById('categoryNameInput');
    const colorSelect = document.getElementById('badgeColorSelect');
    const pill = document.getElementById('badgePreviewPill');
    if (!pill) return;
    
    pill.innerText = nameInput.value.trim() || 'Preview';
    const color = colorSelect.value;
    
    const colorMap = {
        purple: 'bg-purple-50 text-purple-700 border-purple-200',
        pink: 'bg-pink-50 text-pink-700 border-pink-200',
        rose: 'bg-rose-50 text-rose-700 border-rose-200',
        amber: 'bg-amber-50 text-amber-700 border-amber-200',
        indigo: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200'
    };
    
    pill.className = 'px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border ' + (colorMap[color] || colorMap.purple);
}

// Auto slug generation from category name
document.getElementById('categoryNameInput')?.addEventListener('input', function(e) {
    const slugInput = document.getElementById('categorySlugInput');
    if (slugInput && !slugInput.dataset.manual) {
        slugInput.value = e.target.value.toLowerCase().trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }
    updateBadgePreview();
});
document.getElementById('categorySlugInput')?.addEventListener('input', function() {
    this.dataset.manual = 'true';
});
</script>

<%- include('../partials/footer') %>
