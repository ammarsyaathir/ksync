<%- include('../partials/header', { title: 'Manage Categories | K-Sync Admin' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-6">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Event Categories</h1>
        <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">Manage event classification types (Concerts, Fan Meetings, Cupsleeve Events, Exhibitions).</p>
    </div>

    <!-- Admin Nav -->
    <%- include('./admin-nav', { activePath: '/admin/categories' }) %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Add Category Form -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm h-fit space-y-4">
            <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-3">Add New Category</h3>
            <form action="/admin/categories/add" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Category Name</label>
                    <input type="text" name="name" required placeholder="e.g. Pop-up Store"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">URL Slug</label>
                    <input type="text" name="slug" required placeholder="e.g. pop-up-store"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Badge Color Theme</label>
                    <select name="badge_color" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                        <option value="pink">Pink</option>
                        <option value="purple">Purple</option>
                        <option value="indigo">Indigo</option>
                        <option value="emerald">Emerald</option>
                    </select>
                </div>
                <button type="submit" class="w-full py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs shadow hover:bg-slate-800">
                    Add Category
                </button>
            </form>
        </div>

        <!-- Categories Table -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4">Existing Categories</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-700">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px]">
                        <tr>
                            <th class="p-3">ID</th>
                            <th class="p-3">Name</th>
                            <th class="p-3">Slug</th>
                            <th class="p-3">Events</th>
                            <th class="p-3 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% categories.forEach(function(c) { %>
                            <tr>
                                <td class="p-3 font-mono font-bold text-slate-400">#<%= c.id %></td>
                                <td class="p-3 font-bold text-slate-900"><%= c.name %></td>
                                <td class="p-3 font-mono text-slate-500"><%= c.slug %></td>
                                <td class="p-3 font-bold text-pink-600"><%= c.event_count || 0 %></td>
                                <td class="p-3 text-right">
                                    <form action="/admin/categories/delete" method="POST" onsubmit="return confirm('Delete category?')" class="inline">
                                        <input type="hidden" name="id" value="<%= c.id %>">
                                        <button type="submit" class="p-1.5 text-rose-500 hover:text-rose-700">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
