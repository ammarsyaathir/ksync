<%- include('partials/header', { title: 'My Saved Events | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 pb-6 border-b border-slate-200/80 gap-4">
        <div>
            <div class="flex items-center space-x-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200">
                    <i class="fas fa-bookmark me-1 text-pink-500"></i> Fan Saved Events
                </span>
            </div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight flex items-center">
                My Saved Events
            </h1>
            <p class="text-slate-600 text-sm mt-1 font-medium">Track upcoming schedules, live countdowns, and organizer updates for saved events.</p>
        </div>
        <span class="px-4 py-2 rounded-2xl text-xs font-bold bg-slate-900 text-white shadow-sm flex items-center shrink-0 self-start md:self-auto">
            <i class="fas fa-heart me-2 text-rose-400"></i> <%= saved_events.length %> Saved Event(s)
        </span>
    </div>

    <% if (saved_events.length === 0) { %>
        <div class="bg-white rounded-3xl p-12 text-center max-w-lg mx-auto my-12 border border-slate-200 shadow-sm">
            <div class="w-16 h-16 rounded-full bg-pink-50 text-pink-500 flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="far fa-bookmark"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">No Saved Events Yet</h3>
            <p class="text-slate-500 text-xs mb-6 font-medium">Discover upcoming concerts, fan meetings, and cupsleeve events and save them here for quick countdown tracking.</p>
            <a href="/events" class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md transition-all inline-block">
                Discover K-Pop Events
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% saved_events.forEach(function(event) { %>
                <% const calcStatus = helpers.getCalculatedEventStatus(event); %>
                <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-all">
                    <div class="relative h-44 overflow-hidden bg-slate-100">
                        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                             class="w-full h-full object-cover"
                             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>
                        <div class="absolute top-3 left-3 flex gap-1 z-10">
                            <%- helpers.getStatusBadge(calcStatus) %>
                        </div>
                        <div class="absolute top-3 right-3 z-10">
                            <button onclick="removeSaved(<%= event.id %>)" title="Remove from bookmarks"
                                    class="w-8 h-8 rounded-full bg-white/90 text-rose-500 hover:bg-rose-500 hover:text-white flex items-center justify-center text-xs shadow transition-all cursor-pointer">
                                <i class="fas fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </div>
                    <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                        <div>
                            <div class="text-xs font-bold text-purple-600 mb-1"><%= event.artist_name || 'Various Artists' %></div>
                            <h3 class="text-base font-bold text-slate-900 line-clamp-2">
                                <a href="<%= helpers.getEventUrl(event) %>" class="hover:text-pink-600 transition-colors">
                                    <%= event.event_name %>
                                </a>
                            </h3>
                        </div>
                        <div class="text-xs text-slate-500 space-y-1">
                            <div><i class="far fa-calendar me-1.5 text-pink-500"></i> <%= helpers.formatDate(event.event_date) %></div>
                            <div><i class="fas fa-location-dot me-1.5 text-rose-500"></i> <%= event.venue_name %>, <%= event.city %></div>
                        </div>
                        <div class="pt-3 border-t border-slate-100 flex justify-end">
                            <a href="<%= helpers.getEventUrl(event) %>" class="px-4 py-1.5 rounded-xl bg-pink-50 text-pink-700 font-bold text-xs hover:bg-pink-600 hover:text-white transition-all">
                                View Event Details &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
    function removeSaved(eventId) {
        window.showConfirmModal({
            title: 'Remove Bookmark',
            message: 'Remove this event from your saved bookmarks?',
            confirmText: 'Remove Bookmark',
            confirmType: 'danger',
            onConfirm: async function() {
                try {
                    const res = await fetch(`/api/events/${eventId}/save`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (data.status === 'success') {
                        window.showToast({ message: 'Event removed from bookmarks.', type: 'info' });
                        setTimeout(() => location.reload(), 500);
                    }
                } catch (e) {
                    console.error(e);
                }
            }
        });
    }
</script>

<%- include('partials/footer') %>
