<%- include('partials/header', { title: 'Sign In with Email OTP | K-Sync Malaysia' }) %>

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl space-y-6">
        <div class="text-center">
            <div class="w-14 h-14 rounded-2xl bg-purple-50 border border-purple-200 text-purple-600 flex items-center justify-center text-2xl mx-auto mb-3 shadow-xs">
                <i class="fas fa-key"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Sign In with Email OTP</h1>
            <p class="text-xs text-slate-500 mt-1.5 font-medium leading-relaxed">
                Passwordless authentication for Organizers & Fans.<br>
                Enter your registered email to receive a secure 6-digit code.
            </p>
        </div>

        <form action="/request-login-otp" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Your Registered Email Address</label>
                <div class="relative">
                    <i class="fas fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="email" name="email" required autofocus placeholder="e.g. organizer@ksync.my or fan@ksync.my"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-400">
                </div>
            </div>

            <button type="submit" class="w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-xl text-xs font-extrabold shadow-md shadow-purple-500/20 transition-all cursor-pointer flex items-center justify-center gap-2">
                <span>Send 6-Digit Sign In Code</span>
                <i class="fas fa-arrow-right text-[11px]"></i>
            </button>
        </form>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <a href="/login" class="text-slate-500 hover:text-slate-800 font-bold transition-colors">
                &larr; Standard Password Sign In
            </a>
            <a href="/register" class="text-pink-600 hover:underline font-extrabold">
                Register New Account
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
