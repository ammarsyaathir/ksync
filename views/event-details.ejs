<%- include('partials/header', { title: event.event_name + ' | K-Sync Malaysia' }) %>

<% 
    const calcStatus = helpers.getCalculatedEventStatus(event);
    const isSaved = isSavedEvent;
    const userObj = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
    
    // Calendar URL generation
    const rawDate = (event.event_date instanceof Date) 
        ? event.event_date.toISOString().split('T')[0] 
        : String(event.event_date || '');
    const dateFormatted = rawDate.replace(/-/g, '');
    const startTimeFormatted = String(event.start_time || '18:00:00').replace(/:/g, '').substring(0, 4) + '00';
    const endTimeFormatted = String(event.end_time || '22:00:00').replace(/:/g, '').substring(0, 4) + '00';
    const gCalDates = `${dateFormatted}T${startTimeFormatted}/${dateFormatted}T${endTimeFormatted}`;
    const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.event_name)}&dates=${gCalDates}&details=${encodeURIComponent(event.description || 'K-Pop Event in Malaysia')}&location=${encodeURIComponent(event.venue_name + ', ' + event.city)}`;
    const mapQuery = encodeURIComponent(`${event.venue_name} ${event.address || ''} ${event.city} Malaysia`);
%>

<!-- Banner Header -->
<div class="relative bg-gradient-to-b from-pink-100/70 via-purple-50/40 to-slate-50 border-b border-pink-100">
    <div class="h-64 sm:h-80 w-full relative overflow-hidden bg-slate-900">
        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
             class="w-full h-full object-cover opacity-60 blur-xs scale-105"
             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
        
        <div class="absolute bottom-6 left-0 right-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
            <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-white text-slate-900 shadow">
                    <%= event.category_name || 'Event' %>
                </span>
                <%- helpers.getStatusBadge(calcStatus) %>
                <%- helpers.getVerificationBadge(event.verification_status) %>
                <% const trust = (event.trust_level || '').toUpperCase(); %>
                <% if (trust === 'OFFICIAL') { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500 text-white shadow-sm flex items-center gap-1.5 border border-emerald-400">
                        <i class="fas fa-shield-halved text-amber-300"></i> Verified – Official Source
                    </span>
                <% } else if (trust === 'COMMUNITY') { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-purple-600 text-white shadow-sm flex items-center gap-1.5 border border-purple-400">
                        <i class="fas fa-users text-pink-300"></i> Verified – Community Event
                    </span>
                <% } %>
            </div>
            <% if (event.verification_status === 'SUSPENDED') { %>
                <div class="mb-3 p-3.5 rounded-2xl bg-rose-600/95 text-white text-xs font-medium flex items-center gap-2.5 backdrop-blur-md border border-rose-400 shadow-lg">
                    <i class="fas fa-triangle-exclamation text-amber-300 text-lg shrink-0"></i>
                    <div>
                        <span class="font-extrabold uppercase tracking-wide">⚠️ Listing Frozen by Moderation:</span>
                        This listing is currently suspended following a community report. Ticket purchases are halted while evidence is verified with organizers.
                    </div>
                </div>
            <% } %>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-2 leading-tight">
                <%= event.event_name %>
            </h1>
            <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-200 font-medium">
                <span class="flex items-center"><i class="fas fa-microphone-lines me-1.5 text-pink-400"></i> <%= event.artist_name || 'Multiple Artists' %></span>
                <span class="flex items-center"><i class="fas fa-calendar-day me-1.5 text-purple-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                <span class="flex items-center"><i class="fas fa-location-dot me-1.5 text-rose-400"></i> <%= event.venue_name %>, <%= event.city %></span>
            </div>
        </div>
    </div>
</div>

<!-- Main Details Layout -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left 2 Cols: Countdown, Action Bar, Description, Checklist, Biodata, Live Chat -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Live Countdown To Event Card -->
            <% if (calcStatus === 'UPCOMING') { %>
                <div class="p-6 rounded-3xl bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 shadow-lg text-white">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <p class="text-xs font-black flex items-center text-pink-100 uppercase tracking-wider mb-1">
                                <i class="fas fa-stopwatch me-2 text-white animate-pulse"></i> Live Event Countdown
                            </p>
                            <h3 class="text-lg font-extrabold text-white">Get Ready for <%= event.artist_name || 'the Show' %>!</h3>
                        </div>
                        <div id="countdown-timer" class="grid grid-cols-4 gap-2 text-center shrink-0">
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-days" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Days</span>
                            </div>
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-hours" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Hours</span>
                            </div>
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-minutes" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Mins</span>
                            </div>
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-seconds" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Secs</span>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Action Bar (Bookmark, Share, Calendar, Report, Official Link) -->
            <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2.5">
                    <button onclick="toggleSaveEvent(<%= event.id %>, this)" 
                            class="px-4 py-2.5 rounded-xl border <%= isSaved ? 'bg-rose-50 text-rose-600 border-rose-200' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50' %> font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer">
                        <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart me-1.5 text-rose-500"></i>
                        <span><%= isSaved ? 'Saved' : 'Save Event' %></span>
                    </button>
                    
                    <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                    <button onclick="openShareModal('<%= event.event_name.replace(/'/g, "\\'") %>', '<%= eventSlug %>')" 
                            class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer">
                        <i class="fas fa-share-nodes me-1.5 text-pink-500"></i>
                        <span>Share</span>
                    </button>

                    <a href="<%= gCalUrl %>" target="_blank" rel="noopener" 
                       class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center shadow-xs transition-all"
                       title="Add to Google Calendar">
                        <i class="far fa-calendar-plus me-1.5 text-purple-600"></i>
                        <span>Add to Calendar</span>
                    </a>

                    <button onclick="openReportModal()" 
                            class="px-3.5 py-2.5 rounded-xl border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-600 font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer"
                            title="File a verified community report regarding tickets, scam, or inaccurate info">
                        <i class="fas fa-flag text-amber-500 me-1.5"></i>
                        <span>Report Listing</span>
                    </button>
                </div>

                <% if (event.official_url && event.verification_status !== 'SUSPENDED') { %>
                    <a href="<%= event.official_url %>" target="_blank" rel="noopener" 
                       class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md flex items-center">
                        <i class="fas fa-ticket me-2 text-pink-400"></i> Official Ticket Link &rarr;
                    </a>
                <% } else if (event.verification_status === 'SUSPENDED') { %>
                    <span class="px-5 py-2.5 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs border border-slate-200 flex items-center cursor-not-allowed">
                        <i class="fas fa-lock me-2 text-rose-500"></i> Ticket Links Disabled
                    </span>
                <% } %>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
                    <i class="fas fa-circle-info text-pink-600 me-2.5"></i> Event Overview
                </h2>
                <div class="text-sm text-slate-600 leading-relaxed space-y-4 whitespace-pre-line font-normal">
                    <%= event.description || 'No detailed description provided for this event.' %>
                </div>
            </div>

            <!-- Ticket Info & Rules -->
            <% if (event.ticket_info || event.event_rules) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
                    <% if (event.ticket_info) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center">
                                <i class="fas fa-tags text-purple-600 me-2"></i> Ticket Tiers & Prices
                            </h3>
                            <div class="text-xs text-slate-600 bg-purple-50/50 p-4 rounded-2xl border border-purple-100 whitespace-pre-line leading-relaxed">
                                <%= event.ticket_info %>
                            </div>
                        </div>
                    <% } %>

                    <% if (event.event_rules) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center">
                                <i class="fas fa-shield-halved text-pink-600 me-2"></i> Guidelines, Prohibited Items & Rules
                            </h3>
                            <div class="text-xs text-slate-600 bg-pink-50/50 p-4 rounded-2xl border border-pink-100 whitespace-pre-line leading-relaxed">
                                <%= event.event_rules %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Concert Day Survival & Fan Prep Checklist Card -->
            <div class="bg-gradient-to-b from-emerald-50/50 via-white to-white rounded-3xl p-6 sm:p-8 border border-emerald-200/90 shadow-sm space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-4 gap-2">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 flex items-center">
                            <i class="fas fa-clipboard-check text-emerald-600 me-2.5"></i> Concert Day Survival Checklist
                        </h3>
                        <p class="text-xs text-slate-500 mt-1">Interactive checklist for attendees. Items are automatically saved to your browser.</p>
                    </div>
                    <span id="checklist-count-label" class="text-xs font-bold px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full self-start sm:self-auto">
                        0 / 7 Prepared (0%)
                    </span>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div id="checklist-progress-bar" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>

                <!-- Checklist Items -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_ticket">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-ticket text-amber-500 me-1.5"></i> E-Ticket / Wristband Barcode</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Screenshot or save PDF offline on your phone.</span>
                        </div>
                    </label>

                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_nric">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-id-card text-indigo-500 me-1.5"></i> NRIC / Passport ID</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Required for identity verification at entry gates.</span>
                        </div>
                    </label>

                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_lightstick">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-wand-sparkles text-pink-500 me-1.5"></i> Official Lightstick + Batteries</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Bring 3x fresh AAA batteries (load them before entering).</span>
                        </div>
                    </label>

                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_powerbank">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-battery-three-quarters text-emerald-500 me-1.5"></i> Power Bank (&lt; 20,000mAh)</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Keep phone charged for concert clips and Grab ride home.</span>
                        </div>
                    </label>

                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_bag">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-bag-shopping text-purple-500 me-1.5"></i> Compact Bag (Max A4 Size)</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Most Malaysian arenas ban large backpacks at security.</span>
                        </div>
                    </label>

                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_shoes">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-shoe-prints text-amber-600 me-1.5"></i> Comfortable Shoes</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Expect 2–4 hours of standing in queue and pit zones.</span>
                        </div>
                    </label>

                    <label class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-start space-x-3 cursor-pointer hover:border-emerald-300 transition-all shadow-xs group sm:col-span-2">
                        <input type="checkbox" onchange="updateChecklistProgress()" class="chk-item rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 mt-0.5" data-id="e_<%= event.id %>_transit">
                        <div class="text-xs font-bold text-slate-800">
                            <span class="block group-hover:text-emerald-700 transition-colors"><i class="fas fa-route text-rose-500 me-1.5"></i> Public Transit / Grab Route Planned</span>
                            <span class="text-[10px] text-slate-400 font-normal block mt-0.5">Check LRT extension hours or pre-agree on designated pickup point.</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Idol Group Members & Biodata (Same Table 'artists.members') -->
            <% if (typeof members !== 'undefined' && members && members.length > 0) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-slate-100 gap-2">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900 flex items-center">
                                <i class="fas fa-users-viewfinder text-purple-600 me-2.5"></i> 
                                <%= event.artist_name %> Member Profiles & Biodata
                            </h2>
                            <p class="text-xs text-slate-500 mt-1">
                                Essential personal and career details for <%= event.artist_name %> members.
                            </p>
                        </div>
                        <span class="self-start sm:self-auto px-3.5 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                            <%= members.length %> <%= members.length === 1 ? 'Idol' : 'Group Members' %>
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% members.forEach(function(member) { %>
                            <div class="bg-slate-50/70 hover:bg-white rounded-2xl p-4 border border-slate-200/80 hover:border-purple-300 hover:shadow-md transition-all group">
                                <div class="flex items-start gap-3.5">
                                    <div class="w-16 h-16 rounded-2xl overflow-hidden bg-slate-200 flex-shrink-0 border-2 border-white shadow-sm">
                                        <img src="<%= member.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop' %>" 
                                             alt="<%= member.stage_name %>" 
                                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between gap-1 mb-0.5">
                                            <h4 class="text-base font-extrabold text-slate-900 truncate"><%= member.stage_name %></h4>
                                            <% if (member.mbti) { %>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-pink-100 text-pink-700 uppercase tracking-wider flex-shrink-0">
                                                    <%= member.mbti %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-slate-500 font-medium truncate mb-1.5"><%= member.birth_name %></p>
                                        <div class="text-[11px] text-purple-700 font-bold bg-purple-50 rounded-lg px-2.5 py-1 inline-block mb-3 border border-purple-100">
                                            <%= member.position %>
                                        </div>
                                        
                                        <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] text-slate-600 border-t border-slate-200/60 pt-2.5">
                                            <div><span class="text-slate-400">DOB:</span> <strong class="text-slate-700"><%= member.dob || '-' %></strong></div>
                                            <div><span class="text-slate-400">Zodiac:</span> <strong class="text-slate-700"><%= member.zodiac || '-' %></strong></div>
                                            <div><span class="text-slate-400">Height:</span> <strong class="text-slate-700"><%= member.height || '-' %></strong></div>
                                            <div><span class="text-slate-400">Blood:</span> <strong class="text-slate-700"><%= member.blood_type || '-' %></strong></div>
                                            <div class="col-span-2 truncate"><span class="text-slate-400">Nationality:</span> <strong class="text-slate-700"><%= member.nationality || '-' %></strong></div>
                                            <div class="col-span-2 truncate"><span class="text-slate-400">Active:</span> <strong class="text-slate-700"><%= member.years_active || '-' %></strong></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <!-- 24-Hour Event Live Group Chat Room -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900 flex items-center">
                            <i class="fas fa-comments text-pink-600 me-2.5"></i> Event Fan Chat Hub
                        </h2>
                        <p class="text-xs text-slate-500 mt-1">Connect with Malaysian fans attending this show. Closes 24 hours after concert finishes.</p>
                    </div>
                    <% if (isChatLocked) { %>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                            <i class="fas fa-lock me-1"></i> Chat Closed
                        </span>
                    <% } else { %>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping inline-block me-1"></span> Live Chat
                        </span>
                    <% } %>
                </div>

                <!-- Messages Stream Box -->
                <div id="chat-messages" class="h-80 overflow-y-auto space-y-3 p-4 bg-slate-50 rounded-2xl border border-slate-200 mb-4">
                    <% if (chatMessages.length === 0) { %>
                        <div class="text-center py-12 text-slate-400 text-xs font-medium">
                            No messages yet. Be the first fan to say hi!
                        </div>
                    <% } %>
                    <% chatMessages.forEach(function(msg) { %>
                        <div class="flex items-start space-x-3 <%= userObj && userObj.id === msg.user_id ? 'flex-row-reverse space-x-reverse' : '' %>">
                            <div class="w-8 h-8 rounded-full bg-slate-300 overflow-hidden shrink-0">
                                <% if (msg.profile_image) { %>
                                    <img src="<%= msg.profile_image %>" alt="" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full bg-pink-500 text-white text-xs font-bold flex items-center justify-center">
                                        <%= (msg.full_name || 'F').charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="max-w-xs sm:max-w-md">
                                <div class="text-[10px] text-slate-400 mb-0.5 <%= userObj && userObj.id === msg.user_id ? 'text-right' : '' %>">
                                    <span class="font-bold text-slate-700"><%= msg.full_name %></span>
                                    <% if (msg.is_organizer) { %>
                                        <span class="px-1.5 py-0.2 rounded text-[9px] bg-emerald-100 text-emerald-800 font-bold">Organizer</span>
                                    <% } %>
                                </div>
                                <div class="p-3 rounded-2xl text-xs <%= userObj && userObj.id === msg.user_id ? 'bg-slate-900 text-white rounded-tr-none' : 'bg-white text-slate-800 border border-slate-200 rounded-tl-none shadow-xs' %>">
                                    <%= msg.message %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Message Input -->
                <% if (isChatLocked) { %>
                    <div class="text-center p-3 rounded-xl bg-slate-100 text-xs text-slate-500 font-medium">
                        <i class="fas fa-lock me-1.5"></i> This event chat is permanently closed (24-hour post-event archive window reached).
                    </div>
                <% } else if (userObj) { %>
                    <form id="chat-form" onsubmit="sendChatMessage(event)" class="flex gap-2">
                        <input type="text" id="chat-input" placeholder="Type a message to fellow attendees..." 
                               class="flex-grow bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300">
                        <button type="submit" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                <% } else { %>
                    <div class="text-center p-4 rounded-xl bg-slate-100 text-xs text-slate-600 font-medium">
                        <a href="/login?redirect=/events/<%= event.id %>" class="font-bold text-pink-600 hover:underline">Log in</a> or 
                        <a href="/register" class="font-bold text-slate-900 hover:underline">register</a> to participate in the live event chat.
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Right 1 Col: Event Info Card, Venue Map, Organizer Verification -->
        <div class="space-y-6">
            <!-- Event Schedule & Location Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Event Summary</h3>

                <div class="space-y-4 text-xs">
                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center shrink-0 me-3">
                            <i class="far fa-calendar-check"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Event Date</div>
                            <div class="text-slate-600"><%= helpers.formatDate(event.event_date) %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0 me-3">
                            <i class="far fa-clock"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Start Time</div>
                            <div class="text-slate-600"><%= helpers.formatTime(event.start_time) %> <%= event.end_time ? ' - ' + helpers.formatTime(event.end_time) : '' %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 me-3">
                            <i class="fas fa-location-dot"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900"><%= event.venue_name %></div>
                            <div class="text-slate-600"><%= event.address %>, <%= event.city %>, <%= event.state %></div>
                            <% if (event.map_link) { %>
                                <a href="<%= event.map_link %>" target="_blank" rel="noopener" class="text-pink-600 font-bold hover:underline inline-block mt-1">
                                    <i class="fas fa-arrow-up-right-from-square me-1"></i> Open Google Maps
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Embedded Interactive Google Map in Browser -->
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider flex items-center">
                                <i class="fas fa-map-location-dot text-rose-500 me-1.5"></i> Interactive Venue Map
                            </span>
                            <a href="https://maps.google.com/?q=<%= mapQuery %>" target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold text-pink-600 hover:underline flex items-center">
                                <span>Directions</span> <i class="fas fa-arrow-up-right-from-square ms-1 text-[9px]"></i>
                            </a>
                        </div>
                        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-52 bg-slate-100">
                            <iframe class="w-full h-full border-0" loading="lazy" allowfullscreen 
                                    src="https://maps.google.com/maps?q=<%= mapQuery %>&t=&z=15&ie=UTF8&iwloc=&output=embed">
                            </iframe>
                        </div>
                    </div>
                </div>

                <% if (event.transit_info) { %>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs">
                        <div class="font-bold text-slate-800 mb-1 flex items-center"><i class="fas fa-train text-purple-600 me-1.5"></i> Public Transit Directions</div>
                        <div class="text-slate-600 leading-relaxed"><%= event.transit_info %></div>
                    </div>
                <% } %>
            </div>

            <!-- Organizer / Fanclub Legitimacy Card -->
            <% 
                const displayOrgName = event.promoter_name || event.organization_name || event.submitter_name || (event.organizer_name && event.organizer_name !== 'System Admin' ? event.organizer_name : 'Authorized Tour Production');
                const rawHandle = event.submitter_social || event.social_handle || '';
                const cleanHandle = rawHandle.replace(/^@/, '');
                const orgSocialLink = event.social_url || (rawHandle ? (rawHandle.startsWith('http') ? rawHandle : `https://x.com/${cleanHandle}`) : '');
                const ticketSec = helpers.getTicketingSecurity(event.official_url, displayOrgName);
            %>
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="text-base font-bold text-slate-900 flex items-center">
                        <i class="fas fa-shield-halved text-pink-600 me-2"></i> Organizer Legitimacy
                    </h3>
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full <%= ticketSec.statusClass %>">
                        <i class="fas <%= ticketSec.icon %> me-1"></i> <%= ticketSec.badge %>
                    </span>
                </div>

                <div>
                    <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Host / Promoter</div>
                    <div class="font-extrabold text-base text-slate-900 mt-0.5"><%= displayOrgName %></div>
                    
                    <div class="mt-2.5 flex flex-wrap gap-2">
                        <% if (event.is_verified_organizer === 1 || event.promoter_name) { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-800 border border-emerald-300">
                                <i class="fas fa-certificate text-emerald-500 me-1.5"></i> Verified Entity
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                <i class="fas fa-users text-slate-400 me-1.5"></i> Community Organizer
                            </span>
                        <% } %>

                        <% if (orgSocialLink) { %>
                            <a href="<%= orgSocialLink %>" target="_blank" rel="noopener noreferrer" 
                               class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-pink-50 hover:bg-pink-100 text-pink-700 border border-pink-200 transition-colors">
                                <i class="fab fa-x-twitter me-1.5 text-pink-600"></i> <%= rawHandle || 'Official Profile' %>
                                <i class="fas fa-arrow-up-right-from-square text-[9px] ms-1.5 text-pink-400"></i>
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Anti-Fraud Trust Check -->
                <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 space-y-2 text-[11px] text-slate-600">
                    <div class="font-bold text-slate-800 text-xs flex items-center">
                        <i class="fas fa-circle-check text-emerald-600 me-1.5"></i> Verified Event Safeguards
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-emerald-500 text-[10px] mt-0.5"></i>
                        <span>Ticketing gateway: <strong class="text-slate-800"><%= ticketSec.domain %></strong></span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-emerald-500 text-[10px] mt-0.5"></i>
                        <span>Submitted with verifiable organizer credentials & social handle</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-shield text-purple-500 text-[10px] mt-0.5"></i>
                        <span>Protected by community double-verification reporting system</span>
                    </div>
                </div>
            </div>

            <!-- Official K-Sync Verification & Safety Card (Small Card) -->
            <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 rounded-3xl p-6 text-white shadow-lg space-y-3.5">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-lg">
                        <i class="fas fa-shield-check"></i>
                    </div>
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        <i class="fas fa-circle-check me-1"></i> Verified Event
                    </span>
                </div>
                <div>
                    <h3 class="font-extrabold text-sm text-white">Event Reference ID</h3>
                    <p class="text-[11px] text-slate-300 mt-0.5">Use this reference code to track verified event updates.</p>
                </div>
                <div class="flex items-center justify-between bg-white/10 rounded-xl p-2.5 border border-white/10 font-mono text-xs">
                    <span class="text-pink-300 font-bold tracking-wider"><%= event.tracking_code || 'KS-2026-TXT001' %></span>
                    <button onclick="copyRefCode('<%= event.tracking_code || 'KS-2026-TXT001' %>')" 
                            class="text-[11px] text-slate-300 hover:text-white font-sans font-bold flex items-center cursor-pointer transition-colors">
                        <i class="far fa-copy me-1 text-xs"></i> Copy
                    </button>
                </div>
                <div class="text-[11px] text-slate-300/90 leading-relaxed pt-1 border-t border-white/10 space-y-1">
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-pink-400 text-[10px] mt-0.5"></i>
                        <span>Vetted against official tour promoters</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-ban text-rose-400 text-[10px] mt-0.5"></i>
                        <span>Never buy from unverified social media scalpers</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function toggleInterest(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/interest`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    function openReportModal() {
        <% if (!userObj) { %>
            const authModal = document.getElementById('report-auth-modal');
            if (authModal) {
                authModal.classList.remove('hidden');
                authModal.classList.add('flex');
            }
            return;
        <% } %>
        const modal = document.getElementById('report-modal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }

    function closeReportModal() {
        const modal = document.getElementById('report-modal');
        if (modal) {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
        const authModal = document.getElementById('report-auth-modal');
        if (authModal) {
            authModal.classList.remove('flex');
            authModal.classList.add('hidden');
        }
    }

    function updateReportCharCount() {
        const details = document.getElementById('report-details').value;
        const countSpan = document.getElementById('report-char-count');
        if (countSpan) countSpan.textContent = details.length;
        if (details.length >= 20) {
            countSpan.classList.remove('text-rose-500');
            countSpan.classList.add('text-emerald-600');
        } else {
            countSpan.classList.remove('text-emerald-600');
            countSpan.classList.add('text-rose-500');
        }
    }

    async function submitVerifiedReport(e) {
        e.preventDefault();
        const reason = document.getElementById('report-reason').value;
        const details = document.getElementById('report-details').value.trim();
        const evidence_url = document.getElementById('report-evidence-url').value.trim();
        const declaration = document.getElementById('report-declaration').checked;
        const msgBox = document.getElementById('report-modal-msg');
        const submitBtn = document.getElementById('report-submit-btn');

        if (!reason) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Please select a violation category.</div>';
            return;
        }

        if (details.length < 20) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Detailed explanation must be at least 20 characters.</div>';
            return;
        }

        if (!declaration) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">You must check and agree to the Good-Faith Anti-Defamation Declaration.</div>';
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting...';

        try {
            const res = await fetch(`/api/events/<%= event.id %>/report`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason, details, evidence_url, declaration: true })
            });
            const data = await res.json();

            if (data.status === 'success') {
                msgBox.innerHTML = '<div class="p-4 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200 flex items-center gap-2"><i class="fas fa-circle-check text-emerald-500 text-base"></i> ' + data.message + '</div>';
                setTimeout(() => {
                    closeReportModal();
                    showToast('Report submitted for priority admin review!');
                }, 2200);
            } else if (data.status === 'duplicate') {
                msgBox.innerHTML = '<div class="p-3 rounded-xl bg-amber-50 text-amber-800 text-xs font-bold border border-amber-200"><i class="fas fa-clock me-1 text-amber-500"></i> ' + data.message + '</div>';
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Report';
            } else {
                msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">' + (data.message || 'Error submitting report.') + '</div>';
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Report';
            }
        } catch (err) {
            console.error(err);
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Network error. Please try again.</div>';
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Submit Report';
        }
    }

    async function sendChatMessage(e) {
        e.preventDefault();
        const input = document.getElementById('chat-input');
        const msg = input.value.trim();
        if (!msg) return;

        try {
            const res = await fetch(`/api/chat/<%= event.id %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            const data = await res.json();
            if (data.status === 'success') {
                input.value = '';
                location.reload();
            } else {
                alert(data.message || 'Error sending message');
            }
        } catch (err) {
            console.error(err);
        }
    }

    // Scroll chat to bottom
    const chatBox = document.getElementById('chat-messages');
    if (chatBox) {
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    // Toast Helper
    function showToast(msg) {
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-msg');
        if (toast && toastMsg) {
            toastMsg.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }
    }

    // Share Modal Logic
    function openShareModal(eventName, eventSlug) {
        const origin = window.location.origin;
        const slug = eventSlug || '<%= helpers.slugify(event.event_name) || event.id %>';
        const url = origin + '/events/' + slug;

        if (navigator.share && /mobile|android|iphone/i.test(navigator.userAgent)) {
            navigator.share({
                title: eventName,
                text: 'Check out ' + eventName + ' on K-Sync Malaysia: ' + url,
                url: url
            }).catch(() => {});
            return;
        }

        const modal = document.getElementById('share-modal');
        const content = document.getElementById('share-modal-content');
        document.getElementById('share-url-input').value = url;
        
        const shareText = encodeURIComponent('Check out ' + eventName + ' on K-Sync Malaysia: ' + url);
        document.getElementById('share-wa').href = 'https://api.whatsapp.com/send?text=' + shareText;
        document.getElementById('share-x').href = 'https://twitter.com/intent/tweet?text=' + shareText;
        document.getElementById('share-tg').href = 'https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent('Check out ' + eventName + ' on K-Sync Malaysia');
        document.getElementById('share-fb').href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    // Auto-update browser URL bar from /events/24 to /events/name-of-event
    document.addEventListener('DOMContentLoaded', () => {
        const cleanSlug = '<%= helpers.slugify(event.event_name) || event.id %>';
        if (cleanSlug && !window.location.pathname.endsWith('/' + cleanSlug)) {
            window.history.replaceState({}, '', '/events/' + cleanSlug);
        }
    });

    function closeShareModal() {
        const modal = document.getElementById('share-modal');
        const content = document.getElementById('share-modal-content');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }, 200);
    }

    function copyShareUrl() {
        const input = document.getElementById('share-url-input');
        input.select();
        navigator.clipboard.writeText(input.value);
        showToast('Event link copied to clipboard!');
        const btn = document.getElementById('share-copy-btn');
        btn.innerHTML = '<i class="fas fa-check text-emerald-400"></i>';
        setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
    }

    function copyRefCode(code) {
        navigator.clipboard.writeText(code);
        showToast('Reference code ' + code + ' copied!');
    }

    // Live Countdown Timer
    const eventDateStr = "<%= event.event_date %>";
    const startTimeStr = "<%= event.start_time || '18:00:00' %>";
    const targetTime = new Date(`${eventDateStr}T${startTimeStr}`).getTime();

    function updateCountdown() {
        const now = Date.now();
        const diff = targetTime - now;

        if (diff <= 0) {
            const timerEl = document.getElementById('countdown-timer');
            if (timerEl) {
                timerEl.innerHTML = '<div class="col-span-4 bg-white/20 py-2 px-4 rounded-xl text-xs font-bold">Event Started / Live!</div>';
            }
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        const cdDays = document.getElementById('cd-days');
        const cdHours = document.getElementById('cd-hours');
        const cdMinutes = document.getElementById('cd-minutes');
        const cdSeconds = document.getElementById('cd-seconds');

        if (cdDays) cdDays.textContent = String(days).padStart(2, '0');
        if (cdHours) cdHours.textContent = String(hours).padStart(2, '0');
        if (cdMinutes) cdMinutes.textContent = String(minutes).padStart(2, '0');
        if (cdSeconds) cdSeconds.textContent = String(seconds).padStart(2, '0');
    }

    if (targetTime) {
        updateCountdown();
        setInterval(updateCountdown, 1000);
    }

    // Interactive Checklist Progress & LocalStorage
    function updateChecklistProgress() {
        const items = document.querySelectorAll('.chk-item');
        let checkedCount = 0;

        items.forEach(item => {
            const id = item.getAttribute('data-id');
            if (item.checked) {
                checkedCount++;
                localStorage.setItem(id, '1');
            } else {
                localStorage.removeItem(id);
            }
        });

        const total = items.length;
        const percentage = total > 0 ? Math.round((checkedCount / total) * 100) : 0;

        const label = document.getElementById('checklist-count-label');
        const progressBar = document.getElementById('checklist-progress-bar');

        if (label) label.textContent = `${checkedCount} / ${total} Prepared (${percentage}%)`;
        if (progressBar) progressBar.style.width = `${percentage}%`;
    }

    function loadChecklistState() {
        const items = document.querySelectorAll('.chk-item');
        items.forEach(item => {
            const id = item.getAttribute('data-id');
            if (localStorage.getItem(id) === '1') {
                item.checked = true;
            }
        });
        updateChecklistProgress();
    }

    document.addEventListener('DOMContentLoaded', loadChecklistState);
</script>

<!-- Interactive Share Modal -->
<div id="share-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-100 transform transition-all scale-95 opacity-0 duration-200" id="share-modal-content">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <h3 class="text-lg font-bold text-slate-900 flex items-center">
                <i class="fas fa-share-nodes text-pink-600 me-2.5"></i> Share This Event
            </h3>
            <button onclick="closeShareModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-xs cursor-pointer transition-colors">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <p class="text-xs text-slate-600 mb-4 font-medium">Spread the word to fellow Malaysian K-pop fans!</p>

        <!-- Direct Social Share Buttons -->
        <div class="grid grid-cols-4 gap-3 mb-6">
            <a id="share-wa" href="#" target="_blank" rel="noopener" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 transition-colors group">
                <i class="fab fa-whatsapp text-2xl mb-1 text-emerald-600 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-bold">WhatsApp</span>
            </a>
            <a id="share-x" href="#" target="_blank" rel="noopener" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-900 transition-colors group">
                <i class="fab fa-x-twitter text-2xl mb-1 text-slate-900 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-bold">X (Twitter)</span>
            </a>
            <a id="share-tg" href="#" target="_blank" rel="noopener" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-sky-50 hover:bg-sky-100 text-sky-700 transition-colors group">
                <i class="fab fa-telegram text-2xl mb-1 text-sky-500 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-bold">Telegram</span>
            </a>
            <a id="share-fb" href="#" target="_blank" rel="noopener" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-blue-50 hover:bg-blue-100 text-blue-700 transition-colors group">
                <i class="fab fa-facebook text-2xl mb-1 text-blue-600 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-bold">Facebook</span>
            </a>
        </div>

        <!-- Copy Link Input Box -->
        <div class="relative">
            <input type="text" id="share-url-input" readonly 
                   class="w-full bg-slate-50 border border-slate-200 rounded-2xl py-3 pl-4 pr-24 text-xs text-slate-700 font-mono focus:outline-none">
            <button onclick="copyShareUrl()" id="share-copy-btn"
                    class="absolute right-1.5 top-1.5 bottom-1.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center justify-center transition-all cursor-pointer">
                <span>Copy</span>
            </button>
        </div>
    </div>
</div>

<!-- Multi-Layer Double-Verification Report Modal -->
<div id="report-modal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-100 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <div>
                <h3 class="text-lg font-black text-slate-900 flex items-center">
                    <i class="fas fa-shield-halved text-rose-600 me-2.5"></i> Community Safety Report
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Double-Verification Anti-Scam & Accuracy Audit</p>
            </div>
            <button onclick="closeReportModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-xs cursor-pointer transition-colors">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <form onsubmit="submitVerifiedReport(event)" class="space-y-4">
            <!-- Layer 1: Authenticated User Gate -->
            <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200 flex items-center justify-between text-xs">
                <div>
                    <span class="text-slate-400 font-semibold block text-[10px] uppercase tracking-wider">Layer 1: Verified Identity</span>
                    <span class="font-bold text-slate-800">
                        <i class="fas fa-user-check text-emerald-500 me-1"></i> 
                        <%= userObj ? userObj.username : 'Guest' %> (<%= userObj ? userObj.email : '' %>)
                    </span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">Account Bound</span>
            </div>

            <!-- Layer 2: Violation Classification -->
            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                    Layer 2: Violation Classification <span class="text-rose-500">*</span>
                </label>
                <select id="report-reason" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400 font-medium">
                    <option value="">-- Select Specific Violation Category --</option>
                    <option value="SCAM_TICKETS">🚨 Phishing / Fake Ticket Scalper Link (Attempting to steal money or unofficial resale)</option>
                    <option value="IMPOSTOR_ORGANIZER">🎭 Impostor / Fake Organizer (Unauthorized or fake fanclub identity)</option>
                    <option value="INACCURATE_SCHEDULE">📅 Inaccurate Venue, Date, or Starting Time</option>
                    <option value="CANCELLED_EVENT">🚫 Cancelled or Postponed by Artist Agency</option>
                    <option value="OTHER">⚠️ Other Community Guideline Violation</option>
                </select>
            </div>

            <!-- Layer 3: Counter-Evidence & Detailed Description -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-bold text-slate-800">
                        Layer 3: Detailed Explanation <span class="text-rose-500">*</span>
                    </label>
                    <span class="text-[10px] font-mono font-bold"><span id="report-char-count" class="text-rose-500">0</span> / 20 min characters</span>
                </div>
                <textarea id="report-details" rows="3" required oninput="updateReportCharCount()"
                          placeholder="Explain specifically why this listing is fraudulent or inaccurate. Provide context (minimum 20 characters)..."
                          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400 leading-relaxed"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                    Counter-Evidence Proof URL <span class="text-slate-400 font-normal">(Optional but recommended)</span>
                </label>
                <div class="relative">
                    <input type="url" id="report-evidence-url" 
                           placeholder="https://x.com/official_agency/status/... or venue website"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400">
                </div>
                <p class="text-[10px] text-slate-400 mt-1">Link to official agency tweet, promoter announcement, or cafe cancellation post.</p>
            </div>

            <!-- Layer 4: Good-Faith Anti-Defamation Declaration -->
            <div class="bg-rose-50/60 rounded-2xl p-3.5 border border-rose-200 text-xs">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" id="report-declaration" required class="mt-0.5 rounded text-rose-600 focus:ring-rose-500">
                    <span class="text-[11px] text-rose-900 leading-snug">
                        <strong>Layer 4: Anti-Defamation Declaration:</strong> I declare in good faith that this report contains truthful, verifiable evidence. I acknowledge that submitting false, defamatory, or abusive reports against legitimate fanclubs will result in an immediate permanent ban of my K-Sync account.
                    </span>
                </label>
            </div>

            <div id="report-modal-msg"></div>

            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeReportModal()" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold text-xs">
                    Cancel
                </button>
                <button type="submit" id="report-submit-btn" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md transition-all">
                    Submit Verified Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Authentication Required Notice Modal for Guest Visitors -->
<div id="report-auth-modal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-100 text-center">
        <div class="w-14 h-14 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-2xl mx-auto mb-4">
            <i class="fas fa-lock"></i>
        </div>
        <h3 class="text-lg font-black text-slate-900 mb-1.5">Account Required to Report</h3>
        <p class="text-xs text-slate-600 leading-relaxed mb-6 font-medium">
            To protect genuine K-pop fanclubs and organizers from anonymous spam and competitor sabotage, all community reports require double-verification with a registered K-Sync account.
        </p>
        <div class="space-y-2.5">
            <a href="/login?redirect=/events/<%= event.id %>" class="block w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md">
                Log In to Submit Report
            </a>
            <a href="/register" class="block w-full py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs">
                Create Free Account
            </a>
            <button type="button" onclick="closeReportModal()" class="text-xs text-slate-400 hover:text-slate-600 pt-1 font-semibold">
                Cancel
            </button>
        </div>
    </div>
</div>

<!-- Floating Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-bold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <i class="fas fa-circle-check text-emerald-400"></i>
    <span id="toast-msg">Copied to clipboard!</span>
</div>

<%- include('partials/footer') %>
