<!-- Multi-Layer Double-Verification Report Modal -->
<div id="report-modal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-100 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <div>
                <h3 class="text-lg font-black text-slate-900 flex items-center">
                    <i class="fas fa-shield-halved text-rose-600 me-2.5"></i> Community Safety Report
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Double-Verification Anti-Scam & Accuracy Audit</p>
            </div>
            <button onclick="closeReportModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-xs cursor-pointer transition-colors">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <form onsubmit="submitVerifiedReport(event)" class="space-y-4">
            <!-- Layer 1: Authenticated User Gate -->
            <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200 flex items-center justify-between text-xs">
                <div>
                    <span class="text-slate-400 font-semibold block text-[10px] uppercase tracking-wider">Layer 1: Verified Identity</span>
                    <span class="font-bold text-slate-800">
                        <i class="fas fa-user-check text-emerald-500 me-1"></i> 
                        <%= userObj ? userObj.username : 'Guest' %> (<%= userObj ? userObj.email : '' %>)
                    </span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">Account Bound</span>
            </div>

            <!-- Layer 2: Violation Classification -->
            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                    Layer 2: Violation Classification <span class="text-rose-500">*</span>
                </label>
                <select id="report-reason" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400 font-medium">
                    <option value="">-- Select Specific Violation Category --</option>
                    <option value="SCAM_TICKETS">🚨 Phishing / Fake Ticket Scalper Link (Attempting to steal money or unofficial resale)</option>
                    <option value="IMPOSTOR_ORGANIZER">🎭 Impostor / Fake Organizer (Unauthorized or fake fanclub identity)</option>
                    <option value="INACCURATE_SCHEDULE">📅 Inaccurate Venue, Date, or Starting Time</option>
                    <option value="CANCELLED_EVENT">🚫 Cancelled or Postponed by Artist Agency</option>
                    <option value="OTHER">⚠️ Other Community Guideline Violation</option>
                </select>
            </div>

            <!-- Layer 3: Counter-Evidence & Detailed Description -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-bold text-slate-800">
                        Layer 3: Detailed Explanation <span class="text-rose-500">*</span>
                    </label>
                    <span class="text-[10px] font-mono font-bold"><span id="report-char-count" class="text-rose-500">0</span> / 20 min characters</span>
                </div>
                <textarea id="report-details" rows="3" required oninput="updateReportCharCount()"
                          placeholder="Explain specifically why this listing is fraudulent or inaccurate. Provide context (minimum 20 characters)..."
                          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400 leading-relaxed"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                    Counter-Evidence Proof URL <span class="text-slate-400 font-normal">(Optional but recommended)</span>
                </label>
                <div class="relative">
                    <input type="url" id="report-evidence-url" 
                           placeholder="https://x.com/official_agency/status/... or venue website"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400">
                </div>
                <p class="text-[10px] text-slate-400 mt-1">Link to official agency tweet, promoter announcement, or cafe cancellation post.</p>
            </div>

            <!-- Layer 4: Good-Faith Anti-Defamation Declaration -->
            <div class="bg-rose-50/60 rounded-2xl p-3.5 border border-rose-200 text-xs">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" id="report-declaration" required class="mt-0.5 rounded text-rose-600 focus:ring-rose-500">
                    <span class="text-[11px] text-rose-900 leading-snug">
                        <strong>Layer 4: Anti-Defamation Declaration:</strong> I declare in good faith that this report contains truthful, verifiable evidence. I acknowledge that submitting false, defamatory, or abusive reports against legitimate fanclubs will result in an immediate permanent ban of my K-Sync account.
                    </span>
                </label>
            </div>

            <div id="report-modal-msg"></div>

            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeReportModal()" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold text-xs">
                    Cancel
                </button>
                <button type="submit" id="report-submit-btn" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md transition-all">
                    Submit Verified Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Authentication Required Notice Modal for Guest Visitors -->
<div id="report-auth-modal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-100 text-center">
        <div class="w-14 h-14 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-2xl mx-auto mb-4">
            <i class="fas fa-lock"></i>
        </div>
        <h3 class="text-lg font-black text-slate-900 mb-1.5">Account Required to Report</h3>
        <p class="text-xs text-slate-600 leading-relaxed mb-6 font-medium">
            To protect genuine K-pop fanclubs and organizers from anonymous spam and competitor sabotage, all community reports require double-verification with a registered K-Sync account.
        </p>
        <div class="space-y-2.5">
            <a href="/login?redirect=/events/<%= event.id %>" class="block w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md">
                Log In to Submit Report
            </a>
            <a href="/register" class="block w-full py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs">
                Create Free Account
            </a>
            <button type="button" onclick="closeReportModal()" class="text-xs text-slate-400 hover:text-slate-600 pt-1 font-semibold">
                Cancel
            </button>
        </div>
    </div>
</div>

<!-- Fullscreen Poster Lightbox Modal -->
<div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-2 sm:p-6" onclick="closeLightbox()">
    <div class="relative max-w-5xl max-h-[96vh] w-full flex flex-col items-center justify-center" onclick="event.stopPropagation()">
        <div class="w-full flex items-center justify-between text-white pb-3 px-3">
            <h4 id="lightbox-title" class="text-sm font-extrabold truncate pr-4 text-slate-100 flex items-center">
                <i class="fas fa-image me-2 text-pink-400"></i>
                <span>Official Event Poster</span>
            </h4>
            <div class="flex items-center space-x-2 shrink-0">
                <a id="lightbox-download" href="#" target="_blank" download class="px-3.5 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-bold flex items-center transition-colors">
                    <i class="fas fa-download me-1.5 text-pink-400"></i> Open Original
                </a>
                <button onclick="closeLightbox()" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center text-sm cursor-pointer transition-colors" title="Close (Esc)">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="max-h-[86vh] w-full flex items-center justify-center overflow-auto p-2 bg-slate-950/40 rounded-2xl border border-white/10">
            <img id="lightbox-img" src="" alt="Enlarged Poster" class="max-h-[82vh] w-auto max-w-full object-contain rounded-xl shadow-2xl">
        </div>
    </div>
</div>

<!-- Floating Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-bold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <i class="fas fa-circle-check text-emerald-400"></i>
    <span id="toast-msg">Copied to clipboard!</span>
</div>

<%- include('partials/footer') %>
