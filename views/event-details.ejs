               class="flex items-center justify-between p-4 rounded-2xl bg-violet-50 hover:bg-violet-100 border border-violet-200/80 transition-all group press-tactile">
                <div class="flex items-center space-x-3.5">
                    <div class="w-11 h-11 rounded-xl bg-violet-600 text-white flex items-center justify-center text-lg shadow-sm group-hover:scale-105 transition-transform">
                        <i class="fas fa-mobile-screen-button"></i>
                    </div>
                    <div>
                        <div class="text-xs font-black text-slate-900 flex items-center">
                            <span>Phone / Apple Calendar (.ics)</span>
                            <span class="ms-2 px-2 py-0.5 rounded text-[10px] font-black bg-violet-200 text-violet-800">Native</span>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-0.5">Saves to iOS / Android calendar with 24h & 2h alarms</p>
                    </div>
                </div>
                <i class="fas fa-download text-violet-600 group-hover:translate-y-0.5 transition-transform ms-2"></i>
            </a>

            <!-- Option 2: Google Calendar -->
            <a href="<%= gCalUrl %>" target="_blank" rel="noopener"
               class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-blue-200 transition-all group press-tactile">
                <div class="flex items-center space-x-3.5">
                    <div class="w-11 h-11 rounded-xl bg-white border border-slate-200 text-blue-600 flex items-center justify-center text-lg shadow-xs group-hover:scale-105 transition-transform">
                        <i class="fab fa-google"></i>
                    </div>
                    <div>
                        <div class="text-xs font-black text-slate-900">Google Calendar</div>
                        <p class="text-[11px] text-slate-500 mt-0.5">Syncs directly into Google Calendar app</p>
                    </div>
                </div>
                <i class="fas fa-arrow-up-right-from-square text-slate-400 group-hover:text-blue-600 transition-colors ms-2"></i>
            </a>

            <!-- Option 3: Outlook / Office 365 -->
            <a href="https://outlook.live.com/calendar/0/deeplink/compose?subject=<%= encodeURIComponent(event.event_name) %>&startdt=<%= rawDate %>T<%= startTimeFormatted %>&enddt=<%= rawDate %>T<%= endTimeFormatted %>&location=<%= encodeURIComponent(event.venue_name + ', ' + (event.city || 'Malaysia')) %>&body=<%= encodeURIComponent(event.description || 'K-Pop Concert in Malaysia') %>" 
               target="_blank" rel="noopener"
               class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 hover:bg-sky-50 border border-slate-200 hover:border-sky-200 transition-all group press-tactile">
                <div class="flex items-center space-x-3.5">
                    <div class="w-11 h-11 rounded-xl bg-white border border-slate-200 text-sky-600 flex items-center justify-center text-lg shadow-xs group-hover:scale-105 transition-transform">
                        <i class="fab fa-microsoft"></i>
                    </div>
                    <div>
                        <div class="text-xs font-black text-slate-900">Outlook / Office 365</div>
                        <p class="text-[11px] text-slate-500 mt-0.5">Sync to Microsoft Outlook calendar</p>
                    </div>
                </div>
                <i class="fas fa-arrow-up-right-from-square text-slate-400 group-hover:text-sky-600 transition-colors ms-2"></i>
            </a>
        </div>

        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 text-[11px] text-slate-500 flex items-center gap-2">
            <i class="fas fa-bell text-amber-500 text-xs"></i>
            <span>Includes 2 automated alerts: 1 day before & 2 hours before showtime.</span>
        </div>
    </div>
</div>

<!-- 4-Layer Double-Verification Report Modal -->
<div id="report-modal" class="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-100 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <div>
                <h3 class="text-lg font-black text-slate-900 flex items-center gap-2.5">
                    <i class="fas fa-shield-halved text-rose-600"></i>
                    <span>Community Safety Report</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Double-Verification Anti-Scam & Accuracy Audit</p>
            </div>
            <button onclick="closeReportModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-xs cursor-pointer transition-colors press-tactile">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <form onsubmit="submitVerifiedReport(event)" class="space-y-4">
            <!-- Layer 1: Authenticated Identity Gate -->
            <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200 flex items-center justify-between text-xs">
                <div>
                    <span class="text-slate-400 font-semibold block text-[10px] uppercase tracking-wider">Layer 1: Verified Identity</span>
                    <span class="font-bold text-slate-800">
                        <i class="fas fa-user-check text-emerald-500 me-1"></i> 
                        <%= userObj ? userObj.username : 'Guest' %> (<%= userObj ? userObj.email : '' %>)
                    </span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">Account Bound</span>
            </div>

            <!-- Layer 2: Violation Classification -->
            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                    Layer 2: Violation Classification <span class="text-rose-500">*</span>
                </label>
                <select id="report-reason" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400 font-medium">
                    <option value="">-- Select Specific Violation Category --</option>
                    <option value="SCAM_TICKETS">🚨 Phishing / Fake Ticket Scalper Link (Attempting unofficial resale)</option>
                    <option value="IMPOSTOR_ORGANIZER">🎭 Impostor / Fake Organizer (Unauthorized promoter identity)</option>
                    <option value="INACCURATE_SCHEDULE">📅 Inaccurate Venue, Date, or Starting Time</option>
                    <option value="CANCELLED_EVENT">🚫 Cancelled or Postponed by Artist Agency</option>
                    <option value="OTHER">⚠️ Other Community Guideline Violation</option>
                </select>
            </div>

            <!-- Layer 3: Counter-Evidence & Details -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-bold text-slate-800">
                        Layer 3: Detailed Explanation <span class="text-rose-500">*</span>
                    </label>
                    <span class="text-[10px] font-mono font-bold"><span id="report-char-count" class="text-rose-500">0</span> / 20 min characters</span>
                </div>
                <textarea id="report-details" rows="3" required oninput="updateReportCharCount()"
                          placeholder="Explain specifically why this listing is fraudulent or inaccurate. Provide context (minimum 20 characters)..."
                          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400 leading-relaxed"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                    Counter-Evidence Proof URL <span class="text-slate-400 font-normal">(Optional but recommended)</span>
                </label>
                <div class="relative">
                    <input type="url" id="report-evidence-url" 
                           placeholder="https://x.com/official_agency/status/... or venue website"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-400">
                </div>
                <p class="text-[10px] text-slate-400 mt-1">Link to official agency post, promoter tweet, or venue announcement.</p>
            </div>

            <!-- Layer 4: Good-Faith Anti-Defamation Declaration -->
            <div class="bg-rose-50/60 rounded-2xl p-3.5 border border-rose-200 text-xs">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" id="report-declaration" required class="mt-0.5 rounded text-rose-600 focus:ring-rose-500">
                    <span class="text-[11px] text-rose-900 leading-snug">
                        <strong>Layer 4: Anti-Defamation Declaration:</strong> I declare in good faith that this report contains truthful, verifiable evidence. I acknowledge that submitting false reports against legitimate fan organizers will result in immediate permanent account termination.
                    </span>
                </label>
            </div>

            <div id="report-modal-msg"></div>

            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeReportModal()" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold text-xs press-tactile">
                    Cancel
                </button>
                <button type="submit" id="report-submit-btn" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md transition-all press-tactile">
                    Submit Verified Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Authentication Required Notice Modal for Guest Visitors -->
<div id="report-auth-modal" class="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-100 text-center">
        <div class="w-14 h-14 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-2xl mx-auto mb-4">
            <i class="fas fa-lock"></i>
        </div>
        <h3 class="text-lg font-black text-slate-900 mb-1.5">Account Required to Report</h3>
        <p class="text-xs text-slate-600 leading-relaxed mb-6 font-medium">
            To protect genuine K-pop fan organizers from anonymous spam and competitor sabotage, all community reports require double-verification with a registered K-Sync account.
        </p>
        <div class="space-y-2.5">
            <a href="/login?redirect=/events/<%= eventSlug %>" class="block w-full py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs shadow-md press-tactile">
                Log In to Submit Report
            </a>
            <a href="/register" class="block w-full py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs press-tactile">
                Create Free Account
            </a>
            <button type="button" onclick="closeReportModal()" class="text-xs text-slate-400 hover:text-slate-600 pt-1 font-semibold press-tactile">
                Cancel
            </button>
        </div>
    </div>
</div>

<!-- Floating Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-950 text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-bold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none border border-white/10">
    <i class="fas fa-circle-check text-emerald-400"></i>
    <span id="toast-msg">Copied to clipboard!</span>
</div>

<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function toggleRecommendEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/recommend`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                const badge = document.getElementById('recommendCountBadge');
                const icon = btn.querySelector('i');
                if (badge) badge.textContent = data.count;
                if (data.recommended) {
                    btn.className = "px-4 py-2.5 rounded-xl border bg-amber-50 text-amber-700 border-amber-300 font-extrabold text-xs flex items-center shadow-xs cursor-pointer press-tactile";
                    if (icon) icon.className = "fas fa-thumbs-up me-1.5 text-amber-500";
                    if (badge) badge.className = "ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-amber-200 text-amber-900 font-black";
                } else {
                    btn.className = "px-4 py-2.5 rounded-xl border bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile";
                    if (icon) icon.className = "far fa-thumbs-up me-1.5 text-slate-400";
                    if (badge) badge.className = "ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-200 text-slate-700 font-black";
                }
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function toggleInterest(eventId, btn) {
        return toggleRecommendEvent(eventId, btn);
    }

    function openReportModal() {
        <% if (!userObj) { %>
            const authModal = document.getElementById('report-auth-modal');
            if (authModal) {
                authModal.classList.remove('hidden');
                authModal.classList.add('flex');
            }
            return;
        <% } %>
        const modal = document.getElementById('report-modal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }

    function closeReportModal() {
        const modal = document.getElementById('report-modal');
        if (modal) {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
        const authModal = document.getElementById('report-auth-modal');
        if (authModal) {
            authModal.classList.remove('flex');
            authModal.classList.add('hidden');
        }
    }

    function updateReportCharCount() {
        const details = document.getElementById('report-details').value;
        const countSpan = document.getElementById('report-char-count');
        if (countSpan) countSpan.textContent = details.length;
        if (details.length >= 20) {
            countSpan.classList.remove('text-rose-500');
            countSpan.classList.add('text-emerald-600');
        } else {
            countSpan.classList.remove('text-emerald-600');
            countSpan.classList.add('text-rose-500');
        }
    }

    async function submitVerifiedReport(e) {
        e.preventDefault();
        const reason = document.getElementById('report-reason').value;
        const details = document.getElementById('report-details').value.trim();
        const evidence_url = document.getElementById('report-evidence-url').value.trim();
        const declaration = document.getElementById('report-declaration').checked;
        const msgBox = document.getElementById('report-modal-msg');
        const submitBtn = document.getElementById('report-submit-btn');

        if (!reason) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Please select a violation category.</div>';
            return;
        }

        if (details.length < 20) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Detailed explanation must be at least 20 characters.</div>';
            return;
        }

        if (!declaration) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">You must check and agree to the Good-Faith Anti-Defamation Declaration.</div>';
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting...';

        try {
            const res = await fetch(`/api/events/<%= event.id %>/report`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason, details, evidence_url, declaration: true })
            });
            const data = await res.json();

            if (data.status === 'success') {
                msgBox.innerHTML = '<div class="p-4 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200 flex items-center gap-2"><i class="fas fa-circle-check text-emerald-500 text-base"></i> ' + data.message + '</div>';
                setTimeout(() => {
                    closeReportModal();
                    showToast('Report submitted for priority admin review!');
                }, 2200);
            } else if (data.status === 'duplicate') {
                msgBox.innerHTML = '<div class="p-3 rounded-xl bg-amber-50 text-amber-800 text-xs font-bold border border-amber-200"><i class="fas fa-clock me-1 text-amber-500"></i> ' + data.message + '</div>';
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Report';
            } else {
                msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">' + (data.message || 'Error submitting report.') + '</div>';
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Report';
            }
        } catch (err) {
            console.error(err);
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Network error. Please try again.</div>';
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Submit Report';
        }
    }

    function toggleReplyBox(commentId) {
        const form = document.getElementById(`reply-form-${commentId}`);
        if (!form) return;
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) {
            const textarea = document.getElementById(`reply-input-${commentId}`);
            if (textarea) textarea.focus();
        }
    }

    async function postComment(e, parentId = null) {
        e.preventDefault();
        const inputId = parentId ? `reply-input-${parentId}` : 'main-comment-input';
        const input = document.getElementById(inputId);
        const msg = input ? input.value.trim() : '';
        if (!msg) return;

        const btn = parentId ? e.target.querySelector('button[type="submit"]') : document.getElementById('main-comment-btn');
        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-50');
        }

        try {
            const res = await fetch(`/api/chat/<%= event.id %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, parent_id: parentId })
            });
            const data = await res.json();
            if (data.status === 'success') {
                input.value = '';
                window.location.hash = 'discussion';
                window.location.reload();
            } else {
                alert(data.message || 'Error posting comment');
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-50');
                }
            }
        } catch (err) {
            console.error('Comment submission error:', err);
            alert('Failed to post comment. Please try again.');
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-50');
            }
        }
    }

    async function deleteComment(messageId) {
        if (!confirm('Are you sure you want to delete this comment?')) return;

        try {
            const res = await fetch(`/api/chat/${messageId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'success') {
                const el = document.getElementById(`comment-${messageId}`);
                if (el) {
                    el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    el.style.opacity = '0';
                    el.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        window.location.hash = 'discussion';
                        window.location.reload();
                    }, 250);
                } else {
                    window.location.reload();
                }
            } else {
                alert(data.message || 'Unable to delete comment.');
            }
        } catch (err) {
            console.error('Delete comment error:', err);
            alert('Network error while deleting comment.');
        }
    }

    function showToast(msg) {
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-msg');
        if (toast && toastMsg) {
            toastMsg.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }
    }

    function openShareModal(eventName, eventSlug) {
        const origin = window.location.origin;
        const slug = eventSlug || '<%= eventSlug %>';
        const url = origin + '/events/' + slug;

        if (navigator.share && /mobile|android|iphone/i.test(navigator.userAgent)) {
            navigator.share({
                title: eventName,
                text: 'Check out ' + eventName + ' on K-Sync Malaysia: ' + url,
                url: url
            }).catch(() => {});
            return;
        }

        const modal = document.getElementById('share-modal');
        const content = document.getElementById('share-modal-content');
        document.getElementById('share-url-input').value = url;
        
        const shareText = encodeURIComponent('Check out ' + eventName + ' on K-Sync Malaysia: ' + url);
        document.getElementById('share-wa').href = 'https://api.whatsapp.com/send?text=' + shareText;
        document.getElementById('share-x').href = 'https://twitter.com/intent/tweet?text=' + shareText;
        document.getElementById('share-tg').href = 'https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent('Check out ' + eventName + ' on K-Sync Malaysia');
        document.getElementById('share-fb').href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const cleanSlug = '<%= eventSlug %>';
        if (cleanSlug && !window.location.pathname.endsWith('/' + cleanSlug)) {
            window.history.replaceState({}, '', '/events/' + cleanSlug);
        }
    });

    function closeShareModal() {
        const modal = document.getElementById('share-modal');
        const content = document.getElementById('share-modal-content');
        if (content) {
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
        }
        setTimeout(() => {
            if (modal) {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }
        }, 180);
    }

    function openCalendarModal() {
        const modal = document.getElementById('calendar-modal');
        const content = document.getElementById('calendar-modal-content');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeCalendarModal() {
        const modal = document.getElementById('calendar-modal');
        const content = document.getElementById('calendar-modal-content');
        if (content) {
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
        }
        setTimeout(() => {
            if (modal) {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }
        }, 180);
    }

    function copyShareUrl() {
        const input = document.getElementById('share-url-input');
        input.select();
        navigator.clipboard.writeText(input.value);
        showToast('Concert link copied to clipboard!');
        const btn = document.getElementById('share-copy-btn');
        btn.innerHTML = '<i class="fas fa-check text-emerald-400"></i>';
        setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
    }

    function copyRefCode(code) {
        navigator.clipboard.writeText(code);
        showToast('Reference code ' + code + ' copied!');
    }

    // Live Synchronized Countdown Timer
    const eventDateStr = "<%= event.event_date instanceof Date ? event.event_date.toISOString().split('T')[0] : event.event_date %>";
    const startTimeStr = "<%= event.start_time || '18:00:00' %>";
    const targetTime = new Date(`${eventDateStr}T${startTimeStr}`).getTime();

    function updateCountdown() {
        const now = Date.now();
        const diff = targetTime - now;

        if (diff <= 0) {
            const timerEl = document.getElementById('countdown-timer');
            if (timerEl) {
                timerEl.innerHTML = '<div class="col-span-4 bg-emerald-500/20 text-emerald-300 py-2.5 px-4 rounded-xl text-xs font-black border border-emerald-500/30">Concert Live / Showtime Active!</div>';
            }
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        const cdDays = document.getElementById('cd-days');
        const cdHours = document.getElementById('cd-hours');
        const cdMinutes = document.getElementById('cd-minutes');
        const cdSeconds = document.getElementById('cd-seconds');

        if (cdDays) cdDays.textContent = String(days).padStart(2, '0');
        if (cdHours) cdHours.textContent = String(hours).padStart(2, '0');
        if (cdMinutes) cdMinutes.textContent = String(minutes).padStart(2, '0');
        if (cdSeconds) cdSeconds.textContent = String(seconds).padStart(2, '0');
    }

    if (targetTime && !isNaN(targetTime)) {
        updateCountdown();
        setInterval(updateCountdown, 1000);
    }

    // Lightbox Logic
    function openLightbox(imgSrc, title) {
        const modal = document.getElementById('lightbox-modal');
        if (!modal) return;
        document.getElementById('lightbox-img').src = imgSrc;
        document.getElementById('lightbox-title').querySelector('span').textContent = title || 'Official Event Poster';
        document.getElementById('lightbox-download').href = imgSrc;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        const modal = document.getElementById('lightbox-modal');
        if (!modal) return;
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeLightbox();
            closeShareModal();
            closeCalendarModal();
            closeReportModal();
        }
    });

    // -------------------------------------------------------------------------
    // Official Tour Anthem Audio Preview Engine for Event Details
    // -------------------------------------------------------------------------
    let isDetailsAnthemPlaying = false;
    document.addEventListener('DOMContentLoaded', async () => {
        const artistName = "<%= event.artist_name || '' %>";
        const eventTitle = "<%= event.event_name.replace(/"/g, '\\"') %>";
        if (!artistName) return;

        const titleEl = document.getElementById('details-song-title');
        const albumEl = document.getElementById('details-song-album');
        const artEl = document.getElementById('details-song-art');
        const audio = document.getElementById('details-audio-player');
        const progressEl = document.getElementById('details-song-progress');
        const timeEl = document.getElementById('details-song-current-time');
        const streamLink = document.getElementById('details-stream-link');

        try {
            const res = await fetch(`/api/music/preview?artist=${encodeURIComponent(artistName)}&title=${encodeURIComponent(eventTitle)}`);
            const json = await res.json();
            if (json.status === 'success' && json.data) {
                const anthem = json.data;
                if (titleEl) titleEl.textContent = anthem.trackName;
                if (albumEl) albumEl.textContent = `${anthem.artistName} · ${anthem.collectionName || 'Official Tour Hit'}`;
                if (artEl && anthem.artworkUrl) artEl.src = anthem.artworkUrl;
                if (audio) audio.src = anthem.previewUrl;
                if (streamLink && anthem.trackViewUrl) streamLink.href = anthem.trackViewUrl;

                if (audio) {
                    audio.ontimeupdate = () => {
                        if (audio.duration) {
                            const pct = (audio.currentTime / audio.duration) * 100;
                            if (progressEl) progressEl.style.width = `${pct}%`;
                            const mins = Math.floor(audio.currentTime / 60);
                            const secs = Math.floor(audio.currentTime % 60);
                            if (timeEl) timeEl.textContent = `${mins}:${String(secs).padStart(2, '0')}`;
                        }
                    };
                    audio.onended = () => {
                        isDetailsAnthemPlaying = false;
                        const icon = document.getElementById('details-play-icon');
                        const text = document.getElementById('details-play-text');
                        const bars = document.getElementById('details-audio-bars');
                        if (icon) icon.className = 'fas fa-play text-xs';
                        if (text) text.textContent = 'Play Tour Preview';
                        if (artEl) artEl.classList.remove('animate-spin');
                        if (bars) bars.classList.add('opacity-40');
                        if (progressEl) progressEl.style.width = '0%';
                        if (timeEl) timeEl.textContent = '0:00';
                    };
                }
            }
        } catch (e) {
            console.warn('Could not load tour anthem:', e);
        }
    });

    function toggleDetailsSongPlayback() {
        const audio = document.getElementById('details-audio-player');
        const icon = document.getElementById('details-play-icon');
        const text = document.getElementById('details-play-text');
        const artEl = document.getElementById('details-song-art');
        const bars = document.getElementById('details-audio-bars');
        if (!audio || !audio.src) return;

        if (isDetailsAnthemPlaying) {
            audio.pause();
            isDetailsAnthemPlaying = false;
            if (icon) icon.className = 'fas fa-play text-xs';
            if (text) text.textContent = 'Play Tour Preview';
            if (artEl) artEl.classList.remove('animate-spin');
            if (bars) bars.classList.add('opacity-40');
        } else {
            audio.play().then(() => {
                isDetailsAnthemPlaying = true;
                if (icon) icon.className = 'fas fa-pause text-xs';
                if (text) text.textContent = 'Pause Preview';
                if (artEl) artEl.classList.add('animate-spin');
                if (bars) bars.classList.remove('opacity-40');
            }).catch(e => console.warn('Details audio play error:', e));
        }
    }
</script>

