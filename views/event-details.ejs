<%- include('partials/header', { title: event.event_name + ' | K-Sync Malaysia' }) %>

<% 
    const calcStatus = helpers.getCalculatedEventStatus(event);
    const isSaved = isSavedEvent;
%>

<!-- Banner Header -->
<div class="relative bg-gradient-to-b from-pink-100/70 via-purple-50/40 to-slate-50 border-b border-pink-100">
    <div class="h-64 sm:h-80 w-full relative overflow-hidden bg-slate-900">
        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
             class="w-full h-full object-cover opacity-60 blur-xs scale-105"
             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
        
        <div class="absolute bottom-6 left-0 right-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
            <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-white text-slate-900 shadow">
                    <%= event.category_name || 'Event' %>
                </span>
                <%- helpers.getStatusBadge(calcStatus) %>
                <%- helpers.getVerificationBadge(event.verification_status) %>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-2 leading-tight">
                <%= event.event_name %>
            </h1>
            <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-200 font-medium">
                <span class="flex items-center"><i class="fas fa-microphone-lines me-1.5 text-pink-400"></i> <%= event.artist_name || 'Multiple Artists' %></span>
                <span class="flex items-center"><i class="fas fa-calendar-day me-1.5 text-purple-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                <span class="flex items-center"><i class="fas fa-location-dot me-1.5 text-rose-400"></i> <%= event.venue_name %>, <%= event.city %></span>
            </div>
        </div>
    </div>
</div>

<!-- Main Details Layout -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left 2 Cols: Description, Rules, Updates, Live Chat -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Action Bar (RSVP & Bookmark) -->
            <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <button onclick="toggleSaveEvent(<%= event.id %>, this)" 
                            class="px-5 py-2.5 rounded-xl border <%= isSaved ? 'bg-rose-50 text-rose-600 border-rose-200' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50' %> font-bold text-xs flex items-center shadow-sm transition-all cursor-pointer">
                        <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart me-2 text-rose-500"></i>
                        <span><%= isSaved ? 'Saved to Bookmarks' : 'Save Event' %></span>
                    </button>
                    <button onclick="toggleInterest(<%= event.id %>, this)" 
                            class="px-5 py-2.5 rounded-xl border <%= isInterested ? 'bg-pink-600 text-white border-pink-600' : 'bg-pink-50 text-pink-700 border-pink-200 hover:bg-pink-100' %> font-bold text-xs flex items-center shadow-sm transition-all cursor-pointer">
                        <i class="fas fa-user-plus me-2"></i>
                        <span><%= isInterested ? "I'm Attending!" : 'Join / Going' %></span>
                        <span class="ms-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-white/20"><%= interestCount %></span>
                    </button>
                </div>
                <% if (event.official_url) { %>
                    <a href="<%= event.official_url %>" target="_blank" rel="noopener" 
                       class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md flex items-center">
                        <i class="fas fa-ticket me-2 text-pink-400"></i> Official Ticket Link &rarr;
                    </a>
                <% } %>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
                    <i class="fas fa-circle-info text-pink-600 me-2.5"></i> Event Overview
                </h2>
                <div class="text-sm text-slate-600 leading-relaxed space-y-4 whitespace-pre-line font-normal">
                    <%= event.description || 'No detailed description provided for this event.' %>
                </div>
            </div>

            <!-- Ticket Info & Rules -->
            <% if (event.ticket_info || event.event_rules) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
                    <% if (event.ticket_info) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center">
                                <i class="fas fa-tags text-purple-600 me-2"></i> Ticket Tiers & Prices
                            </h3>
                            <div class="text-xs text-slate-600 bg-purple-50/50 p-4 rounded-2xl border border-purple-100 whitespace-pre-line leading-relaxed">
                                <%= event.ticket_info %>
                            </div>
                        </div>
                    <% } %>

                    <% if (event.event_rules) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center">
                                <i class="fas fa-shield-halved text-pink-600 me-2"></i> Guidelines, Prohibited Items & Rules
                            </h3>
                            <div class="text-xs text-slate-600 bg-pink-50/50 p-4 rounded-2xl border border-pink-100 whitespace-pre-line leading-relaxed">
                                <%= event.event_rules %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Idol Group Members & Biodata (Same Table 'artists.members') -->
            <% if (typeof members !== 'undefined' && members && members.length > 0) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-slate-100 gap-2">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900 flex items-center">
                                <i class="fas fa-users-viewfinder text-purple-600 me-2.5"></i> 
                                <%= event.artist_name %> Member Profiles & Biodata
                            </h2>
                            <p class="text-xs text-slate-500 mt-1">
                                Essential personal and career details for <%= event.artist_name %> members.
                            </p>
                        </div>
                        <span class="self-start sm:self-auto px-3.5 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                            <%= members.length %> <%= members.length === 1 ? 'Idol' : 'Group Members' %>
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% members.forEach(function(member) { %>
                            <div class="bg-slate-50/70 hover:bg-white rounded-2xl p-4 border border-slate-200/80 hover:border-purple-300 hover:shadow-md transition-all group">
                                <div class="flex items-start gap-3.5">
                                    <div class="w-16 h-16 rounded-2xl overflow-hidden bg-slate-200 flex-shrink-0 border-2 border-white shadow-sm">
                                        <img src="<%= member.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop' %>" 
                                             alt="<%= member.stage_name %>" 
                                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between gap-1 mb-0.5">
                                            <h4 class="text-base font-extrabold text-slate-900 truncate"><%= member.stage_name %></h4>
                                            <% if (member.mbti) { %>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-pink-100 text-pink-700 uppercase tracking-wider flex-shrink-0">
                                                    <%= member.mbti %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-slate-500 font-medium truncate mb-1.5"><%= member.birth_name %></p>
                                        <div class="text-[11px] text-purple-700 font-bold bg-purple-50 rounded-lg px-2.5 py-1 inline-block mb-3 border border-purple-100">
                                            <%= member.position %>
                                        </div>
                                        
                                        <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] text-slate-600 border-t border-slate-200/60 pt-2.5">
                                            <div><span class="text-slate-400">DOB:</span> <strong class="text-slate-700"><%= member.dob || '-' %></strong></div>
                                            <div><span class="text-slate-400">Zodiac:</span> <strong class="text-slate-700"><%= member.zodiac || '-' %></strong></div>
                                            <div><span class="text-slate-400">Height:</span> <strong class="text-slate-700"><%= member.height || '-' %></strong></div>
                                            <div><span class="text-slate-400">Blood:</span> <strong class="text-slate-700"><%= member.blood_type || '-' %></strong></div>
                                            <div class="col-span-2 truncate"><span class="text-slate-400">Nationality:</span> <strong class="text-slate-700"><%= member.nationality || '-' %></strong></div>
                                            <div class="col-span-2 truncate"><span class="text-slate-400">Active:</span> <strong class="text-slate-700"><%= member.years_active || '-' %></strong></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <!-- 24-Hour Event Live Group Chat Room -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900 flex items-center">
                            <i class="fas fa-comments text-pink-600 me-2.5"></i> Event Fan Chat Hub
                        </h2>
                        <p class="text-xs text-slate-500 mt-1">Connect with Malaysian fans attending this show. Closes 24 hours after concert finishes.</p>
                    </div>
                    <% if (isChatLocked) { %>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                            <i class="fas fa-lock me-1"></i> Chat Closed
                        </span>
                    <% } else { %>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping inline-block me-1"></span> Live Chat
                        </span>
                    <% } %>
                </div>

                <!-- Messages Stream Box -->
                <div id="chat-messages" class="h-80 overflow-y-auto space-y-3 p-4 bg-slate-50 rounded-2xl border border-slate-200 mb-4">
                    <% if (chatMessages.length === 0) { %>
                        <div class="text-center py-12 text-slate-400 text-xs font-medium">
                            No messages yet. Be the first fan to say hi!
                        </div>
                    <% } %>
                    <% chatMessages.forEach(function(msg) { %>
                        <div class="flex items-start space-x-3 <%= currentUser && currentUser.id === msg.user_id ? 'flex-row-reverse space-x-reverse' : '' %>">
                            <div class="w-8 h-8 rounded-full bg-slate-300 overflow-hidden shrink-0">
                                <% if (msg.profile_image) { %>
                                    <img src="<%= msg.profile_image %>" alt="" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full bg-pink-500 text-white text-xs font-bold flex items-center justify-center">
                                        <%= (msg.full_name || 'F').charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="max-w-xs sm:max-w-md">
                                <div class="text-[10px] text-slate-400 mb-0.5 <%= currentUser && currentUser.id === msg.user_id ? 'text-right' : '' %>">
                                    <span class="font-bold text-slate-700"><%= msg.full_name %></span>
                                    <% if (msg.is_organizer) { %>
                                        <span class="px-1.5 py-0.2 rounded text-[9px] bg-emerald-100 text-emerald-800 font-bold">Organizer</span>
                                    <% } %>
                                </div>
                                <div class="p-3 rounded-2xl text-xs <%= currentUser && currentUser.id === msg.user_id ? 'bg-slate-900 text-white rounded-tr-none' : 'bg-white text-slate-800 border border-slate-200 rounded-tl-none shadow-xs' %>">
                                    <%= msg.message %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Message Input -->
                <% if (isChatLocked) { %>
                    <div class="text-center p-3 rounded-xl bg-slate-100 text-xs text-slate-500 font-medium">
                        <i class="fas fa-lock me-1.5"></i> This event chat is permanently closed (24-hour post-event archive window reached).
                    </div>
                <% } else if (currentUser) { %>
                    <form id="chat-form" onsubmit="sendChatMessage(event)" class="flex gap-2">
                        <input type="text" id="chat-input" placeholder="Type a message to fellow attendees..." 
                               class="flex-grow bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300">
                        <button type="submit" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                <% } else { %>
                    <div class="text-center p-4 rounded-xl bg-slate-100 text-xs text-slate-600 font-medium">
                        <a href="/login?redirect=/events/<%= event.id %>" class="font-bold text-pink-600 hover:underline">Log in</a> or 
                        <a href="/register" class="font-bold text-slate-900 hover:underline">register</a> to participate in the live event chat.
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Right 1 Col: Event Info Card, Venue Map, Organizer Verification -->
        <div class="space-y-6">
            <!-- Event Schedule & Location Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Event Summary</h3>

                <div class="space-y-4 text-xs">
                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center shrink-0 me-3">
                            <i class="far fa-calendar-check"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Event Date</div>
                            <div class="text-slate-600"><%= helpers.formatDate(event.event_date) %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0 me-3">
                            <i class="far fa-clock"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Start Time</div>
                            <div class="text-slate-600"><%= helpers.formatTime(event.start_time) %> <%= event.end_time ? ' - ' + helpers.formatTime(event.end_time) : '' %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 me-3">
                            <i class="fas fa-location-dot"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900"><%= event.venue_name %></div>
                            <div class="text-slate-600"><%= event.address %>, <%= event.city %>, <%= event.state %></div>
                            <% if (event.map_link) { %>
                                <a href="<%= event.map_link %>" target="_blank" rel="noopener" class="text-pink-600 font-bold hover:underline inline-block mt-1">
                                    <i class="fas fa-arrow-up-right-from-square me-1"></i> Google Maps Link
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% if (event.transit_info) { %>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs">
                        <div class="font-bold text-slate-800 mb-1 flex items-center"><i class="fas fa-train text-purple-600 me-1.5"></i> Public Transit Directions</div>
                        <div class="text-slate-600 leading-relaxed"><%= event.transit_info %></div>
                    </div>
                <% } %>
            </div>

            <!-- Organizer / Fanclub Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Organizer Verification</h3>
                <div>
                    <div class="font-bold text-sm text-slate-900"><%= event.organization_name || event.organizer_name || 'Community Event' %></div>
                    <div class="mt-1.5">
                        <%- helpers.getOrganizerBadge({ is_verified_organizer: event.is_verified_organizer, organization_type: event.organization_type, social_handle: event.social_handle }) %>
                    </div>
                    <% if (event.social_url) { %>
                        <a href="<%= event.social_url %>" target="_blank" rel="noopener" class="text-xs text-pink-600 font-bold hover:underline block mt-2">
                            <i class="fab fa-x-twitter me-1"></i> <%= event.social_handle || 'Organizer Social Profile' %>
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- Concert Buddy Match Shortcut -->
            <div class="bg-gradient-to-br from-pink-500 to-purple-600 rounded-3xl p-6 text-white shadow-lg space-y-3">
                <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur-md flex items-center justify-center text-lg">
                    <i class="fas fa-handshake"></i>
                </div>
                <h3 class="font-bold text-base">Looking for a Concert Buddy?</h3>
                <p class="text-xs text-pink-100 leading-relaxed font-medium">Connect with other Carats, ONCEs, or ARMYs attending this show. Match up for carpooling or queueing together!</p>
                <a href="/buddies" class="inline-block px-5 py-2.5 rounded-xl bg-white text-slate-900 font-bold text-xs shadow hover:bg-pink-50 transition-all">
                    Find Event Buddy &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function toggleInterest(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/interest`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function sendChatMessage(e) {
        e.preventDefault();
        const input = document.getElementById('chat-input');
        const msg = input.value.trim();
        if (!msg) return;

        try {
            const res = await fetch(`/api/chat/<%= event.id %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            const data = await res.json();
            if (data.status === 'success') {
                input.value = '';
                location.reload();
            } else {
                alert(data.message || 'Error sending message');
            }
        } catch (err) {
            console.error(err);
        }
    }

    // Scroll chat to bottom
    const chatBox = document.getElementById('chat-messages');
    if (chatBox) {
        chatBox.scrollTop = chatBox.scrollHeight;
    }
</script>

<%- include('partials/footer') %>
