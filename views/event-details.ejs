<%- include('partials/header', { title: event.event_name + ' | K-Sync Malaysia' }) %>

<% 
    const calcStatus = helpers.getCalculatedEventStatus(event);
    const isSaved = isSavedEvent;
    const userObj = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
    
    // Calendar URL generation
    const rawDate = (event.event_date instanceof Date) 
        ? event.event_date.toISOString().split('T')[0] 
        : String(event.event_date || '');
    const dateFormatted = rawDate.replace(/-/g, '');
    const startTimeFormatted = String(event.start_time || '18:00:00').replace(/:/g, '').substring(0, 4) + '00';
    const endTimeFormatted = String(event.end_time || '22:00:00').replace(/:/g, '').substring(0, 4) + '00';
    const gCalDates = `${dateFormatted}T${startTimeFormatted}/${dateFormatted}T${endTimeFormatted}`;
    const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.event_name)}&dates=${gCalDates}&details=${encodeURIComponent(event.description || 'K-Pop Event in Malaysia')}&location=${encodeURIComponent(event.venue_name + ', ' + event.city)}`;
    const mapQuery = encodeURIComponent(`${event.venue_name} ${event.address || ''} ${event.city} Malaysia`);
%>

<!-- Banner Header -->
<div class="relative bg-gradient-to-b from-pink-100/70 via-purple-50/40 to-slate-50 border-b border-pink-100">
    <div class="h-64 sm:h-80 w-full relative overflow-hidden bg-slate-900">
        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
             class="w-full h-full object-cover opacity-60 blur-xs scale-105"
             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
        
        <div class="absolute bottom-6 left-0 right-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
            <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-white text-slate-900 shadow">
                    <%= event.category_name || 'Event' %>
                </span>
                <%- helpers.getStatusBadge(calcStatus) %>
                <%- helpers.getVerificationBadge(event.verification_status) %>
                <% const trust = (event.trust_level || '').toUpperCase(); %>
                <% if (trust === 'OFFICIAL') { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500 text-white shadow-sm flex items-center gap-1.5 border border-emerald-400">
                        <i class="fas fa-shield-halved text-amber-300"></i> Verified – Official Source
                    </span>
                <% } else if (trust === 'COMMUNITY') { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-purple-600 text-white shadow-sm flex items-center gap-1.5 border border-purple-400">
                        <i class="fas fa-users text-pink-300"></i> Verified – Community Event
                    </span>
                <% } %>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/10 backdrop-blur-md text-slate-200 border border-white/20 flex items-center gap-1.5">
                    <i class="fas fa-clock-rotate-left text-pink-400"></i> Updated <%= helpers.timeAgo(event.updated_at || event.created_at) %>
                </span>
            </div>
            <% if (event.verification_status === 'SUSPENDED') { %>
                <div class="mb-3 p-3.5 rounded-2xl bg-rose-600/95 text-white text-xs font-medium flex items-center gap-2.5 backdrop-blur-md border border-rose-400 shadow-lg">
                    <i class="fas fa-triangle-exclamation text-amber-300 text-lg shrink-0"></i>
                    <div>
                        <span class="font-extrabold uppercase tracking-wide">⚠️ Listing Frozen by Moderation:</span>
                        This listing is currently suspended following a community report. Ticket purchases are halted while evidence is verified with organizers.
                    </div>
                </div>
            <% } %>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-2 leading-tight">
                <%= event.event_name %>
            </h1>
            <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-200 font-medium">
                <span class="flex items-center"><i class="fas fa-microphone-lines me-1.5 text-pink-400"></i> <%= event.artist_name || 'Multiple Artists' %></span>
                <span class="flex items-center"><i class="fas fa-calendar-day me-1.5 text-purple-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                <span class="flex items-center">
                    <i class="fas fa-location-dot me-1.5 text-rose-400"></i> <%= event.venue_name %>, <%= event.city %>
                    <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(event.venue_name + ' ' + (event.city || 'Malaysia')) %>" 
                       target="_blank" rel="noopener noreferrer" 
                       class="ms-2 px-2 py-0.5 rounded-lg bg-white/10 hover:bg-white/20 text-pink-300 hover:text-white text-[11px] font-bold border border-white/20 transition-all inline-flex items-center gap-1">
                        <i class="fas fa-map-location-dot text-[10px]"></i> Maps ↗
                    </a>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Main Details Layout -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left 2 Cols: Countdown, Action Bar, Description, Checklist, Biodata, Live Chat -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Live Countdown To Event Card -->
            <% if (calcStatus === 'UPCOMING') { %>
                <div class="p-6 rounded-3xl bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 shadow-lg text-white">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <p class="text-xs font-black flex items-center text-pink-100 uppercase tracking-wider mb-1">
                                <i class="fas fa-stopwatch me-2 text-white animate-pulse"></i> Live Event Countdown
                            </p>
                            <h3 class="text-lg font-extrabold text-white">Get Ready for <%= event.artist_name || 'the Show' %>!</h3>
                        </div>
                        <div id="countdown-timer" class="grid grid-cols-4 gap-2 text-center shrink-0">
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-days" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Days</span>
                            </div>
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-hours" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Hours</span>
                            </div>
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-minutes" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Mins</span>
                            </div>
                            <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-2 border border-white/25 min-w-[62px]">
                                <span id="cd-seconds" class="block text-xl font-black">00</span>
                                <span class="text-[9px] font-bold text-pink-100 uppercase">Secs</span>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Action Bar (Bookmark, Share, Calendar, Report, Official Link) -->
            <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2.5">
                    <button onclick="toggleSaveEvent(<%= event.id %>, this)" 
                            class="px-4 py-2.5 rounded-xl border <%= isSaved ? 'bg-rose-50 text-rose-600 border-rose-200' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50' %> font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer">
                        <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart me-1.5 text-rose-500"></i>
                        <span><%= isSaved ? 'Saved' : 'Save Event' %></span>
                    </button>
                    
                    <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                    <button onclick="openShareModal('<%= event.event_name.replace(/'/g, "\\'") %>', '<%= eventSlug %>')" 
                            class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer">
                        <i class="fas fa-share-nodes me-1.5 text-pink-500"></i>
                        <span>Share</span>
                    </button>

                    <button onclick="openCalendarModal()" 
                            class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer"
                            title="Add to Phone Calendar or Google Calendar">
                        <i class="far fa-calendar-plus me-1.5 text-purple-600"></i>
                        <span>Add to Calendar</span>
                    </button>

                    <button onclick="openReportModal()" 
                            class="px-3.5 py-2.5 rounded-xl border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-600 font-bold text-xs flex items-center shadow-xs transition-all cursor-pointer"
                            title="File a verified community report regarding tickets, scam, or inaccurate info">
                        <i class="fas fa-flag text-amber-500 me-1.5"></i>
                        <span>Report Listing</span>
                    </button>
                </div>

                <% if (event.official_url && event.verification_status !== 'SUSPENDED') { %>
                    <a href="<%= event.official_url %>" target="_blank" rel="noopener" 
                       class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md flex items-center">
                        <i class="fas fa-ticket me-2 text-pink-400"></i> Official Ticket Link &rarr;
                    </a>
                <% } else if (event.verification_status === 'SUSPENDED') { %>
                    <span class="px-5 py-2.5 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs border border-slate-200 flex items-center cursor-not-allowed">
                        <i class="fas fa-lock me-2 text-rose-500"></i> Ticket Links Disabled
                    </span>
                <% } %>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center">
                    <i class="fas fa-circle-info text-pink-600 me-2.5"></i> Event Overview
                </h2>
                <div class="text-sm text-slate-600 leading-relaxed space-y-4 whitespace-pre-line font-normal">
                    <%= event.description || 'No detailed description provided for this event.' %>
                </div>
            </div>

            <!-- Ticket Info & Rules -->
            <% if (event.ticket_info || event.event_rules) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
                    <% if (event.ticket_info) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center">
                                <i class="fas fa-tags text-purple-600 me-2"></i> Ticket Tiers & Prices
                            </h3>
                            <div class="text-xs text-slate-600 bg-purple-50/50 p-4 rounded-2xl border border-purple-100 whitespace-pre-line leading-relaxed">
                                <%= event.ticket_info %>
                            </div>
                        </div>
                    <% } %>

                    <% if (event.event_rules) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2 flex items-center">
                                <i class="fas fa-shield-halved text-pink-600 me-2"></i> Guidelines, Prohibited Items & Rules
                            </h3>
                            <div class="text-xs text-slate-600 bg-pink-50/50 p-4 rounded-2xl border border-pink-100 whitespace-pre-line leading-relaxed">
                                <%= event.event_rules %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Accessibility & Special Facilities (80% Demand in User Research) -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center">
                        <i class="fas fa-universal-access text-pink-600 me-2.5"></i> Accessibility & Special Facilities
                    </h3>
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-pink-50 text-pink-700 border border-pink-200">
                        Fan Inclusivity
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs">
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-2.5">
                        <i class="fas fa-wheelchair text-purple-600 text-base shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-slate-900 block font-bold mb-0.5">OKU / Wheelchair Access</strong>
                            <p class="text-slate-600 leading-relaxed">Dedicated ramp access, accessible passenger lifts, and reserved viewing zones for wheelchair users.</p>
                        </div>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-2.5">
                        <i class="fas fa-bolt-lightning text-amber-500 text-base shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-slate-900 block font-bold mb-0.5">Sensory & Strobe Warning</strong>
                            <p class="text-slate-600 leading-relaxed">Stage performance features sudden loud pyrotechnics, heavy bass, and high-intensity strobe lighting.</p>
                        </div>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-2.5">
                        <i class="fas fa-kit-medical text-rose-500 text-base shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-slate-900 block font-bold mb-0.5">Medical & Assistance</strong>
                            <p class="text-slate-600 leading-relaxed">Certified first-aid paramedical booths on-site and priority seating assistance for expectant mothers.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Official Event Posters & Visual Gallery (Flexible 1-4 Posters: Square, Portrait, Landscape) -->
            <% 
                const eventPosters = (typeof posters !== 'undefined' && posters && posters.length > 0) 
                    ? posters 
                    : [event.poster_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'];
            %>
            <div class="bg-white rounded-3xl p-5 sm:p-7 lg:p-8 border border-slate-200 shadow-sm space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
                    <div>
                        <h3 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center">
                            <i class="fas fa-images text-pink-600 me-2.5"></i> Official Event Posters & Visuals
                        </h3>
                        <p class="text-xs text-slate-500 mt-1">Official high-resolution promotional posters, seating chart, and event guidelines. Click any poster to view full size.</p>
                    </div>
                    <span class="self-start sm:self-auto px-3.5 py-1 rounded-full text-xs font-bold bg-pink-50 text-pink-700 border border-pink-200 shrink-0">
                        <%= eventPosters.length %> <%= eventPosters.length === 1 ? 'Poster' : 'Posters / Notices' %>
                    </span>
                </div>

                <% if (eventPosters.length === 1) { %>
                    <!-- Single Hero Poster (Any Aspect Ratio: Square, Portrait, Landscape) -->
                    <div class="relative bg-slate-950/5 rounded-2xl p-2 sm:p-4 border border-slate-200/80 flex items-center justify-center overflow-hidden group">
                        <img src="<%= eventPosters[0] %>" alt="<%= event.event_name %> Poster"
                             class="max-h-[580px] w-auto max-w-full rounded-xl object-contain shadow-md cursor-pointer hover:scale-[1.01] transition-transform duration-300"
                             onclick="openLightbox('<%= eventPosters[0] %>', '<%= event.event_name.replace(/'/g, "\\'") %>')">
                        <button onclick="openLightbox('<%= eventPosters[0] %>', '<%= event.event_name.replace(/'/g, "\\'") %>')"
                                class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 px-4 py-2 rounded-xl bg-slate-900/80 hover:bg-slate-900 text-white text-xs font-bold backdrop-blur-md flex items-center shadow-lg transition-all cursor-pointer">
                            <i class="fas fa-magnifying-glass-plus me-1.5 text-pink-400"></i> Click to Enlarge
                        </button>
                    </div>
                <% } else { %>
                    <!-- Multi-Poster Gallery Grid (2 to 4 Posters / Seating Map / Notices) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                        <% eventPosters.forEach(function(imgUrl, idx) { %>
                            <div class="relative bg-slate-950/5 rounded-2xl p-3 sm:p-4 border border-slate-200/80 flex flex-col justify-between overflow-hidden group transition-all hover:border-pink-300 hover:shadow-md">
                                <div class="flex items-center justify-between mb-2.5 px-1">
                                    <span class="text-[11px] font-extrabold text-slate-600 uppercase tracking-wider flex items-center">
                                        <i class="fas fa-image me-1.5 text-pink-500"></i>
                                        <%= idx === 0 ? 'Main Official Poster' : (idx === 1 ? 'Notice / Seating Map' : 'Visual #' + (idx + 1)) %>
                                    </span>
                                    <button onclick="openLightbox('<%= imgUrl %>', '<%= event.event_name.replace(/'/g, "\\'") %> - Visual #<%= idx + 1 %>')"
                                            class="text-xs font-bold text-pink-600 hover:text-pink-700 flex items-center cursor-pointer">
                                        <i class="fas fa-expand me-1"></i> Fullscreen
                                    </button>
                                </div>
                                <div class="flex items-center justify-center min-h-[280px] sm:min-h-[340px] max-h-[460px] overflow-hidden rounded-xl bg-white/70 p-2">
                                    <img src="<%= imgUrl %>" alt="<%= event.event_name %> - Visual #<%= idx + 1 %>"
                                         class="max-h-[440px] w-auto max-w-full object-contain rounded-lg shadow-sm cursor-pointer group-hover:scale-[1.02] transition-transform duration-300"
                                         onclick="openLightbox('<%= imgUrl %>', '<%= event.event_name.replace(/'/g, "\\'") %> - Visual #<%= idx + 1 %>')">
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Idol Group Members & Biodata (from the `members` table, FK -> artists.id) -->
            <% if (typeof members !== 'undefined' && members && members.length > 0) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-slate-100 gap-2">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900 flex items-center">
                                <i class="fas fa-users-viewfinder text-purple-600 me-2.5"></i> 
                                <%= event.artist_name %> Member Profiles & Biodata
                            </h2>
                            <p class="text-xs text-slate-500 mt-1">
                                Essential personal and career details for <%= event.artist_name %> members.
                            </p>
                        </div>
                        <span class="self-start sm:self-auto px-3.5 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                            <%= members.length %> <%= members.length === 1 ? 'Idol' : 'Group Members' %>
                        </span>
                    </div>

                    <div class="space-y-3.5">
                        <% members.forEach(function(member) { %>
                            <div class="bg-slate-50/70 hover:bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 hover:border-purple-300 hover:shadow-md transition-all group">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <!-- Left: Photo + Identity -->
                                    <div class="flex items-center gap-3.5 sm:gap-4 md:w-72 shrink-0">
                                        <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl overflow-hidden bg-slate-200 shrink-0 border-2 border-white shadow-sm">
                                            <img src="<%= member.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop' %>" 
                                                 alt="<%= member.stage_name %>" 
                                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2 mb-0.5">
                                                <h4 class="text-base sm:text-lg font-extrabold text-slate-900 truncate"><%= member.stage_name %></h4>
                                                <% if (member.mbti) { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-pink-100 text-pink-700 uppercase tracking-wider shrink-0">
                                                        <%= member.mbti %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-xs text-slate-500 font-medium truncate mb-1"><%= member.birth_name %></p>
                                            <span class="text-[11px] text-purple-700 font-bold bg-purple-50 rounded-lg px-2.5 py-0.5 inline-block border border-purple-100 truncate max-w-full">
                                                <%= member.position %>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Right: 6-cell horizontal biodata chips -->
                                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-xs text-slate-600 md:border-l md:border-slate-200/80 md:ps-6 pt-3 md:pt-0 border-t border-slate-200/60 md:border-t-0 flex-1">
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">DOB</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.dob || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Zodiac</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.zodiac || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Height</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.height || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Blood</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.blood_type || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Nationality</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.nationality || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Active</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.years_active || '-' %></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <!-- Event-Based Community Discussion (1-Level Threaded Q&A Forum) -->
            <div id="discussion" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
                <!-- Discussion Section Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900 flex items-center">
                            <i class="fas fa-comments text-pink-600 me-2.5"></i> Community Discussion
                            <span class="ms-3 px-3 py-0.5 rounded-full text-xs font-extrabold bg-pink-50 text-pink-700 border border-pink-200">
                                <%= totalCommentsCount || (typeof comments !== 'undefined' && comments ? comments.length : (chatMessages ? chatMessages.length : 0)) %> Comments
                            </span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-1">Ask questions, share concert tips, and connect with fellow Malaysian attendees for this event.</p>
                    </div>
                    <% if (isChatLocked) { %>
                        <span class="self-start sm:self-auto px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 shrink-0">
                            <i class="fas fa-lock me-1"></i> Discussion Archived
                        </span>
                    <% } else { %>
                        <span class="self-start sm:self-auto px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping inline-block me-1.5"></span> Open Discussion
                        </span>
                    <% } %>
                </div>

                <!-- Community Discussion Safety Guidelines (Requirement R-42) -->
                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs text-slate-500 flex items-start gap-2.5">
                    <i class="fas fa-shield-halved text-pink-500 text-sm shrink-0 mt-0.5"></i>
                    <div class="leading-relaxed">
                        <strong class="text-slate-800">Community Discussion Guidelines:</strong>
                        Feel free to ask questions and share concert advice. Unofficial ticket reselling, scalping, harassment, and unverified rumors are strictly prohibited and subject to immediate moderation.
                    </div>
                </div>

                <!-- Input Box (Posting Area) -->
                <% if (isChatLocked) { %>
                    <div class="p-4 rounded-2xl bg-slate-100 text-xs text-slate-500 font-medium flex items-center gap-2">
                        <i class="fas fa-lock text-slate-400"></i> This discussion is archived (24-hour post-event archive window reached). All past questions and answers remain visible for reference.
                    </div>
                <% } else if (userObj) { %>
                    <form id="main-comment-form" onsubmit="postComment(event, null)" class="bg-slate-50/80 p-4 sm:p-5 rounded-2xl border border-slate-200/80 space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="w-9 h-9 rounded-full bg-pink-100 text-pink-700 font-extrabold text-xs flex items-center justify-center shrink-0 border border-pink-200 overflow-hidden">
                                <% if (userObj.profile_image) { %>
                                    <img src="<%= userObj.profile_image %>" alt="" class="w-full h-full object-cover">
                                <% } else { %>
                                    <%= (userObj.full_name || userObj.username || 'U').charAt(0).toUpperCase() %>
                                <% } %>
                            </div>
                            <div class="flex-1">
                                <textarea id="main-comment-input" rows="3" 
                                          placeholder="Write a comment or question about this event (e.g. transport, venue guidelines, merchandise, fan chants)..." 
                                          required
                                          class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent transition-all resize-y"></textarea>
                            </div>
                        </div>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-[11px] text-slate-400 flex items-center gap-1.5">
                                <i class="fas fa-circle-info text-pink-500"></i> Be respectful and helpful to fellow fans
                            </span>
                            <button type="submit" id="main-comment-btn" 
                                    class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-2 cursor-pointer">
                                <i class="fas fa-paper-plane text-pink-400"></i> Post Comment
                            </button>
                        </div>
                    </form>
                <% } else { %>
                    <div class="p-5 rounded-2xl bg-gradient-to-r from-pink-50/80 via-purple-50/50 to-indigo-50/80 border border-pink-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <div class="w-10 h-10 rounded-xl bg-pink-100 text-pink-600 flex items-center justify-center shrink-0 shadow-2xs">
                                <i class="fas fa-comments text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-xs font-bold text-slate-900">Join the Community Discussion</h4>
                                <p class="text-[11px] text-slate-500">Please log in or create an account to post questions and share tips with other attendees.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5 shrink-0">
                            <a href="/login?redirect=/events/<%= event.id %>#discussion" 
                               class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 text-xs font-bold transition-all shadow-2xs">
                                Log In
                            </a>
                            <a href="/register" 
                               class="px-4 py-2 rounded-xl bg-pink-600 hover:bg-pink-700 text-white text-xs font-bold transition-all shadow-2xs">
                                Register
                            </a>
                        </div>
                    </div>
                <% } %>

                <!-- The Comment Thread (1-Level Nested) -->
                <% 
                    const threadList = (typeof comments !== 'undefined' && comments) ? comments : []; 
                %>
                <div class="space-y-5 pt-2">
                    <% if (threadList.length === 0) { %>
                        <div class="text-center py-12 text-slate-400 text-xs font-medium bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
                            <i class="fas fa-comment-dots text-3xl mb-2 text-slate-300 block"></i>
                            No comments or questions yet. Be the first fan to start the discussion!
                        </div>
                    <% } else { %>
                        <% threadList.forEach(function(comment) { %>
                            <% 
                                const isCommentAuthor = userObj && userObj.id === comment.user_id;
                                const isAdmin = userObj && (userObj.role || '').toUpperCase() === 'ADMIN';
                                const isSubmitter = (event.organizer_id && comment.user_id === event.organizer_id) || Boolean(comment.is_organizer);
                                const isCommentAdmin = (comment.role || '').toUpperCase() === 'ADMIN';
                            %>
                            <div id="comment-<%= comment.id %>" class="bg-slate-50/60 hover:bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200/80 transition-all">
                                <!-- Main Comment Header -->
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-slate-200 text-slate-700 font-extrabold text-xs flex items-center justify-center shrink-0 border border-slate-300/80 overflow-hidden">
                                            <% if (comment.profile_image) { %>
                                                <img src="<%= comment.profile_image %>" alt="" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <%= (comment.username || comment.full_name || 'F').charAt(0).toUpperCase() %>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex flex-wrap items-center gap-1.5">
                                                <span class="text-xs font-extrabold text-slate-900 truncate">
                                                    <%= comment.username || comment.full_name %>
                                                </span>
                                                <% if (isSubmitter) { %>
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-pink-100 text-pink-700 border border-pink-200 flex items-center gap-1">
                                                        <i class="fas fa-star text-[9px] text-pink-500"></i> Event Submitter
                                                    </span>
                                                <% } %>
                                                <% if (isCommentAdmin) { %>
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-purple-100 text-purple-700 border border-purple-200 flex items-center gap-1">
                                                        <i class="fas fa-shield text-[9px] text-purple-500"></i> Admin
                                                    </span>
                                                <% } %>
                                                <span class="text-slate-400 text-[11px] font-normal">
                                                    • <%= helpers.timeAgo(comment.created_at) %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Delete Action for Author or Admin -->
                                    <% if (isCommentAuthor || isAdmin) { %>
                                        <button onclick="deleteComment(<%= comment.id %>)" 
                                                class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition-colors text-xs cursor-pointer" 
                                                title="<%= isAdmin && !isCommentAuthor ? 'Moderate / Delete comment as Admin' : 'Delete your comment' %>">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    <% } %>
                                </div>

                                <!-- Main Comment Body -->
                                <div class="text-xs text-slate-700 leading-relaxed whitespace-pre-line mt-2.5 ps-12">
                                    <%= comment.message %>
                                </div>

                                <!-- Action Controls (Reply Trigger) -->
                                <% if (!isChatLocked && userObj) { %>
                                    <div class="mt-2.5 ps-12 flex items-center gap-4">
                                        <button onclick="toggleReplyBox(<%= comment.id %>)" 
                                                class="text-[11px] font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1 cursor-pointer transition-colors">
                                            <i class="fas fa-reply text-[10px]"></i> Reply
                                        </button>
                                    </div>

                                    <!-- Inline Reply Box (Hidden by default) -->
                                    <form id="reply-form-<%= comment.id %>" 
                                          onsubmit="postComment(event, <%= comment.id %>)" 
                                          class="hidden mt-3 ps-12 space-y-2">
                                        <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs space-y-2">
                                            <textarea id="reply-input-<%= comment.id %>" rows="2" 
                                                      placeholder="Write a reply to <%= comment.username || comment.full_name %>..." 
                                                      required
                                                      class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 resize-y"></textarea>
                                            <div class="flex items-center justify-end gap-2">
                                                <button type="button" onclick="toggleReplyBox(<%= comment.id %>)" 
                                                        class="px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 text-xs font-semibold cursor-pointer">
                                                    Cancel
                                                </button>
                                                <button type="submit" 
                                                        class="px-4 py-1.5 rounded-lg bg-pink-600 hover:bg-pink-700 text-white text-xs font-bold cursor-pointer shadow-2xs">
                                                    Reply
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                <% } %>

                                <!-- 1-Level Nested Direct Replies -->
                                <% if (comment.replies && comment.replies.length > 0) { %>
                                    <div class="mt-3.5 ms-6 sm:ms-12 ps-3 sm:ps-4 border-l-2 border-pink-200 space-y-3">
                                        <% comment.replies.forEach(function(reply) { %>
                                            <% 
                                                const isReplyAuthor = userObj && userObj.id === reply.user_id;
                                                const isReplySubmitter = (event.organizer_id && reply.user_id === event.organizer_id) || Boolean(reply.is_organizer);
                                                const isReplyAdmin = (reply.role || '').toUpperCase() === 'ADMIN';
                                            %>
                                            <div id="comment-<%= reply.id %>" class="bg-white p-3 sm:p-3.5 rounded-xl border border-slate-200/80 shadow-2xs">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <span class="text-pink-400 font-bold text-xs">↳</span>
                                                        <div class="w-7 h-7 rounded-full bg-slate-200 text-slate-700 font-bold text-[11px] flex items-center justify-center shrink-0 border border-slate-300 overflow-hidden">
                                                            <% if (reply.profile_image) { %>
                                                                <img src="<%= reply.profile_image %>" alt="" class="w-full h-full object-cover">
                                                            <% } else { %>
                                                                <%= (reply.username || reply.full_name || 'F').charAt(0).toUpperCase() %>
                                                            <% } %>
                                                        </div>
                                                        <div class="flex flex-wrap items-center gap-1.5">
                                                            <span class="text-xs font-bold text-slate-900">
                                                                <%= reply.username || reply.full_name %>
                                                            </span>
                                                            <% if (isReplySubmitter) { %>
                                                                <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-pink-100 text-pink-700 border border-pink-200">
                                                                    Event Submitter
                                                                </span>
                                                            <% } %>
                                                            <% if (isReplyAdmin) { %>
                                                                <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-purple-100 text-purple-700 border border-purple-200">
                                                                    Admin
                                                                </span>
                                                            <% } %>
                                                            <span class="text-slate-400 text-[10px]">
                                                                • <%= helpers.timeAgo(reply.created_at) %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <% if (isReplyAuthor || isAdmin) { %>
                                                        <button onclick="deleteComment(<%= reply.id %>)" 
                                                                class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors text-xs cursor-pointer" 
                                                                title="Delete reply">
                                                            <i class="fas fa-trash-can text-[10px]"></i>
                                                        </button>
                                                    <% } %>
                                                </div>

                                                <div class="text-xs text-slate-700 leading-relaxed whitespace-pre-line mt-1.5 ps-6">
                                                    <%= reply.message %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right 1 Col: Event Info Card, Venue Map, Organizer Verification -->
        <div class="space-y-6">
            <!-- Event Schedule & Location Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Event Summary</h3>

                <div class="space-y-4 text-xs">
                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center shrink-0 me-3">
                            <i class="far fa-calendar-check"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Event Date</div>
                            <div class="text-slate-600"><%= helpers.formatDate(event.event_date) %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0 me-3">
                            <i class="far fa-clock"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Start Time</div>
                            <div class="text-slate-600"><%= helpers.formatTime(event.start_time) %> <%= event.end_time ? ' - ' + helpers.formatTime(event.end_time) : '' %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 me-3">
                            <i class="fas fa-location-dot"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900"><%= event.venue_name %></div>
                            <% const mapUrl = event.map_link || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(event.venue_name + ' ' + (event.city || 'Malaysia'))); %>
                            <a href="<%= mapUrl %>" target="_blank" rel="noopener noreferrer" class="text-pink-600 font-bold hover:underline inline-flex items-center gap-1 mt-1.5">
                                <i class="fas fa-arrow-up-right-from-square text-[10px]"></i> Open in Google Maps ↗
                            </a>
                        </div>
                    </div>

                    <!-- Embedded Interactive Google Map in Browser -->
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider flex items-center">
                                <i class="fas fa-map-location-dot text-rose-500 me-1.5"></i> Interactive Venue Map
                            </span>
                            <a href="https://maps.google.com/?q=<%= mapQuery %>" target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold text-pink-600 hover:underline flex items-center">
                                <span>Directions</span> <i class="fas fa-arrow-up-right-from-square ms-1 text-[9px]"></i>
                            </a>
                        </div>
                        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-52 bg-slate-100">
                            <iframe class="w-full h-full border-0" loading="lazy" allowfullscreen 
                                    src="https://maps.google.com/maps?q=<%= mapQuery %>&t=&z=15&ie=UTF8&iwloc=&output=embed">
                            </iframe>
                        </div>
                    </div>
                </div>

                <% if (event.transit_info) { %>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs">
                        <div class="font-bold text-slate-800 mb-1 flex items-center"><i class="fas fa-train text-purple-600 me-1.5"></i> Public Transit Directions</div>
                        <div class="text-slate-600 leading-relaxed"><%= event.transit_info %></div>
                    </div>
                <% } %>
            </div>

            <!-- Organizer / Fanclub Legitimacy Card -->
            <% 
                const displayOrgName = event.promoter_name || event.organization_name || event.submitter_name || (event.organizer_name && event.organizer_name !== 'System Admin' ? event.organizer_name : 'Authorized Tour Production');
                const rawHandle = event.submitter_social || event.social_handle || '';
                const cleanHandle = rawHandle.replace(/^@/, '');
                const orgSocialLink = event.social_url || (rawHandle ? (rawHandle.startsWith('http') ? rawHandle : `https://x.com/${cleanHandle}`) : '');
                const ticketSec = helpers.getTicketingSecurity(event.official_url, displayOrgName);
            %>
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="text-base font-bold text-slate-900 flex items-center">
                        <i class="fas fa-shield-halved text-pink-600 me-2"></i> Organizer Legitimacy
                    </h3>
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full <%= ticketSec.statusClass %>">
                        <i class="fas <%= ticketSec.icon %> me-1"></i> <%= ticketSec.badge %>
                    </span>
                </div>

                <div>
                    <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Host / Promoter</div>
                    <div class="font-extrabold text-base text-slate-900 mt-0.5"><%= displayOrgName %></div>
                    
                    <div class="mt-2.5 flex flex-wrap gap-2">
                        <% if (event.is_verified_organizer === 1 || event.promoter_name) { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-800 border border-emerald-300">
                                <i class="fas fa-certificate text-emerald-500 me-1.5"></i> Verified Entity
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                <i class="fas fa-users text-slate-400 me-1.5"></i> Community Organizer
                            </span>
                        <% } %>

                        <% if (orgSocialLink) { %>
                            <a href="<%= orgSocialLink %>" target="_blank" rel="noopener noreferrer" 
                               class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-pink-50 hover:bg-pink-100 text-pink-700 border border-pink-200 transition-colors">
                                <i class="fab fa-x-twitter me-1.5 text-pink-600"></i> <%= rawHandle || 'Official Profile' %>
                                <i class="fas fa-arrow-up-right-from-square text-[9px] ms-1.5 text-pink-400"></i>
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Anti-Fraud Trust Check -->
                <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 space-y-2 text-[11px] text-slate-600">
                    <div class="font-bold text-slate-800 text-xs flex items-center">
                        <i class="fas fa-robot text-purple-600 me-1.5"></i> Dual-AI Verification Safeguards
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-emerald-500 text-[10px] mt-0.5"></i>
                        <span>Ensemble verified: <strong class="text-slate-800">Vision OCR + Semantic Auditor Consensus</strong></span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-emerald-500 text-[10px] mt-0.5"></i>
                        <span>Official source gateway: <strong class="text-slate-800"><%= ticketSec.domain %></strong></span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-shield text-purple-500 text-[10px] mt-0.5"></i>
                        <span>Protected by community double-verification reporting system</span>
                    </div>
                </div>
            </div>

            <!-- Official K-Sync Verification & Safety Card (Small Card) -->
            <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 rounded-3xl p-6 text-white shadow-lg space-y-3.5">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-lg">
                        <i class="fas fa-shield-check"></i>
                    </div>
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        <i class="fas fa-circle-check me-1"></i> Verified Event
                    </span>
                </div>
                <div>
                    <h3 class="font-extrabold text-sm text-white">Event Reference ID</h3>
                    <p class="text-[11px] text-slate-300 mt-0.5">Use this reference code to track verified event updates.</p>
                </div>
                <div class="flex items-center justify-between bg-white/10 rounded-xl p-2.5 border border-white/10 font-mono text-xs">
                    <span class="text-pink-300 font-bold tracking-wider"><%= event.tracking_code || 'KS-2026-TXT001' %></span>
                    <button onclick="copyRefCode('<%= event.tracking_code || 'KS-2026-TXT001' %>')" 
                            class="text-[11px] text-slate-300 hover:text-white font-sans font-bold flex items-center cursor-pointer transition-colors">
                        <i class="far fa-copy me-1 text-xs"></i> Copy
                    </button>
                </div>
                <div class="text-[11px] text-slate-300/90 leading-relaxed pt-1 border-t border-white/10 space-y-1">
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-pink-400 text-[10px] mt-0.5"></i>
                        <span>Vetted against official tour promoters</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-ban text-rose-400 text-[10px] mt-0.5"></i>
                        <span>Never buy from unverified social media scalpers</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function toggleInterest(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/interest`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    function openReportModal() {
        <% if (!userObj) { %>
            const authModal = document.getElementById('report-auth-modal');
            if (authModal) {
                authModal.classList.remove('hidden');
                authModal.classList.add('flex');
            }
            return;
        <% } %>
        const modal = document.getElementById('report-modal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }

    function closeReportModal() {
        const modal = document.getElementById('report-modal');
        if (modal) {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
        const authModal = document.getElementById('report-auth-modal');
        if (authModal) {
            authModal.classList.remove('flex');
            authModal.classList.add('hidden');
        }
    }

    function updateReportCharCount() {
        const details = document.getElementById('report-details').value;
        const countSpan = document.getElementById('report-char-count');
        if (countSpan) countSpan.textContent = details.length;
        if (details.length >= 20) {
            countSpan.classList.remove('text-rose-500');
            countSpan.classList.add('text-emerald-600');
        } else {
            countSpan.classList.remove('text-emerald-600');
            countSpan.classList.add('text-rose-500');
        }
    }

    async function submitVerifiedReport(e) {
        e.preventDefault();
        const reason = document.getElementById('report-reason').value;
        const details = document.getElementById('report-details').value.trim();
        const evidence_url = document.getElementById('report-evidence-url').value.trim();
        const declaration = document.getElementById('report-declaration').checked;
        const msgBox = document.getElementById('report-modal-msg');
        const submitBtn = document.getElementById('report-submit-btn');

        if (!reason) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Please select a violation category.</div>';
            return;
        }

        if (details.length < 20) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Detailed explanation must be at least 20 characters.</div>';
            return;
        }

        if (!declaration) {
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">You must check and agree to the Good-Faith Anti-Defamation Declaration.</div>';
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting...';

        try {
            const res = await fetch(`/api/events/<%= event.id %>/report`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason, details, evidence_url, declaration: true })
            });
            const data = await res.json();

            if (data.status === 'success') {
                msgBox.innerHTML = '<div class="p-4 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200 flex items-center gap-2"><i class="fas fa-circle-check text-emerald-500 text-base"></i> ' + data.message + '</div>';
                setTimeout(() => {
                    closeReportModal();
                    showToast('Report submitted for priority admin review!');
                }, 2200);
            } else if (data.status === 'duplicate') {
                msgBox.innerHTML = '<div class="p-3 rounded-xl bg-amber-50 text-amber-800 text-xs font-bold border border-amber-200"><i class="fas fa-clock me-1 text-amber-500"></i> ' + data.message + '</div>';
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Report';
            } else {
                msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">' + (data.message || 'Error submitting report.') + '</div>';
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Report';
            }
        } catch (err) {
            console.error(err);
            msgBox.innerHTML = '<div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200">Network error. Please try again.</div>';
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Submit Report';
        }
    }

    function toggleReplyBox(commentId) {
        const form = document.getElementById(`reply-form-${commentId}`);
        if (!form) return;
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) {
            const textarea = document.getElementById(`reply-input-${commentId}`);
            if (textarea) textarea.focus();
        }
    }

    async function postComment(e, parentId = null) {
        e.preventDefault();
        const inputId = parentId ? `reply-input-${parentId}` : 'main-comment-input';
        const input = document.getElementById(inputId);
        const msg = input ? input.value.trim() : '';
        if (!msg) return;

        const btn = parentId ? e.target.querySelector('button[type="submit"]') : document.getElementById('main-comment-btn');
        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-50');
        }

        try {
            const res = await fetch(`/api/chat/<%= event.id %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, parent_id: parentId })
            });
            const data = await res.json();
            if (data.status === 'success') {
                input.value = '';
                window.location.hash = 'discussion';
                window.location.reload();
            } else {
                alert(data.message || 'Error posting comment');
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-50');
                }
            }
        } catch (err) {
            console.error('Comment submission error:', err);
            alert('Failed to post comment. Please try again.');
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-50');
            }
        }
    }

    async function deleteComment(messageId) {
        if (!confirm('Are you sure you want to delete this comment?')) return;

        try {
            const res = await fetch(`/api/chat/${messageId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'success') {
                const el = document.getElementById(`comment-${messageId}`);
                if (el) {
                    el.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                    el.style.opacity = '0';
                    el.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        window.location.hash = 'discussion';
                        window.location.reload();
                    }, 300);
                } else {
                    window.location.reload();
                }
            } else {
                alert(data.message || 'Unable to delete comment.');
            }
        } catch (err) {
            console.error('Delete comment error:', err);
            alert('Network error while deleting comment.');
        }
    }

    // Toast Helper
    function showToast(msg) {
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-msg');
        if (toast && toastMsg) {
            toastMsg.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }
    }

    // Share Modal Logic
    function openShareModal(eventName, eventSlug) {
        const origin = window.location.origin;
        const slug = eventSlug || '<%= helpers.slugify(event.event_name) || event.id %>';
        const url = origin + '/events/' + slug;

        if (navigator.share && /mobile|android|iphone/i.test(navigator.userAgent)) {
            navigator.share({
                title: eventName,
                text: 'Check out ' + eventName + ' on K-Sync Malaysia: ' + url,
                url: url
            }).catch(() => {});
            return;
        }

        const modal = document.getElementById('share-modal');
        const content = document.getElementById('share-modal-content');
        document.getElementById('share-url-input').value = url;
        
        const shareText = encodeURIComponent('Check out ' + eventName + ' on K-Sync Malaysia: ' + url);
        document.getElementById('share-wa').href = 'https://api.whatsapp.com/send?text=' + shareText;
        document.getElementById('share-x').href = 'https://twitter.com/intent/tweet?text=' + shareText;
        document.getElementById('share-tg').href = 'https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent('Check out ' + eventName + ' on K-Sync Malaysia');
        document.getElementById('share-fb').href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    // Auto-update browser URL bar from /events/24 to /events/name-of-event
    document.addEventListener('DOMContentLoaded', () => {
        const cleanSlug = '<%= helpers.slugify(event.event_name) || event.id %>';
        if (cleanSlug && !window.location.pathname.endsWith('/' + cleanSlug)) {
            window.history.replaceState({}, '', '/events/' + cleanSlug);
        }
    });

    function closeShareModal() {
        const modal = document.getElementById('share-modal');
        const content = document.getElementById('share-modal-content');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }, 200);
    }

    function openCalendarModal() {
        const modal = document.getElementById('calendar-modal');
        const content = document.getElementById('calendar-modal-content');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeCalendarModal() {
        const modal = document.getElementById('calendar-modal');
        const content = document.getElementById('calendar-modal-content');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }, 200);
    }

    function copyShareUrl() {
        const input = document.getElementById('share-url-input');
        input.select();
        navigator.clipboard.writeText(input.value);
        showToast('Event link copied to clipboard!');
        const btn = document.getElementById('share-copy-btn');
        btn.innerHTML = '<i class="fas fa-check text-emerald-400"></i>';
        setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
    }

    function copyRefCode(code) {
        navigator.clipboard.writeText(code);
        showToast('Reference code ' + code + ' copied!');
    }

    // Live Countdown Timer
    const eventDateStr = "<%= event.event_date %>";
    const startTimeStr = "<%= event.start_time || '18:00:00' %>";
    const targetTime = new Date(`${eventDateStr}T${startTimeStr}`).getTime();

    function updateCountdown() {
        const now = Date.now();
        const diff = targetTime - now;

        if (diff <= 0) {
            const timerEl = document.getElementById('countdown-timer');
            if (timerEl) {
                timerEl.innerHTML = '<div class="col-span-4 bg-white/20 py-2 px-4 rounded-xl text-xs font-bold">Event Started / Live!</div>';
            }
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        const cdDays = document.getElementById('cd-days');
        const cdHours = document.getElementById('cd-hours');
        const cdMinutes = document.getElementById('cd-minutes');
        const cdSeconds = document.getElementById('cd-seconds');

        if (cdDays) cdDays.textContent = String(days).padStart(2, '0');
        if (cdHours) cdHours.textContent = String(hours).padStart(2, '0');
        if (cdMinutes) cdMinutes.textContent = String(minutes).padStart(2, '0');
        if (cdSeconds) cdSeconds.textContent = String(seconds).padStart(2, '0');
    }

    if (targetTime) {
        updateCountdown();
        setInterval(updateCountdown, 1000);
    }

    // Lightbox Fullscreen Viewer Logic
    function openLightbox(imgSrc, title) {
        const modal = document.getElementById('lightbox-modal');
        if (!modal) return;
        document.getElementById('lightbox-img').src = imgSrc;
        document.getElementById('lightbox-title').textContent = title || 'Official Event Poster';
        document.getElementById('lightbox-download').href = imgSrc;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        const modal = document.getElementById('lightbox-modal');
        if (!modal) return;
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
    });
</script>

