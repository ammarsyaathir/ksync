<%- include('partials/header', { title: event.event_name + ' | Concert Dossier & Live Intel | K-Sync Malaysia' }) %>

<% 
    const calcStatus = helpers.getCalculatedEventStatus(event);
    const isSaved = (typeof isSavedEvent !== 'undefined') ? isSavedEvent : false;
    const userObj = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
    const userRole = (userObj && (userObj.role || userObj.role_name)) ? String(userObj.role || userObj.role_name).toLowerCase() : '';
    const isOrganizer = userRole === 'organizer';
    const isAdmin = userRole === 'admin';
    const isFanOrGuest = !isOrganizer && !isAdmin;
    
    // Calendar URL generation
    const rawDate = (event.event_date instanceof Date) 
        ? event.event_date.toISOString().split('T')[0] 
        : String(event.event_date || '');
    const dateFormatted = rawDate.replace(/-/g, '');
    const startTimeFormatted = String(event.start_time || '18:00:00').replace(/:/g, '').substring(0, 4) + '00';
    const endTimeFormatted = String(event.end_time || '22:00:00').replace(/:/g, '').substring(0, 4) + '00';
    const gCalDates = `${dateFormatted}T${startTimeFormatted}/${dateFormatted}T${endTimeFormatted}`;
    const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.event_name)}&dates=${gCalDates}&details=${encodeURIComponent(event.description || 'K-Pop Concert in Malaysia')}&location=${encodeURIComponent(event.venue_name + ', ' + (event.city || 'Malaysia'))}`;
    const mapQuery = encodeURIComponent(`${event.venue_name} ${event.address || ''} ${event.city || ''} Malaysia`);
    const eventSlug = helpers.slugify(event.event_name) || event.id;
    const displayOrgName = event.promoter_name || event.organization_name || event.submitter_name || (event.organizer_name && event.organizer_name !== 'System Admin' ? event.organizer_name : 'Authorized Tour Production');
    const rawHandle = event.submitter_social || event.social_handle || '';
    const cleanHandle = rawHandle.replace(/^@/, '');
    const orgSocialLink = event.social_url || (rawHandle ? (rawHandle.startsWith('http') ? rawHandle : `https://x.com/${cleanHandle}`) : '');
    const ticketSec = helpers.getTicketingSecurity(event.official_url, displayOrgName);
    const eventPosters = (typeof posters !== 'undefined' && posters && posters.length > 0) 
        ? posters 
        : [event.poster_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'];

    // Venue GPS Coordinate Resolver for Google Maps & Leaflet
    let venueCoords = [3.1408, 101.7088]; // Default KL center
    const venueLower = (event.venue_name || '').toLowerCase();
    const cityLower = (event.city || '').toLowerCase();

    if (venueLower.includes('axiata') || venueLower.includes('bukit jalil')) {
        venueCoords = [3.0583, 101.6917];
    } else if (venueLower.includes('zepp') || venueLower.includes('lalaport') || venueLower.includes('bbcc')) {
        venueCoords = [3.1408, 101.7088];
    } else if (venueLower.includes('mega star') || venueLower.includes('sungei wang')) {
        venueCoords = [3.1451, 101.7114];
    } else if (venueLower.includes('sunway') || venueLower.includes('jiospace') || cityLower.includes('petaling')) {
        venueCoords = [3.0729, 101.6074];
    } else if (venueLower.includes('spice') || cityLower.includes('penang')) {
        venueCoords = [5.3283, 100.2825];
    } else if (venueLower.includes('austin') || cityLower.includes('johor')) {
        venueCoords = [1.5542, 103.7766];
    } else if (venueLower.includes('mitec')) {
        venueCoords = [3.1788, 101.6678];
    } else if (venueLower.includes('wtc') || venueLower.includes('world trade')) {
        venueCoords = [3.1690, 101.6918];
    } else if (venueLower.includes('kl sentral') || venueLower.includes('sentral')) {
        venueCoords = [3.1342, 101.6865];
    }
%>

<!-- Electric Concert Stage Hero Banner -->
<div class="relative bg-slate-950 overflow-hidden border-b border-white/10">
    <!-- Ambient Stage Lighting Atmosphere -->
    <div class="absolute inset-0 z-0">
        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
             class="w-full h-full object-cover opacity-25 blur-2xl scale-110 pointer-events-none"
             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent"></div>
        <div class="absolute -top-32 left-1/4 w-96 h-96 rounded-full bg-violet-600/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -top-20 right-1/4 w-96 h-96 rounded-full bg-pink-500/20 blur-3xl pointer-events-none"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <i class="fas fa-chevron-right text-[10px] text-slate-600"></i>
            <a href="/events" class="hover:text-white transition-colors">Concert Directory</a>
            <i class="fas fa-chevron-right text-[10px] text-slate-600"></i>
            <span class="text-pink-400 font-bold truncate max-w-xs sm:max-w-md"><%= event.event_name %></span>
        </nav>

        <!-- Status Badges Tray -->
        <div class="flex flex-wrap items-center gap-2.5 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-white text-slate-950 shadow-md">
                <%= event.category_name || 'Concert' %>
            </span>
            <%- helpers.getStatusBadge(calcStatus) %>
            <%- helpers.getVerificationBadge(event.verification_status) %>
            <% const trust = (event.trust_level || '').toUpperCase(); %>
            <% if (trust === 'OFFICIAL') { %>
                <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 backdrop-blur-md flex items-center gap-1.5">
                    <i class="fas fa-shield-halved text-amber-300"></i> Verified Official Tour
                </span>
            <% } else if (trust === 'COMMUNITY') { %>
                <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-violet-500/20 text-violet-300 border border-violet-500/40 backdrop-blur-md flex items-center gap-1.5">
                    <i class="fas fa-users text-pink-300"></i> Verified Fan Event
                </span>
            <% } %>
            <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/5 text-slate-300 border border-white/10 backdrop-blur-md flex items-center gap-1.5">
                <i class="fas fa-clock-rotate-left text-pink-400"></i> Updated <%= helpers.timeAgo(event.updated_at || event.created_at) %>
            </span>
        </div>

        <% if (event.verification_status === 'SUSPENDED') { %>
            <div class="mb-5 p-4 rounded-2xl bg-rose-950/90 border border-rose-500 text-rose-100 text-xs font-medium flex items-center gap-3 backdrop-blur-md shadow-xl">
                <i class="fas fa-triangle-exclamation text-amber-400 text-xl shrink-0"></i>
                <div>
                    <span class="font-extrabold uppercase tracking-wide text-amber-300">⚠️ Listing Suspended for Community Safety:</span>
                    This event has been frozen following verified community reports. Ticket purchases are locked pending official promoter clarification.
                </div>
            </div>
        <% } %>

        <!-- Concert Headline -->
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4 max-w-4xl">
            <%= event.event_name %>
        </h1>

        <!-- Event Key Meta Chips -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-5 text-xs sm:text-sm text-slate-300 font-medium">
            <span class="flex items-center gap-2">
                <i class="fas fa-microphone-lines text-pink-400 text-sm"></i>
                <strong class="text-white"><%= event.artist_name || 'Multiple Artists' %></strong>
            </span>
            <span class="flex items-center gap-2">
                <i class="fas fa-calendar-day text-violet-400 text-sm"></i>
                <span><%= helpers.formatDate(event.event_date) %></span>
            </span>
            <% if (event.start_time) { %>
                <span class="flex items-center gap-2">
                    <i class="fas fa-clock text-cyan-400 text-sm"></i>
                    <span><%= helpers.formatTime(event.start_time) %> <%= event.end_time ? '– ' + helpers.formatTime(event.end_time) : '' %></span>
                </span>
            <% } %>
            <span class="flex items-center gap-2">
                <i class="fas fa-location-dot text-rose-400 text-sm"></i>
                <span><%= event.venue_name %>, <%= event.city %></span>
                <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(event.venue_name + ' ' + (event.city || 'Malaysia')) %>" 
                   target="_blank" rel="noopener noreferrer" 
                   class="ms-1 px-2.5 py-0.5 rounded-lg bg-white/10 hover:bg-white/20 text-pink-300 hover:text-white text-[11px] font-bold border border-white/15 transition-all inline-flex items-center gap-1 press-tactile">
                    <span>Maps</span>
                    <i class="fas fa-arrow-up-right-from-square text-[9px]"></i>
                </a>
            </span>
        </div>
    </div>
</div>

<!-- Main Details Workspace Grid -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left 2 Cols: Countdown, Action Bar, Description, Guidelines, Posters, Idol Members, Discussion -->
        <div class="lg:col-span-2 space-y-7">
            
            <!-- Live Event Countdown Stage Card -->
            <% if (calcStatus === 'UPCOMING') { %>
                <div class="p-6 sm:p-7 rounded-3xl bg-gradient-to-r from-violet-950 via-slate-900 to-pink-950 border border-violet-500/30 shadow-2xl text-white relative overflow-hidden">
                    <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-pink-500/10 rounded-full blur-2xl pointer-events-none"></div>
                    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
                        <div class="space-y-1">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-pink-500 text-white inline-flex items-center gap-1.5 shadow-xs">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
                                Live Showtime Countdown
                            </span>
                            <h3 class="text-xl font-black text-white tracking-tight">Counting Down to the Live Stage</h3>
                            <p class="text-xs text-slate-300">Automatic synchronized countdown based on official venue door opening time.</p>
                        </div>
                        <div id="countdown-timer" class="grid grid-cols-4 gap-2.5 text-center shrink-0">
                            <div class="bg-black/60 backdrop-blur-md rounded-2xl px-3.5 py-2.5 border border-white/10 min-w-[64px]">
                                <span id="cd-days" class="block text-2xl font-black text-pink-400 tabular-nums font-mono">00</span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Days</span>
                            </div>
                            <div class="bg-black/60 backdrop-blur-md rounded-2xl px-3.5 py-2.5 border border-white/10 min-w-[64px]">
                                <span id="cd-hours" class="block text-2xl font-black text-white tabular-nums font-mono">00</span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Hours</span>
                            </div>
                            <div class="bg-black/60 backdrop-blur-md rounded-2xl px-3.5 py-2.5 border border-white/10 min-w-[64px]">
                                <span id="cd-minutes" class="block text-2xl font-black text-white tabular-nums font-mono">00</span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Mins</span>
                            </div>
                            <div class="bg-black/60 backdrop-blur-md rounded-2xl px-3.5 py-2.5 border border-white/10 min-w-[64px]">
                                <span id="cd-seconds" class="block text-2xl font-black text-amber-300 tabular-nums font-mono">00</span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Secs</span>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Unified Outbound Action Control Bar -->
            <div class="bg-white rounded-3xl p-5 border border-slate-200/90 shadow-sm flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2">
                    <!-- UC017: Wishlist Toggle -->
                    <button onclick="toggleSaveEvent(<%= event.id %>, this)" 
                            class="px-4 py-2.5 rounded-xl border <%= isSaved ? 'bg-rose-50 text-rose-600 border-rose-200 font-extrabold' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200' %> font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile">
                        <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart me-1.5 text-rose-500"></i>
                        <span><%= isSaved ? 'Saved to Wishlist' : 'Save Event' %></span>
                    </button>

                    <!-- UC018: Crowdsourced Reliability Recommendation / Upvote -->
                    <button onclick="toggleRecommendEvent(<%= event.id %>, this)" 
                            id="btnRecommendEvent"
                            class="px-4 py-2.5 rounded-xl border <%= (typeof isInterested !== 'undefined' && isInterested) ? 'bg-amber-50 text-amber-700 border-amber-300 font-extrabold' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200' %> font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile"
                            title="Crowdsourced Reliability: Recommend this legitimate event">
                        <i class="<%= (typeof isInterested !== 'undefined' && isInterested) ? 'fas' : 'far' %> fa-thumbs-up me-1.5 <%= (typeof isInterested !== 'undefined' && isInterested) ? 'text-amber-500' : 'text-slate-400' %>"></i>
                        <span>Recommend</span>
                        <span id="recommendCountBadge" class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] <%= (typeof isInterested !== 'undefined' && isInterested) ? 'bg-amber-200 text-amber-900' : 'bg-slate-200 text-slate-700' %> font-black"><%= (typeof interestCount !== 'undefined') ? interestCount : 0 %></span>
                    </button>
                    
                    <!-- UC010: Share Event Outbound Button -->
                    <button onclick="openShareModal('<%= event.event_name.replace(/'/g, "\\'") %>', '<%= eventSlug %>')" 
                            class="px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile">
                        <i class="fas fa-share-nodes me-1.5 text-pink-500"></i>
                        <span>Share</span>
                    </button>

                    <!-- UC011: Calendar Export Outbound Button -->
                    <button onclick="openCalendarModal()" 
                            class="px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile"
                            title="Export Calendar (.ics / Google Calendar)">
                        <i class="far fa-calendar-plus me-1.5 text-violet-600"></i>
                        <span>Export Calendar</span>
                    </button>

                    <% if (isFanOrGuest) { %>
                        <!-- 3D Stadium & Seating POV Sightlines (Fans & Guests only) -->
                        <a href="/venues/seating-3d?event=<%= event.id %>&venue=<%= event.venue_id || 1 %>" 
                           class="px-4 py-2.5 rounded-xl border border-pink-200 bg-pink-50 hover:bg-pink-100 text-pink-700 font-extrabold text-xs flex items-center shadow-xs cursor-pointer press-tactile transition-all"
                           title="Explore 3D Stadium & Seat Sightlines in WebGL">
                            <i class="fas fa-cube me-1.5 text-pink-600"></i>
                            <span>3D Arena POV</span>
                        </a>

                        <!-- UC: Stamp to Concert Passport (Fans & Guests only) -->
                        <a href="/passport?event_id=<%= event.id %>" 
                           class="px-4 py-2.5 rounded-xl border border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-800 font-extrabold text-xs flex items-center shadow-xs cursor-pointer press-tactile transition-all"
                           title="Claim digital stamp to your K-Sync Passport">
                            <i class="fas fa-passport me-1.5 text-amber-600"></i>
                            <span>Stamp Passport</span>
                        </a>
                    <% } %>

                    <% if (isOrganizer || isAdmin) { %>
                        <% if (isAdmin || (userObj && userObj.id === event.organizer_id)) { %>
                            <!-- Host / Maintainer Management Quick Actions -->
                            <a href="/organizer/events/<%= event.id %>/edit" 
                               class="px-4 py-2.5 rounded-xl border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-extrabold text-xs flex items-center shadow-xs cursor-pointer press-tactile transition-all"
                               title="Edit Listing Information">
                                <i class="fas fa-pen-to-square me-1.5 text-emerald-600"></i>
                                <span>Edit Listing</span>
                            </a>
                            <a href="/organizer/events/<%= event.id %>/verification" 
                               class="px-4 py-2.5 rounded-xl border border-purple-200 bg-purple-50 hover:bg-purple-100 text-purple-800 font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile transition-all"
                               title="View Verification Checklist">
                                <i class="fas fa-shield-check me-1.5 text-purple-600"></i>
                                <span>Verification</span>
                            </a>
                        <% } %>
                    <% } %>

                    <!-- UC019: Report Listing Button -->
                    <button onclick="openReportModal()" 
                            class="px-3.5 py-2.5 rounded-xl border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-600 font-bold text-xs flex items-center shadow-xs cursor-pointer press-tactile"
                            title="File a verified community report regarding tickets, scam, or inaccurate info">
                        <i class="fas fa-flag text-amber-500 me-1.5"></i>
                        <span>Report Listing</span>
                    </button>
                </div>

                <!-- UC007: Authorized Official Ticketing Gateway -->
                <% if (event.official_url && event.verification_status !== 'SUSPENDED') { %>
                    <a href="<%= event.official_url %>" target="_blank" rel="noopener noreferrer" 
                       class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-pink-600 to-violet-600 hover:from-pink-500 hover:to-violet-500 text-white font-black text-xs shadow-md shadow-pink-500/20 flex items-center gap-2 press-tactile">
                        <i class="fas fa-ticket text-amber-300"></i>
                        <span>Official Ticket Link</span>
                        <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
                    </a>
                <% } else if (event.verification_status === 'SUSPENDED') { %>
                    <span class="px-4 py-2.5 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs border border-slate-200 flex items-center gap-2 cursor-not-allowed">
                        <i class="fas fa-lock text-rose-500"></i>
                        <span>Ticket Link Suspended</span>
                    </span>
                <% } %>
            </div>

            <!-- Official Tour Anthem & Audio Preview Player -->
            <div id="event-anthem-container" class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 rounded-3xl p-6 border border-pink-500/30 shadow-xl text-white relative overflow-hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <!-- Vinyl Album Cover with Spinning Animation -->
                        <div class="relative w-14 h-14 rounded-full overflow-hidden shrink-0 border-2 border-slate-700 shadow-md bg-slate-950">
                            <img id="details-song-art" src="<%= event.poster_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=300' %>" alt="Album Art" class="w-full h-full object-cover" style="animation-duration: 5s;">
                            <div class="absolute inset-0 m-auto w-3.5 h-3.5 rounded-full bg-slate-950 border border-white/50"></div>
                        </div>

                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-pink-500 text-white font-mono flex items-center gap-1 shadow-xs">
                                    <i class="fas fa-compact-disc text-white"></i>
                                    <span>Official Tour Anthem</span>
                                </span>
                                <!-- Live Sound Waves -->
                                <div id="details-audio-bars" class="flex items-end gap-1 h-3.5 opacity-40">
                                    <span class="w-1 bg-pink-400 rounded-full h-1.5 transition-all"></span>
                                    <span class="w-1 bg-pink-500 rounded-full h-3 transition-all"></span>
                                    <span class="w-1 bg-pink-400 rounded-full h-2 transition-all"></span>
                                    <span class="w-1 bg-pink-300 rounded-full h-3.5 transition-all"></span>
                                </div>
                            </div>
                            <h3 id="details-song-title" class="text-base sm:text-lg font-black text-white tracking-tight">Scanning Tour Anthem...</h3>
                            <p id="details-song-album" class="text-xs text-slate-400 font-medium">Apple Music 30s Official Preview</p>
                        </div>
                    </div>

                    <!-- Audio Controls & Links -->
                    <div class="flex items-center gap-3 shrink-0">
                        <button type="button" id="details-play-btn" onclick="toggleDetailsSongPlayback()"
                                class="px-5 py-2.5 rounded-2xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-black text-xs shadow-lg shadow-pink-500/25 flex items-center gap-2 press-tactile transition-all cursor-pointer">
                            <i class="fas fa-play text-xs" id="details-play-icon"></i>
                            <span id="details-play-text">Play Tour Preview</span>
                        </button>
                        <a id="details-stream-link" href="https://music.apple.com" target="_blank" rel="noopener noreferrer" 
                           class="px-4 py-2.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-bold text-xs border border-slate-700 press-tactile transition-all flex items-center gap-1.5"
                           title="Listen on Apple Music">
                            <i class="fab fa-apple text-pink-400"></i>
                            <span class="hidden sm:inline">Stream Full</span>
                            <i class="fas fa-arrow-up-right-from-square text-[9px]"></i>
                        </a>
                    </div>
                </div>

                <!-- Live Progress Scrubber -->
                <div class="mt-4 pt-3 border-t border-slate-800/80 space-y-1">
                    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                        <div id="details-song-progress" class="h-full bg-gradient-to-r from-pink-500 to-rose-400 w-0 transition-all duration-100"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-slate-400 font-mono">
                        <span id="details-song-current-time">0:00</span>
                        <span>0:30 Official Audio Preview</span>
                    </div>
                </div>

                <audio id="details-audio-player" preload="none"></audio>
            </div>

            <!-- Event Overview & Official Description Dossier -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h2 class="text-xl font-black text-slate-900 flex items-center gap-2.5">
                        <i class="fas fa-circle-info text-pink-600"></i>
                        <span>Concert Overview & Dossier</span>
                    </h2>
                    <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-violet-50 text-violet-700 border border-violet-200">
                        Official Release
                    </span>
                </div>
                <div class="text-sm text-slate-700 leading-relaxed space-y-4 whitespace-pre-line font-normal">
                    <%= event.description || 'No detailed description provided for this concert event.' %>
                </div>
            </div>

            <!-- Ticket Tiers, Pricing & Prohibited Items -->
            <% if (event.ticket_info || event.event_rules) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
                    <% if (event.ticket_info) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2.5 flex items-center gap-2">
                                <i class="fas fa-tags text-violet-600"></i>
                                <span>Official Ticket Tiers & Pricing</span>
                            </h3>
                            <div class="text-xs text-slate-700 bg-violet-50/60 p-4 rounded-2xl border border-violet-200/70 whitespace-pre-line leading-relaxed font-medium">
                                <%= event.ticket_info %>
                            </div>
                        </div>
                    <% } %>

                    <% if (event.event_rules) { %>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 mb-2.5 flex items-center gap-2">
                                <i class="fas fa-shield-halved text-pink-600"></i>
                                <span>Venue Security, Prohibited Items & Rules</span>
                            </h3>
                            <div class="text-xs text-slate-700 bg-pink-50/60 p-4 rounded-2xl border border-pink-200/70 whitespace-pre-line leading-relaxed font-medium">
                                <%= event.event_rules %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Fan Inclusivity & Accessibility Facilities -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2.5">
                        <i class="fas fa-universal-access text-pink-600"></i>
                        <span>Accessibility & Fan Facilities</span>
                    </h3>
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-pink-50 text-pink-700 border border-pink-200">
                        Inclusivity Verified
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs">
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-3">
                        <i class="fas fa-wheelchair text-violet-600 text-lg shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-slate-900 block font-bold mb-1">OKU / Wheelchair Access</strong>
                            <p class="text-slate-600 leading-relaxed">Dedicated barrier-free ramps, accessible lifts, and reserved viewing zones for wheelchair users.</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-3">
                        <i class="fas fa-bolt-lightning text-amber-500 text-lg shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-slate-900 block font-bold mb-1">Sensory & Strobe Warning</strong>
                            <p class="text-slate-600 leading-relaxed">Stage performance features sudden pyrotechnics, heavy sub-bass, and high-intensity strobe lighting.</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-3">
                        <i class="fas fa-kit-medical text-rose-500 text-lg shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="text-slate-900 block font-bold mb-1">First Aid & Paramedics</strong>
                            <p class="text-slate-600 leading-relaxed">On-site paramedic triage booth and priority seating support for expectant mothers.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Official Event Posters & Visual Gallery -->
            <div class="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200/90 shadow-sm space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
                    <div>
                        <h3 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2">
                            <i class="fas fa-images text-pink-600"></i>
                            <span>Official Event Posters & Notices</span>
                        </h3>
                        <p class="text-xs text-slate-500 mt-1">High-resolution promotional key visual, seating map, and door regulations.</p>
                    </div>
                    <span class="self-start sm:self-auto px-3.5 py-1 rounded-full text-xs font-bold bg-pink-50 text-pink-700 border border-pink-200 shrink-0">
                        <%= eventPosters.length %> <%= eventPosters.length === 1 ? 'Poster' : 'Visuals' %>
                    </span>
                </div>

                <% if (eventPosters.length === 1) { %>
                    <div class="relative bg-slate-950/5 rounded-2xl p-3 sm:p-4 border border-slate-200/80 flex items-center justify-center overflow-hidden group">
                        <img src="<%= eventPosters[0] %>" alt="<%= event.event_name %> Poster"
                             class="max-h-[580px] w-auto max-w-full rounded-xl object-contain shadow-md cursor-pointer hover:scale-[1.01] transition-transform duration-300"
                             onclick="openLightbox('<%= eventPosters[0] %>', '<%= event.event_name.replace(/'/g, "\\'") %>')">
                        <button onclick="openLightbox('<%= eventPosters[0] %>', '<%= event.event_name.replace(/'/g, "\\'") %>')"
                                class="absolute bottom-4 right-4 px-4 py-2 rounded-xl bg-slate-950/80 hover:bg-slate-900 text-white text-xs font-bold backdrop-blur-md flex items-center shadow-lg transition-all cursor-pointer press-tactile">
                            <i class="fas fa-magnifying-glass-plus me-1.5 text-pink-400"></i>
                            <span>Fullscreen</span>
                        </button>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <% eventPosters.forEach(function(imgUrl, idx) { %>
                            <div class="relative bg-slate-950/5 rounded-2xl p-3 border border-slate-200/80 flex flex-col justify-between overflow-hidden group hover:border-pink-300 hover:shadow-md transition-all">
                                <div class="flex items-center justify-between mb-2 px-1">
                                    <span class="text-[11px] font-black text-slate-600 uppercase tracking-wider flex items-center gap-1.5">
                                        <i class="fas fa-image text-pink-500"></i>
                                        <%= idx === 0 ? 'Main Tour Poster' : (idx === 1 ? 'Seating Chart' : 'Notice #' + (idx + 1)) %>
                                    </span>
                                    <button onclick="openLightbox('<%= imgUrl %>', '<%= event.event_name.replace(/'/g, "\\'") %> - Visual #<%= idx + 1 %>')"
                                            class="text-xs font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1 cursor-pointer press-tactile">
                                        <i class="fas fa-expand text-[10px]"></i>
                                        <span>Enlarge</span>
                                    </button>
                                </div>
                                <div class="flex items-center justify-center min-h-[260px] max-h-[420px] overflow-hidden rounded-xl bg-white/80 p-2">
                                    <img src="<%= imgUrl %>" alt="<%= event.event_name %> - Visual #<%= idx + 1 %>"
                                         class="max-h-[400px] w-auto max-w-full object-contain rounded-lg shadow-xs cursor-pointer group-hover:scale-[1.02] transition-transform duration-300"
                                         onclick="openLightbox('<%= imgUrl %>', '<%= event.event_name.replace(/'/g, "\\'") %> - Visual #<%= idx + 1 %>')">
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Idol Group Members & Biodata Section (from `members` table) -->
            <% if (typeof members !== 'undefined' && members && members.length > 0) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-5">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2.5">
                                <i class="fas fa-users-viewfinder text-violet-600"></i>
                                <span><%= event.artist_name %> Member Profiles & Biodata</span>
                            </h2>
                            <p class="text-xs text-slate-500 mt-1">Official member lineup, positions, and verified profile data.</p>
                        </div>
                        <span class="self-start sm:self-auto px-3.5 py-1 rounded-full text-xs font-bold bg-violet-50 text-violet-700 border border-violet-200">
                            <%= members.length %> <%= members.length === 1 ? 'Idol' : 'Group Members' %>
                        </span>
                    </div>

                    <div class="space-y-3.5">
                        <% members.forEach(function(member) { %>
                            <div class="bg-slate-50/70 hover:bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 hover:border-violet-300 hover:shadow-md transition-all group">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <div class="flex items-center gap-3.5 sm:gap-4 md:w-72 shrink-0">
                                        <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl overflow-hidden bg-slate-200 shrink-0 border-2 border-white shadow-sm">
                                            <img src="<%= member.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop' %>" 
                                                 alt="<%= member.stage_name %>" 
                                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2 mb-0.5">
                                                <h4 class="text-base font-black text-slate-900 truncate"><%= member.stage_name %></h4>
                                                <% if (member.mbti) { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-black bg-pink-100 text-pink-700 uppercase tracking-wider shrink-0">
                                                        <%= member.mbti %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-xs text-slate-500 font-medium truncate mb-1"><%= member.birth_name %></p>
                                            <span class="text-[11px] text-violet-700 font-bold bg-violet-50 rounded-lg px-2.5 py-0.5 inline-block border border-violet-100 truncate max-w-full">
                                                <%= member.position %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-xs text-slate-600 md:border-l md:border-slate-200/80 md:ps-6 pt-3 md:pt-0 border-t border-slate-200/60 md:border-t-0 flex-1">
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">DOB</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.dob || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Zodiac</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.zodiac || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Height</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.height || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Blood</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.blood_type || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Nationality</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.nationality || '-' %></div>
                                        </div>
                                        <div class="bg-white/90 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                            <div class="text-[10px] font-bold text-slate-400 uppercase">Active</div>
                                            <div class="font-bold text-slate-800 text-[11px] truncate"><%= member.years_active || '-' %></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <!-- Anti-Scalper Community Discussion (1-Level Threaded Q&A Forum) -->
            <!-- Strict Immutability: No Edit Feature Allowed by Design to Prevent Scalper Bait & Switch -->
            <div id="discussion" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
                <!-- Section Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
                    <div>
                        <h2 class="text-xl font-black text-slate-900 flex items-center gap-2.5">
                            <i class="fas fa-comments text-pink-600"></i>
                            <span>Concert Community Discussion</span>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-pink-50 text-pink-700 border border-pink-200">
                                <%= totalCommentsCount || (typeof comments !== 'undefined' && comments ? comments.length : (chatMessages ? chatMessages.length : 0)) %>
                            </span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-1">Concert logistics, transport carpools, fan chant tips, and venue questions.</p>
                    </div>
                    <% if (isChatLocked) { %>
                        <span class="self-start sm:self-auto px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 shrink-0 flex items-center gap-1.5">
                            <i class="fas fa-lock"></i>
                            <span>Discussion Archived</span>
                        </span>
                    <% } else { %>
                        <span class="self-start sm:self-auto px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                            <span>Live Discussion Open</span>
                        </span>
                    <% } %>
                </div>

                <!-- Discussion Anti-Fraud Safety Notice -->
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs text-slate-600 flex items-start gap-3">
                    <i class="fas fa-shield-halved text-pink-600 text-base shrink-0 mt-0.5"></i>
                    <div class="leading-relaxed">
                        <strong class="text-slate-900">Anti-Scalper & Safety Notice:</strong>
                        Ticket reselling, scalping, unverified QR transfers, and commercial solicitations are strictly forbidden. To preserve safety audit trails, posted comments cannot be secretly edited. Violators face permanent account suspension.
                    </div>
                </div>

                <!-- Input Box (Posting Area) -->
                <% if (isChatLocked) { %>
                    <div class="p-4 rounded-2xl bg-slate-100 text-xs text-slate-500 font-medium flex items-center gap-2">
                        <i class="fas fa-lock text-slate-400"></i>
                        <span>This discussion is archived (24-hour post-event window reached). All past Q&A remains publicly accessible for reference.</span>
                    </div>
                <% } else if (userObj) { %>
                    <form id="main-comment-form" onsubmit="postComment(event, null)" class="bg-slate-50/80 p-4 sm:p-5 rounded-2xl border border-slate-200/80 space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-500 to-violet-600 text-white font-black text-xs flex items-center justify-center shrink-0 border border-white/20 shadow-sm overflow-hidden">
                                <% if (userObj.profile_image) { %>
                                    <img src="<%= userObj.profile_image %>" alt="" class="w-full h-full object-cover">
                                <% } else { %>
                                    <%= (userObj.full_name || userObj.username || 'U').charAt(0).toUpperCase() %>
                                <% } %>
                            </div>
                            <div class="flex-1">
                                <textarea id="main-comment-input" rows="3" 
                                          placeholder="Ask a question or share advice about this concert (e.g. transport, merch queue, entry gates, fan chants)..." 
                                          required
                                          class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 transition-all resize-y"></textarea>
                            </div>
                        </div>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-[11px] text-slate-400 flex items-center gap-1.5">
                                <i class="fas fa-circle-info text-pink-500"></i>
                                <span>Be courteous and supportive of fellow fans</span>
                            </span>
                            <button type="submit" id="main-comment-btn" 
                                    class="px-5 py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm flex items-center gap-2 cursor-pointer press-tactile">
                                <i class="fas fa-paper-plane text-pink-400"></i>
                                <span>Post Comment</span>
                            </button>
                        </div>
                    </form>
                <% } else { %>
                    <div class="p-5 rounded-2xl bg-gradient-to-r from-pink-50/80 via-violet-50/50 to-indigo-50/80 border border-pink-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <div class="w-10 h-10 rounded-xl bg-pink-100 text-pink-600 flex items-center justify-center shrink-0 shadow-2xs">
                                <i class="fas fa-comments text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-xs font-bold text-slate-900">Join the Concert Discussion</h4>
                                <p class="text-[11px] text-slate-500">Log in or create a free fan account to post questions and connect with fellow concert attendees.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2.5 shrink-0">
                            <a href="/login?redirect=/events/<%= eventSlug %>#discussion" 
                               class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 text-xs font-bold transition-all shadow-2xs press-tactile">
                                Log In
                            </a>
                            <a href="/register" 
                               class="px-4 py-2 rounded-xl bg-pink-600 hover:bg-pink-700 text-white text-xs font-bold transition-all shadow-2xs press-tactile">
                                Register
                            </a>
                        </div>
                    </div>
                <% } %>

                <!-- Thread List (1-Level Nested Q&A) -->
                <% const threadList = (typeof comments !== 'undefined' && comments) ? comments : []; %>
                <div class="space-y-4 pt-2">
                    <% if (threadList.length === 0) { %>
                        <div class="text-center py-12 text-slate-400 text-xs font-medium bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
                            <i class="fas fa-comment-dots text-3xl mb-2 text-slate-300 block"></i>
                            <span>No comments yet. Be the first Malaysian fan to start the discussion!</span>
                        </div>
                    <% } else { %>
                        <% threadList.forEach(function(comment) { %>
                            <% 
                                const isCommentAuthor = userObj && userObj.id === comment.user_id;
                                const isAdmin = userObj && (userObj.role || '').toUpperCase() === 'ADMIN';
                                const isSubmitter = (event.organizer_id && comment.user_id === event.organizer_id) || Boolean(comment.is_organizer);
                                const isCommentAdmin = (comment.role || '').toUpperCase() === 'ADMIN';
                            %>
                            <div id="comment-<%= comment.id %>" class="bg-slate-50/70 hover:bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200/80 transition-all">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-slate-200 text-slate-700 font-black text-xs flex items-center justify-center shrink-0 border border-slate-300/80 overflow-hidden">
                                            <% if (comment.profile_image) { %>
                                                <img src="<%= comment.profile_image %>" alt="" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <%= (comment.username || comment.full_name || 'F').charAt(0).toUpperCase() %>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex flex-wrap items-center gap-1.5">
                                                <span class="text-xs font-black text-slate-900 truncate">
                                                    <%= comment.username || comment.full_name %>
                                                </span>
                                                <% if (isSubmitter) { %>
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-pink-100 text-pink-700 border border-pink-200 flex items-center gap-1">
                                                        <i class="fas fa-star text-[9px] text-pink-500"></i> Event Submitter
                                                    </span>
                                                <% } %>
                                                <% if (isCommentAdmin) { %>
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-violet-100 text-violet-700 border border-violet-200 flex items-center gap-1">
                                                        <i class="fas fa-shield text-[9px] text-violet-500"></i> Admin
                                                    </span>
                                                <% } %>
                                                <% if (typeof userFlairs !== 'undefined' && userFlairs[comment.user_id]) { %>
                                                    <a href="/passport/<%= comment.username %>" class="px-2 py-0.5 rounded-full text-[10px] font-black <%= userFlairs[comment.user_id].bg %> flex items-center gap-1 hover:opacity-90 transition-opacity" title="K-Sync Concert Passport: <%= userFlairs[comment.user_id].title %>">
                                                        <i class="fas <%= userFlairs[comment.user_id].icon %> text-[9px]"></i>
                                                        <span><%= userFlairs[comment.user_id].title %></span>
                                                    </a>
                                                <% } %>
                                                <span class="text-slate-400 text-[11px] font-normal">
                                                    • <%= helpers.timeAgo(comment.created_at) %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <% if (isCommentAuthor || isAdmin) { %>
                                        <button onclick="deleteComment(<%= comment.id %>)" 
                                                class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition-colors text-xs cursor-pointer press-tactile" 
                                                title="<%= isAdmin && !isCommentAuthor ? 'Moderate comment as Admin' : 'Delete your comment' %>">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    <% } %>
                                </div>

                                <div class="text-xs text-slate-700 leading-relaxed whitespace-pre-line mt-2.5 ps-12">
                                    <%= comment.message %>
                                </div>

                                <% if (!isChatLocked && userObj) { %>
                                    <div class="mt-2.5 ps-12 flex items-center gap-4">
                                        <button onclick="toggleReplyBox(<%= comment.id %>)" 
                                                class="text-[11px] font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1 cursor-pointer press-tactile">
                                            <i class="fas fa-reply text-[10px]"></i> Reply
                                        </button>
                                    </div>

                                    <!-- Inline Reply Box -->
                                    <form id="reply-form-<%= comment.id %>" 
                                          onsubmit="postComment(event, <%= comment.id %>)" 
                                          class="hidden mt-3 ps-12 space-y-2">
                                        <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs space-y-2">
                                            <textarea id="reply-input-<%= comment.id %>" rows="2" 
                                                      placeholder="Write a reply to <%= comment.username || comment.full_name %>..." 
                                                      required
                                                      class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 resize-y"></textarea>
                                            <div class="flex items-center justify-end gap-2">
                                                <button type="button" onclick="toggleReplyBox(<%= comment.id %>)" 
                                                        class="px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 text-xs font-semibold cursor-pointer press-tactile">
                                                    Cancel
                                                </button>
                                                <button type="submit" 
                                                        class="px-4 py-1.5 rounded-lg bg-pink-600 hover:bg-pink-700 text-white text-xs font-bold cursor-pointer shadow-2xs press-tactile">
                                                    Reply
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                <% } %>

                                <!-- 1-Level Nested Direct Replies -->
                                <% if (comment.replies && comment.replies.length > 0) { %>
                                    <div class="mt-3.5 ms-6 sm:ms-12 ps-3 sm:ps-4 border-l-2 border-pink-200 space-y-3">
                                        <% comment.replies.forEach(function(reply) { %>
                                            <% 
                                                const isReplyAuthor = userObj && userObj.id === reply.user_id;
                                                const isReplySubmitter = (event.organizer_id && reply.user_id === event.organizer_id) || Boolean(reply.is_organizer);
                                                const isReplyAdmin = (reply.role || '').toUpperCase() === 'ADMIN';
                                            %>
                                            <div id="comment-<%= reply.id %>" class="bg-white p-3 sm:p-3.5 rounded-xl border border-slate-200/80 shadow-2xs">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-center gap-2.5">
                                                        <span class="text-pink-500 font-bold text-xs">↳</span>
                                                        <div class="w-7 h-7 rounded-full bg-slate-200 text-slate-700 font-bold text-[11px] flex items-center justify-center shrink-0 border border-slate-300 overflow-hidden">
                                                            <% if (reply.profile_image) { %>
                                                                <img src="<%= reply.profile_image %>" alt="" class="w-full h-full object-cover">
                                                            <% } else { %>
                                                                <%= (reply.username || reply.full_name || 'F').charAt(0).toUpperCase() %>
                                                            <% } %>
                                                        </div>
                                                        <div class="flex flex-wrap items-center gap-1.5">
                                                            <span class="text-xs font-bold text-slate-900">
                                                                <%= reply.username || reply.full_name %>
                                                            </span>
                                                            <% if (isReplySubmitter) { %>
                                                                <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-pink-100 text-pink-700 border border-pink-200">
                                                                    Event Submitter
                                                                </span>
                                                            <% } %>
                                                            <% if (isReplyAdmin) { %>
                                                                <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-violet-100 text-violet-700 border border-violet-200">
                                                                    Admin
                                                                </span>
                                                            <% } %>
                                                            <% if (typeof userFlairs !== 'undefined' && userFlairs[reply.user_id]) { %>
                                                                <a href="/passport/<%= reply.username %>" class="px-2 py-0.5 rounded-full text-[9px] font-black <%= userFlairs[reply.user_id].bg %> flex items-center gap-1 hover:opacity-90 transition-opacity" title="K-Sync Concert Passport: <%= userFlairs[reply.user_id].title %>">
                                                                    <i class="fas <%= userFlairs[reply.user_id].icon %> text-[8px]"></i>
                                                                    <span><%= userFlairs[reply.user_id].title %></span>
                                                                </a>
                                                            <% } %>
                                                            <span class="text-slate-400 text-[10px]">
                                                                • <%= helpers.timeAgo(reply.created_at) %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <% if (isReplyAuthor || isAdmin) { %>
                                                        <button onclick="deleteComment(<%= reply.id %>)" 
                                                                class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors text-xs cursor-pointer press-tactile" 
                                                                title="Delete reply">
                                                            <i class="fas fa-trash-can text-[10px]"></i>
                                                        </button>
                                                    <% } %>
                                                </div>

                                                <div class="text-xs text-slate-700 leading-relaxed whitespace-pre-line mt-1.5 ps-6">
                                                    <%= reply.message %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right 1 Col: Event Summary & Map, Organizer Legitimacy, Reference ID -->
        <div class="space-y-6">
            <!-- Event Schedule & Location Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm space-y-5">
                <h3 class="text-base font-black text-slate-900 border-b border-slate-100 pb-3 flex items-center justify-between">
                    <span>Showtime & Venue Intel</span>
                    <span class="text-[11px] font-bold text-pink-600 bg-pink-50 px-2 py-0.5 rounded-full">
                        <%= event.cluster_area || 'Kuala Lumpur' %>
                    </span>
                </h3>

                <div class="space-y-4 text-xs">
                    <div class="flex items-start">
                        <div class="w-9 h-9 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center shrink-0 me-3 shadow-2xs">
                            <i class="far fa-calendar-check text-sm"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Concert Date</div>
                            <div class="text-slate-600 font-medium"><%= helpers.formatDate(event.event_date) %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-9 h-9 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center shrink-0 me-3 shadow-2xs">
                            <i class="far fa-clock text-sm"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900">Door & Showtime</div>
                            <div class="text-slate-600 font-medium"><%= helpers.formatTime(event.start_time) %> <%= event.end_time ? '– ' + helpers.formatTime(event.end_time) : '' %></div>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 me-3 shadow-2xs">
                            <i class="fas fa-location-dot text-sm"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900"><%= event.venue_name %></div>
                            <div class="text-slate-500 text-[11px]"><%= event.address ? event.address + ', ' : '' %><%= event.city %>, <%= event.state %></div>
                            <% const mapUrl = event.map_link || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(event.venue_name + ' ' + (event.city || 'Malaysia'))); %>
                            <a href="<%= mapUrl %>" target="_blank" rel="noopener noreferrer" class="text-pink-600 font-bold hover:underline inline-flex items-center gap-1 mt-1.5 press-tactile">
                                <i class="fas fa-arrow-up-right-from-square text-[10px]"></i> Open in Google Maps ↗
                            </a>
                        </div>
                    </div>

                    <!-- Interactive Venue Map Explorer -->
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-black text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fas fa-map-location-dot text-rose-500"></i> Interactive Venue Map
                            </span>
                            <a href="https://maps.google.com/?q=<%= mapQuery %>" target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold text-pink-600 hover:underline flex items-center gap-1 press-tactile">
                                <span>Directions</span>
                                <i class="fas fa-arrow-up-right-from-square text-[9px]"></i>
                            </a>
                        </div>
                        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-xs h-56 bg-slate-100 relative">
                            <!-- Guaranteed Render Map via CARTO Basemaps & Leaflet -->
                            <div id="venue-carto-map" class="w-full h-full z-10"></div>
                        </div>
                    </div>
                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const mapContainer = document.getElementById('venue-carto-map');
                            if (!mapContainer || typeof L === 'undefined') return;

                            try {
                                const venueCoords = [<%= venueCoords[0] %>, <%= venueCoords[1] %>];
                                const vMap = L.map('venue-carto-map', {
                                    center: venueCoords,
                                    zoom: 15,
                                    zoomControl: true,
                                    attributionControl: false
                                });

                                const cartoKey = "<%= typeof cartoApiKey !== 'undefined' ? cartoApiKey : 'cb1_4rvy_1_933f092a5de2104f28a689ca' %>";
                                L.tileLayer(`https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=${cartoKey}`, {
                                    maxZoom: 19,
                                    subdomains: 'abcd'
                                }).addTo(vMap);

                                const customIcon = L.divIcon({
                                    className: 'venue-marker-pin',
                                    html: `
                                        <div style="transform: translate(-50%, -50%);">
                                            <div style="width: 32px; height: 32px; border-radius: 12px; background: #0f172a; border: 2px solid #ec4899; box-shadow: 0 4px 14px rgba(236,72,153,0.4); display: flex; align-items: center; justify-content: center; color: white;">
                                                <i class="fas fa-location-dot" style="color: #f472b6; font-size: 14px;"></i>
                                            </div>
                                        </div>
                                    `,
                                    iconSize: [32, 32],
                                    iconAnchor: [16, 16]
                                });

                                L.marker(venueCoords, { icon: customIcon }).addTo(vMap)
                                    .bindPopup(`
                                        <div style="padding: 4px; font-family: ui-sans-serif, system-ui, sans-serif; min-width: 180px;">
                                            <strong style="font-size: 13px; color: #0f172a;"><%= event.venue_name.replace(/"/g, '\\"') %></strong>
                                            <p style="font-size: 11px; color: #64748b; margin: 4px 0;"><%= (event.address ? event.address + ', ' : '') + event.city %></p>
                                            <a href="https://maps.google.com/?q=<%= mapQuery %>" target="_blank" rel="noopener noreferrer" style="font-size: 11px; font-weight: bold; color: #db2777; text-decoration: none;">Open in Google Maps ↗</a>
                                        </div>
                                    `)
                                    .openPopup();

                                setTimeout(() => { vMap.invalidateSize(); }, 300);
                            } catch (e) {
                                console.error('Venue map error:', e);
                            }
                        });
                    </script>
                </div>

                <% if (event.transit_info) { %>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs">
                        <div class="font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                            <i class="fas fa-train text-violet-600"></i>
                            <span>Public Transit & LRT Directions</span>
                        </div>
                        <div class="text-slate-600 leading-relaxed"><%= event.transit_info %></div>
                    </div>
                <% } %>
            </div>

            <!-- Organizer / Fanclub Legitimacy Card -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                        <i class="fas fa-shield-halved text-pink-600"></i>
                        <span>Organizer Legitimacy</span>
                    </h3>
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full <%= ticketSec.statusClass %>">
                        <i class="fas <%= ticketSec.icon %> me-1"></i> <%= ticketSec.badge %>
                    </span>
                </div>

                <div>
                    <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Host / Promoter</div>
                    <div class="font-black text-base text-slate-900 mt-0.5"><%= displayOrgName %></div>
                    
                    <div class="mt-2.5 flex flex-wrap gap-2">
                        <% if (event.is_verified_organizer === 1 || event.promoter_name) { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-800 border border-emerald-300">
                                <i class="fas fa-certificate text-emerald-500 me-1.5"></i> Verified Entity
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                <i class="fas fa-users text-slate-400 me-1.5"></i> Community Organizer
                            </span>
                        <% } %>

                        <% if (orgSocialLink) { %>
                            <a href="<%= orgSocialLink %>" target="_blank" rel="noopener noreferrer" 
                               class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-pink-50 hover:bg-pink-100 text-pink-700 border border-pink-200 transition-colors press-tactile">
                                <i class="fab fa-x-twitter me-1.5 text-pink-600"></i> <%= rawHandle || 'Official Profile' %>
                                <i class="fas fa-arrow-up-right-from-square text-[9px] ms-1.5 text-pink-400"></i>
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Anti-Fraud Trust Check -->
                <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200/80 space-y-2 text-[11px] text-slate-600">
                    <div class="font-bold text-slate-800 text-xs flex items-center gap-1.5">
                        <i class="fas fa-robot text-violet-600"></i>
                        <span>Autonomous Dual-AI Verification Audit</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-emerald-500 text-[10px] mt-0.5"></i>
                        <span>Ensemble verified: <strong class="text-slate-800">Vision OCR + Semantic Auditor Consensus</strong></span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-emerald-500 text-[10px] mt-0.5"></i>
                        <span>Official source gateway: <strong class="text-slate-800"><%= ticketSec.domain %></strong></span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-shield text-violet-500 text-[10px] mt-0.5"></i>
                        <span>Backed by 4-layer verified community anti-scalper reporting</span>
                    </div>
                </div>
            </div>

            <!-- Official K-Sync Verification Card & Reference Code -->
            <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-violet-950 rounded-3xl p-6 text-white shadow-xl space-y-4 border border-white/10">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-lg shadow-xs">
                        <i class="fas fa-shield-check"></i>
                    </div>
                    <span class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        <i class="fas fa-circle-check me-1"></i> Verified Record
                    </span>
                </div>
                <div>
                    <h3 class="font-black text-sm text-white">Event Reference Tracking ID</h3>
                    <p class="text-[11px] text-slate-300 mt-0.5">Use this immutable code to track verified concert schedule changes.</p>
                </div>
                <div class="flex items-center justify-between bg-white/10 rounded-xl p-3 border border-white/10 font-mono text-xs">
                    <span class="text-pink-300 font-bold tracking-wider"><%= event.tracking_code || 'KS-2026-MY001' %></span>
                    <button onclick="copyRefCode('<%= event.tracking_code || 'KS-2026-MY001' %>')" 
                            class="text-[11px] text-slate-300 hover:text-white font-sans font-bold flex items-center gap-1 cursor-pointer transition-colors press-tactile">
                        <i class="far fa-copy text-xs"></i>
                        <span>Copy</span>
                    </button>
                </div>
                <div class="text-[11px] text-slate-300/90 leading-relaxed pt-1 border-t border-white/10 space-y-1">
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-check text-pink-400 text-[10px] mt-0.5"></i>
                        <span>Direct synchronization with official promoter calendar</span>
                    </div>
                    <div class="flex items-start gap-1.5">
                        <i class="fas fa-ban text-rose-400 text-[10px] mt-0.5"></i>
                        <span>Never buy from unauthorized secondary scalpers</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Lightbox Fullscreen Viewer Modal -->
