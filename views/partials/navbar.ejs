                                            <i class="fas fa-heart"></i>
                                        </div>
                                        <span>Saved Wishlist</span>
                                    </a>
                                    <a href="/passport" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-xs group-hover/item:bg-purple-100 transition-colors shrink-0">
                                            <i class="fas fa-passport"></i>
                                        </div>
                                        <span>Fan Passport</span>
                                    </a>
                                    <div class="h-px bg-slate-100 my-1 mx-2"></div>
                                    <a href="/profile" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center text-xs group-hover/item:bg-slate-200 transition-colors shrink-0">
