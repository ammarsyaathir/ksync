                                            <i class="fas fa-house-user"></i>
                                        </div>
                                        <span>Personal Dashboard</span>
                                    </a>
                                    <a href="/saved-events" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
