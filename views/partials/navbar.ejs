<%
    const user = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
    const path = (typeof activePath !== 'undefined' && activePath) ? activePath : '';
    const userRole = (user && (user.role || user.role_name)) ? String(user.role || user.role_name).toLowerCase() : '';
    const userInit = (user && user.full_name) ? user.full_name.trim().charAt(0).toUpperCase() : 'U';
    const userFirstName = (user && user.full_name) ? user.full_name.trim().split(' ')[0] : 'Fan';
    const unread = (typeof unreadCount !== 'undefined') ? Number(unreadCount) : 0;
%>

<!-- Fixed Floating Glassmorphism Navigation Bar -->
<div class="sticky top-0 sm:top-2.5 z-50 w-full px-2 sm:px-4 lg:px-6 transition-all duration-300">
    <header id="main-glass-nav" class="max-w-7xl mx-auto glass-nav rounded-2xl sm:rounded-3xl px-3 sm:px-5 lg:px-6 py-2 sm:py-2.5 transition-all duration-200">
        <div class="flex items-center justify-between h-12 sm:h-14">
            <!-- Brand Wordmark & Logo -->
            <div class="flex items-center space-x-3 shrink-0">
                <a href="/" class="flex items-center space-x-2.5 press-tactile group cursor-pointer" title="K-Sync Malaysia Homepage">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-gradient-to-tr from-slate-950 via-purple-950 to-slate-900 flex items-center justify-center text-white text-base shadow-sm ring-1 ring-slate-900/10 group-hover:scale-105 transition-transform duration-200">
                        <i class="fas fa-bolt text-pink-400 group-hover:text-pink-300 transition-colors"></i>
                    </div>
                    <div class="flex items-center space-x-1.5">
                        <span class="text-xl font-black tracking-[-0.03em] text-slate-900 font-sans">K-SYNC</span>
                        <span class="text-[10px] font-black px-1.5 py-0.5 rounded-md bg-slate-900 text-white uppercase tracking-wider">MY</span>
                        <% if (userRole === 'organizer') { %>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200/80 ms-1 hidden sm:inline-flex items-center gap-1">
                                <i class="fas fa-circle-check text-[9px] text-emerald-600"></i> HOST
                            </span>
                        <% } else if (userRole === 'admin') { %>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200/80 ms-1 hidden sm:inline-flex items-center gap-1">
                                <i class="fas fa-shield-halved text-[9px] text-purple-600"></i> MAINTAINER
                            </span>
                        <% } %>
                    </div>
                </a>
            </div>

            <!-- Desktop Navigation Links (Actor-Tailored with Tactile Floating Pills) -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-1.5" aria-label="Main Navigation">
                <a href="/" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all press-tactile cursor-pointer <%= path === '/' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                    <span>Home</span>
                </a>
                <a href="/events" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= (path === '/events' || path.startsWith('/events/')) && path !== '/events/radar' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                    <i class="fas fa-compass text-xs text-slate-400"></i>
                    <span>Discover</span>
                </a>

                <% if (userRole === 'organizer') { %>
                    <!-- Organizer-Only Controls: Streamlined & Accessible -->
                    <a href="/organizer/dashboard" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/organizer') ? 'bg-emerald-700 text-white shadow-xs' : 'bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-200' %>">
                        <i class="fas fa-gauge text-xs text-emerald-500"></i>
                        <span>Organizer Portal</span>
                    </a>
                    <a href="/submit-event" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer bg-slate-900 hover:bg-slate-800 text-white shadow-xs">
                        <i class="fas fa-wand-magic-sparkles text-xs text-pink-400"></i>
                        <span>AI Submit</span>
                    </a>
                    <a href="/profile" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/profile') ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-building text-xs text-slate-400"></i>
                        <span>Org Profile</span>
                    </a>
                <% } else if (userRole === 'admin') { %>
                    <!-- Admin Controls: Comprehensive, Clean & Responsive -->
                    <a href="/admin" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path === '/admin' ? 'bg-purple-900 text-white shadow-xs' : 'bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-200' %>">
                        <i class="fas fa-chart-line text-xs <%= path === '/admin' ? 'text-purple-300' : 'text-purple-600' %>"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/admin/events" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/events') ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-calendar-days text-xs text-purple-500"></i>
                        <span>Events</span>
                    </a>
                    <a href="/admin/verifications" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/verifications') ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-check-double text-xs text-pink-500"></i>
                        <span>Verifications</span>
                    </a>
                    <a href="/admin/artists" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/artists') ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-microphone-lines text-xs text-indigo-500"></i>
                        <span>Artists</span>
                    </a>
                    <a href="/admin/reports" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/reports') ? 'bg-rose-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-shield-virus text-xs text-rose-500"></i>
                        <span>Reports</span>
                    </a>

                    <!-- Admin System Dropdown Menu -->
                    <div class="relative group">
                        <button type="button" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= (path.startsWith('/admin/venues') || path.startsWith('/admin/categories') || path.startsWith('/admin/users') || path.startsWith('/admin/logs')) ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                            <i class="fas fa-sliders text-xs text-slate-400"></i>
                            <span>System</span>
                            <i class="fas fa-chevron-down text-[9px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                        </button>
                        <div class="absolute left-0 mt-2 w-48 glass-dropdown rounded-2xl py-1.5 hidden group-hover:block transition-all z-50">
                            <a href="/admin/venues" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-location-dot w-4 text-emerald-500 me-2"></i>
                                <span>Venues & Transit</span>
                            </a>
                            <a href="/admin/categories" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-layer-group w-4 text-pink-500 me-2"></i>
                                <span>Categories</span>
                            </a>
                            <a href="/admin/users" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-users-gear w-4 text-indigo-500 me-2"></i>
                                <span>Users & Roles</span>
                            </a>
                            <a href="/admin/logs" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-clock-rotate-left w-4 text-amber-500 me-2"></i>
                                <span>Audit Logs</span>
                            </a>
                            <div class="border-t border-slate-100 my-1"></div>
                            <a href="/events" target="_blank" class="flex items-center px-3.5 py-2 text-xs font-medium text-slate-500 hover:bg-slate-50 hover:text-slate-900">
                                <i class="fas fa-arrow-up-right-from-square w-4 text-slate-400 me-2"></i>
                                <span>Public Portal</span>
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Fan & Guest Discovery: Artists, 360° Radar, For Organizers -->
                    <a href="/artists" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/artists') ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-microphone-lines text-xs text-purple-500"></i>
                        <span>Artists</span>
                    </a>
                    <a href="/events/radar" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path === '/events/radar' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
                        </span>
                        <span>360° Radar</span>
                    </a>
                    <a href="/submit-event" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer text-slate-600 hover:text-pink-600 hover:bg-pink-50/60">
                        <i class="fas fa-bullhorn text-xs text-pink-500"></i>
                        <span>For Organizers</span>
                    </a>
                <% } %>
            </nav>

            <!-- Right Controls: Saved, Notifications & User Menu (Matching Example Accent CTA) -->
            <div class="hidden md:flex items-center space-x-2">
                <% if (user) { %>
                    <!-- Saved Events Wishlist -->
                    <a href="/saved-events" class="p-2 text-slate-500 hover:text-pink-600 hover:bg-pink-50 rounded-xl transition-colors press-tactile cursor-pointer" title="Wishlist & Saved Shows">
                        <i class="fas fa-heart text-sm"></i>
                    </a>

                    <!-- Notifications Bell Tray with Animated Glow -->
                    <a href="/notifications" class="relative p-2 text-slate-500 hover:text-purple-600 hover:bg-purple-50 rounded-xl transition-colors press-tactile cursor-pointer" title="Notification Center">
                        <i class="fas fa-bell text-sm"></i>
                        <% if (unread > 0) { %>
                            <span class="absolute top-1 right-1 w-4 h-4 bg-pink-500 text-white text-[10px] font-black rounded-full flex items-center justify-center animate-pulse shadow-xs">
                                <%= unread > 9 ? '9+' : unread %>
                            </span>
                        <% } %>
                    </a>

                    <!-- User Profile Dropdown Pill -->
                    <div class="relative group ms-1">
                        <button class="flex items-center space-x-2 py-1 px-2 rounded-xl hover:bg-slate-900/5 transition-colors press-tactile focus:outline-none cursor-pointer">
                            <% if (user.profile_image) { %>
                                <img src="<%= user.profile_image %>" alt="<%= user.full_name %>" class="w-8 h-8 rounded-xl object-cover border border-slate-200 shadow-2xs">
                            <% } else { %>
                                <div class="w-8 h-8 rounded-xl bg-slate-900 text-white font-black text-xs flex items-center justify-center ring-1 ring-slate-900/10 shadow-2xs">
                                    <%= userInit %>
                                </div>
                            <% } %>
                            <span class="text-xs font-bold text-slate-900 font-sans"><%= userFirstName %></span>
                            <i class="fas fa-chevron-down text-[10px] text-slate-400"></i>
                        </button>
                        <!-- Menu Drawer Popover -->
                        <div class="absolute right-0 mt-2 w-52 glass-dropdown rounded-2xl py-1.5 hidden group-hover:block transition-all z-50">
                            <div class="px-4 py-2.5 border-b border-slate-100">
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Signed in as</div>
                                <div class="text-xs font-bold text-slate-900 truncate">@<%= user.username %></div>
                            </div>
                            <% if (userRole === 'organizer') { %>
                                <a href="/organizer/dashboard" class="flex items-center px-4 py-2 text-xs font-bold text-emerald-800 hover:bg-emerald-50">
                                    <i class="fas fa-gauge w-5 text-emerald-600"></i>
                                    <span>Organizer Portal</span>
                                </a>
                                <a href="/submit-event" class="flex items-center px-4 py-2 text-xs font-bold text-slate-800 hover:bg-slate-50">
                                    <i class="fas fa-plus w-5 text-pink-500"></i>
                                    <span>Publish Concert</span>
                                </a>
                                <a href="/profile" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50">
                                    <i class="fas fa-building w-5 text-slate-400"></i>
                                    <span>Organization Profile</span>
                                </a>
                            <% } else if (userRole === 'admin') { %>
                                <a href="/admin" class="flex items-center px-4 py-2 text-xs font-bold text-purple-700 hover:bg-purple-50">
                                    <i class="fas fa-shield-halved w-5 text-purple-500"></i>
                                    <span>Maintainer Hub</span>
                                </a>
                                <a href="/admin/reports" class="flex items-center px-4 py-2 text-xs font-bold text-rose-700 hover:bg-rose-50">
                                    <i class="fas fa-shield-virus w-5 text-rose-500"></i>
                                    <span>Audit Scam Reports</span>
                                </a>
                                <a href="/profile" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50">
                                    <i class="fas fa-user-shield w-5 text-slate-400"></i>
                                    <span>Admin Profile</span>
                                </a>
                            <% } else { %>
                                <a href="/profile" class="flex items-center px-4 py-2 text-xs font-bold text-slate-900 hover:bg-slate-50">
                                    <i class="fas fa-user-circle w-5 text-pink-500"></i>
                                    <span>My Profile</span>
                                </a>
                                <a href="/saved-events" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50">
                                    <i class="fas fa-heart w-5 text-rose-500"></i>
                                    <span>Saved Wishlist</span>
                                </a>
                                <a href="/passport" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50">
                                    <i class="fas fa-passport w-5 text-purple-500"></i>
                                    <span>Fan Passport</span>
                                </a>
                            <% } %>
                            <div class="border-t border-slate-100 my-1"></div>
                            <a href="/logout" class="flex items-center px-4 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50">
                                <i class="fas fa-arrow-right-from-bracket w-5 text-rose-400"></i>
                                <span>Log Out</span>
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="text-xs font-bold text-slate-700 hover:text-slate-900 px-3.5 py-2 rounded-xl hover:bg-slate-900/5 transition-colors press-tactile">
                        Log In
                    </a>
                    <!-- Accent Pill CTA Button (Like example image) -->
                    <a href="/register" class="text-xs font-extrabold text-white bg-gradient-to-r from-slate-900 via-purple-950 to-slate-900 hover:from-slate-800 hover:to-slate-800 px-4 py-2.5 rounded-xl sm:rounded-2xl shadow-sm hover:shadow-md transition-all press-tactile flex items-center gap-1.5 cursor-pointer">
                        <span>Join K-Sync</span>
                        <i class="fas fa-arrow-right text-[10px] text-pink-400"></i>
                    </a>
                <% } %>
            </div>

            <!-- Mobile Right Controls: Notification & Hamburger Toggle Button -->
            <div class="flex md:hidden items-center space-x-1.5">
                <% if (user) { %>
                    <a href="/notifications" class="relative p-2 text-slate-600 hover:bg-slate-900/5 rounded-xl" title="Notifications">
                        <i class="fas fa-bell"></i>
                        <% if (unread > 0) { %>
                            <span class="absolute top-1 right-1 w-3.5 h-3.5 bg-pink-500 text-white text-[9px] font-black rounded-full flex items-center justify-center">
                                <%= unread > 9 ? '9+' : unread %>
                            </span>
                        <% } %>
                    </a>
                <% } %>
                <button id="mobile-menu-toggle" type="button" 
                        class="p-2 text-slate-700 hover:text-slate-900 rounded-xl hover:bg-slate-900/5 transition-colors focus:outline-none press-tactile cursor-pointer" 
                        aria-label="Toggle navigation menu" aria-expanded="false">
                    <i id="mobile-menu-icon" class="fas fa-bars text-lg text-slate-800"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Hamburger Menu Dropdown (Matching Frosted Glass Card) -->
    <div id="mobile-menu-dropdown" class="hidden md:hidden max-w-7xl mx-auto glass-dropdown rounded-2xl sm:rounded-3xl p-4 mt-2 space-y-1 shadow-2xl transition-all">
        <% if (userRole === 'organizer') { %>
            <!-- Organizer Mobile Links -->
            <div class="pb-2 mb-2 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <div class="text-[10px] font-black uppercase tracking-wider text-emerald-700">Organizer Mode</div>
                    <div class="text-xs font-bold text-slate-900 truncate"><%= user ? (user.organization_name || user.full_name) : 'Organizer' %></div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">HOST</span>
            </div>
            <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path === '/' ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-house w-4 text-slate-400"></i>
                <span>Home</span>
            </a>
            <a href="/events" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path === '/events' ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-compass w-4 text-slate-400"></i>
                <span>Discover Events</span>
            </a>
            <a href="/organizer/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/organizer') ? 'bg-emerald-700 text-white' : 'bg-emerald-50 text-emerald-800 hover:bg-emerald-100' %>">
                <i class="fas fa-gauge w-4 text-emerald-600"></i>
                <span>Organizer Portal</span>
            </a>
            <a href="/submit-event" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-slate-900 text-white">
                <i class="fas fa-plus w-4 text-pink-400"></i>
                <span>Publish Concert / Event</span>
            </a>
            <a href="/profile" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/profile') ? 'bg-slate-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-building w-4 text-slate-400"></i>
                <span>Organization Profile</span>
            </a>
        <% } else if (userRole === 'admin') { %>
            <!-- Admin Mobile Links -->
            <div class="pb-2 mb-2 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <div class="text-[10px] font-black uppercase tracking-wider text-purple-700">Administrator Console</div>
                    <div class="text-xs font-bold text-slate-900 truncate">@<%= user ? user.username : 'admin' %></div>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200">ADMIN</span>
            </div>
            <a href="/admin" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path === '/admin' ? 'bg-purple-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-chart-line w-4 text-purple-500"></i>
                <span>Dashboard</span>
            </a>
            <a href="/admin/events" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/admin/events') ? 'bg-purple-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-calendar-days w-4 text-purple-500"></i>
                <span>Events Catalog</span>
            </a>
            <a href="/admin/verifications" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/admin/verifications') ? 'bg-purple-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-check-double w-4 text-pink-500"></i>
                <span>Verifications Queue</span>
            </a>
            <a href="/admin/artists" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/admin/artists') ? 'bg-purple-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-microphone-lines w-4 text-indigo-500"></i>
                <span>Artists & Lineups</span>
            </a>
            <a href="/admin/reports" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/admin/reports') ? 'bg-rose-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-shield-virus w-4 text-rose-500"></i>
                <span>Scam Reports</span>
            </a>
            <a href="/admin/venues" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/admin/venues') ? 'bg-purple-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-location-dot w-4 text-emerald-500"></i>
                <span>Venues & Transit</span>
            </a>
            <a href="/admin/categories" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold <%= path.startsWith('/admin/categories') ? 'bg-purple-900 text-white' : 'text-slate-700 hover:bg-slate-100' %>">
                <i class="fas fa-layer-group w-4 text-pink-500"></i>
                <span>Categories</span>
            </a>
