<!-- Scroll Elevation Observer & Mobile Hamburger Toggle Script -->
<script>
    (function() {
        // Dynamic Elevation on Scroll for Floating Glass Pill
        const navHeader = document.getElementById('main-glass-nav');
        if (navHeader) {
            function updateNavScroll() {
                if (window.scrollY > 12) {
                    navHeader.classList.add('is-scrolled');
                } else {
                    navHeader.classList.remove('is-scrolled');
                }
            }
            window.addEventListener('scroll', updateNavScroll, { passive: true });
            updateNavScroll();
        }

        // Mobile Hamburger Drawer Toggle
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const menuDropdown = document.getElementById('mobile-menu-dropdown');
        const icon = document.getElementById('mobile-menu-icon');

        if (toggleBtn && menuDropdown) {
            toggleBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = !menuDropdown.classList.contains('hidden');
                if (isOpen) {
                    menuDropdown.classList.add('hidden');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    if (icon) icon.className = 'fas fa-bars text-lg text-slate-800';
                } else {
                    menuDropdown.classList.remove('hidden');
                    toggleBtn.setAttribute('aria-expanded', 'true');
                    if (icon) icon.className = 'fas fa-xmark text-lg text-slate-800';
                }
            });

            // Close menu when tapping outside
            document.addEventListener('click', function(e) {
                if (!menuDropdown.contains(e.target) && !toggleBtn.contains(e.target)) {
                    menuDropdown.classList.add('hidden');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    if (icon) icon.className = 'fas fa-bars text-lg text-slate-800';
                }
            });

            // Close on Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && !menuDropdown.classList.contains('hidden')) {
                    menuDropdown.classList.add('hidden');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    if (icon) icon.className = 'fas fa-bars text-lg text-slate-800';
                }
            });
        // Desktop User Menu Toggle & Outside Click Handler
        const userBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-menu-dropdown');
        const userChevron = document.getElementById('user-menu-chevron');

        if (userBtn && userDropdown) {
            function toggleUserMenu(forceState) {
                const isCurrentlyOpen = !userDropdown.classList.contains('hidden');
                const shouldOpen = forceState !== undefined ? forceState : !isCurrentlyOpen;

                if (shouldOpen) {
                    userDropdown.classList.remove('hidden');
                    userBtn.setAttribute('aria-expanded', 'true');
                    if (userChevron) userChevron.classList.add('rotate-180');
                } else {
                    userDropdown.classList.add('hidden');
                    userBtn.setAttribute('aria-expanded', 'false');
                    if (userChevron) userChevron.classList.remove('rotate-180');
                }
            }

            userBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                toggleUserMenu();
            });

            document.addEventListener('click', function(e) {
                if (!userDropdown.contains(e.target) && !userBtn.contains(e.target)) {
                    toggleUserMenu(false);
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && !userDropdown.classList.contains('hidden')) {
                    toggleUserMenu(false);
                }
            });
        }
    })();
</script>
