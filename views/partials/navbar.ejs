<%
    const user = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
    const path = (typeof activePath !== 'undefined' && activePath) ? activePath : '';
    const userRole = (user && (user.role || user.role_name)) ? String(user.role || user.role_name).toLowerCase() : '';
    const userInit = (user && user.full_name) ? user.full_name.trim().charAt(0).toUpperCase() : 'U';
    const userFirstName = (user && user.full_name) ? user.full_name.trim().split(' ')[0] : 'Fan';
    const unread = (typeof unreadCount !== 'undefined') ? Number(unreadCount) : 0;
%>

<!-- Fixed Floating Glassmorphism Navigation Bar -->
<div class="sticky top-0 sm:top-2.5 z-50 w-full px-2 sm:px-4 lg:px-6 transition-all duration-300">
    <header id="main-glass-nav" class="max-w-7xl mx-auto glass-nav rounded-2xl sm:rounded-3xl px-3 sm:px-5 lg:px-6 py-2 sm:py-2.5 transition-all duration-200">
        <div class="flex items-center justify-between h-12 sm:h-14">
            <!-- Brand Wordmark & Logo -->
            <div class="flex items-center space-x-3 shrink-0">
                <a href="/" class="flex items-center space-x-2.5 press-tactile group cursor-pointer" title="K-Sync Malaysia Homepage">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-gradient-to-tr from-slate-950 via-purple-950 to-slate-900 flex items-center justify-center text-white text-base shadow-sm ring-1 ring-slate-900/10 group-hover:scale-105 transition-transform duration-200">
                        <i class="fas fa-bolt text-pink-400 group-hover:text-pink-300 transition-colors"></i>
                    </div>
                    <div class="flex items-center space-x-1.5">
                        <span class="text-xl font-black tracking-[-0.03em] text-slate-900 font-sans">K-SYNC</span>
                        <span class="text-[10px] font-black px-1.5 py-0.5 rounded-md bg-slate-900 text-white uppercase tracking-wider">MY</span>
                        <% if (userRole === 'organizer') { %>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200/80 ms-1 hidden sm:inline-flex items-center gap-1">
                                <i class="fas fa-circle-check text-[9px] text-emerald-600"></i> HOST
                            </span>
                        <% } else if (userRole === 'admin') { %>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200/80 ms-1 hidden sm:inline-flex items-center gap-1">
                                <i class="fas fa-shield-halved text-[9px] text-purple-600"></i> MAINTAINER
                            </span>
                        <% } %>
                    </div>
                </a>
            </div>

            <!-- Desktop Navigation Links (Actor-Tailored with Tactile Floating Pills) -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-1.5" aria-label="Main Navigation">
                <% if (userRole === 'organizer') { %>
                    <!-- Organizer-Only Controls: Exactly 3 Core Links + Plus Submit Icon -->
                    <a href="/organizer/dashboard" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path === '/organizer' || path === '/organizer/dashboard' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <span class="w-2 h-2 rounded-full <%= path === '/organizer' || path === '/organizer/dashboard' ? 'bg-emerald-400 animate-pulse' : 'bg-slate-400' %>"></span>
                        <span>Dashboard</span>
                    </a>
                    <a href="/organizer/events" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/organizer/events') && path !== '/organizer/events/new' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-list-check text-xs text-purple-500"></i>
                        <span>My Events</span>
                    </a>
                    <a href="/organizer/events/new" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer bg-slate-900 hover:bg-slate-800 text-white shadow-xs">
                        <i class="fas fa-plus text-xs text-[#c6f03d]"></i>
                        <span>Submit Event</span>
                    </a>
                    <div class="h-4 w-px bg-slate-200 mx-1"></div>
                    <a href="/events" target="_blank" class="px-3 py-2 rounded-xl text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-100 flex items-center space-x-1 transition-colors">
                        <i class="fas fa-arrow-up-right-from-square text-[10px] text-slate-400"></i>
                        <span>Public View</span>
                    </a>
                <% } else if (userRole === 'admin') { %>
                    <a href="/" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all press-tactile cursor-pointer <%= path === '/' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <span>Home</span>
                    </a>
                    <a href="/events" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= (path === '/events' || path.startsWith('/events/')) && path !== '/events/radar' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-compass text-xs text-slate-400"></i>
                        <span>Discover</span>
                    </a>
                    <!-- Admin Controls: Comprehensive, Clean & Responsive -->
                    <a href="/admin" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path === '/admin' ? 'bg-purple-900 text-white shadow-xs' : 'bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-200' %>">
                        <i class="fas fa-chart-line text-xs <%= path === '/admin' ? 'text-purple-300' : 'text-purple-600' %>"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/admin/events" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/events') ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-calendar-days text-xs text-purple-500"></i>
                        <span>Events</span>
                    </a>
                    <a href="/admin/verifications" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/verifications') ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-check-double text-xs text-pink-500"></i>
                        <span>Verifications</span>
                    </a>
                    <a href="/admin/artists" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/artists') ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-microphone-lines text-xs text-indigo-500"></i>
                        <span>Artists</span>
                    </a>
                    <a href="/admin/reports" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/admin/reports') ? 'bg-rose-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-shield-virus text-xs text-rose-500"></i>
                        <span>Reports</span>
                    </a>

                    <!-- Admin System Dropdown Menu -->
                    <div class="relative group">
                        <button type="button" class="px-3 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 press-tactile cursor-pointer <%= (path.startsWith('/admin/venues') || path.startsWith('/admin/categories') || path.startsWith('/admin/users') || path.startsWith('/admin/logs')) ? 'bg-purple-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                            <i class="fas fa-sliders text-xs text-slate-400"></i>
                            <span>System</span>
                            <i class="fas fa-chevron-down text-[9px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                        </button>
                        <div class="absolute left-0 mt-2 w-48 glass-dropdown rounded-2xl py-1.5 hidden group-hover:block transition-all z-50">
                            <a href="/admin/venues" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-location-dot w-4 text-emerald-500 me-2"></i>
                                <span>Venues & Transit</span>
                            </a>
                            <a href="/admin/categories" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-layer-group w-4 text-pink-500 me-2"></i>
                                <span>Categories</span>
                            </a>
                            <a href="/admin/users" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-users-gear w-4 text-indigo-500 me-2"></i>
                                <span>Users & Roles</span>
                            </a>
                            <a href="/admin/logs" class="flex items-center px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                                <i class="fas fa-clock-rotate-left w-4 text-amber-500 me-2"></i>
                                <span>Audit Logs</span>
                            </a>
                            <div class="border-t border-slate-100 my-1"></div>
                            <a href="/events" target="_blank" class="flex items-center px-3.5 py-2 text-xs font-medium text-slate-500 hover:bg-slate-50 hover:text-slate-900">
                                <i class="fas fa-arrow-up-right-from-square w-4 text-slate-400 me-2"></i>
                                <span>Public Portal</span>
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Fan & Guest Main Navigation: Discovery / Event / Radar / Artist -->
                    <a href="/" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path === '/' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-compass text-xs <%= path === '/' ? 'text-pink-400' : 'text-slate-400' %>"></i>
                        <span>Discovery</span>
                    </a>
                    <a href="/events" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= (path === '/events' || (path.startsWith('/events/') && path !== '/events/radar')) ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-calendar-days text-xs <%= (path === '/events' || (path.startsWith('/events/') && path !== '/events/radar')) ? 'text-[#c6f03d]' : 'text-purple-500' %>"></i>
                        <span>Event</span>
                    </a>
                    <a href="/events/radar" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path === '/events/radar' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
                        </span>
                        <span>Radar</span>
                    </a>
                    <a href="/artists" class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 press-tactile cursor-pointer <%= path.startsWith('/artists') ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-slate-900/5' %>">
                        <i class="fas fa-microphone-lines text-xs <%= path.startsWith('/artists') ? 'text-purple-300' : 'text-purple-500' %>"></i>
                        <span>Artist</span>
                    </a>
                <% } %>
            </nav>

            <!-- Right Controls: Saved, Notifications & User Menu (Matching Example Accent CTA) -->
            <div class="hidden md:flex items-center space-x-2">
                <% if (user) { %>
                    <!-- Saved Events Wishlist -->
                    <a href="/saved-events" class="p-2 text-slate-500 hover:text-pink-600 hover:bg-pink-50 rounded-xl transition-colors press-tactile cursor-pointer" title="Wishlist & Saved Shows">
                        <i class="fas fa-heart text-sm"></i>
                    </a>

                    <!-- Notifications Bell Tray with Animated Glow -->
                    <a href="/notifications" class="relative p-2 text-slate-500 hover:text-purple-600 hover:bg-purple-50 rounded-xl transition-colors press-tactile cursor-pointer" title="Notification Center">
                        <i class="fas fa-bell text-sm"></i>
                        <% if (unread > 0) { %>
                            <span class="absolute top-1 right-1 w-4 h-4 bg-pink-500 text-white text-[10px] font-black rounded-full flex items-center justify-center animate-pulse shadow-xs">
                                <%= unread > 9 ? '9+' : unread %>
                            </span>
                        <% } %>
                    </a>

                    <!-- User Profile Dropdown Pill -->
                    <div class="relative group ms-1" id="user-menu-wrapper">
                        <button id="user-menu-btn" 
                                type="button" 
                                class="flex items-center gap-2 py-1 px-2.5 rounded-full border border-slate-200/90 bg-white hover:bg-slate-50 text-slate-800 transition-all press-tactile focus:outline-none focus:ring-2 focus:ring-slate-900/10 cursor-pointer shadow-2xs"
                                aria-expanded="false" 
                                aria-haspopup="true">
                            <% if (user.profile_image) { %>
                                <img src="<%= user.profile_image %>" alt="<%= user.full_name %>" class="w-7 h-7 rounded-full object-cover border border-slate-200 shadow-2xs">
                            <% } else { %>
                                <div class="w-7 h-7 rounded-full bg-slate-950 text-white font-black text-xs flex items-center justify-center shadow-2xs">
                                    <%= userInit %>
                                </div>
                            <% } %>
                            <span class="text-xs font-extrabold text-slate-900 font-sans tracking-tight"><%= userFirstName %></span>
                            <i class="fas fa-chevron-down text-[10px] text-slate-400 group-hover:rotate-180 transition-transform duration-200" id="user-menu-chevron"></i>
                        </button>

                        <!-- Menu Drawer Popover (100% Solid White, High-Elevation Dropdown) -->
                        <div id="user-menu-dropdown" 
                             class="absolute right-0 mt-2.5 w-64 bg-white rounded-2xl border border-slate-200/90 shadow-2xl shadow-slate-900/15 overflow-hidden hidden group-hover:block transition-all z-[100]">
                            
                            <!-- Identity Header Compartment -->
                            <div class="p-3.5 bg-slate-50/90 border-b border-slate-100 flex items-center gap-3">
                                <% if (user.profile_image) { %>
                                    <img src="<%= user.profile_image %>" alt="<%= user.full_name %>" class="w-9 h-9 rounded-xl object-cover border border-slate-200 shadow-2xs shrink-0">
                                <% } else { %>
                                    <div class="w-9 h-9 rounded-xl bg-slate-950 text-white font-black text-xs flex items-center justify-center shadow-2xs shrink-0">
                                        <%= userInit %>
                                    </div>
                                <% } %>
                                <div class="min-w-0 flex-1">
                                    <div class="text-xs font-extrabold text-slate-900 truncate leading-tight">
                                        <%= user.organization_name || user.full_name || user.username %>
                                    </div>
                                    <div class="text-[11px] text-slate-500 truncate leading-tight mt-0.5">
                                        @<%= user.username %>
                                    </div>
                                </div>
                                <% if (userRole === 'organizer') { %>
                                    <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200 shrink-0">Host</span>
                                <% } else if (userRole === 'admin') { %>
                                    <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-purple-100 text-purple-800 border border-purple-200 shrink-0">Admin</span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-pink-100 text-pink-800 border border-pink-200 shrink-0">Fan</span>
                                <% } %>
                            </div>

                            <!-- Menu Action Items -->
                            <div class="p-1.5 space-y-0.5">
                                <% if (userRole === 'organizer') { %>
                                    <a href="/organizer/dashboard" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs group-hover/item:bg-emerald-100 transition-colors shrink-0">
                                            <i class="fas fa-gauge"></i>
                                        </div>
                                        <span>Organizer Dashboard</span>
                                    </a>
                                    <a href="/organizer/events" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-xs group-hover/item:bg-purple-100 transition-colors shrink-0">
                                            <i class="fas fa-list-check"></i>
                                        </div>
                                        <span>My Events</span>
                                    </a>
                                    <a href="/organizer/events/new" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-slate-900 text-[#c6f03d] flex items-center justify-center text-xs group-hover/item:bg-slate-800 transition-colors shrink-0">
                                            <i class="fas fa-plus"></i>
                                        </div>
                                        <span>Submit New Event</span>
                                    </a>
                                    <div class="h-px bg-slate-100 my-1 mx-2"></div>
                                    <a href="/profile" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center text-xs group-hover/item:bg-slate-200 transition-colors shrink-0">
                                            <i class="fas fa-building"></i>
                                        </div>
                                        <span>Organization Profile</span>
                                    </a>
                                    <a href="/events" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-slate-50 text-slate-400 flex items-center justify-center text-xs group-hover/item:bg-slate-100 transition-colors shrink-0">
                                            <i class="fas fa-compass"></i>
                                        </div>
                                        <span>Switch to Fan View</span>
                                    </a>
                                <% } else if (userRole === 'admin') { %>
                                    <a href="/admin" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-purple-50/80 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center text-xs group-hover/item:bg-purple-200 transition-colors shrink-0">
                                            <i class="fas fa-shield-halved"></i>
                                        </div>
                                        <span>Maintainer Hub</span>
                                    </a>
                                    <a href="/admin/reports" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-rose-50/80 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center text-xs group-hover/item:bg-rose-200 transition-colors shrink-0">
                                            <i class="fas fa-shield-virus"></i>
                                        </div>
                                        <span>Audit Scam Reports</span>
                                    </a>
                                    <div class="h-px bg-slate-100 my-1 mx-2"></div>
                                    <a href="/profile" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center text-xs group-hover/item:bg-slate-200 transition-colors shrink-0">
                                            <i class="fas fa-user-shield"></i>
                                        </div>
                                        <span>Admin Profile</span>
                                    </a>
                                    <a href="/events" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
                                        <div class="w-6 h-6 rounded-lg bg-slate-50 text-slate-400 flex items-center justify-center text-xs group-hover/item:bg-slate-100 transition-colors shrink-0">
                                            <i class="fas fa-earth-asia"></i>
                                        </div>
                                        <span>Public Portal</span>
                                    </a>
                                <% } else { %>
                                    <a href="/dashboard" class="group/item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-all cursor-pointer">
