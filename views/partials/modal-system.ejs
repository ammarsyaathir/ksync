<!-- Global In-App Confirmation Modal (Eliminates Browser "localhost:9000 says" Dialogs) -->
<div id="ksync-confirm-modal" 
     class="fixed inset-0 z-[100000] hidden items-center justify-center p-4 transition-all duration-200" 
     role="dialog" 
     aria-modal="true" 
     aria-labelledby="ksync-confirm-title">
  
  <!-- Soft Dark Blur Backdrop -->
  <div id="ksync-confirm-backdrop" 
       class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs opacity-0 transition-opacity duration-200"></div>

  <!-- Modal Dialog Card -->
  <div id="ksync-confirm-dialog" 
       class="relative bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200/90 transform scale-95 opacity-0 transition-all duration-200 ease-out z-10">
    
    <!-- Header with Icon & Text -->
    <div class="flex items-start gap-4">
      <div id="ksync-confirm-icon-wrap" 
           class="w-12 h-12 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center text-xl shrink-0 shadow-xs">
        <i id="ksync-confirm-icon" class="fas fa-trash-can"></i>
      </div>
      <div class="flex-1 min-w-0 pt-0.5">
        <h3 id="ksync-confirm-title" class="text-base font-black text-slate-900 tracking-tight">
          Confirm Action
        </h3>
        <p id="ksync-confirm-message" class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed font-medium">
          Are you sure you want to proceed?
        </p>
      </div>
    </div>

    <!-- Actions Footer -->
    <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
      <button type="button" 
              id="ksync-confirm-cancel" 
              class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer">
        Cancel
      </button>
      <button type="button" 
              id="ksync-confirm-ok" 
              class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-xs font-bold text-white shadow-lg shadow-rose-600/25 transition-all cursor-pointer">
        Yes, Proceed
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const modal = document.getElementById('ksync-confirm-modal');
    const backdrop = document.getElementById('ksync-confirm-backdrop');
    const dialog = document.getElementById('ksync-confirm-dialog');
    const iconWrap = document.getElementById('ksync-confirm-icon-wrap');
    const icon = document.getElementById('ksync-confirm-icon');
    const titleEl = document.getElementById('ksync-confirm-title');
    const msgEl = document.getElementById('ksync-confirm-message');
    const cancelBtn = document.getElementById('ksync-confirm-cancel');
    const okBtn = document.getElementById('ksync-confirm-ok');

    let currentCallback = null;
    let cancelCallback = null;

    function closeModal() {
      if (!modal) return;
      dialog.classList.remove('scale-100', 'opacity-100');
      dialog.classList.add('scale-95', 'opacity-0');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      setTimeout(function() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        currentCallback = null;
        cancelCallback = null;
      }, 200);
    }

    // Export showConfirmModal globally
    window.showConfirmModal = function(options) {
      if (!modal) return;
      options = options || {};
      const title = options.title || 'Confirm Action';
      const message = options.message || 'Are you sure you want to proceed with this action?';
      const confirmText = options.confirmText || 'Yes, Proceed';
      const cancelText = options.cancelText || 'Cancel';
      const type = options.confirmType || 'danger'; // 'danger', 'primary', 'warning'

      titleEl.textContent = title;
      msgEl.textContent = message;
      cancelBtn.textContent = cancelText;
      okBtn.textContent = confirmText;

      currentCallback = typeof options.onConfirm === 'function' ? options.onConfirm : null;
      cancelCallback = typeof options.onCancel === 'function' ? options.onCancel : null;

      // Theme icon & confirm button based on type
      if (type === 'danger') {
        iconWrap.className = 'w-12 h-12 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center text-xl shrink-0 shadow-xs';
        icon.className = 'fas fa-trash-can';
        okBtn.className = 'px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-xs font-bold text-white shadow-lg shadow-rose-600/25 transition-all cursor-pointer';
      } else if (type === 'warning') {
        iconWrap.className = 'w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 text-amber-600 flex items-center justify-center text-xl shrink-0 shadow-xs';
        icon.className = 'fas fa-triangle-exclamation';
        okBtn.className = 'px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-xs font-bold text-white shadow-lg shadow-amber-600/25 transition-all cursor-pointer';
      } else {
        iconWrap.className = 'w-12 h-12 rounded-2xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center text-xl shrink-0 shadow-xs';
        icon.className = 'fas fa-circle-check';
        okBtn.className = 'px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-xs font-bold text-white shadow-lg shadow-slate-950/20 transition-all cursor-pointer';
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');

      requestAnimationFrame(function() {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        dialog.classList.remove('scale-95', 'opacity-0');
        dialog.classList.add('scale-100', 'opacity-100');
        okBtn.focus();
      });
    };

    // Button event listeners
    if (cancelBtn) {
      cancelBtn.addEventListener('click', function() {
        if (typeof cancelCallback === 'function') cancelCallback();
        closeModal();
      });
    }

    if (okBtn) {
      okBtn.addEventListener('click', function() {
        const cb = currentCallback;
        closeModal();
        if (typeof cb === 'function') {
          setTimeout(cb, 100);
        }
      });
    }

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        if (typeof cancelCallback === 'function') cancelCallback();
        closeModal();
      });
    }

    // Keyboard Escape support
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        if (typeof cancelCallback === 'function') cancelCallback();
        closeModal();
      }
    });

    // Global Delegated Form Interceptor for all forms with data-confirm
    document.addEventListener('submit', function(e) {
      const form = e.target;
      if (!form || form.tagName !== 'FORM') return;

      const confirmMsg = form.getAttribute('data-confirm') || form.dataset.confirm;
      if (confirmMsg && form.dataset.confirmed !== 'true') {
        e.preventDefault();
        e.stopImmediatePropagation();

        window.showConfirmModal({
          title: form.dataset.confirmTitle || 'Confirm Action',
          message: confirmMsg,
          confirmText: form.dataset.confirmButton || 'Yes, Delete',
          confirmType: form.dataset.confirmType || 'danger',
          onConfirm: function() {
            form.dataset.confirmed = 'true';
            form.submit();
          }
        });
      }
    }, true);
  })();
</script>
