<!-- Firebase Web SDK CDN (Compat Version for Native Browser Support) -->
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>

<script>
// Official Firebase Configuration for K-Sync Malaysia
const firebaseConfig = {
  apiKey: "AIzaSyAI6j0xuTti4MvqbpHWhSb1O4TFiEYrjFc",
  authDomain: "k-sync-malaysia.firebaseapp.com",
  projectId: "k-sync-malaysia",
  storageBucket: "k-sync-malaysia.firebasestorage.app",
  messagingSenderId: "276342828455",
  appId: "1:276342828455:web:52a2c83eca0e4215385a82",
  measurementId: "G-BZRE4PMHP5"
};

// Initialize Firebase
if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
}

// Global Google Auth Provider instance
const googleProvider = new firebase.auth.GoogleAuthProvider();
googleProvider.addScope('email');
googleProvider.addScope('profile');

/**
 * Triggers Google Sign-In pop-up via Firebase Auth and syncs session with Node.js Express backend
 */
function handleFirebaseGoogleSignIn(selectedRole = 'Fan') {
    const btn = document.getElementById('google-signin-btn');
    function resetButton() {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4 me-2.5 inline" alt="Google"> Continue with Google';
        }
    }

    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Connecting to Google...';
    }

    firebase.auth().signInWithPopup(googleProvider)
        .then(async (result) => {
            const user = result.user;
            console.log("Firebase Auth success:", user.displayName, user.email);

            if (btn) {
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Verifying session...';
            }

            const idToken = await user.getIdToken();

            const res = await fetch('/auth/google', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    idToken: idToken,
                    role: selectedRole
                })
            });

            const data = await res.json().catch(() => ({ status: 'error', message: 'Invalid response from server' }));
            if (res.ok && data.status === 'success') {
                window.location.href = data.redirect || '/';
            } else {
                window.showToast({ message: 'Google Sign-in Error: ' + (data.message || 'Authentication failed.'), type: 'error' });
                resetButton();
            }
        })
        .catch((error) => {
            console.error("Firebase Sign-in failed:", error);
            if (error.code === 'auth/popup-closed-by-user') {
                // User closed popup without selecting an account
            } else if (error.code === 'auth/unauthorized-domain') {
                window.showToast({ message: "Firebase Auth Domain Not Authorized: Please add '" + window.location.hostname + "' to Firebase Console > Authentication > Settings > Authorized domains.", type: 'error', duration: 6000 });
            } else {
                window.showToast({ message: "Google Sign-In Error (" + error.code + "): " + error.message, type: 'error' });
            }
            resetButton();
        });
}
</script>
