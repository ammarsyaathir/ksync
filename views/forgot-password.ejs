<%- include('partials/header', { title: 'Forgot Password | K-Sync Malaysia' }) %>

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl space-y-6">
        <div class="text-center">
            <div class="w-14 h-14 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-xl mx-auto mb-3 shadow">
                <i class="fas fa-key text-pink-400"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Forgot Password?</h1>
            <p class="text-xs text-slate-500 mt-1 font-medium leading-relaxed">
                Enter your registered email address and we'll send you a 6-digit password reset code.
            </p>
        </div>

        <form action="/forgot-password" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Registered Email Address</label>
                <div class="relative">
                    <i class="fas fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="email" name="email" required placeholder="fan@ksync.my or your personal email"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-300">
                </div>
                <span class="block text-[10px] text-slate-400 mt-1">We will send a 6-digit recovery code to this email.</span>
            </div>

            <button type="submit" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-extrabold shadow transition-all cursor-pointer flex items-center justify-center">
                <span>Send Reset Code &rarr;</span>
            </button>
        </form>

        <div class="pt-4 border-t border-slate-100 text-center text-xs text-slate-500">
            Remembered your password? 
            <a href="/login" class="font-bold text-pink-600 hover:underline">Log in here</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
