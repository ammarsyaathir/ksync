<%- include('partials/header', { title: 'K-Pop Artists Directory | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Header Banner -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200/90 pb-6">
        <div>
            <div class="flex items-center space-x-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-violet-100 text-violet-700 border border-violet-200">
                    <i class="fas fa-users-viewfinder me-1 text-violet-500"></i> Idol Directory
                </span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
                K-Pop Artists & Groups
            </h1>
            <p class="text-slate-600 text-sm mt-1.5 font-medium max-w-2xl">
                Explore boy groups, girl groups, and soloists. View normalized member biodata, agency profiles, and track live Malaysian tour dates.
            </p>
        </div>
        <span class="px-4 py-2 rounded-2xl text-xs font-black bg-slate-950 text-white shadow-sm flex items-center shrink-0 self-start md:self-auto gap-2">
            <i class="fas fa-microphone-lines text-pink-400"></i>
            <span><%= artists.length %> Artist<%= artists.length !== 1 ? 's' : '' %> Listed</span>
        </span>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/90 mb-8">
        <form action="/artists" method="GET" class="flex flex-col md:flex-row gap-3 items-center justify-between">
            <!-- Search Text -->
            <div class="relative w-full md:w-96">
                <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="search" value="<%= searchKeyword || '' %>" placeholder="Search artist name, agency, or fandom..." 
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2.5 text-xs font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-violet-400 transition-all">
            </div>

            <!-- Group Type Filter Pills -->
            <div class="flex items-center space-x-2 overflow-x-auto w-full md:w-auto pb-1 md:pb-0 scrollbar-none">
                <a href="/artists<%= searchKeyword ? '?search=' + encodeURIComponent(searchKeyword) : '' %>" 
                   class="px-4 py-2 rounded-xl text-xs font-bold shrink-0 transition-all press-tactile <%= !selectedType ? 'bg-slate-950 text-white shadow-sm' : 'bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
                    All Categories
                </a>
                <% groupTypes.forEach(function(type) { %>
                    <% const isActive = selectedType === type; %>
                    <a href="/artists?type=<%= encodeURIComponent(type) %><%= searchKeyword ? '&search=' + encodeURIComponent(searchKeyword) : '' %>" 
                       class="px-4 py-2 rounded-xl text-xs font-bold shrink-0 transition-all press-tactile <%= isActive ? 'bg-violet-600 text-white shadow-sm' : 'bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
                        <%= type %>
                    </a>
                <% }); %>
            </div>

            <div class="flex items-center space-x-2 w-full md:w-auto justify-end">
                <% if (selectedType || searchKeyword) { %>
                    <a href="/artists" class="px-3.5 py-2 rounded-xl text-xs font-bold text-rose-600 hover:bg-rose-50 border border-rose-200 transition-colors press-tactile">
                        Reset
                    </a>
                <% } %>
                <button type="submit" class="px-5 py-2.5 bg-slate-950 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition-all shadow-sm press-tactile">
                    Search
                </button>
            </div>
        </form>
    </div>

    <!-- Artists Grid -->
    <% if (artists.length === 0) { %>
        <div class="bg-white rounded-3xl p-12 text-center max-w-lg mx-auto my-12 border border-slate-200 shadow-sm">
            <div class="w-16 h-16 rounded-full bg-violet-50 text-violet-600 flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fas fa-users-slash"></i>
            </div>
            <h3 class="text-lg font-black text-slate-900 mb-2">No Artists Found</h3>
            <p class="text-slate-500 text-xs mb-6 font-medium">No K-Pop artists matched your search filters. Try clearing your keyword or category selection.</p>
            <a href="/artists" class="px-6 py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs shadow-md transition-all inline-block press-tactile">
                View All Artists
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% artists.forEach(function(artist) { %>
                <% const artistSlug = helpers.slugify(artist.name) || artist.id; %>
                <div class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden flex flex-col shadow-sm hover:shadow-xl hover:border-violet-300 transition-all duration-300 group">
                    <!-- Image Card Header -->
                    <div class="relative h-52 overflow-hidden bg-slate-950">
                        <img src="<%= artist.image_url || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&auto=format&fit=crop' %>" 
                             alt="<%= artist.name %>" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&auto=format&fit=crop'">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
                        
                        <!-- Top Badges -->
                        <div class="absolute top-3 left-3 z-10">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-white/95 text-slate-950 backdrop-blur-sm shadow-xs border border-white/50">
                                <%= artist.group_type || 'Artist' %>
                            </span>
                        </div>

                        <% if (artist.upcoming_events_count > 0) { %>
                            <div class="absolute top-3 right-3 z-10">
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-pink-600 text-white shadow-md flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
                                    <%= artist.upcoming_events_count %> Tour Date<%= artist.upcoming_events_count > 1 ? 's' : '' %>
                                </span>
                            </div>
                        <% } %>

                        <!-- Bottom Name in Image -->
                        <div class="absolute bottom-3.5 left-4 right-4 z-10">
                            <h3 class="text-xl font-black text-white tracking-tight drop-shadow-sm group-hover:text-pink-300 transition-colors">
                                <%= artist.name %>
                            </h3>
                            <p class="text-[11px] font-semibold text-slate-300 truncate">
                                <%= artist.agency || 'Independent' %>
                            </p>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                        <div class="space-y-2.5">
                            <% if (artist.description) { %>
                                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                                    <%= artist.description %>
                                </p>
                            <% } else { %>
                                <p class="text-xs text-slate-400 italic">Official profile and Malaysian concert schedule.</p>
                            <% } %>

                            <div class="pt-2 flex items-center justify-between text-[11px] font-semibold text-slate-500 border-t border-slate-100">
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-user-group text-violet-500"></i>
                                    <span><%= artist.members_count > 0 ? artist.members_count + ' Members' : 'Soloist' %></span>
                                </span>
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-ticket text-pink-500"></i>
                                    <span><%= artist.total_events_count %> Show<%= artist.total_events_count !== 1 ? 's' : '' %></span>
                                </span>
                            </div>
                        </div>

                        <a href="/artists/<%= artist.id %>-<%= artistSlug %>" 
                           class="w-full py-2.5 rounded-xl bg-slate-950 group-hover:bg-violet-600 text-white text-xs font-bold text-center transition-all flex items-center justify-center gap-1.5 shadow-sm press-tactile">
                            <span>View Artist & Members</span>
                            <i class="fas fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
