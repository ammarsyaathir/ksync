<%- include('partials/header', { title: 'K-Sync Malaysia | Centralized K-Pop Event Information & Discovery' }) %>

<!-- Hero Section -->
<div class="relative overflow-hidden pt-12 pb-20 lg:pt-16 lg:pb-24 border-b border-slate-200 bg-gradient-to-b from-pink-50 via-purple-50/50 to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center space-x-2 mb-6">
            <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200">
                <i class="fas fa-compass me-1 text-pink-500"></i> Verified K-Pop Event Discovery Platform
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-900 text-white">Malaysia</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 mb-6 leading-tight">
            Discover K-Pop Events <br class="hidden sm:inline">
            <span class="text-slate-800">In Malaysia</span>
        </h1>
        <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 mb-10 leading-relaxed font-medium">
            Centralized discovery for concerts, fan meetings, cupsleeve gatherings, birthday pop-ups, and exhibitions across Malaysia.
        </p>

        <!-- Quick Event Search Bar -->
        <form action="/events" method="GET" class="max-w-3xl mx-auto">
            <div class="bg-white p-3 rounded-3xl flex flex-col sm:flex-row items-center gap-2.5 shadow-xl border border-slate-200">
                <div class="relative w-full flex-grow">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" name="search" placeholder="Search by artist, event name, venue or city..." 
                           class="w-full bg-slate-50 text-slate-900 placeholder-slate-400 pl-11 pr-4 py-3.5 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-400 text-sm font-medium">
                </div>
                <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition-all flex items-center justify-center cursor-pointer">
                    <span>Search Events</span>
                    <i class="fas fa-arrow-right ms-2 text-xs"></i>
                </button>
            </div>
        </form>

        <!-- Quick Tag Badges -->
        <div class="mt-6 flex flex-wrap justify-center gap-2 text-xs text-slate-600 font-medium">
            <span class="text-slate-500 font-bold me-1">Popular Right Now:</span>
            <a href="/events?search=SEVENTEEN" class="px-3.5 py-1 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 shadow-sm transition-all cursor-pointer">#SEVENTEEN</a>
            <a href="/events?search=TWICE" class="px-3.5 py-1 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 shadow-sm transition-all cursor-pointer">#TWICE</a>
            <a href="/events?search=IU" class="px-3.5 py-1 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 shadow-sm transition-all cursor-pointer">#IU</a>
            <a href="/events?category=cup-sleeve" class="px-3.5 py-1 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 shadow-sm transition-all cursor-pointer">#CupsleeveKL</a>
            <a href="/events?search=Axiata" class="px-3.5 py-1 rounded-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 shadow-sm transition-all cursor-pointer">#AxiataArena</a>
        </div>
    </div>
</div>

<!-- Community Feature Highlights Counter Bar -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
    <div class="bg-white rounded-3xl p-6 shadow-xl border border-slate-200">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-pink-50/80 border border-pink-200 flex items-center space-x-3.5">
                <div class="w-11 h-11 rounded-xl bg-pink-100 text-pink-600 flex items-center justify-center text-lg shrink-0 font-bold shadow-sm">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div>
                    <h4 class="text-lg font-extrabold text-pink-950">100% Free</h4>
                    <p class="text-[11px] font-medium text-pink-800">Discovery Hub</p>
                </div>
            </div>

            <div class="p-4 rounded-2xl bg-emerald-50/80 border border-emerald-200 flex items-center space-x-3.5">
                <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg shrink-0 font-bold shadow-sm">
                    <i class="fas fa-circle-check"></i>
                </div>
                <div>
                    <h4 class="text-lg font-extrabold text-emerald-950">Verified</h4>
                    <p class="text-[11px] font-medium text-emerald-800">Organizers & Events</p>
                </div>
            </div>

            <div class="p-4 rounded-2xl bg-indigo-50/80 border border-indigo-200 flex items-center space-x-3.5">
                <div class="w-11 h-11 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-lg shrink-0 font-bold shadow-sm">
                    <i class="fas fa-handshake"></i>
                </div>
                <div>
                    <h4 class="text-lg font-extrabold text-indigo-950">Concert Buddy</h4>
                    <p class="text-[11px] font-medium text-indigo-800">Never Go Alone</p>
                </div>
            </div>

            <div class="p-4 rounded-2xl bg-purple-50/80 border border-purple-200 flex items-center space-x-3.5">
                <div class="w-11 h-11 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-lg shrink-0 font-bold shadow-sm">
                    <i class="fas fa-barcode"></i>
                </div>
                <div>
                    <h4 class="text-lg font-extrabold text-purple-950">Track Submissions</h4>
                    <p class="text-[11px] font-medium text-purple-800">Open Public Submissions</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upcoming Verified Events Section -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center">
                <i class="fas fa-calendar-days text-pink-600 me-2.5"></i> Upcoming K-Pop Events
            </h2>
            <p class="text-slate-600 text-sm mt-1 font-medium">Verified official & fan-organized K-Pop events happening in Malaysia</p>
        </div>
        <a href="/events" class="mt-4 md:mt-0 text-sm font-bold text-pink-600 hover:text-pink-700 flex items-center cursor-pointer group">
            <span>Explore All Events</span>
            <i class="fas fa-chevron-right ms-1.5 group-hover:translate-x-1 transition-transform text-xs"></i>
        </a>
    </div>

    <!-- Event Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (upcoming_events.length === 0) { %>
            <div class="col-span-full text-center py-12 bg-white rounded-3xl border border-slate-200">
                <i class="fas fa-calendar-xmark text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-lg font-bold text-slate-700">No events currently scheduled</h3>
                <p class="text-xs text-slate-500 mt-1">Check back soon or submit a new event!</p>
            </div>
        <% } %>
        <% upcoming_events.forEach(function(event) { %>
            <% 
                const calcStatus = helpers.getCalculatedEventStatus(event);
                const isSaved = savedEventIds.includes(event.id);
            %>
            <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden flex flex-col group transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                <!-- Poster Banner -->
                <div class="relative h-52 overflow-hidden bg-slate-100">
                    <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                         onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-black/20"></div>
                    
                    <!-- Category & Status Badges -->
                    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
                        <span class="px-3 py-1 rounded-xl text-[11px] font-bold bg-white text-slate-900 shadow-md">
                            <%= event.category_name || 'K-Pop Event' %>
                        </span>
                        <%- helpers.getStatusBadge(calcStatus) %>
                    </div>

                    <!-- Date Badge Overlaid on Image -->
                    <div class="absolute bottom-3 left-3 bg-white/95 rounded-2xl px-3 py-1.5 text-center shadow-md border border-white/40">
                        <span class="block text-xs font-bold text-pink-600 uppercase"><%= new Date(event.event_date).toLocaleDateString('en-MY', { month: 'short' }) %></span>
                        <span class="block text-lg font-extrabold text-slate-900 leading-none"><%= new Date(event.event_date).getDate() %></span>
                    </div>

                    <!-- Floating Top-Right Action Buttons -->
                    <div class="absolute top-3 right-3 flex items-center space-x-2 z-10">
                        <button onclick="toggleSaveEvent(<%= event.id %>, this)" 
                                title="Save Event"
                                class="w-9 h-9 rounded-full <%= isSaved ? 'bg-rose-500 text-white border-rose-500' : 'bg-white/90 text-slate-700 hover:text-rose-500 border-slate-200' %> border backdrop-blur-md flex items-center justify-center text-xs shadow-md transition-all cursor-pointer hover:scale-110">
                            <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex items-center text-xs font-bold text-purple-600 mb-2">
                            <i class="fas fa-microphone-lines me-1.5 text-purple-500"></i>
                            <span><%= event.artist_name || 'Multiple Artists' %></span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-pink-600 transition-colors line-clamp-2 leading-snug">
                            <a href="<%= helpers.getEventUrl(event) %>" class="cursor-pointer">
                                <%= event.event_name %>
                            </a>
                        </h3>
                    </div>

                    <div class="space-y-2 border-t border-slate-100 pt-4 text-xs text-slate-600 font-medium">
                        <div class="flex items-center">
                            <i class="far fa-clock w-4 me-2 text-pink-500"></i>
                            <span><%= helpers.formatTime(event.start_time) %></span>
                        </div>
                        <div class="flex items-center truncate">
                            <i class="fas fa-location-dot w-4 me-2 text-rose-500"></i>
                            <span class="truncate"><%= event.venue_name %>, <%= event.city %></span>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-[11px] text-emerald-700 font-bold flex items-center"><i class="fas fa-circle-check me-1 text-emerald-600"></i> Verified</span>
                        <a href="<%= helpers.getEventUrl(event) %>" 
                           class="px-5 py-2 rounded-xl bg-pink-50 hover:bg-pink-600 text-pink-700 hover:text-white text-xs font-bold transition-all shadow-sm cursor-pointer">
                            View Details &rarr;
                        </a>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<!-- Browse by Category Section -->
<div class="bg-slate-100/70 border-y border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-xl mx-auto mb-12">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Browse by Event Type</h2>
            <p class="text-slate-600 text-sm mt-2 font-medium">Filter events tailored to your favorite K-Pop activities</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-5">
            <% 
                const catStyles = [
                    { bg: 'bg-pink-50/90 border-pink-200 hover:border-pink-400', icon: 'text-pink-600', text: 'text-pink-900' },
                    { bg: 'bg-purple-50/90 border-purple-200 hover:border-purple-400', icon: 'text-purple-600', text: 'text-purple-900' },
                    { bg: 'bg-indigo-50/90 border-indigo-200 hover:border-indigo-400', icon: 'text-indigo-600', text: 'text-indigo-900' },
                    { bg: 'bg-emerald-50/90 border-emerald-200 hover:border-emerald-400', icon: 'text-emerald-600', text: 'text-emerald-900' }
                ];
            %>
            <% categories.forEach(function(cat, idx) { %>
                <% const style = catStyles[idx % catStyles.length]; %>
                <a href="/events?category=<%= encodeURIComponent(cat.slug) %>" 
                   class="<%= style.bg %> p-6 rounded-3xl border hover:shadow-lg transition-all text-center group cursor-pointer">
                    <div class="w-14 h-14 rounded-2xl bg-white <%= style.icon %> border border-slate-200 mx-auto flex items-center justify-center text-2xl group-hover:scale-110 transition-transform mb-4 shadow-sm">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <h3 class="font-extrabold <%= style.text %> text-sm"><%= cat.name %></h3>
                    <p class="text-xs text-slate-500 mt-1 font-medium"><%= cat.event_count || 0 %> active events</p>
                </a>
            <% }); %>
        </div>
    </div>
</div>

<!-- Featured K-Pop Artists -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Popular K-Pop Artists</h2>
            <p class="text-slate-600 text-sm font-medium">Follow upcoming tours and fan events by group</p>
        </div>
        <a href="/events" class="text-sm font-bold text-slate-800 hover:text-slate-900 cursor-pointer">View All Artists &rarr;</a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-5">
        <% featured_artists.forEach(function(art) { %>
            <a href="/events?artist_id=<%= art.id %>" 
               class="bg-white p-5 rounded-3xl border border-slate-200 text-center hover:border-slate-300 hover:shadow-md transition-all group cursor-pointer">
                <div class="w-20 h-20 rounded-full overflow-hidden mx-auto mb-3 border-2 border-slate-200 group-hover:border-slate-400 transition-colors shadow-sm p-0.5 bg-white">
                    <img src="<%= art.image_url %>" alt="<%= art.name %>" class="w-full h-full object-cover rounded-full"
                         onerror="this.src='https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&auto=format&fit=crop'">
                </div>
                <h4 class="font-bold text-sm text-slate-900 truncate"><%= art.name %></h4>
                <p class="text-[11px] text-slate-500 font-medium"><%= art.group_type %></p>
            </a>
        <% }); %>
    </div>
</div>

<!-- Public Event Submission Call-to-Action -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-white rounded-3xl p-8 sm:p-12 relative overflow-hidden border border-slate-200 shadow-lg">
        <div class="relative z-10 max-w-2xl">
            <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 mb-4 border border-pink-200 shadow-sm">Open Public Submissions</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Organizing or know of a K-Pop Event in Malaysia?</h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6 font-medium">
                Submit any concert, fan meeting, cupsleeve gathering, birthday pop-up, or random play dance to K-Sync Malaysia. <strong>No registration required!</strong> Receive a tracking code immediately and get verified by our admin team.
            </p>
            <div class="flex flex-wrap gap-3">
                <a href="/submit-event" class="px-8 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition-all cursor-pointer">
                    <i class="fas fa-paper-plane me-2"></i> Submit Event Now
                </a>
                <a href="/check-submission" class="px-8 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-800 font-bold text-sm border border-slate-200 shadow-sm transition-all cursor-pointer">
                    <i class="fas fa-barcode me-2"></i> Track Submission Status
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                const icon = btn.querySelector('i');
                if (data.saved) {
                    btn.classList.add('bg-rose-500', 'text-white', 'border-rose-500');
                    btn.classList.remove('bg-white/90', 'text-slate-700');
                    icon.classList.remove('far');
                    icon.classList.add('fas');
                } else {
                    btn.classList.remove('bg-rose-500', 'text-white', 'border-rose-500');
                    btn.classList.add('bg-white/90', 'text-slate-700');
                    icon.classList.remove('fas');
                    icon.classList.add('far');
                }
            }
        } catch (e) {
            console.error('Error toggling save:', e);
        }
    }
</script>

<%- include('partials/footer') %>
