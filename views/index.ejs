<%- include('partials/header', { title: 'K-Sync Malaysia | 4D K-Pop Event Intelligence & Community' }) %>

<!-- Electric Stage Hero Section (Impeccable: Bold display voice, no eyebrows/kickers) -->
<section class="relative overflow-hidden pt-12 pb-16 sm:pt-16 sm:pb-24 border-b border-slate-200/80 bg-gradient-to-b from-slate-100/70 via-pink-50/20 to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <!-- Live Showtime Ticker Bar (Next Upcoming Headline Concert) -->
        <% if (upcoming_events && upcoming_events.length > 0) { %>
            <% const headliner = upcoming_events[0]; %>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold bg-white text-slate-900 border border-slate-200/90 shadow-xs mb-8 press-tactile">
                <span class="w-2 h-2 rounded-full bg-pink-500 animate-ping"></span>
                <span class="text-pink-600 font-black uppercase tracking-wider">NEXT SHOWTIME:</span>
                <a href="<%= helpers.getEventUrl(headliner) %>" class="hover:text-pink-600 font-semibold truncate max-w-xs sm:max-w-md">
                    <%= headliner.artist_name || 'K-Pop' %> — <%= headliner.event_name %> (<%= helpers.formatDate(headliner.event_date) %>)
                </a>
                <i class="fas fa-chevron-right text-[10px] text-slate-400"></i>
            </div>
        <% } %>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-[-0.035em] text-slate-900 mb-6 leading-[1.08] font-sans">
            Malaysia’s Live <br class="hidden sm:inline">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-purple-900 to-pink-600">K-Pop Stage</span>
        </h1>
        <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 mb-10 leading-relaxed font-medium">
            Centralized tour dates, verified ticketing provider links, autonomous multimodal verification, and 4D fan transit radar across Malaysia.
        </p>

        <!-- Floating Intelligent Search Command -->
        <form action="/events" method="GET" class="max-w-3xl mx-auto">
            <div class="bg-white p-2.5 sm:p-3 rounded-3xl flex flex-col sm:flex-row items-center gap-2.5 shadow-xl border border-slate-200/90">
                <div class="relative w-full flex-grow">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" name="search" placeholder="Search by artist, tour, venue (Axiata, Zepp), or city..." 
                           class="w-full bg-slate-50 text-slate-900 placeholder-slate-400 pl-11 pr-4 py-3.5 rounded-2xl border border-slate-200/80 focus:outline-none focus:ring-2 focus:ring-pink-500 text-base sm:text-sm font-medium">
                </div>
                <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition-all press-tactile flex items-center justify-center cursor-pointer shrink-0">
                    <span>Search Events</span>
                    <i class="fas fa-arrow-right ms-2 text-xs text-pink-400"></i>
                </button>
            </div>
        </form>

        <!-- Quick Filter Tags -->
        <div class="mt-6 flex flex-wrap justify-center items-center gap-2 text-xs text-slate-600 font-medium">
            <span class="text-slate-400 font-bold me-1 text-[11px] uppercase tracking-wider">Trending:</span>
            <a href="/events?search=BOYNEXTDOOR" class="px-3 py-1 rounded-full bg-white border border-slate-200 hover:border-slate-300 text-slate-700 shadow-xs press-tactile cursor-pointer">#BOYNEXTDOOR</a>
            <a href="/events?search=TXT" class="px-3 py-1 rounded-full bg-white border border-slate-200 hover:border-slate-300 text-slate-700 shadow-xs press-tactile cursor-pointer">#TOMORROW_X_TOGETHER</a>
            <a href="/events?search=Axiata" class="px-3 py-1 rounded-full bg-white border border-slate-200 hover:border-slate-300 text-slate-700 shadow-xs press-tactile cursor-pointer">#AxiataArena</a>
            <a href="/events?search=Zepp" class="px-3 py-1 rounded-full bg-white border border-slate-200 hover:border-slate-300 text-slate-700 shadow-xs press-tactile cursor-pointer">#ZeppKL</a>
            <a href="/events/radar" class="px-3 py-1 rounded-full bg-pink-50 border border-pink-200 text-pink-700 font-bold shadow-xs press-tactile cursor-pointer">
                <i class="fas fa-radar me-1"></i> 4D Event Radar
            </a>
        </div>
    </div>
</section>

<!-- 4D Geospatial Radar Spotlight Banner -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-8 relative z-20">
    <div class="bg-slate-950 text-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-800 flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded text-[10px] font-black bg-cyan-400 text-slate-950 uppercase tracking-widest">
                    NEW FEATURE
                </span>
                <span class="text-xs text-slate-400 font-mono">4D TEMPORAL TRANSIT MATRIX</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-2.5">
                <i class="fas fa-earth-asia text-pink-400"></i>
                <span>Explore the 4D Geospatial Event Radar</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-medium">
                Plot Malaysian concert venues on an interactive 4D scope. Scrub time chronologically across the 2026/2027 season, detect inter-fandom transit clashes on the Sri Petaling LRT line, and coordinate trips effortlessly.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full lg:w-auto">
            <a href="/events/radar" class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white font-extrabold text-sm shadow-stage-glow transition-all press-tactile flex items-center justify-center gap-2 cursor-pointer">
                <i class="fas fa-radar"></i>
                <span>Launch 4D Radar Scope</span>
            </a>
            <a href="/events" class="w-full sm:w-auto px-5 py-3.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm border border-slate-700 press-tactile flex items-center justify-center cursor-pointer">
                <span>Browse Directory</span>
            </a>
        </div>
    </div>
</section>

<!-- Upcoming Verified Events Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
            <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-[-0.03em] flex items-center gap-2.5">
                <span>Upcoming K-Pop Stage Shows</span>
            </h2>
            <p class="text-slate-600 text-sm mt-1.5 font-medium">Verified arena tours, fan meetings, and community gatherings in Malaysia</p>
        </div>
        <a href="/events" class="text-xs font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1.5 press-tactile cursor-pointer group">
            <span>Explore All <%= upcoming_events ? upcoming_events.length : 0 %> Listings</span>
            <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
        </a>
    </div>

    <!-- Event Cards Grid (Impeccable: Ticket-stub style, high visual hierarchy) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (!upcoming_events || upcoming_events.length === 0) { %>
            <div class="col-span-full text-center py-16 bg-white rounded-3xl border border-slate-200">
                <i class="fas fa-calendar-xmark text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-lg font-bold text-slate-800">No events currently scheduled</h3>
                <p class="text-xs text-slate-500 mt-1">Check back soon or submit a new tour announcement!</p>
            </div>
        <% } %>

        <% (upcoming_events || []).forEach(function(event) { %>
            <% 
                const calcStatus = helpers.getCalculatedEventStatus(event);
                const isSaved = (savedEventIds || []).includes(event.id);
                const eventSlug = helpers.slugify(event.event_name) || event.id;
            %>
            <article class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden flex flex-col group hover-lift transition-all shadow-xs">
                <!-- Poster Banner with Overlaid Badges -->
                <div class="relative h-56 overflow-hidden bg-slate-900">
                    <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                         onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                    
                    <!-- Top Category & Verification Badges -->
                    <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-1.5 z-10">
                        <span class="px-2.5 py-1 rounded-xl text-[10px] font-black bg-slate-900/90 text-white backdrop-blur-md border border-white/10 uppercase tracking-wider">
                            <%= event.category_name || 'Concert' %>
                        </span>
                        <%- helpers.getStatusBadge(calcStatus) %>
                    </div>

                    <!-- Heart Wishlist Toggle Button (Emil Kowalski Tactile Button) -->
                    <div class="absolute top-3.5 right-3.5 z-10">
                        <button type="button" onclick="toggleSaveEvent(<%= event.id %>, this)" 
                                title="Save to Wishlist"
                                class="w-9 h-9 rounded-2xl <%= isSaved ? 'bg-pink-600 text-white' : 'bg-slate-950/80 text-white hover:text-pink-400' %> backdrop-blur-md flex items-center justify-center text-xs shadow-md press-tactile cursor-pointer border border-white/10">
                            <i class="<%= isSaved ? 'fas' : 'far' %> fa-heart"></i>
                        </button>
                    </div>

                    <!-- Date Badge Overlaid on Poster Base -->
                    <div class="absolute bottom-3.5 left-3.5 bg-slate-950/90 backdrop-blur-md rounded-2xl px-3 py-1.5 border border-white/15 text-center shadow-lg">
                        <span class="block text-[10px] font-black text-pink-400 uppercase tracking-wider">
                            <%= new Date(event.event_date).toLocaleDateString('en-MY', { month: 'short' }) %>
                        </span>
                        <span class="block text-lg font-black text-white leading-none font-mono">
                            <%= new Date(event.event_date).getDate() %>
                        </span>
                    </div>

                    <!-- Time & Location Strip -->
                    <div class="absolute bottom-3.5 right-3.5 text-right text-xs text-white font-medium">
                        <% if (event.cluster_area) { %>
                            <span class="px-2 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-md text-[10px] text-slate-300 font-bold border border-white/10">
                                <i class="fas fa-location-dot text-pink-400 me-1"></i> <%= event.cluster_area %>
                            </span>
                        <% } %>
                    </div>
                </div>

                <!-- Card Content -->
                <div class="p-5 sm:p-6 flex-grow flex flex-col justify-between space-y-4">
                    <div>
                        <div class="text-xs font-bold text-pink-600 mb-1 flex items-center gap-1.5">
                            <i class="fas fa-microphone-lines text-purple-500"></i>
                            <span><%= event.artist_name || 'Multiple Artists' %></span>
                        </div>
                        <h3 class="text-base sm:text-lg font-black text-slate-900 group-hover:text-pink-600 transition-colors line-clamp-2 leading-snug">
                            <a href="<%= helpers.getEventUrl(event) %>" class="cursor-pointer">
                                <%= event.event_name %>
                            </a>
                        </h3>
                        <p class="text-xs text-slate-500 mt-2 flex items-center gap-1.5 font-medium">
                            <i class="fas fa-building text-slate-400"></i>
                            <span class="truncate"><%= event.venue_name %>, <%= event.city %></span>
                        </p>
                    </div>

                    <!-- Bottom Action Controls -->
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <div class="text-[11px] font-bold text-emerald-700 flex items-center gap-1">
                            <i class="fas fa-circle-check text-emerald-600"></i>
                            <span>Verified Channel</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <a href="<%= helpers.getEventUrl(event) %>" 
                               class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all press-tactile shadow-xs flex items-center gap-1.5">
                                <span>Details</span>
                                <i class="fas fa-arrow-right text-[10px] text-pink-400"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </article>
        <% }); %>
    </div>
</section>

<!-- Browse by Category Section -->
<section class="bg-white border-y border-slate-200/80 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-xl mx-auto mb-12">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Browse by Event Category</h2>
            <p class="text-slate-600 text-xs sm:text-sm mt-1.5 font-medium">Filter tailored specifically to your Malaysian K-Pop plans</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-5">
            <% (categories || []).forEach(function(cat) { %>
                <a href="/events?category=<%= encodeURIComponent(cat.slug) %>" 
                   class="bg-slate-50 hover:bg-white p-6 rounded-3xl border border-slate-200 hover:border-pink-300 shadow-xs hover-lift transition-all text-center group cursor-pointer press-tactile">
                    <div class="w-12 h-12 rounded-2xl bg-white text-pink-600 border border-slate-200/80 mx-auto flex items-center justify-center text-xl group-hover:scale-110 transition-transform mb-3 shadow-xs">
                        <i class="fas fa-ticket-simple"></i>
                    </div>
                    <h3 class="font-extrabold text-slate-900 text-sm group-hover:text-pink-600 transition-colors"><%= cat.name %></h3>
                    <p class="text-[11px] text-slate-500 mt-1 font-medium"><%= cat.event_count || 0 %> active listings</p>
                </a>
            <% }); %>
        </div>
    </div>
</section>

<!-- Popular K-Pop Artists Directory Strip -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Featured Artists</h2>
            <p class="text-slate-600 text-xs sm:text-sm font-medium mt-0.5">Explore idol group biodata, member rosters, and tour archives</p>
        </div>
        <a href="/artists" class="text-xs font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1 press-tactile cursor-pointer">
            <span>View All Artists</span>
            <i class="fas fa-arrow-right text-[10px]"></i>
        </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-5">
        <% (featured_artists || []).forEach(function(art) { %>
            <a href="/artists/<%= art.id %>" 
               class="bg-white p-5 rounded-3xl border border-slate-200 text-center hover:border-purple-300 hover-lift transition-all group cursor-pointer press-tactile shadow-xs">
                <div class="w-20 h-20 rounded-2xl overflow-hidden mx-auto mb-3 border border-slate-200 shadow-xs p-0.5 bg-slate-100 group-hover:border-purple-400 transition-colors">
                    <img src="<%= art.image_url %>" alt="<%= art.name %>" class="w-full h-full object-cover rounded-xl"
                         onerror="this.src='https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&auto=format&fit=crop'">
                </div>
                <h4 class="font-black text-sm text-slate-900 truncate group-hover:text-purple-600 transition-colors"><%= art.name %></h4>
                <p class="text-[11px] text-slate-500 font-medium"><%= art.group_type || 'K-Pop' %></p>
            </a>
        <% }); %>
    </div>
</section>

<!-- Organizer & Fanclub Publishing Call-to-Action -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-900 rounded-3xl p-8 sm:p-12 relative overflow-hidden border border-slate-800 shadow-2xl text-white">
        <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-2xl">
            <span class="inline-block px-3.5 py-1 rounded-full text-xs font-black bg-pink-500 text-white mb-4 shadow-sm">
                <i class="fas fa-wand-magic-sparkles me-1 text-yellow-300"></i> OpenRouter Gemini 4 Argon OCR
            </span>
            <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4">Are you an Event Host or Fanclub Representative?</h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 font-medium">
                Publish Malaysian K-Pop events with instant autonomous verification. Paste your official tour poster to auto-extract date, artist, and venue coordinates via multimodal AI vision — published instantly with zero manual admin queues.
            </p>
            <div class="flex flex-wrap gap-3">
                <a href="/submit-event" class="px-8 py-3.5 rounded-2xl bg-pink-600 hover:bg-pink-500 text-white font-black text-sm shadow-stage-glow transition-all press-tactile flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-wand-magic-sparkles"></i>
                    <span>Submit with AI Poster Scanner</span>
                </a>
                <a href="/events/radar" class="px-7 py-3.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 press-tactile flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-radar text-pink-400"></i>
                    <span>Open 4D Radar</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Wishlist Save Ajax Handler -->
<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                const icon = btn.querySelector('i');
                if (data.saved) {
                    btn.classList.add('bg-pink-600', 'text-white');
                    btn.classList.remove('bg-slate-950/80', 'text-white');
                    icon.className = 'fas fa-heart text-xs';
                } else {
                    btn.classList.remove('bg-pink-600', 'text-white');
                    btn.classList.add('bg-slate-950/80', 'text-white');
                    icon.className = 'far fa-heart text-xs';
                }
            }
        } catch (e) {
            console.error('Error toggling save:', e);
        }
    }
</script>

<%- include('partials/footer') %>
