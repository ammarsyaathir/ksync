<%- include('partials/header', { title: 'K-Sync Malaysia | 4D K-Pop Event Intelligence & Community' }) %>

<<!-- GoLive-Inspired Cinematic Hero Carousel Section -->
<section class="pt-6 pb-12 sm:pb-16 bg-slate-950 text-white relative overflow-hidden">
    <!-- Ambient festival backdrop glow -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-pink-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 -right-40 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- GoLive Panoramic Hero Carousel -->
        <% const heroEvents = (upcoming_events && upcoming_events.length > 0) ? upcoming_events.slice(0, 4) : []; %>
        <% if (heroEvents.length > 0) { %>
            <div id="golive-carousel" class="relative w-full rounded-3xl overflow-hidden shadow-2xl bg-slate-900 border border-white/10 aspect-[16/9] sm:aspect-[21/9] min-h-[380px] sm:min-h-[460px] max-h-[560px]">
                <% heroEvents.forEach(function(event, idx) { %>
                    <% const isFirst = idx === 0; %>
                    <% const nextEvt = heroEvents[(idx + 1) % heroEvents.length]; %>
                    <div class="carousel-slide absolute inset-0 transition-opacity duration-700 ease-out <%= isFirst ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none' %>" data-index="<%= idx %>">
                        <!-- Panoramic Stage Image -->
                        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                             class="w-full h-full object-cover object-center"
                             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=1600&auto=format&fit=crop'">
                        
                        <!-- GoLive Vignette Overlays (Cinematic Dark Gradients) -->
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-slate-950/20 sm:bg-gradient-to-r sm:from-slate-950/95 sm:via-slate-950/60 sm:to-transparent"></div>

                        <!-- Left Overlay Content (GoLive Style: Badges, Big Typography, Date alert, Link) -->
                        <div class="absolute inset-y-0 left-0 p-6 sm:p-10 lg:p-14 flex flex-col justify-end sm:justify-center max-w-2xl z-20">
                            <!-- Badges (Green outline pill + trending) -->
                            <div class="flex flex-wrap items-center gap-2 mb-3">
                                <span class="px-3 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider border border-emerald-400 text-emerald-300 bg-emerald-950/50 backdrop-blur-md">
                                    <%= event.category_name || 'CONCERT' %>
                                </span>
                                <span class="text-xs font-bold text-rose-400 flex items-center gap-1">
                                    <i class="fas fa-arrow-trend-up text-[10px]"></i> TRENDING
                                </span>
                                <span class="text-xs font-bold text-amber-300 flex items-center gap-1">
                                    <i class="fas fa-circle text-[7px] text-emerald-400 animate-pulse"></i> ON SALE
                                </span>
                            </div>

                            <!-- Big Artist / Tour Headline -->
                            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight uppercase leading-none font-sans drop-shadow-lg">
                                <%= event.artist_name || 'K-POP TOUR' %>
                            </h2>
                            <p class="text-sm sm:text-base text-slate-200 font-bold mt-2 truncate drop-shadow">
                                <%= event.event_name %>
                            </p>

                            <!-- Date & Venue Alert -->
                            <p class="text-xs sm:text-sm text-slate-300 font-medium mt-3 flex items-center gap-2">
                                <span><i class="far fa-calendar-days text-pink-400 me-1"></i> <%= helpers.formatDate(event.event_date) %></span>
                                <span>&bull;</span>
                                <span class="truncate"><i class="fas fa-location-dot text-rose-400 me-1"></i> <%= event.venue_name %>, <%= event.city %></span>
                            </p>

                            <!-- Cyan View More Info Link -->
                            <div class="mt-5">
                                <a href="<%= helpers.getEventUrl(event) %>" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-black text-xs sm:text-sm uppercase tracking-wider press-tactile transition-colors group">
                                    <span>VIEW MORE INFO</span>
                                    <i class="fas fa-chevron-right text-xs group-hover:translate-x-1 transition-transform"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Right Overlay Content (GoLive Style: Up Next in Malaysia) -->
                        <div class="hidden lg:flex absolute bottom-12 right-12 flex-col items-end text-right z-20 pointer-events-none">
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">UP NEXT IN MALAYSIA</span>
                            <span class="text-xl font-black text-white/90 tracking-tight mt-1"><%= nextEvt.artist_name %></span>
                            <span class="text-xs text-slate-400"><%= helpers.formatDate(nextEvt.event_date) %></span>
                        </div>
                    </div>
                <% }); %>

                <!-- Prev & Next Circular Glass Buttons (GoLive Style) -->
                <% if (heroEvents.length > 1) { %>
                    <button type="button" onclick="moveCarousel(-1)" 
                            class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-950/60 hover:bg-slate-900 border border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg z-30 cursor-pointer press-tactile"
                            aria-label="Previous Slide">
                        <i class="fas fa-chevron-left text-xs"></i>
                    </button>
                    <button type="button" onclick="moveCarousel(1)" 
                            class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-950/60 hover:bg-slate-900 border border-white/20 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg z-30 cursor-pointer press-tactile"
                            aria-label="Next Slide">
                        <i class="fas fa-chevron-right text-xs"></i>
                    </button>

                    <!-- Bottom Horizontal Progress Slider Bar (GoLive Style) -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-30">
                        <% heroEvents.forEach(function(_, idx) { %>
                            <button type="button" onclick="jumpCarousel(<%= idx %>)" 
                                    class="carousel-indicator h-1 rounded-full transition-all duration-300 <%= idx === 0 ? 'w-8 bg-cyan-400' : 'w-3 bg-white/30 hover:bg-white/60' %> cursor-pointer" 
                                    aria-label="Go to slide <%= idx + 1 %>"></button>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- Capsule Search Command Bar (GoLive Style) -->
        <div class="mt-8 max-w-3xl mx-auto">
            <form action="/events" method="GET">
                <div class="bg-slate-900/90 backdrop-blur-xl p-2 rounded-full flex flex-col sm:flex-row items-center gap-2 shadow-2xl border border-white/15">
                    <div class="relative w-full flex-grow">
                        <i class="fas fa-search absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" name="search" placeholder="Search by artist, tour, venue (Axiata, Zepp KL), or city..." 
                               class="w-full bg-transparent text-white placeholder-slate-400 pl-12 pr-4 py-3 rounded-full focus:outline-none text-sm font-medium">
                    </div>
                    <button type="submit" class="w-full sm:w-auto px-7 py-3 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-black text-xs uppercase tracking-wider shadow-md transition-all press-tactile flex items-center justify-center cursor-pointer shrink-0">
                        <span>Search</span>
                        <i class="fas fa-arrow-right ms-2 text-[10px]"></i>
                    </button>
                </div>
            </form>

            <!-- Quick Filter Capsule Tags -->
            <div class="mt-4 flex flex-wrap justify-center items-center gap-2 text-xs text-slate-400 font-medium">
                <span class="text-slate-500 font-bold text-[11px] uppercase tracking-wider me-1">Trending:</span>
                <a href="/events?search=SEVENTEEN" class="px-3 py-1 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-colors cursor-pointer">#SEVENTEEN</a>
                <a href="/events?search=BABYMONSTER" class="px-3 py-1 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-colors cursor-pointer">#BABYMONSTER</a>
                <a href="/events?search=Axiata" class="px-3 py-1 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-colors cursor-pointer">#AxiataArena</a>
                <a href="/events?search=Zepp" class="px-3 py-1 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-colors cursor-pointer">#ZeppKL</a>
                <a href="/events/radar" class="px-3 py-1 rounded-full bg-pink-500/15 border border-pink-500/30 text-pink-300 font-bold hover:bg-pink-500/25 transition-colors cursor-pointer">
                    <i class="fas fa-radar me-1 text-pink-400"></i> 4D Event Radar
                </a>
            </div>
        </div>
    </div>
</section>

