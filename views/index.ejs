<!-- Wishlist Save Ajax Handler & GoLive Carousel Controller -->
<script>
    async function toggleSaveEvent(eventId, btn) {
        try {
            const res = await fetch(`/api/events/${eventId}/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.status === 'unauthorized') {
                window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (data.status === 'success') {
                const icon = btn.querySelector('i');
                if (data.saved) {
                    btn.classList.add('bg-pink-600', 'text-white');
                    btn.classList.remove('bg-slate-950/70', 'text-white');
                    icon.className = 'fas fa-heart text-xs';
                } else {
                    btn.classList.remove('bg-pink-600', 'text-white');
                    btn.classList.add('bg-slate-950/70', 'text-white');
                    icon.className = 'far fa-heart text-xs';
                }
            }
        } catch (e) {
            console.error('Error toggling save:', e);
        }
    }

    // GoLive Hero Carousel Controller
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.carousel-indicator');
    let autoSlideInterval = null;

    function showSlide(index) {
        if (!slides.length) return;
        if (index >= slides.length) currentSlide = 0;
        else if (index < 0) currentSlide = slides.length - 1;
        else currentSlide = index;

        slides.forEach((s, idx) => {
            if (idx === currentSlide) {
                s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
                s.classList.add('opacity-100', 'z-10');
            } else {
                s.classList.remove('opacity-100', 'z-10');
                s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
            }
        });

        indicators.forEach((ind, idx) => {
            if (idx === currentSlide) {
                ind.className = 'carousel-indicator h-1 rounded-full transition-all duration-300 w-8 bg-cyan-400 cursor-pointer';
            } else {
                ind.className = 'carousel-indicator h-1 rounded-full transition-all duration-300 w-3 bg-white/30 hover:bg-white/60 cursor-pointer';
            }
        });
    }

    function moveCarousel(dir) {
        showSlide(currentSlide + dir);
        resetAutoSlide();
    }

    function jumpCarousel(idx) {
        showSlide(idx);
        resetAutoSlide();
    }

    function resetAutoSlide() {
        if (autoSlideInterval) clearInterval(autoSlideInterval);
        autoSlideInterval = setInterval(() => {
            showSlide(currentSlide + 1);
        }, 5500);
    }

    if (slides.length > 1) {
        resetAutoSlide();
        const carousel = document.getElementById('golive-carousel');
        if (carousel) {
            carousel.addEventListener('mouseenter', () => {
                if (autoSlideInterval) clearInterval(autoSlideInterval);
            });
            carousel.addEventListener('mouseleave', resetAutoSlide);
        }
    }
</script>

