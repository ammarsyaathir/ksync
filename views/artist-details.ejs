<%- include('partials/header', { title: artist.name + ' Profile & Malaysia Tour Schedule | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-xs font-semibold text-slate-400 mb-6">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <i class="fas fa-chevron-right text-[10px] text-slate-300"></i>
        <a href="/artists" class="hover:text-slate-900 transition-colors">Artists</a>
        <i class="fas fa-chevron-right text-[10px] text-slate-300"></i>
        <span class="text-violet-600 font-bold"><%= artist.name %></span>
    </nav>

    <!-- Artist Split Hero Stage Banner -->
    <div class="relative bg-slate-950 rounded-3xl overflow-hidden border border-white/10 shadow-2xl mb-12">
        <div class="flex flex-col lg:flex-row items-stretch">
            <!-- Left Side: Latest Official Group / Stage Photography -->
            <div class="w-full lg:w-1/2 min-h-[340px] sm:min-h-[420px] lg:min-h-[480px] relative overflow-hidden bg-slate-900 shrink-0">
                <% 
                  const heroPhoto = (artist.image_url && !artist.image_url.includes('unsplash.com'))
                    ? artist.image_url 
                    : (artist.header_image || artist.image_url || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=1600&auto=format&fit=crop');
                %>
                <img src="<%= heroPhoto %>" 
                     alt="<%= artist.name %>" 
                     class="w-full h-full object-cover object-top sm:object-center"
                     onerror="this.src='<%= artist.image_url || artist.header_image %>'">
                <!-- Subtle Gradient Overlays -->
                <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-transparent via-transparent to-slate-950/20 lg:to-slate-950/40 pointer-events-none"></div>
            </div>

            <!-- Right Side: Official Artist Information & Metadata -->
            <div class="w-full lg:w-1/2 p-6 sm:p-8 lg:p-12 flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <!-- Top Tag & Badges -->
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-2 text-violet-400 text-xs font-bold tracking-widest uppercase">
                            <i class="fa-solid fa-address-card text-sm text-purple-400"></i>
                            <span>ARTIST PROFILE</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 pt-0.5">
                            <span class="px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#c6f03d] text-slate-950 shadow-xs">
                                <%= artist.group_type || 'K-Pop Artist' %>
                            </span>
                            <% if (artist.agency) { %>
                                <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-white/10 text-slate-200 border border-white/15 backdrop-blur-sm">
                                    <%= artist.agency %>
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Main Artist Name -->
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight uppercase">
                        <%= artist.name %>
                    </h1>

                    <!-- Summary / Description -->
                    <% if (artist.description) { %>
                        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
                            <%= artist.description %>
                        </p>
                    <% } %>
                </div>

                <!-- 2x2 Stats & Metadata Grid -->
                <div class="grid grid-cols-2 gap-y-5 gap-x-8 pt-6 border-t border-white/10">
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest block mb-1">DEBUT</span>
                        <span class="text-xl sm:text-2xl font-black text-white tracking-tight"><%= artist.debut_year || '2020' %></span>
                    </div>
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest block mb-1">FANDOM</span>
                        <span class="text-xl sm:text-2xl font-black text-white tracking-tight"><%= artist.fandom_name || 'Global Fans' %></span>
                    </div>
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest block mb-1">MEMBERS</span>
                        <span class="text-xl sm:text-2xl font-black text-white tracking-tight"><%= members.length > 0 ? members.length : 'Soloist' %></span>
                    </div>
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest block mb-1">MALAYSIAN EVENTS</span>
                        <span class="text-xl sm:text-2xl font-black text-white tracking-tight">
                            <%= upcoming_events.length > 0 ? upcoming_events.length + ' upcoming' : (past_events.length > 0 ? past_events.length + ' past show' + (past_events.length > 1 ? 's' : '') : 'Active Roster') %>
                        </span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-2 flex flex-wrap items-center gap-3">
                    <a href="#tour-schedule" class="px-5 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs border border-white/15 transition-all flex items-center gap-2 press-tactile">
                        <i class="fas fa-calendar-days text-pink-400"></i>
                        <span>Upcoming events</span>
                    </a>
                    <a href="/events?artist=<%= artist.slug || artist.id %>" class="px-6 py-2.5 rounded-full bg-white text-slate-950 hover:bg-slate-100 font-black text-xs transition-all shadow-md flex items-center gap-1.5 press-tactile">
                        <span>Explore Malaysian Shows</span>
                        <i class="fas fa-arrow-right text-[10px]"></i>
                    </a>
                    <button onclick="navigator.clipboard.writeText(window.location.href); alert('Artist profile link copied!');" 
                            class="px-4 py-2.5 rounded-full bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white text-xs font-semibold border border-white/10 transition-all flex items-center gap-1.5 cursor-pointer press-tactile" title="Share Profile">
                        <i class="fas fa-share-nodes text-xs"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 1: Upcoming Malaysia Tour Dates -->
    <div id="tour-schedule" class="mb-14">
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
            <div>
                <span class="text-xs font-bold text-pink-600 uppercase tracking-wider">Malaysian Live Schedule</span>
                <h2 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                    <i class="fas fa-calendar-check text-pink-500"></i> Upcoming Events & Concerts
                </h2>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700">
                <%= upcoming_events.length %> Show<%= upcoming_events.length !== 1 ? 's' : '' %>
            </span>
        </div>

        <% if (upcoming_events.length === 0) { %>
            <div class="bg-white rounded-3xl p-8 text-center border border-slate-200 shadow-sm">
                <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-lg">
                    <i class="far fa-calendar-xmark"></i>
                </div>
                <h3 class="text-base font-bold text-slate-800 mb-1">No Upcoming Malaysian Dates Announced Yet</h3>
                <p class="text-xs text-slate-500 max-w-md mx-auto mb-4">Stay tuned! When official tour dates or local fan cupsleeve gatherings are scheduled, they will appear here automatically.</p>
                <a href="/events" class="px-5 py-2.5 rounded-xl bg-slate-950 text-white text-xs font-bold hover:bg-slate-800 transition-all inline-block press-tactile">
                    Explore Other K-Pop Events
                </a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% upcoming_events.forEach(function(event) { %>
                    <% const calcStatus = helpers.getCalculatedEventStatus(event); %>
                    <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                    <div class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-all group">
                        <div class="relative h-48 overflow-hidden bg-slate-950">
                            <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                 onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
                            
                            <div class="absolute top-3 left-3 z-10">
                                <%- helpers.getStatusBadge(calcStatus) %>
                            </div>

                            <div class="absolute bottom-3 left-4 right-4 z-10 flex items-center justify-between text-white text-xs font-bold">
                                <span><i class="fas fa-calendar-day me-1 text-pink-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                                <% if (event.start_time) { %>
                                    <span><i class="fas fa-clock me-1 text-violet-400"></i> <%= helpers.formatTime(event.start_time) %></span>
                                <% } %>
                            </div>
                        </div>

                        <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                            <div>
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-violet-50 text-violet-700 border border-violet-200">
                                        <%= event.category_name || 'Concert' %>
                                    </span>
                                    <% if (event.cluster_area) { %>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">
                                            <%= event.cluster_area %>
                                        </span>
                                    <% } %>
                                </div>
                                
                                <h3 class="text-base font-bold text-slate-900 group-hover:text-pink-600 transition-colors line-clamp-2">
                                    <a href="/events/<%= eventSlug %>">
                                        <%= event.event_name %>
                                    </a>
                                </h3>

                                <div class="mt-3 text-xs text-slate-500 space-y-1">
                                    <div class="flex items-center gap-1.5">
                                        <i class="fas fa-location-dot text-rose-500 w-4"></i>
                                        <span class="truncate"><%= event.venue_name || event.venue_display %></span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-slate-400">
                                        <i class="fas fa-city w-4"></i>
                                        <span><%= event.city %>, <%= event.state %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
                                <a href="/events/<%= eventSlug %>" 
                                   class="flex-1 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs text-center transition-all press-tactile">
                                    Event Details
                                </a>
                                <% if (event.ticket_url) { %>
                                    <a href="<%= event.ticket_url %>" target="_blank" rel="noopener noreferrer" 
                                       class="px-3 py-2 rounded-xl bg-pink-50 hover:bg-pink-100 text-pink-700 font-bold text-xs border border-pink-200 transition-all press-tactile" title="Open Official Ticketing Link">
                                        <i class="fas fa-ticket text-xs"></i>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- Section 2: Group Members & Profiles (Normalized Biodata) -->
    <div class="mb-14">
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
            <div>
                <span class="text-xs font-bold text-violet-600 uppercase tracking-wider">Member Lineup & Biodata</span>
                <h2 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                    <i class="fas fa-id-card text-violet-500"></i> Members Profile
                </h2>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-violet-100 text-violet-700">
                <%= members.length %> Member<%= members.length !== 1 ? 's' : '' %>
            </span>
        </div>

        <% if (members.length === 0) { %>
            <div class="bg-white rounded-3xl p-8 text-center border border-slate-200 shadow-sm">
                <p class="text-xs text-slate-500 font-medium">Individual member biodata for this artist is currently being updated in our database.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% members.forEach(function(member) { %>
                    <div class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-md hover:border-violet-300 transition-all flex flex-col group">
                        <!-- Member Photo -->
                        <div class="relative h-64 bg-slate-950 overflow-hidden">
                            <img src="<%= member.photo || artist.image_url || artist.header_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&auto=format&fit=crop' %>" 
                                 alt="<%= member.stage_name %>" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95 group-hover:opacity-100"
                                 onerror="this.src='<%= artist.image_url || artist.header_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&auto=format&fit=crop' %>'">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                            
                            <!-- Primary Position Badge -->
                            <% if (member.position) { %>
                                <div class="absolute top-3 left-3 z-10">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-950/85 text-pink-300 backdrop-blur-sm border border-white/20 shadow-xs">
                                        <%= member.position.split(',')[0].trim() %>
                                    </span>
                                </div>
                            <% } %>

                            <% if (member.years_active) { %>
                                <div class="absolute top-3 right-3 z-10">
                                    <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-white/10 text-slate-200 backdrop-blur-xs border border-white/10">
                                        <%= member.years_active %>
                                    </span>
                                </div>
                            <% } %>

                            <div class="absolute bottom-3.5 left-4 right-4 z-10">
                                <h3 class="text-xl font-black text-white tracking-tight drop-shadow-sm group-hover:text-pink-300 transition-colors"><%= member.stage_name %></h3>
                                <% if (member.birth_name) { %>
                                    <p class="text-xs font-semibold text-slate-300 truncate"><%= member.birth_name %></p>
                                <% } %>
                            </div>
                        </div>

                        <!-- Biodata List -->
                        <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                            <div class="space-y-3">
                                <% if (member.position) { %>
                                    <div class="pb-2.5 border-b border-slate-100">
                                        <div class="text-[10px] font-bold text-violet-600 uppercase tracking-wider">Position</div>
                                        <div class="text-xs font-semibold text-slate-800 leading-snug"><%= member.position %></div>
                                    </div>
                                <% } %>

                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <% if (member.dob) { %>
                                        <div class="bg-slate-50/80 p-2 rounded-xl border border-slate-100">
                                            <span class="text-[10px] text-slate-400 block font-medium">Birthday</span>
                                            <span class="font-bold text-slate-700 text-[11px]"><%= member.dob %></span>
                                        </div>
                                    <% } %>
                                    <% if (member.zodiac) { %>
                                        <div class="bg-slate-50/80 p-2 rounded-xl border border-slate-100">
                                            <span class="text-[10px] text-slate-400 block font-medium">Zodiac</span>
                                            <span class="font-bold text-slate-700 text-[11px]"><%= member.zodiac %></span>
                                        </div>
                                    <% } %>
                                    <% if (member.nationality) { %>
                                        <div class="bg-slate-50/80 p-2 rounded-xl border border-slate-100">
                                            <span class="text-[10px] text-slate-400 block font-medium">Nationality</span>
                                            <span class="font-bold text-slate-700 text-[11px]"><%= member.nationality %></span>
                                        </div>
                                    <% } %>
                                    <% if (member.mbti) { %>
                                        <div class="bg-pink-50/60 p-2 rounded-xl border border-pink-100">
                                            <span class="text-[10px] text-pink-500 block font-medium">MBTI</span>
                                            <span class="font-black text-pink-700 text-[11px]"><%= member.mbti %></span>
                                        </div>
                                    <% } %>
                                    <% if (member.height) { %>
                                        <div class="bg-slate-50/80 p-2 rounded-xl border border-slate-100">
                                            <span class="text-[10px] text-slate-400 block font-medium">Height</span>
                                            <span class="font-bold text-slate-700 text-[11px]"><%= member.height %></span>
                                        </div>
                                    <% } %>
                                    <% if (member.blood_type) { %>
                                        <div class="bg-slate-50/80 p-2 rounded-xl border border-slate-100">
                                            <span class="text-[10px] text-slate-400 block font-medium">Blood Type</span>
                                            <span class="font-bold text-slate-700 text-[11px]"><%= member.blood_type %></span>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- Section 3: Past Malaysian Tour Archive -->
    <% if (past_events.length > 0) { %>
        <div class="mb-10">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200">
                <h3 class="text-lg font-bold text-slate-700 flex items-center gap-2">
                    <i class="fas fa-clock-rotate-left text-slate-400"></i> Past Malaysian Tour Archive
                </h3>
                <span class="text-xs text-slate-400 font-medium"><%= past_events.length %> Past Concert<%= past_events.length !== 1 ? 's' : '' %></span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                <% past_events.forEach(function(event) { %>
                    <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                    <div class="bg-white rounded-2xl p-4 border border-slate-200 flex items-center space-x-3 opacity-80 hover:opacity-100 transition-opacity">
                        <img src="<%= event.poster_image %>" alt="" class="w-14 h-14 rounded-xl object-cover shrink-0">
                        <div class="min-w-0 flex-1">
                            <a href="/events/<%= eventSlug %>" class="text-xs font-bold text-slate-900 hover:text-pink-600 truncate block">
                                <%= event.event_name %>
                            </a>
                            <div class="text-[11px] text-slate-500"><%= helpers.formatDate(event.event_date) %> · <%= event.venue_name %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
