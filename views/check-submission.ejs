<%- include('partials/header', { title: 'Track Event Submission Status | K-Sync Malaysia' }) %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="mb-8 text-center max-w-xl mx-auto">
        <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-700 border border-purple-200 uppercase tracking-wider">
            <i class="fas fa-barcode me-1.5 text-purple-500"></i> Submission Tracker (UC21, UC22)
        </span>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-3">Check Submission Status</h1>
        <p class="text-slate-600 text-xs sm:text-sm mt-1 font-medium">
            Enter your official Reference Code (e.g. KS-2026-XXXX) or submitter email address to check approval status.
        </p>
    </div>

    <!-- Lookup Form -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm mb-8">
        <form action="/check-submission" method="GET" class="grid grid-cols-1 sm:grid-cols-5 gap-3">
            <div class="sm:col-span-4">
                <input type="text" name="code" value="<%= queryCode || '' %>" required 
                       placeholder="Enter Reference Code (e.g. KS-2026-...) or your email address"
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-900 font-mono font-medium focus:outline-none focus:ring-2 focus:ring-purple-300">
            </div>
            <div>
                <button type="submit" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs sm:text-sm font-bold transition-all shadow-sm flex items-center justify-center">
                    <i class="fas fa-magnifying-glass me-2 text-pink-400"></i> Track
                </button>
            </div>
        </form>
    </div>

    <!-- Results Section -->
    <% if (searched) { %>
        <% if (!event) { %>
            <div class="text-center py-12 bg-white rounded-3xl border border-slate-200 shadow-sm">
                <div class="w-16 h-16 rounded-full bg-rose-50 text-rose-500 flex items-center justify-center text-2xl mx-auto mb-3">
                    <i class="fas fa-circle-xmark"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900">No submission found</h3>
                <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                    Please double-check your Reference Code or Email. Reference codes follow the format <code class="font-bold text-pink-600">KS-2026-XXXXX</code>.
                </p>
            </div>
        <% } else { %>
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
                <!-- Status Header Banner -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                    <div>
                        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
                            Reference: <span class="font-mono text-pink-600 font-black"><%= event.tracking_code %></span>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">
                            <%= event.event_name %>
                        </h2>
                        <div class="text-xs text-slate-500 mt-1">
                            Submitted on <%= helpers.formatDate(event.created_at) %> by <span class="font-semibold text-slate-700"><%= event.submitter_name %></span>
                        </div>
                    </div>
                    <div>
                        <%- helpers.getVerificationBadge(event.verification_status) %>
                    </div>
                </div>

                <!-- Visual Step-by-Step Timeline -->
                <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Verification Progression</h4>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 relative">
                        <!-- Step 1: Received -->
                        <div class="flex items-center space-x-3 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800">
                            <i class="fas fa-check-circle text-emerald-600 text-lg"></i>
                            <div>
                                <div class="text-xs font-bold">1. Received</div>
                                <div class="text-[10px] text-emerald-600">Submission recorded</div>
                            </div>
                        </div>

                        <!-- Step 2: Autonomous Multi-Factor Verification -->
                        <% const isUnderReview = ['PENDING', 'VERIFIED', 'REJECTED', 'FLAGGED'].includes(event.verification_status); %>
                        <div class="flex items-center space-x-3 p-3 rounded-xl <%= isUnderReview ? 'bg-purple-50 border border-purple-200 text-purple-800' : 'bg-white border border-slate-200 text-slate-400' %>">
                            <i class="fas fa-robot text-purple-600 text-lg"></i>
                            <div>
                                <div class="text-xs font-bold">2. Dual-AI Verification</div>
                                <div class="text-[10px] text-purple-600">Vision OCR & Semantic Audit</div>
                            </div>
                        </div>

                        <!-- Step 3: Decision Reached -->
                        <% if (event.verification_status === 'VERIFIED') { %>
                            <div class="flex items-center space-x-3 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800">
                                <i class="fas fa-circle-check text-emerald-600 text-lg"></i>
                                <div>
                                    <div class="text-xs font-bold">3. Dual-AI Consensus!</div>
                                    <div class="text-[10px] text-emerald-600">Published live to catalog</div>
                                </div>
                            </div>
                        <% } else if (event.verification_status === 'FLAGGED' || event.verification_status === 'REJECTED') { %>
                            <div class="flex items-center space-x-3 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800">
                                <i class="fas fa-triangle-exclamation text-rose-600 text-lg"></i>
                                <div>
                                    <div class="text-xs font-bold">3. Discrepancy Flagged</div>
                                    <div class="text-[10px] text-rose-600">Action required below</div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="flex items-center space-x-3 p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-800">
                                <i class="fas fa-clock text-amber-600 text-lg"></i>
                                <div>
                                    <div class="text-xs font-bold">3. Needs Evidence</div>
                                    <div class="text-[10px] text-amber-600">Provide official link</div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Dual-AI Verification Breakdown Telemetry Card -->
                <div class="bg-gradient-to-br from-slate-900 to-indigo-950 rounded-2xl p-6 text-white border border-slate-800 shadow-md space-y-4">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-7 h-7 rounded-lg bg-pink-500/20 text-pink-400 flex items-center justify-center text-xs font-bold">
                                <i class="fas fa-robot"></i>
                            </span>
                            <span class="text-xs font-extrabold uppercase tracking-wider text-slate-200">Autonomous Dual-AI Verification Engine</span>
                        </div>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full inline-flex items-center gap-1.5 <%= event.verification_status === 'VERIFIED' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30' %>">
                            <% if (event.verification_status === 'VERIFIED') { %>
                                <i class="fas fa-circle-check text-[10px]"></i> Dual-AI Consensus Confirmed
                            <% } else { %>
                                <i class="fas fa-triangle-exclamation text-[10px]"></i> Action Needed / Evidence Pending
                            <% } %>
                        </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
                        <div class="bg-white/5 rounded-xl p-3 border border-white/10">
                            <div class="text-[10px] text-slate-400 font-bold uppercase">1. Rule Sanity</div>
                            <div class="text-emerald-400 font-extrabold mt-1 flex items-center gap-1">
                                <i class="fas fa-check-circle text-[10px]"></i> 100% Valid
                            </div>
                            <div class="text-[10px] text-slate-400 mt-0.5">Chronology & fields check</div>
                        </div>

                        <div class="bg-white/5 rounded-xl p-3 border border-white/10">
                            <div class="text-[10px] text-slate-400 font-bold uppercase">2. Source Check</div>
                            <div class="<%= (event.official_url || event.evidence_link) ? 'text-emerald-400' : 'text-amber-400' %> font-extrabold mt-1 flex items-center gap-1">
                                <i class="fas <%= (event.official_url || event.evidence_link) ? 'fa-check-circle' : 'fa-circle-exclamation' %> text-[10px]"></i>
                                <%= (event.official_url || event.evidence_link) ? 'Domain Linked' : 'No Source' %>
                            </div>
                            <div class="text-[10px] text-slate-400 mt-0.5 truncate"><%= event.official_url || 'Needs official URL' %></div>
                        </div>

                        <div class="bg-white/5 rounded-xl p-3 border border-white/10">
                            <div class="text-[10px] text-slate-400 font-bold uppercase">3. Model 1 (Vision)</div>
                            <div class="text-pink-300 font-extrabold mt-1 flex items-center gap-1">
                                <i class="fas fa-eye text-[10px]"></i> Poster OCR
                            </div>
                            <div class="text-[10px] text-slate-400 mt-0.5">Graphics & dates cross-checked</div>
                        </div>

                        <div class="bg-white/5 rounded-xl p-3 border border-white/10">
                            <div class="text-[10px] text-slate-400 font-bold uppercase">4. Model 2 (Auditor)</div>
                            <div class="text-purple-300 font-extrabold mt-1 flex items-center gap-1">
                                <i class="fas fa-shield-halved text-[10px]"></i> Semantic Sanity
                            </div>
                            <div class="text-[10px] text-slate-400 mt-0.5">Geographic & scam risk audited</div>
                        </div>
                    </div>

                    <% if (event.admin_verification_notes) { %>
                        <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-300">
                            <strong class="text-pink-300">Engine Telemetry:</strong> <%= event.admin_verification_notes %>
                        </div>
                    <% } %>
                </div>

                <!-- Discrepancy Resolution & Automated Re-Verification (UC13) -->
                <% if (['REJECTED', 'FLAGGED', 'PENDING'].includes(event.verification_status) && event.verification_status !== 'VERIFIED') { %>
                    <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 space-y-4">
                        <div class="flex items-start space-x-3">
                            <i class="fas fa-circle-exclamation text-amber-500 text-xl shrink-0 mt-0.5"></i>
                            <div>
                                <h4 class="text-sm font-bold text-amber-900">Autonomous Verification Feedback</h4>
                                <p class="text-xs text-amber-700 mt-1 leading-relaxed">
                                    <%= event.admin_verification_notes || event.rejection_reason || 'Autonomous verification requires additional evidence or correction of detected discrepancies. Update the fields below to trigger an immediate re-evaluation.' %>
                                </p>
                            </div>
                        </div>

                        <!-- Resubmission Button -->
                        <div class="pt-2">
                            <button onclick="document.getElementById('resubmit-box').classList.toggle('hidden')" 
                                    class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all inline-flex items-center gap-2">
                                <i class="fas fa-wand-magic-sparkles text-pink-400"></i> Correct Event & Re-run Dual-AI Verification
                            </button>
                        </div>
                    </div>

                    <!-- Resubmit Form (Initially hidden) -->
                    <div id="resubmit-box" class="hidden bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-4">
                        <h4 class="text-sm font-bold text-slate-900">Update Event Details for Autonomous Re-Verification</h4>
                        <form action="/check-submission/resubmit" method="POST" class="space-y-4">
                            <input type="hidden" name="event_id" value="<%= event.id %>">
                            <input type="hidden" name="tracking_code" value="<%= event.tracking_code %>">

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Event Name</label>
                                <input type="text" name="event_name" value="<%= event.event_name %>" required 
                                       class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs">
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">Official Verification URL</label>
                                    <input type="url" name="official_url" value="<%= event.official_url || '' %>" required 
                                           placeholder="https://..." class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">Poster Image URL</label>
                                    <input type="url" name="poster_image" value="<%= event.poster_image || '' %>" required 
                                           class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Event Description & Ticketing Notes</label>
                                <textarea name="description" rows="3" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs"><%= event.description %></textarea>
                            </div>

                            <button type="submit" class="px-6 py-2.5 rounded-xl bg-pink-600 hover:bg-pink-500 text-white text-xs font-bold shadow inline-flex items-center gap-2">
                                <i class="fas fa-bolt"></i> Re-evaluate with Dual-AI Engine Now
                            </button>
                        </form>
                    </div>
                <% } %>

                <!-- Verified View Live Link -->
                <% if (event.verification_status === 'VERIFIED') { %>
                    <div class="p-6 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center space-x-3">
                            <i class="fas fa-circle-check text-emerald-500 text-2xl"></i>
                            <div>
                                <div class="text-sm font-bold text-emerald-900">Your event has been approved and published!</div>
                                <div class="text-xs text-emerald-700">It is now visible to all Malaysian K-Pop fans on the discovery board.</div>
                            </div>
                        </div>
                        <a href="<%= helpers.getEventUrl(event) %>" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow shrink-0">
                            View Live Event &rarr;
                        </a>
                    </div>
                <% } %>
            </div>
        <% } %>
    <% } %>
</div>

<%- include('partials/footer') %>
