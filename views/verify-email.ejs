<%- include('partials/header', { title: 'Verify Email OTP | K-Sync Malaysia' }) %>

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl space-y-6">
        <div class="text-center">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-pink-500 to-purple-600 text-white flex items-center justify-center text-2xl mx-auto mb-3 shadow-md">
                <i class="fas fa-shield-alt"></i>
            </div>
            
            <% if (typeof role !== 'undefined' && role === 'ORGANIZER') { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-purple-100 text-purple-700 uppercase tracking-wider mb-2">
                    <i class="fas fa-certificate text-purple-500"></i> Organizer Account Activation
                </span>
            <% } else { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-pink-100 text-pink-700 uppercase tracking-wider mb-2">
                    <i class="fas fa-user-check text-pink-500"></i> Fan Account Activation
                </span>
            <% } %>

            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Verify Your Email</h1>
            <p class="text-xs text-slate-500 mt-1.5 font-medium leading-relaxed">
                We sent a 6-digit verification code to<br>
                <strong class="text-slate-900 font-extrabold text-sm"><%= email %></strong>
            </p>
        </div>

        <% if (typeof devOtp !== 'undefined' && devOtp) { %>
        <!-- FYP Evaluator / Test Auto-Fill Card -->
        <div class="p-3.5 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 text-amber-900 text-xs">
            <div class="flex items-center justify-between mb-1.5">
                <span class="font-extrabold text-[11px] uppercase tracking-wider text-amber-800 flex items-center gap-1.5">
                    <i class="fas fa-flask text-amber-600"></i> Evaluation / Demo Mode
                </span>
                <span class="text-[10px] bg-amber-200/80 text-amber-900 font-bold px-2 py-0.5 rounded-full">Zero-Admin OTP</span>
            </div>
            <p class="text-[11px] text-amber-700 mb-2 leading-relaxed">
                Code generated by server: <strong class="font-mono text-xs font-black text-amber-900 bg-amber-100 px-1.5 py-0.5 rounded border border-amber-300"><%= devOtp %></strong>
            </p>
            <button type="button" onclick="fillOtp('<%= devOtp %>')" 
                    class="w-full py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-xs shadow-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                <i class="fas fa-magic"></i>
                <span>1-Click Fill OTP (<%= devOtp %>)</span>
            </button>
        </div>
        <% } %>

        <form action="/verify-email" method="POST" class="space-y-5">
            <input type="hidden" name="email" value="<%= email %>">

            <div>
                <label class="block text-xs font-bold text-slate-700 text-center mb-2">Enter 6-Digit Verification Code</label>
                
                <!-- 6 Individual Tactile Digit Boxes -->
                <div class="flex items-center justify-center gap-2 mb-3" id="otp-boxes-container">
                    <% for(let i = 0; i < 6; i++) { %>
                        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                               class="otp-digit w-11 h-14 text-center text-2xl font-mono font-black text-slate-900 bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-purple-500 focus:bg-purple-50/20 focus:outline-none focus:ring-4 focus:ring-purple-100 transition-all"
                               data-index="<%= i %>" autocomplete="off">
                    <% } %>
                </div>

                <!-- Hidden Master Input for Form Submission -->
                <input type="hidden" id="master-otp-input" name="otp" required>

                <!-- Fallback Direct Input (Synchronized) -->
                <div class="relative max-w-[240px] mx-auto text-center">
                    <span class="block text-[11px] text-slate-400 mt-2">Code valid for 10 minutes. Zero human admin queues required.</span>
                </div>
            </div>

            <button type="submit" id="btn-submit-verify" class="w-full py-3.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-xl text-xs font-extrabold shadow-md shadow-purple-500/20 transition-all cursor-pointer flex items-center justify-center gap-2 active:scale-95">
                <i class="fas fa-check-circle"></i>
                <span>Verify & Activate <%= (typeof role !== 'undefined' && role === 'ORGANIZER') ? 'Organizer Portal' : 'Account' %> &rarr;</span>
            </button>
        </form>

        <!-- Resend OTP option -->
        <div class="pt-4 border-t border-slate-100 text-center space-y-2">
            <p class="text-xs text-slate-500">Didn't receive the email code?</p>
            <form action="/resend-otp" method="POST" class="inline">
                <input type="hidden" name="email" value="<%= email %>">
                <button type="submit" class="text-xs font-extrabold text-purple-600 hover:text-purple-700 hover:underline cursor-pointer">
                    <i class="fas fa-rotate-right me-1"></i> Resend Verification Code
                </button>
            </form>
            <div class="text-[11px] text-slate-400">
                Wrong email address? <a href="/register" class="text-slate-600 font-bold hover:underline">Register again</a>
            </div>
        </div>
    </div>
</div>

<script>
    const digitInputs = document.querySelectorAll('.otp-digit');
    const masterInput = document.getElementById('master-otp-input');

    function syncMasterInput() {
        let code = '';
        digitInputs.forEach(input => code += input.value.trim());
        if (masterInput) masterInput.value = code;
    }

    digitInputs.forEach((input, idx) => {
        input.addEventListener('input', (e) => {
            const val = e.target.value.replace(/[^0-9]/g, '');
            e.target.value = val ? val[0] : '';
            syncMasterInput();

            if (val && idx < digitInputs.length - 1) {
                digitInputs[idx + 1].focus();
            }
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !input.value && idx > 0) {
                digitInputs[idx - 1].focus();
            }
        });

        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim().replace(/[^0-9]/g, '');
            if (pasteData) {
                fillOtp(pasteData);
            }
        });
    });

    // Auto-focus first digit on page load
    if (digitInputs.length > 0) {
        digitInputs[0].focus();
    }

    function fillOtp(code) {
        const str = String(code).slice(0, 6);
        for (let i = 0; i < digitInputs.length; i++) {
            digitInputs[i].value = str[i] || '';
        }
        syncMasterInput();
        if (str.length >= 6) {
            digitInputs[5].focus();
        }
    }
</script>

<%- include('partials/footer') %>
