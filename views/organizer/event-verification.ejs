                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 font-medium">
                            <% checks.forEach(chk => { 
                                let badgeClass = 'bg-slate-100 text-slate-700 border-slate-200';
                                if (chk.status === 'Passed') badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                                if (chk.status === 'Failed') badgeClass = 'bg-rose-50 text-rose-700 border-rose-200';
                                if (chk.status === 'Skipped') badgeClass = 'bg-amber-50 text-amber-700 border-amber-200';
                            %>
                                <tr class="hover:bg-white/80 transition-colors">
                                    <td class="py-2.5 px-3">
                                        <div class="font-bold text-slate-900 flex items-center gap-1.5">
                                            <span><%= chk.name %></span>
                                            <% if (chk.isHardGate) { %>
                                                <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-purple-100 text-purple-700 border border-purple-200 uppercase">
                                                    Hard Gate
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="text-[11px] text-slate-500 mt-0.5">
                                            <%= chk.details %>
                                        </div>
                                    </td>
                                    <td class="py-2.5 px-3">
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border <%= badgeClass %> inline-block">
                                            <%= chk.status %>
                                        </span>
                                    </td>
                                    <td class="py-2.5 px-3 text-right font-mono font-bold <%= chk.points > 0 ? 'text-slate-900' : 'text-slate-400' %>">
                                        <%= chk.points %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </details>
