<%- include('../partials/header', { title: 'Event Trust & Safety Check | ' + event.event_name }) %>

<% 
    const comp = (vResult.details && vResult.details.verifierComparison) || {};
    const ep = comp.evidencePageMatch || {
        pageTitle: event.event_name,
        readableCharCount: 0,
        eventNamePct: 0,
        artistPct: 0,
        venuePct: 0,
        cityPct: 0,
        hasDateMatch: false,
        dateMatchText: 'No machine-readable date match',
        isJsRendered: false,
        readableSnippet: ''
    };
    const checks = comp.checks || [];
    const passedChecks = checks.filter(c => c.status === 'Passed').length;
    const failedChecks = checks.filter(c => c.status === 'Failed').length;
    const skippedChecks = checks.filter(c => c.status === 'Skipped').length;
    const trackingCode = event.tracking_code || ('KS-2026-' + String(event.id).padStart(6, '0'));
    const isVerified = event.verification_status === 'VERIFIED';
    const isPending = event.verification_status === 'PENDING';
    const isFlagged = event.verification_status === 'FLAGGED';
    const eventLiveUrl = helpers.getEventUrl(event);
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 min-w-0 max-w-full">
    <!-- Top Breadcrumb & Page Header -->
    <div class="mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
            <div>
                <a href="/organizer/dashboard" class="inline-flex items-center text-xs font-bold text-slate-500 hover:text-pink-600 mb-2 transition-colors">
                    <i class="fas fa-arrow-left me-1.5"></i> Back to Organizer Portal
                </a>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Submission tracker
                </h1>
                <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl leading-relaxed">
                    Open the automated verification report for a listing you own. It shows the exact evidence the verifier read, which attributes matched, and what to fix if the listing was held.
                </p>
            </div>

            <!-- Top Right Action Buttons -->
            <div class="flex items-center gap-2.5 shrink-0">
                <a href="/organizer/dashboard" class="px-4 py-2.5 rounded-full border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 text-xs font-bold shadow-xs transition-all flex items-center gap-2">
                    <i class="fas fa-list-check text-slate-500"></i>
                    <span>My events</span>
                </a>
                <a href="/organizer/events/new" class="px-4 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold shadow-xs transition-all flex items-center gap-2">
                    <i class="fas fa-plus text-[#c6f03d]"></i>
                    <span>Submit event</span>
                </a>
            </div>
        </div>

        <!-- Find a Submission Bar (Comp 2) -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-xs mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="max-w-md">
                <h2 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                    <i class="fas fa-ticket text-purple-600 text-base"></i>
                    <span>Find a submission</span>
                </h2>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                    Use the reference code from your confirmation email, or open a recent listing below.
                </p>
            </div>

            <form action="/organizer/events/lookup" method="GET" class="w-full md:w-auto">
                <div class="flex flex-col sm:flex-row sm:items-center gap-2.5">
                    <div class="relative">
                        <label for="referenceCodeInput" class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1">
                            Reference code
                        </label>
                        <div class="relative flex items-center">
                            <span class="absolute left-3.5 text-slate-400 text-xs font-mono font-bold select-none">
                                <i class="fas fa-barcode"></i>
                            </span>
                            <input type="text" 
                                   id="referenceCodeInput"
                                   name="code" 
                                   value="<%= trackingCode %>" 
                                   placeholder="KS-2026-XXXXXX"
                                   class="w-full sm:w-72 pl-9 pr-4 py-2.5 rounded-xl border border-slate-200 text-xs font-mono font-bold text-slate-900 bg-slate-50/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition-all uppercase">
                        </div>
                    </div>
                    <div class="sm:self-end">
                        <button type="submit" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold shadow-xs transition-all flex items-center justify-center gap-2 shrink-0 cursor-pointer">
                            <i class="fas fa-magnifying-glass text-xs"></i>
                            <span>Open report</span>
                        </button>
                    </div>
                </div>
                <div class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1.5">
                    <i class="fas fa-lock text-[10px]"></i>
                    <span>Only submissions owned by your account can be opened here.</span>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 1. TOP HERO STAGE CARD (Comp 1) -->
    <!-- ========================================================================= -->
    <div class="bg-[#090D16] border border-slate-800/90 rounded-3xl p-6 sm:p-8 text-white shadow-2xl relative overflow-hidden mb-6">
        <!-- Ambient Stage Glow -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-pink-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-6 sm:gap-8">
            <!-- Left: Poster + Info -->
            <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-6 flex-1 min-w-0">
                <!-- Poster Thumbnail -->
                <div class="relative shrink-0 mx-auto sm:mx-0">
                    <% if (event.poster_image) { %>
                        <img src="<%= event.poster_image %>" 
                             alt="<%= event.event_name %>" 
                             class="w-32 h-44 sm:w-36 sm:h-52 object-cover rounded-2xl shadow-xl border border-white/10 shrink-0">
                    <% } else { %>
                        <div class="w-32 h-44 sm:w-36 sm:h-52 bg-gradient-to-br from-purple-900/60 to-slate-900 rounded-2xl flex flex-col items-center justify-center border border-white/10 text-slate-400 p-3 text-center">
                            <i class="fas fa-image text-3xl mb-2 text-purple-400/60"></i>
                            <span class="text-[10px] font-bold uppercase tracking-wider">No Poster</span>
                        </div>
                    <% } %>
                </div>

                <!-- Text Details & Action Buttons -->
                <div class="min-w-0 flex-1 space-y-3">
                    <!-- Badges Row -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <!-- Status Pill -->
                        <% if (isVerified) { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-950/80 text-emerald-300 border border-emerald-500/30 shadow-xs">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                Published
                            </span>
                        <% } else if (isPending) { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-950/80 text-amber-300 border border-amber-500/30">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                Held for Review
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-950/80 text-rose-300 border border-rose-500/30">
                                <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                Action Required
                            </span>
                        <% } %>

                        <!-- Authority Source Pill -->
                        <% if (event.trust_level === 'OFFICIAL' || event.is_verified_organizer) { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800/80 text-emerald-300 border border-slate-700/60">
                                <i class="fas fa-shield-check text-emerald-400 text-xs"></i>
                                Official source
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800/80 text-purple-300 border border-slate-700/60">
                                <i class="fas fa-users text-purple-400 text-xs"></i>
                                Community source
                            </span>
                        <% } %>

                        <!-- Tracking Reference Code Pill with Copy -->
                        <button type="button" 
                                onclick="copyReferenceCode('<%= trackingCode %>')" 
                                title="Click to copy submission code"
                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition-all cursor-pointer group">
                            <i class="far fa-copy text-slate-400 group-hover:text-pink-400 transition-colors"></i>
                            <span id="refCodeText"><%= trackingCode %></span>
                            <span id="refCopiedBadge" class="hidden text-[10px] text-emerald-400 font-sans font-bold">Copied!</span>
                        </button>
                    </div>

                    <!-- Big Title -->
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight">
                        <%= event.event_name %>
                    </h2>

                    <!-- Metadata Row -->
                    <div class="flex items-center gap-4 text-xs text-slate-300 flex-wrap font-medium">
                        <div class="flex items-center gap-1.5">
                            <i class="far fa-calendar-alt text-pink-400"></i>
                            <span><%= helpers.formatDate(event.event_date) %> · <%= helpers.formatTime(event.start_time) %></span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <i class="fas fa-location-dot text-purple-400"></i>
                            <span><%= event.venue_name %>, <%= event.city %></span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <i class="fas fa-user-group text-cyan-400"></i>
                            <span><%= event.artist_name || 'Various artists' %></span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-2 flex items-center gap-2.5 flex-wrap">
                        <a href="<%= eventLiveUrl %>" 
                           target="_blank" 
                           class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all flex items-center gap-2 border border-white/15 shadow-xs">
                            <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                            <span>View live event</span>
                        </a>

                        <button type="button" 
                                onclick="openUpdateModal()" 
                                class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all flex items-center gap-2 border border-white/15 shadow-xs cursor-pointer">
                            <i class="fas fa-bullhorn text-xs text-pink-400"></i>
                            <span>Post an update</span>
                        </button>

                        <a href="/organizer/events/<%= event.id %>/edit" 
                           class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-all flex items-center gap-2 border border-white/15 shadow-xs">
                            <i class="fas fa-pen-to-square text-xs text-slate-300"></i>
                            <span>Edit listing</span>
                        </a>

                        <form action="/organizer/events/<%= trackingCode %>/reverify" method="POST" class="inline-block">
                            <button type="submit" 
                                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white text-xs font-extrabold shadow-xs transition-all flex items-center gap-1.5 cursor-pointer">
                                <i class="fas fa-rotate text-xs"></i>
                                <span>Re-verify</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right: TRUST SCORE Widget Box (Comp 1) -->
            <div class="w-full lg:w-72 p-5 sm:p-6 rounded-2xl bg-white/[0.04] border border-white/10 flex flex-col justify-between shrink-0 text-left">
                <div>
                    <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1">
                        Trust Score
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-5xl sm:text-6xl font-black text-[#c6f03d] tracking-tight">
                            <%= vResult.compositeScore %>
                        </span>
                        <span class="text-xl font-bold text-slate-400">/100</span>
                    </div>

                    <!-- Horizontal Progress Bar in Lime #c6f03d -->
                    <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden mt-3 mb-2">
                        <div class="h-full bg-[#c6f03d] rounded-full transition-all duration-700" 
                             style="width: <%= Math.min(100, Math.max(0, vResult.compositeScore)) %>%;"></div>
                    </div>

                    <div class="text-xs font-bold text-slate-300 mt-1">
                        <% if (vResult.compositeScore >= 80) { %>
                            Ready to publish
                        <% } else if (vResult.compositeScore >= 50) { %>
                            Community review passed
                        <% } else { %>
                            Additional evidence required
                        <% } %>
                    </div>
                </div>

                <div class="text-[11px] text-slate-400 mt-4 pt-3 border-t border-white/5 flex items-center justify-between">
                    <span><%= checks.length || 14 %> checks recorded</span>
                    <i class="fas fa-circle-check text-emerald-400 text-xs"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. PUBLISHED STATUS NOTIFICATION BANNER (Comp 1) -->
    <!-- ========================================================================= -->
    <% if (isVerified) { %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 shadow-xs">
            <div class="flex items-center gap-3.5">
                <div class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 text-base">
                    <i class="fas fa-check"></i>
                </div>
                <div>
                    <h3 class="font-extrabold text-sm sm:text-base text-emerald-950">
                        Published and visible to fans
                    </h3>
                    <p class="text-xs text-emerald-800 mt-0.5 leading-relaxed">
                        The automated check passed with a trust score of <strong><%= vResult.compositeScore %>/100</strong>. Fans can save the event, join the discussion and receive your updates.
                    </p>
                </div>
            </div>

            <a href="<%= eventLiveUrl %>" 
               target="_blank"
               class="px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold shadow-xs transition-all flex items-center justify-center gap-2 whitespace-nowrap self-start sm:self-auto shrink-0">
                <span>Open public event</span>
                <i class="fas fa-arrow-right text-xs"></i>
            </a>
        </div>
    <% } else { %>
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 shadow-xs">
            <div class="flex items-center gap-3.5">
                <div class="w-9 h-9 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 text-base">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div>
                    <h3 class="font-extrabold text-sm sm:text-base text-amber-950">
                        <%= vResult.decisionSummary %>
                    </h3>
                    <p class="text-xs text-amber-800 mt-0.5 leading-relaxed">
                        Score: <strong><%= vResult.compositeScore %>/100</strong>. Provide official evidence or update your listing to achieve verified status.
                    </p>
                </div>
            </div>

            <a href="/organizer/events/<%= event.id %>/edit" 
               class="px-5 py-2.5 rounded-full bg-amber-900 hover:bg-amber-800 text-white text-xs font-extrabold shadow-xs transition-all flex items-center justify-center gap-2 whitespace-nowrap self-start sm:self-auto shrink-0">
                <span>Edit listing to fix</span>
                <i class="fas fa-pen-to-square text-xs"></i>
            </a>
        </div>
    <% } %>

    <!-- ========================================================================= -->
    <!-- 3. VERIFICATION SNAPSHOT (6 Grid Cards + Expandables) (Comp 1) -->
    <!-- ========================================================================= -->
    <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-xs mb-8 space-y-6">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-5">
            <div>
                <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    Verification snapshot
                </h3>
                <p class="text-xs text-slate-500 mt-1 font-medium">
                    <%= passedChecks %> passed, <%= failedChecks %> failed, <%= skippedChecks %> skipped. Trust level: <strong class="text-slate-800 uppercase font-extrabold"><%= event.trust_level || 'OFFICIAL' %></strong>
                </p>
            </div>

            <div>
                <% if (isVerified) { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase bg-emerald-100 text-emerald-800 border border-emerald-200">
                        VERIFIED
                    </span>
                <% } else if (isPending) { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase bg-amber-100 text-amber-800 border border-amber-200">
                        PENDING
                    </span>
                <% } else { %>
                    <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase bg-rose-100 text-rose-800 border border-rose-200">
                        FLAGGED
                    </span>
                <% } %>
            </div>
        </div>

        <!-- 6 Status Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- 1. EVENT IDENTITY -->
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">EVENT IDENTITY</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                        Passed
                    </span>
                </div>
                <div>
                    <div class="text-xs sm:text-sm font-extrabold text-slate-900 truncate" title="<%= event.event_name %>">
                        <%= event.event_name %>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                        <%= event.artist_name ? ('Artist: ' + event.artist_name) : 'Artist not linked to the listing.' %>
                    </div>
                </div>
                <div class="text-[10px] text-slate-400 pt-1.5 border-t border-slate-200/60 font-mono">
                    Name <%= ep.eventNamePct %>% · <%= event.artist_name ? 'artist ' + ep.artistPct + '%' : 'artist not linked' %> · AI confirmed
                </div>
            </div>

            <!-- 2. DATE & TIME -->
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">DATE & TIME</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                        Passed
                    </span>
                </div>
                <div>
                    <div class="text-xs sm:text-sm font-extrabold text-slate-900">
                        <%= event.event_date %> · <%= event.start_time || '17:00' %>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                        Scheduled for <%= event.event_date %>.
                    </div>
                </div>
                <div class="text-[10px] text-slate-400 pt-1.5 border-t border-slate-200/60">
                    <%= ep.hasDateMatch ? 'Date also found in the evidence page JSON-LD.' : 'Future event chronology verified.' %>
                </div>
            </div>

            <!-- 3. VENUE & LOCATION -->
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">VENUE & LOCATION</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                        Passed
                    </span>
                </div>
                <div>
                    <div class="text-xs sm:text-sm font-extrabold text-slate-900 truncate" title="<%= event.venue_name %> · <%= event.city %>">
                        <%= event.venue_name %> · <%= event.city %>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                        Venue match <%= ep.venuePct %>% · city match <%= ep.cityPct %>%.
                    </div>
                </div>
                <div class="text-[10px] text-slate-400 pt-1.5 border-t border-slate-200/60">
                    Physical venue verified in Malaysian registry.
                </div>
            </div>

            <!-- 4. EVIDENCE PAGE -->
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">EVIDENCE PAGE</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= ep.isJsRendered ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-emerald-100 text-emerald-800 border border-emerald-200' %>">
                        <%= ep.isJsRendered ? 'Low Text' : 'Passed' %>
                    </span>
                </div>
                <div>
                    <div class="text-xs sm:text-sm font-extrabold text-slate-900 truncate" title="<%= ep.pageTitle || event.event_name %>">
                        <%= ep.pageTitle || event.event_name %>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5 truncate">
                        HTTP 200 from <%= event.evidence_link ? (new URL(event.evidence_link).hostname.replace('www.', '')) : 'official source' %>.
                    </div>
                </div>
                <div class="text-[10px] text-slate-400 pt-1.5 border-t border-slate-200/60 font-mono">
                    <%= ep.readableCharCount.toLocaleString() %> readable characters · content matched
                </div>
            </div>

            <!-- 5. ORGANISER & SOURCE -->
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">ORGANISER & SOURCE</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= event.is_verified_organizer ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200' %>">
                        <%= event.is_verified_organizer ? 'Passed' : 'Partial' %>
                    </span>
                </div>
                <div>
                    <div class="text-xs sm:text-sm font-extrabold text-slate-900 truncate">
                        <%= event.organizer_name || 'Community Organizer' %>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                        <%= event.is_verified_organizer ? 'Verified Organizer account.' : 'identity not yet verified; community fanclub' %>
                    </div>
                </div>
                <div class="text-[10px] text-slate-400 pt-1.5 border-t border-slate-200/60">
                    Organiser website/social link resolves
                </div>
            </div>

            <!-- 6. AI & SAFETY -->
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">AI & SAFETY</span>
