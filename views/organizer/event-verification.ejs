                                <td class="py-2.5 px-3 text-right"><span class="text-emerald-600 font-bold">Verified</span></td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-3 font-bold text-slate-900">Organizer Channel</td>
                                <td class="py-2.5 px-3"><%= event.organizer_name %></td>
                                <td class="py-2.5 px-3"><%= event.organizer_social_url || 'Active organizer profile' %></td>
