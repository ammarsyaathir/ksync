                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Venue</span>
                        <strong class="text-slate-800 truncate max-w-[150px]" title="<%= event.venue_name %>, <%= event.city %>"><%= event.venue_name %>, <%= event.city %></strong>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Organiser</span>
                        <strong class="text-slate-800 truncate max-w-[150px]"><%= event.organizer_name || 'Community Organizer' %></strong>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Last checked</span>
                        <strong class="text-slate-800"><%= helpers.timeAgo(event.updated_at || event.created_at) %></strong>
                    </div>
                </div>
            </div>

            <!-- Sources Card -->
            <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
                <div>
                    <h4 class="text-base font-extrabold text-slate-900">Sources</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Open what the verifier used.</p>
                </div>

                <div class="space-y-2.5">
                    <% if (event.evidence_link) { %>
                        <a href="<%= event.evidence_link %>" 
                           target="_blank" 
                           class="p-3 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 flex items-center justify-between gap-3 text-xs transition-colors group">
                            <div class="min-w-0">
                                <div class="font-bold text-slate-900 group-hover:text-purple-600 flex items-center gap-1.5 transition-colors">
                                    <i class="fas fa-link text-slate-400 text-xs"></i>
                                    <span>Evidence link</span>
                                </div>
                                <div class="text-[11px] text-slate-500 truncate mt-0.5 font-mono">
                                    <%= event.evidence_link %>
                                </div>
                            </div>
                            <i class="fas fa-arrow-up-right-from-square text-slate-400 group-hover:text-purple-600 text-xs shrink-0 transition-colors"></i>
                        </a>
                    <% } %>

                    <% if (event.official_url) { %>
                        <a href="<%= event.official_url %>" 
                           target="_blank" 
                           class="p-3 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 flex items-center justify-between gap-3 text-xs transition-colors group">
                            <div class="min-w-0">
                                <div class="font-bold text-slate-900 group-hover:text-purple-600 flex items-center gap-1.5 transition-colors">
                                    <i class="fas fa-globe text-slate-400 text-xs"></i>
                                    <span>Official page</span>
                                </div>
                                <div class="text-[11px] text-slate-500 truncate mt-0.5 font-mono">
                                    <%= event.official_url %>
                                </div>
                            </div>
                            <i class="fas fa-arrow-up-right-from-square text-slate-400 group-hover:text-purple-600 text-xs shrink-0 transition-colors"></i>
                        </a>
                    <% } %>
                </div>

                <div class="text-[11px] text-slate-400 pt-2 border-t border-slate-100 leading-relaxed">
                    Account verification is separate from this listing check. Read the policy.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Logistical Update Modal for Organizers -->
<div id="updateModal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 space-y-4 relative">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i class="fas fa-bullhorn text-pink-600"></i>
                <span>Post Official Organizer Update</span>
            </h3>
            <button type="button" onclick="closeUpdateModal()" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed">
            Announce logistical updates, entry rules, photocard perks, or schedule adjustments directly into the event discussion with an official <strong>Organizer</strong> badge.
        </p>

        <form id="updateForm" onsubmit="submitOrganizerUpdate(event)" class="space-y-4">
            <div>
                <label for="updateCommentText" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                    Update Message
                </label>
                <textarea id="updateCommentText" 
                          rows="4" 
                          required 
                          placeholder="e.g. Venue doors will open at 4:30 PM. Photocard tier redemption counter is at Hall B entrance."
                          class="w-full p-3.5 rounded-xl border border-slate-200 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-2">
                <button type="button" onclick="closeUpdateModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="submitUpdateBtn" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold shadow-xs transition-all flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-bullhorn text-xs text-pink-400"></i>
                    <span>Broadcast Update</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function copyReferenceCode(code) {
        if (!code) return;
        navigator.clipboard.writeText(code).then(() => {
            const badge = document.getElementById('refCopiedBadge');
            const codeText = document.getElementById('refCodeText');
            if (badge && codeText) {
                badge.classList.remove('hidden');
                setTimeout(() => {
                    badge.classList.add('hidden');
                }, 2000);
            }
        }).catch(err => {
            console.error('Copy failed:', err);
        });
    }

    function openUpdateModal() {
        const modal = document.getElementById('updateModal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeUpdateModal() {
        const modal = document.getElementById('updateModal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitOrganizerUpdate(e) {
        e.preventDefault();
        const textarea = document.getElementById('updateCommentText');
        const btn = document.getElementById('submitUpdateBtn');
        const content = textarea.value.trim();
        if (!content) return;

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Broadcasting...';

        try {
            const res = await fetch('/api/events/<%= event.id %>/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ comment_text: '[Official Notice] ' + content })
            });
            const data = await res.json();
            if (res.ok) {
                alert('Update broadcasted successfully into the event discussion!');
                closeUpdateModal();
                textarea.value = '';
            } else {
                alert(data.message || 'Failed to post update.');
            }
        } catch (err) {
            console.error('Error posting update:', err);
            alert('Network error while posting update.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-bullhorn text-xs text-pink-400"></i> Broadcast Update';
        }
    }
</script>

<%- include('../partials/footer') %>
