<!-- ============================================================================
     CLIENT-SIDE LOGIC & STATE ENGINE
============================================================================ -->
<script>
// State Store for 4 Graphics Slots
const slotData = {
    1: { file: null, url: '<%= (existingGallery.length > 0 && existingGallery[0]) ? existingGallery[0] : "" %>' },
    2: { file: null, url: '<%= (existingGallery.length > 1 && existingGallery[1]) ? existingGallery[1] : "" %>' },
    3: { file: null, url: '<%= (existingGallery.length > 2 && existingGallery[2]) ? existingGallery[2] : "" %>' },
    4: { file: null, url: '<%= (existingGallery.length > 3 && existingGallery[3]) ? existingGallery[3] : "" %>' }
};

// Handle File Selection for a given Slot (1-4)
function handleSlotFile(slotNum, inputElement) {
    const file = inputElement.files && inputElement.files[0];
    if (!file) return;

    slotData[slotNum].file = file;

    const reader = new FileReader();
    reader.onload = function(e) {
        slotData[slotNum].url = e.target.result;
        updateSlotUI(slotNum, e.target.result);
        syncConsolidatedUrls();
        updateChecklistState();
    };
    reader.readAsDataURL(file);
}

// Handle URL typed or pasted for a given Slot (1-4)
function handleSlotUrl(slotNum, urlValue) {
    const cleanUrl = urlValue.trim();
    slotData[slotNum].url = cleanUrl;
    slotData[slotNum].file = null;
    updateSlotUI(slotNum, cleanUrl);
    syncConsolidatedUrls();
    updateChecklistState();
}

// Update the Slot Card UI (shows image or placeholder)
function updateSlotUI(slotNum, imgSrc) {
    const previewImg = document.getElementById(`previewImgSlot${slotNum}`);
    const placeholder = document.getElementById(`placeholderSlot${slotNum}`);
    const removeBtn = document.getElementById(`removeBtnSlot${slotNum}`);
    const card = document.getElementById(`slotCard${slotNum}`);

    if (imgSrc) {
        if (previewImg) {
            previewImg.src = imgSrc;
            previewImg.classList.remove('hidden');
        }
        if (placeholder) placeholder.classList.add('hidden');
        if (removeBtn) removeBtn.classList.remove('hidden');
        if (card) card.classList.add('border-purple-400', 'bg-purple-50/30');
    } else {
        if (previewImg) {
            previewImg.src = '';
            previewImg.classList.add('hidden');
        }
        if (placeholder) placeholder.classList.remove('hidden');
        if (removeBtn) removeBtn.classList.add('hidden');
        if (card) card.classList.remove('border-purple-400', 'bg-purple-50/30');
    }
}

// Clear a graphic slot
function clearSlot(slotNum) {
    slotData[slotNum].file = null;
    slotData[slotNum].url = '';
    const urlInput = document.getElementById(`urlInputSlot${slotNum}`);
    if (urlInput) urlInput.value = '';
    updateSlotUI(slotNum, '');
    syncConsolidatedUrls();
    updateChecklistState();
}

// Consolidate non-empty URLs into hidden input for submission
function syncConsolidatedUrls() {
    const urls = [];
    for (let i = 1; i <= 4; i++) {
        if (slotData[i].url && !slotData[i].url.startsWith('data:')) {
            urls.push(slotData[i].url);
        }
    }
    const hiddenInput = document.getElementById('consolidatedPosterUrls');
    if (hiddenInput) hiddenInput.value = urls.join(',');
}

// Switch between Official Link vs Scan Poster tabs in Smart Fill
function switchSmartMode(mode) {
    const tabLink = document.getElementById('tabModeLink');
    const tabScan = document.getElementById('tabModeScan');
    const boxLink = document.getElementById('smartLinkContainer');
    const boxScan = document.getElementById('smartScanContainer');

    if (mode === 'link') {
        tabLink.className = 'px-4 py-2 rounded-full text-xs font-extrabold bg-slate-900 text-white flex items-center gap-1.5 shadow-2xs transition-all cursor-pointer';
        tabScan.className = 'px-4 py-2 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1.5 transition-all cursor-pointer';
        boxLink.classList.remove('hidden');
        boxScan.classList.add('hidden');
    } else {
        tabScan.className = 'px-4 py-2 rounded-full text-xs font-extrabold bg-slate-900 text-white flex items-center gap-1.5 shadow-2xs transition-all cursor-pointer';
        tabLink.className = 'px-4 py-2 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1.5 transition-all cursor-pointer';
        boxScan.classList.remove('hidden');
        boxLink.classList.add('hidden');
    }
}

// Interactive Real-Time Checklist & Progress Calculator (X/7)
function updateChecklistState() {
    let completedCount = 0;
    const stillNeeded = [];

    // 1. Identity (Name & Category)
    const nameVal = document.getElementById('inputEventName')?.value.trim();
    const catVal = document.getElementById('inputCategoryId')?.value.trim();
    const itemIdentity = document.getElementById('checkItemIdentity');
    if (nameVal && catVal) {
        completedCount++;
        setChecklistItem(itemIdentity, true);
    } else {
        setChecklistItem(itemIdentity, false);
        stillNeeded.push('event title and category');
    }

    // 2. Schedule (Date & Start Time)
    const dateVal = document.getElementById('inputEventDate')?.value.trim();
    const timeVal = document.getElementById('inputStartTime')?.value.trim();
    const itemSchedule = document.getElementById('checkItemSchedule');
    if (dateVal && timeVal) {
        completedCount++;
        setChecklistItem(itemSchedule, true);
    } else {
        setChecklistItem(itemSchedule, false);
        stillNeeded.push('date and start time');
    }

    // 3. Venue (Name & City)
    const venueVal = document.getElementById('inputVenueName')?.value.trim();
    const cityVal = document.getElementById('inputCity')?.value.trim();
    const itemVenue = document.getElementById('checkItemVenue');
    if (venueVal && cityVal) {
        completedCount++;
        setChecklistItem(itemVenue, true);
    } else {
        setChecklistItem(itemVenue, false);
        stillNeeded.push('venue and city');
    }

    // 4. Evidence Link (Official URL or Evidence link)
    const officialUrl = document.getElementById('inputOfficialUrl')?.value.trim();
    const evidenceLink = document.getElementById('inputEvidenceLink')?.value.trim();
    const itemEvidence = document.getElementById('checkItemEvidence');
    if (officialUrl || evidenceLink) {
        completedCount++;
        setChecklistItem(itemEvidence, true);
    } else {
        setChecklistItem(itemEvidence, false);
        stillNeeded.push('official ticket or evidence link');
    }

    // 5. Organiser Contact (Name & Email)
    const subName = document.getElementById('inputSubmitterName')?.value.trim();
    const subEmail = document.getElementById('inputSubmitterEmail')?.value.trim();
    const itemContact = document.getElementById('checkItemContact');
    if (subName && subEmail) {
        completedCount++;
        setChecklistItem(itemContact, true);
    } else {
        setChecklistItem(itemContact, false);
        stillNeeded.push('organiser contact name and email');
    }

    // 6. Poster (At least 1 graphic slot populated)
    const hasPoster = slotData[1].url || slotData[2].url || slotData[3].url || slotData[4].url;
    const itemPoster = document.getElementById('checkItemPoster');
    if (hasPoster) {
        completedCount++;
        setChecklistItem(itemPoster, true);
    } else {
        setChecklistItem(itemPoster, false);
        stillNeeded.push('at least 1 poster artwork');
    }

    // 7. Declaration
    const isDeclared = document.getElementById('inputDeclaration')?.checked;
    const itemDecl = document.getElementById('checkItemDeclaration');
    if (isDeclared) {
        completedCount++;
        setChecklistItem(itemDecl, true);
    } else {
        setChecklistItem(itemDecl, false);
        stillNeeded.push('declaration checkbox');
    }

    // Update Progress UI
    const badge = document.getElementById('readyProgressBadge');
    const bar = document.getElementById('readyProgressBar');
    const neededText = document.getElementById('checklistStillNeeded');

    if (badge) badge.textContent = `${completedCount}/7`;
    const percent = Math.round((completedCount / 7) * 100);
    if (bar) bar.style.width = `${percent}%`;

    if (neededText) {
        if (completedCount === 7) {
            neededText.className = 'p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-[11px] text-emerald-800 font-extrabold flex items-center gap-2';
            neededText.innerHTML = '<i class="fas fa-circle-check text-emerald-600 text-sm"></i> All details complete! Ready for Autonomous Dual-AI verification.';
        } else {
            neededText.className = 'p-3.5 rounded-2xl bg-slate-50 border border-slate-100 text-[11px] text-slate-500 leading-relaxed';
            neededText.textContent = `Still needed: ${stillNeeded.join(', ')}.`;
        }
    }
}

function setChecklistItem(container, isComplete) {
    if (!container) return;
    const icon = container.querySelector('.check-icon');
    const title = container.querySelector('.check-title');
    if (isComplete) {
        if (icon) icon.className = 'fas fa-circle-check text-emerald-600 mt-0.5 text-xs check-icon';
        if (title) title.className = 'font-bold text-slate-900 check-title line-through opacity-80';
    } else {
        if (icon) icon.className = 'far fa-circle text-slate-300 mt-0.5 text-xs check-icon';
        if (title) title.className = 'font-bold text-slate-800 check-title';
    }
}

// Live form inputs observer for checklist
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('eventSubmissionForm');
    if (form) {
        form.addEventListener('input', updateChecklistState);
        form.addEventListener('change', updateChecklistState);
    }
    updateChecklistState();
});

