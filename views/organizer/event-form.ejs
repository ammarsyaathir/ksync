/**
 * 1-Click Fill form with preset data (does NOT submit to database)
 */
function fillSampleData(presetKey) {
    const data = SAMPLE_PRESETS[presetKey] || SAMPLE_PRESETS.aespa;
    const form = document.querySelector('form');
    if (!form) return;

    // Populate each form element
    for (const [key, value] of Object.entries(data)) {
        const el = form.querySelector(`[name="${key}"]`);
        if (el) {
            el.value = value;
            // Visual highlight ring effect to show user what changed
            el.classList.add('ring-2', 'ring-pink-400', 'bg-pink-50/30');
            setTimeout(() => {
                el.classList.remove('ring-2', 'ring-pink-400', 'bg-pink-50/30');
            }, 1200);
        }
    }

    // Render Poster Artwork Preview
    const previewContainer = document.getElementById('posterPreviewContainer');
    const previewImg = document.getElementById('posterPreviewImg');
    const previewUrlText = document.getElementById('posterPreviewUrlText');
    if (previewContainer && previewImg && data.poster_url) {
        previewImg.src = data.poster_url;
        if (previewUrlText) previewUrlText.textContent = data.poster_url;
        previewContainer.classList.remove('hidden');
    }

    // Show Confirmation Banner
    const toast = document.getElementById('autofillToast');
    const toastTitle = document.getElementById('toastTitle');
    if (toast) {
        if (toastTitle) toastTitle.textContent = `Sample Loaded: "${data.event_name}"`;
        toast.classList.remove('hidden');
    }

    // Gentle scroll to top of form to review
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

/**
 * Clear all fields
 */
function clearFormFields() {
    const form = document.querySelector('form');
    if (!form) return;
    form.reset();
    const previewContainer = document.getElementById('posterPreviewContainer');
    if (previewContainer) previewContainer.classList.add('hidden');
    const toast = document.getElementById('autofillToast');
    if (toast) toast.classList.add('hidden');
}

// Live URL input listener for Poster preview
const posterUrlInput = document.getElementById('posterUrlInput');
if (posterUrlInput) {
    posterUrlInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        const previewContainer = document.getElementById('posterPreviewContainer');
        const previewImg = document.getElementById('posterPreviewImg');
        const previewUrlText = document.getElementById('posterPreviewUrlText');
        if (val) {
            if (previewImg) previewImg.src = val;
            if (previewUrlText) previewUrlText.textContent = val;
            if (previewContainer) previewContainer.classList.remove('hidden');
        } else if (!document.getElementById('posterFileInput')?.files?.length) {
            if (previewContainer) previewContainer.classList.add('hidden');
        }
    });
}

// Live File input listener for Poster preview via FileReader
const posterFileInput = document.getElementById('posterFileInput');
if (posterFileInput) {
    posterFileInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (ev) => {
                const previewContainer = document.getElementById('posterPreviewContainer');
                const previewImg = document.getElementById('posterPreviewImg');
                const previewUrlText = document.getElementById('posterPreviewUrlText');
                if (previewImg) previewImg.src = ev.target.result;
                if (previewUrlText) previewUrlText.textContent = `Local File: ${file.name} (${Math.round(file.size / 1024)} KB)`;
                if (previewContainer) previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    });
}
</script>

