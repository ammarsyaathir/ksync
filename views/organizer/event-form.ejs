                            <span>Preview event listing</span>
                        </button>

                        <!-- Primary Submit Button -->
                        <button type="submit" id="btnFinalSubmit" 
                                class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-slate-950 hover:bg-slate-900 text-white font-black text-xs sm:text-sm shadow-xl shadow-slate-950/20 transition-all flex items-center justify-center gap-2.5 press-tactile cursor-pointer">
                            <i class="fas fa-shield-check text-[#c6f03d]"></i>
                            <span><%= isEdit ? 'Save Changes & Re-Verify' : 'Submit for verification' %></span>
                            <i class="fas fa-arrow-right text-[10px] text-slate-400"></i>
                        </button>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN (4 Cols): Dynamic Sticky Checklist & Submission Status (Comp 2 & 3) -->
            <div class="lg:col-span-4 space-y-5 lg:sticky lg:top-24">
                
                <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-list-check text-purple-600 text-sm"></i>
                            <h3 class="text-sm font-black text-slate-900">Ready to submit?</h3>
                        </div>
                        <span id="readyProgressBadge" class="w-8 h-8 rounded-full bg-slate-900 text-[#c6f03d] text-xs font-black flex items-center justify-center shadow-2xs">
                            1/7
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 -mt-2">
                        Updates in real-time as you fill the form.
                    </p>

                    <!-- Dynamic Progress Bar -->
                    <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden">
                        <div id="readyProgressBar" class="h-full bg-gradient-to-r from-purple-600 to-[#c6f03d] transition-all duration-300" style="width: 14%;"></div>
                    </div>

                    <!-- 7-Point Live Checklist -->
                    <div class="space-y-3 pt-1 text-xs">
                        <!-- 1. Event Identity -->
                        <div id="checkItemIdentity" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Event identity</div>
                                <div class="text-[11px] text-slate-400">Title and category</div>
                            </div>
                        </div>

                        <!-- 2. Schedule -->
                        <div id="checkItemSchedule" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Schedule</div>
                                <div class="text-[11px] text-slate-400">Date and start time</div>
                            </div>
                        </div>

                        <!-- 3. Venue -->
                        <div id="checkItemVenue" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Venue</div>
                                <div class="text-[11px] text-slate-400">Name, address and city</div>
                            </div>
                        </div>

                        <!-- 4. Evidence Link -->
                        <div id="checkItemEvidence" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Evidence link</div>
                                <div class="text-[11px] text-slate-400">Official ticket or source URL</div>
                            </div>
                        </div>

                        <!-- 5. Organiser Contact -->
                        <div id="checkItemContact" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Organiser contact</div>
                                <div class="text-[11px] text-slate-400">Name and email for the decision</div>
                            </div>
                        </div>

                        <!-- 6. Poster -->
                        <div id="checkItemPoster" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Poster artwork</div>
                                <div class="text-[11px] text-slate-400">Upload or image URL (Slot 1–4)</div>
                            </div>
                        </div>

                        <!-- 7. Declaration -->
                        <div id="checkItemDeclaration" class="flex items-start gap-3 text-slate-500">
                            <i class="far fa-circle text-slate-300 mt-0.5 text-xs check-icon"></i>
                            <div>
                                <div class="font-bold text-slate-800 check-title">Declaration</div>
                                <div class="text-[11px] text-slate-400">Truthfulness confirmed</div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic 'Still Needed' Callout -->
                    <div id="checklistStillNeeded" class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 text-[11px] text-slate-500 leading-relaxed">
                        Still needed: event title and category, date and time, venue and city, official ticket link, poster artwork, declaration.
                    </div>

                    <!-- Preview Trigger in Sidebar -->
                    <button type="button" onclick="openEventPreviewModal()" 
                            class="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fas fa-eye text-purple-600"></i>
                        <span>Preview listing appearance</span>
                    </button>

                    <!-- What runs after you submit Accordion -->
                    <div class="pt-3 border-t border-slate-100">
                        <details class="group">
                            <summary class="flex items-center justify-between text-xs font-bold text-purple-900 hover:text-purple-700 cursor-pointer py-1">
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-shield-halved text-purple-600"></i>
                                    <span>What runs after you submit</span>
                                </span>
                                <i class="fas fa-chevron-down text-[10px] text-slate-400 group-open:rotate-180 transition-transform"></i>
                            </summary>
                            <div class="mt-2.5 space-y-2 text-[11px] text-slate-500 leading-relaxed bg-purple-50/60 p-3 rounded-xl border border-purple-100">
                                <p><strong>1. Dual-AI Scanner:</strong> Google Gemini Vision reads tour typography and dates from your poster graphics.</p>
                                <p><strong>2. Whitelist Verification:</strong> URLs are verified against official promoter domains and authorized ticketing platforms.</p>
                                <p><strong>3. Immediate Publishing:</strong> High-scoring events achieve instant <strong>VERIFIED</strong> status without human bottlenecks.</p>
                            </div>
                        </details>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

