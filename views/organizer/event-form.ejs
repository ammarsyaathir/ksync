<%- include('../partials/header', { title: (isEdit ? 'Edit Event' : 'Create New Event') + ' | Organizer Workspace' }) %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Top Breadcrumb & Title -->
    <div class="mb-8">
        <a href="/organizer/dashboard" class="inline-flex items-center text-xs font-bold text-slate-500 hover:text-pink-600 mb-3 transition-colors">
            <i class="fas fa-arrow-left me-1.5"></i> Back to Organizer Dashboard
        </a>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 uppercase tracking-wider">
                    <i class="fas fa-calendar-plus me-1"></i> Organizer Portal
                </span>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
                    <%= isEdit ? 'Edit Event: ' + event.event_name : 'Create New K-Pop Event' %>
                </h1>
                <p class="text-xs sm:text-sm text-slate-600 mt-1">
                    <%= isEdit ? 'Update your listing details. Edits will trigger autonomous Dual-AI re-evaluation.' : 'Fill in the event dossier below. Our Dual-AI verification engine checks dates, venues, and official links upon submission.' %>
                </p>
            </div>
        </div>
    </div>

    <!-- AI Verification Notice Banner -->
    <div class="bg-gradient-to-r from-purple-900 to-indigo-900 rounded-2xl p-5 text-white shadow-md mb-8 flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-300 flex items-center justify-center text-lg shrink-0 mt-0.5">
            <i class="fas fa-robot"></i>
        </div>
        <div class="text-xs leading-relaxed">
            <div class="font-extrabold text-sm text-pink-200">Autonomous Dual-AI Verification Notice</div>
            <p class="text-slate-300 mt-1">
                K-Sync Malaysia does not require human admin queues. Upon saving, <strong>AI Model 1 (Vision OCR)</strong> and <strong>AI Model 2 (Semantic Auditor)</strong> cross-verify your poster artwork with your form inputs and official announcement URL. Ensure your poster date and form date match exactly to achieve immediate <strong>VERIFIED</strong> status!
            </p>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">

        <% if (!isEdit) { %>
        <!-- ⚡ 1-Click Sample Data Autofill Quick Helper -->
        <div class="bg-gradient-to-r from-pink-50 via-purple-50 to-indigo-50 border border-pink-200/80 rounded-2xl p-5 mb-8 shadow-sm">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-gradient-to-r from-pink-600 to-purple-600 text-white tracking-wide uppercase shadow-sm">
                            ⚡ Quick Demo Helper
                        </span>
                        <span class="text-xs font-bold text-slate-800">1-Click Sample K-Pop Event Autofill</span>
                    </div>
                    <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
                        Click the button below to instantly populate <strong>all 15 form fields and the poster artwork preview</strong>. 
                        <span class="text-rose-600 font-semibold block sm:inline mt-0.5 sm:mt-0">
                            <i class="fas fa-info-circle me-1"></i>No database entry is made yet
                        </span> — you can review, edit, or adjust anything before submitting!
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" onclick="fillSampleData('aespa')" id="btnAutofillAespa" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-extrabold text-xs shadow-md shadow-pink-500/20 transition-all flex items-center gap-2 active:scale-95 cursor-pointer">
                        <i class="fas fa-magic text-yellow-300"></i> ✨ 1-Click: aespa (Concert)
                    </button>
                    <button type="button" onclick="fillSampleData('boynextdoor')" class="px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-extrabold text-xs shadow-md shadow-blue-500/20 transition-all flex items-center gap-1.5 active:scale-95 cursor-pointer">
                        <i class="fas fa-door-open text-yellow-200"></i> BOYNEXTDOOR (iMe)
                    </button>
                    <button type="button" onclick="fillSampleData('ive')" class="px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-pink-300 text-slate-700 hover:text-pink-600 font-bold text-xs transition-all flex items-center gap-1.5 cursor-pointer">
                        <i class="fas fa-music text-purple-500"></i> IVE Tour
                    </button>
                    <button type="button" onclick="fillSampleData('cupsleeve')" class="px-3 py-2 rounded-xl bg-white border border-slate-200 hover:border-pink-300 text-slate-700 hover:text-pink-600 font-bold text-xs transition-all flex items-center gap-1.5 cursor-pointer">
                        <i class="fas fa-coffee text-amber-500"></i> Cupsleeve
                    </button>
                    <button type="button" onclick="clearFormFields()" title="Reset / Clear all fields" class="px-2.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-rose-50 hover:border-rose-200 text-slate-500 hover:text-rose-600 text-xs font-bold transition-all cursor-pointer">
                        <i class="fas fa-rotate-left"></i>
                    </button>
                </div>
            </div>

            <!-- Toast / Confirmation Alert when filled -->
            <div id="autofillToast" class="mt-4 hidden p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-medium flex items-center justify-between transition-all">
                <div class="flex items-center gap-2.5">
                    <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                        <i class="fas fa-check text-xs"></i>
                    </div>
                    <div>
                        <strong id="toastTitle" class="font-extrabold text-emerald-800">Sample event data populated!</strong>
                        <div class="text-[11px] text-emerald-700">All fields and poster preview are filled in below. Review them and click <strong>"Submit & Run Dual-AI Verification"</strong> when ready.</div>
                    </div>
                </div>
                <button type="button" onclick="document.getElementById('autofillToast').classList.add('hidden')" class="text-emerald-500 hover:text-emerald-800 text-base font-bold ml-2 leading-none">&times;</button>
            </div>
        </div>
        <% } %>

        <form action="<%= isEdit ? '/organizer/events/' + event.id + '/edit' : '/organizer/events/new' %>" method="POST" enctype="multipart/form-data" class="space-y-8">
            
            <!-- Section 1: Core Details -->
            <div>
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-pink-100 text-pink-600 text-xs flex items-center justify-center font-bold">1</span>
                    Event & Artist Details
                </h3>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Event Title <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" name="event_name" value="<%= isEdit ? event.event_name : '' %>" required
                               placeholder="e.g. TXT WORLD TOUR IN KUALA LUMPUR"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-900 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                K-Pop Artist / Group <span class="text-rose-500">*</span>
                            </label>
                            <select name="artist_id" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-pink-300">
                                <option value="">Select Artist / Group...</option>
                                <% artists.forEach(a => { %>
                                    <option value="<%= a.id %>" <%= isEdit && event.artist_id == a.id ? 'selected' : '' %>>
                                        <%= a.name %> (<%= a.group_type %>)
                                    </option>
                                <% }); %>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Event Category <span class="text-rose-500">*</span>
                            </label>
                            <select name="category_id" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-pink-300">
                                <option value="">Select Category...</option>
                                <% categories.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= isEdit && event.category_id == c.id ? 'selected' : '' %>>
                                        <%= c.name %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Event Description & Synopsis</label>
                        <textarea name="description" rows="4" placeholder="Describe the tour, soundcheck perks, or cupsleeve giveaways..."
                                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300"><%= isEdit ? event.description : '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Section 2: Date, Time & Venue -->
            <div>
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-purple-100 text-purple-600 text-xs flex items-center justify-center font-bold">2</span>
                    Date, Time & Venue
                </h3>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Event Date <span class="text-rose-500">*</span>
                            </label>
                            <input type="date" name="event_date" value="<%= isEdit ? event.event_date : '' %>" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Start Time <span class="text-rose-500">*</span>
                            </label>
                            <input type="time" name="start_time" value="<%= isEdit ? event.start_time : '' %>" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">End Time (Optional)</label>
                            <input type="time" name="end_time" value="<%= isEdit ? event.end_time : '' %>"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Venue Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="venue_name" value="<%= isEdit ? event.venue_name : '' %>" required
                                   placeholder="e.g. Zepp Kuala Lumpur or Axiata Arena Bukit Jalil"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                City <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="city" value="<%= isEdit ? event.city : 'Kuala Lumpur' %>" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">State</label>
                            <input type="text" name="state" value="<%= isEdit ? event.state : 'W.P. Kuala Lumpur' %>"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Full Street Address</label>
                            <input type="text" name="address" value="<%= isEdit ? event.address : '' %>"
                                   placeholder="e.g. B2-01-02, Level 2, Mitsui Shopping Park LaLaport BBCC"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Ticketing, Rules & Proof -->
            <div>
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 text-xs flex items-center justify-center font-bold">3</span>
                    Ticketing & Official Verification Source
                </h3>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Ticket Categories & Pricing</label>
                            <textarea name="ticket_info" rows="3" placeholder="e.g. VIP Soundcheck: RM888 | Cat 1: RM688 | Cat 2: RM488"
                                      class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300"><%= isEdit ? event.ticket_info : '' %></textarea>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Event Guidelines / Rules</label>
                            <textarea name="event_rules" rows="3" placeholder="e.g. Official lightsticks permitted. No DSLR telephoto lenses allowed."
                                      class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300"><%= isEdit ? event.event_rules : '' %></textarea>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Official Announcement URL / Ticketing Gateway <span class="text-rose-500">*</span>
                        </label>
                        <input type="url" name="official_url" value="<%= isEdit ? event.official_url : '' %>" required
                               placeholder="https://golive-asia.com/event or https://weverse.io/..."
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-mono focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <span class="text-[10px] text-slate-400 mt-1 block">Cross-checked against authorized domain whitelists and OpenGraph metadata.</span>
                    </div>

                    <!-- Poster Upload & Live Preview -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Event Poster Artwork <span class="text-rose-500">*</span>
                        </label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <input type="file" id="posterFileInput" name="poster_file" accept="image/*"
                                       class="w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 cursor-pointer">
                                <span class="text-[10px] text-slate-400 mt-1 block">Upload image file (JPG, PNG, WebP). Used for Gemini Vision OCR analysis.</span>
                            </div>
                            <div>
                                <input type="url" id="posterUrlInput" name="poster_url" value="<%= isEdit ? (event.poster_image || '') : '' %>"
                                       placeholder="Or paste direct image URL (https://...)"
                                       class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-800 font-mono focus:outline-none focus:ring-2 focus:ring-pink-300">
                                <span class="text-[10px] text-slate-400 mt-1 block">Direct HTTPS image link. Live preview renders automatically below.</span>
                            </div>
                        </div>

                        <!-- Live Poster Artwork Preview -->
                        <div id="posterPreviewContainer" class="mt-4 p-4 rounded-2xl bg-gradient-to-r from-slate-50 to-pink-50/40 border border-slate-200 flex flex-col sm:flex-row items-center gap-5 <%= (isEdit && event.poster_image) ? '' : 'hidden' %>">
                            <div class="relative group shrink-0">
                                <img id="posterPreviewImg" src="<%= (isEdit && event.poster_image) ? event.poster_image : '' %>" alt="Poster Artwork Preview" class="w-28 h-40 object-cover rounded-xl shadow-md border border-slate-300 bg-white">
                                <span class="absolute bottom-1.5 left-1.5 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur text-[9px] text-white font-bold tracking-wider uppercase">
                                    Artwork
                                </span>
                            </div>
                            <div class="text-xs text-slate-600 flex-1">
                                <div class="font-extrabold text-slate-900 text-sm flex items-center gap-1.5">
                                    <i class="fas fa-image text-pink-500"></i> Active Poster Artwork Preview
                                </div>
                                <p class="mt-1 text-slate-500 leading-relaxed text-[11px]">
                                    This visual poster will be passed to <strong>Google Gemini Vision AI</strong> upon submission to cross-verify tour typography, concert dates, and venue accuracy against your form inputs.
                                </p>
                                <div class="mt-3 flex items-center gap-2">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Source:</span>
                                    <span id="posterPreviewUrlText" class="text-[10px] font-mono text-purple-700 bg-purple-100/60 px-2.5 py-1 rounded-lg border border-purple-200/60 truncate max-w-sm sm:max-w-md block">
                                        <%= (isEdit && event.poster_image) ? event.poster_image : 'No image loaded' %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (isEdit) { %>
                        <div class="pt-2 border-t border-slate-100">
                            <label class="block text-xs font-bold text-slate-700 mb-1">Event Lifecycle Status</label>
                            <select name="event_status" class="w-full sm:w-64 bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs font-bold">
                                <option value="UPCOMING" <%= event.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                <option value="ONGOING" <%= event.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing</option>
                                <option value="COMPLETED" <%= event.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                <option value="POSTPONED" <%= event.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                <option value="CANCELLED" <%= event.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                <a href="/organizer/dashboard" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="px-8 py-3 rounded-2xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white text-xs sm:text-sm font-extrabold shadow-lg shadow-pink-500/25 transition-all flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-bolt"></i> <%= isEdit ? 'Save Changes & Re-Verify' : 'Submit & Run Dual-AI Verification' %>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// Sample Presets for Malaysian K-Pop Events
// (Client-side ONLY: does NOT submit to database until the user clicks Submit manually)
const SAMPLE_PRESETS = {
    aespa: {
        event_name: '2027 aespa LIVE TOUR – SYNK: PARALLEL LINE in KUALA LUMPUR',
        artist_id: '8', // aespa
        category_id: '1', // Concert
        description: 'SM Entertainment and Live Nation Malaysia proudly present the brand new arena tour: aespa LIVE TOUR – SYNK: PARALLEL LINE in Kuala Lumpur! Karina, Giselle, Winter, and Ningning bring their revolutionary cyberpunk stages to Axiata Arena Bukit Jalil, performing chart-topping anthems including Supernova, Armageddon, Drama, Whiplash, and Next Level along with exclusive solo stages and sync lightstick production.',
        event_date: '2027-05-15',
        start_time: '18:00',
        end_time: '21:30',
        venue_name: 'Axiata Arena, Bukit Jalil',
        city: 'Kuala Lumpur',
        state: 'Wilayah Persekutuan Kuala Lumpur',
        address: 'Jalan Barat, Bukit Jalil, 57000 Kuala Lumpur, Wilayah Persekutuan Kuala Lumpur',
        ticket_info: 'VIP Soundcheck Standing: RM 988 (Includes Soundcheck access, VIP Lanyard & Commemorative Pass)\nCAT 1 Standing: RM 788\nCAT 2 Seated: RM 688\nCAT 3 Seated: RM 488\nCAT 4 Seated: RM 288\n*Prices exclude RM 4 processing fee. Maximum 4 tickets per transaction.',
        event_rules: '- Strictly no DSLR cameras, telephoto zoom lenses, tablets, or audio/video recording devices.\n- Official aespa Lightsticks (Version 1 & 2) permitted.\n- VIP Soundcheck queuing begins at 1:00 PM; Soundcheck starts at 4:00 PM.\n- Bags larger than A4 paper size are strictly prohibited inside the arena hall.',
        official_url: 'https://www.livenation.my/show/1458892/aespa-live-tour-synk-parallel-line-in-kuala-lumpur',
        poster_url: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'
    },
    boynextdoor: {
        event_name: "BOYNEXTDOOR TOUR 'KNOCK ON Vol.2' IN KUALA LUMPUR",
        artist_id: '18', // BOYNEXTDOOR
        category_id: '1', // Concert
        description: "KOZ Entertainment and iMe Malaysia are proud to present BOYNEXTDOOR TOUR 'KNOCK ON Vol.2' IN KUALA LUMPUR! Sungho, Riwoo, Jaehyun, Taesan, Leehan, and Woonhak bring their powerhouse vocals, explosive stages, and infectious energy to Unifi Arena Bukit Jalil on 26 December 2026. Don't miss this landmark concert experience packed with fan favorites and custom stages.",
        event_date: '2026-12-26',
        start_time: '18:00',
        end_time: '21:00',
        venue_name: 'Unifi Arena',
        city: 'Kuala Lumpur',
        state: 'Wilayah Persekutuan Kuala Lumpur',
        address: 'Kompleks Sukan Negara, Bukit Jalil, 57000 Kuala Lumpur',
