                    <div id="terminalLaserBeam" class="absolute left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#c6f03d] to-transparent shadow-[0_0_15px_#c6f03d] pointer-events-none transition-all animate-laser"></div>
                    
                    <!-- Target Overlays / Bounding Boxes -->
