                <div class="p-3 rounded-xl bg-slate-900/70 border border-slate-800/80 text-[11px] text-slate-400 font-mono leading-relaxed">
                    <span class="text-purple-400 font-bold">&bull; Gemini 4 Argon:</span> Ingested poster picture directly into dense spatial OCR matrix. Multimodal vision sweeps typography, timetable, and ticket tiers.
                </div>
            </div>

            <!-- RIGHT COLUMN: Console Stream & 1-by-1 Extracted Cards (7 cols) -->
            <div class="lg:col-span-7 flex flex-col gap-3.5">
                
                <!-- Monospace Terminal Log Output -->
                <div class="rounded-2xl bg-black border border-slate-800 p-3.5 font-mono text-xs">
                    <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800 text-[11px] text-slate-400">
                        <span class="flex items-center gap-1.5">
