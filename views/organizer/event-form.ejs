function openEventPreviewModal() {
    const modal = document.getElementById('eventPreviewModal');
    if (!modal) return;

    // Gather Live Values from Form
    const name = document.getElementById('inputEventName')?.value.trim() || 'Untitled K-Pop Event';
    const catSelect = document.getElementById('inputCategoryId');
    const catText = catSelect?.options[catSelect.selectedIndex]?.text || 'Concert';
    const artistSelect = document.getElementById('inputArtistId');
    const artistText = artistSelect?.options[artistSelect.selectedIndex]?.text || 'K-Pop Artist / Group';
    const rawDate = document.getElementById('inputEventDate')?.value.trim();
    const startTime = document.getElementById('inputStartTime')?.value.trim() || '18:00';
    const venueName = document.getElementById('inputVenueName')?.value.trim() || 'Venue Name';
    const city = document.getElementById('inputCity')?.value.trim() || 'Kuala Lumpur';
    const state = document.getElementById('inputState')?.value.trim() || '';
    const address = document.getElementById('inputAddress')?.value.trim() || '';
    const desc = document.getElementById('inputDescription')?.value.trim() || 'No description provided yet.';
    const rules = document.getElementById('inputEventRules')?.value.trim() || 'Official lightsticks permitted. Please follow venue safety guidelines.';
    const orgName = document.getElementById('inputSubmitterName')?.value.trim() || 'Authorized Host';

    // Populate Modal Fields
    document.getElementById('modalEventTitle').textContent = name;
    document.getElementById('modalCategoryBadge').textContent = catText;
    document.getElementById('modalMetaArtist').textContent = artistText.replace(/\(.*?\)/g, '').trim() || artistText;
    document.getElementById('modalMetaVenue').textContent = venueName;
    document.getElementById('modalMetaAddress').textContent = `${address ? address + ', ' : ''}${city}${state ? ', ' + state : ''} \u2022 Google Maps`;
    document.getElementById('modalDescription').textContent = desc;
    document.getElementById('modalRules').textContent = rules;
    document.getElementById('modalMetaOrganizer').textContent = orgName;

    // Date Format
    if (rawDate) {
        const d = new Date(rawDate);
        if (!isNaN(d.getTime())) {
            const dayNum = d.getDate();
            const monthShort = d.toLocaleString('en-US', { month: 'short' }).toUpperCase();
            const dateFull = d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            document.getElementById('modalDateDay').textContent = dayNum;
            document.getElementById('modalDateMonth').textContent = monthShort;
            document.getElementById('modalMetaDate').textContent = dateFull;
        }
    }
    document.getElementById('modalMetaTime').textContent = `Doors open ${startTime} MYT (Malaysia Time)`;

    // Posters & Gallery Setup in Modal
    const activePoster = document.getElementById('modalActivePoster');
    const thumbnailsContainer = document.getElementById('modalGalleryThumbnails');
    thumbnailsContainer.innerHTML = '';

    const validPosters = [];
    for (let i = 1; i <= 4; i++) {
        if (slotData[i].url) {
            validPosters.push({ slot: i, url: slotData[i].url });
        }
    }

    if (validPosters.length > 0) {
        activePoster.src = validPosters[0].url;
        validPosters.forEach((p, idx) => {
            const thumbBtn = document.createElement('button');
            thumbBtn.type = 'button';
            thumbBtn.className = `w-12 h-14 rounded-lg overflow-hidden border-2 ${idx === 0 ? 'border-purple-600 ring-2 ring-purple-400' : 'border-slate-200 opacity-70'} hover:opacity-100 transition-all shrink-0 cursor-pointer`;
            thumbBtn.innerHTML = `<img src="${p.url}" class="w-full h-full object-cover">`;
            thumbBtn.onclick = () => {
                activePoster.src = p.url;
                thumbnailsContainer.querySelectorAll('button').forEach(b => {
                    b.className = 'w-12 h-14 rounded-lg overflow-hidden border-2 border-slate-200 opacity-70 hover:opacity-100 transition-all shrink-0 cursor-pointer';
                });
                thumbBtn.className = 'w-12 h-14 rounded-lg overflow-hidden border-2 border-purple-600 ring-2 ring-purple-400 transition-all shrink-0 cursor-pointer';
            };
            thumbnailsContainer.appendChild(thumbBtn);
        });
    } else {
        activePoster.src = 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop';
    }

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

function closeEventPreviewModal() {
    const modal = document.getElementById('eventPreviewModal');
    if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }
}

function submitFromPreviewModal() {
    closeEventPreviewModal();
    const form = document.getElementById('eventSubmissionForm');
    if (form) {
        // Automatically check the declaration if user confirms from modal
        const decl = document.getElementById('inputDeclaration');
        if (decl) decl.checked = true;
        updateChecklistState();
        form.submit();
    }
}

