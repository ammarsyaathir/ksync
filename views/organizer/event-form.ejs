                    <div id="bboxTitle" class="absolute top-20 left-4 right-4 h-16 border-2 border-dashed border-cyan-400/80 bg-cyan-500/10 rounded-lg hidden pointer-events-none transition-all animate-pulse flex items-center px-2">
