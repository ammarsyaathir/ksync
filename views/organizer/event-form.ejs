<%- include('../partials/header', { title: (isEdit ? 'Edit Event' : 'Create New Event') + ' | Organizer Workspace' }) %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Top Breadcrumb & Title -->
    <div class="mb-8">
        <a href="/organizer/dashboard" class="inline-flex items-center text-xs font-bold text-slate-500 hover:text-pink-600 mb-3 transition-colors">
            <i class="fas fa-arrow-left me-1.5"></i> Back to Organizer Dashboard
        </a>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 uppercase tracking-wider">
                    <i class="fas fa-calendar-plus me-1"></i> Organizer Portal
                </span>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
                    <%= isEdit ? 'Edit Event: ' + event.event_name : 'Create New K-Pop Event' %>
                </h1>
                <p class="text-xs sm:text-sm text-slate-600 mt-1">
                    <%= isEdit ? 'Update your listing details. Edits will trigger autonomous Dual-AI re-evaluation.' : 'Fill in the event dossier below. Our Dual-AI verification engine checks dates, venues, and official links upon submission.' %>
                </p>
            </div>
        </div>
    </div>

    <!-- AI Verification Notice Banner -->
    <div class="bg-gradient-to-r from-purple-900 to-indigo-900 rounded-2xl p-5 text-white shadow-md mb-8 flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-300 flex items-center justify-center text-lg shrink-0 mt-0.5">
            <i class="fas fa-robot"></i>
        </div>
        <div class="text-xs leading-relaxed">
            <div class="font-extrabold text-sm text-pink-200">Autonomous Dual-AI Verification Notice</div>
            <p class="text-slate-300 mt-1">
                K-Sync Malaysia does not require human admin queues. Upon saving, <strong>AI Model 1 (Vision OCR)</strong> and <strong>AI Model 2 (Semantic Auditor)</strong> cross-verify your poster artwork with your form inputs and official announcement URL. Ensure your poster date and form date match exactly to achieve immediate <strong>VERIFIED</strong> status!
            </p>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
        <form action="<%= isEdit ? '/organizer/events/' + event.id + '/edit' : '/organizer/events/new' %>" method="POST" enctype="multipart/form-data" class="space-y-8">
            
            <!-- Section 1: Core Details -->
            <div>
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-pink-100 text-pink-600 text-xs flex items-center justify-center font-bold">1</span>
                    Event & Artist Details
                </h3>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Event Title <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" name="event_name" value="<%= isEdit ? event.event_name : '' %>" required
                               placeholder="e.g. TXT WORLD TOUR IN KUALA LUMPUR"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-900 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                K-Pop Artist / Group <span class="text-rose-500">*</span>
                            </label>
                            <select name="artist_id" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-pink-300">
                                <option value="">Select Artist / Group...</option>
                                <% artists.forEach(a => { %>
                                    <option value="<%= a.id %>" <%= isEdit && event.artist_id == a.id ? 'selected' : '' %>>
                                        <%= a.name %> (<%= a.group_type %>)
                                    </option>
                                <% }); %>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Event Category <span class="text-rose-500">*</span>
                            </label>
                            <select name="category_id" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-pink-300">
                                <option value="">Select Category...</option>
                                <% categories.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= isEdit && event.category_id == c.id ? 'selected' : '' %>>
                                        <%= c.name %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Event Description & Synopsis</label>
                        <textarea name="description" rows="4" placeholder="Describe the tour, soundcheck perks, or cupsleeve giveaways..."
                                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300"><%= isEdit ? event.description : '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Section 2: Date, Time & Venue -->
            <div>
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-purple-100 text-purple-600 text-xs flex items-center justify-center font-bold">2</span>
                    Date, Time & Venue
                </h3>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Event Date <span class="text-rose-500">*</span>
                            </label>
                            <input type="date" name="event_date" value="<%= isEdit ? event.event_date : '' %>" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Start Time <span class="text-rose-500">*</span>
                            </label>
                            <input type="time" name="start_time" value="<%= isEdit ? event.start_time : '' %>" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">End Time (Optional)</label>
                            <input type="time" name="end_time" value="<%= isEdit ? event.end_time : '' %>"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Venue Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="venue_name" value="<%= isEdit ? event.venue_name : '' %>" required
                                   placeholder="e.g. Zepp Kuala Lumpur or Axiata Arena Bukit Jalil"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                City <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="city" value="<%= isEdit ? event.city : 'Kuala Lumpur' %>" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">State</label>
                            <input type="text" name="state" value="<%= isEdit ? event.state : 'W.P. Kuala Lumpur' %>"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Full Street Address</label>
                            <input type="text" name="address" value="<%= isEdit ? event.address : '' %>"
                                   placeholder="e.g. B2-01-02, Level 2, Mitsui Shopping Park LaLaport BBCC"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Ticketing, Rules & Proof -->
            <div>
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 text-xs flex items-center justify-center font-bold">3</span>
                    Ticketing & Official Verification Source
                </h3>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Ticket Categories & Pricing</label>
                            <textarea name="ticket_info" rows="3" placeholder="e.g. VIP Soundcheck: RM888 | Cat 1: RM688 | Cat 2: RM488"
                                      class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300"><%= isEdit ? event.ticket_info : '' %></textarea>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Event Guidelines / Rules</label>
                            <textarea name="event_rules" rows="3" placeholder="e.g. Official lightsticks permitted. No DSLR telephoto lenses allowed."
                                      class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-300"><%= isEdit ? event.event_rules : '' %></textarea>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Official Announcement URL / Ticketing Gateway <span class="text-rose-500">*</span>
                        </label>
                        <input type="url" name="official_url" value="<%= isEdit ? event.official_url : '' %>" required
                               placeholder="https://golive-asia.com/event or https://weverse.io/..."
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-800 font-mono focus:outline-none focus:ring-2 focus:ring-pink-300">
                        <span class="text-[10px] text-slate-400 mt-1 block">Cross-checked against authorized domain whitelists and OpenGraph metadata.</span>
                    </div>

                    <!-- Poster Upload -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Event Poster Artwork <span class="text-rose-500">*</span>
                        </label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <input type="file" name="poster_file" accept="image/*"
                                       class="w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100">
                                <span class="text-[10px] text-slate-400 mt-1 block">Upload image file (JPG, PNG). Used for Gemini Vision OCR analysis.</span>
                            </div>
                            <div>
                                <input type="url" name="poster_url" value="<%= isEdit ? event.poster_image : '' %>"
                                       placeholder="Or paste direct image URL (https://...)"
                                       class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs text-slate-800 font-mono">
                            </div>
                        </div>
                    </div>

                    <% if (isEdit) { %>
                        <div class="pt-2 border-t border-slate-100">
                            <label class="block text-xs font-bold text-slate-700 mb-1">Event Lifecycle Status</label>
                            <select name="event_status" class="w-full sm:w-64 bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs font-bold">
                                <option value="UPCOMING" <%= event.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                <option value="ONGOING" <%= event.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing</option>
                                <option value="COMPLETED" <%= event.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                <option value="POSTPONED" <%= event.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                <option value="CANCELLED" <%= event.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                <a href="/organizer/dashboard" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="px-8 py-3 rounded-2xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white text-xs sm:text-sm font-extrabold shadow-lg shadow-pink-500/25 transition-all flex items-center gap-2">
                    <i class="fas fa-bolt"></i> <%= isEdit ? 'Save Changes & Re-Verify' : 'Submit & Run Dual-AI Verification' %>
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
