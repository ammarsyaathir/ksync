function fillSampleData(key) {
    const data = SAMPLE_PRESETS[key] || SAMPLE_PRESETS.boynextdoor;
    const form = document.getElementById('eventSubmissionForm');
    if (!form) return;

    // Fill textual inputs
    for (const [k, v] of Object.entries(data)) {
        if (k === 'posters') continue;
        const input = form.querySelector(`[name="${k}"]`);
        if (input) {
            input.value = v;
            input.classList.add('ring-2', 'ring-purple-400', 'bg-purple-50/30');
            setTimeout(() => input.classList.remove('ring-2', 'ring-purple-400', 'bg-purple-50/30'), 1200);
        }
    }

    // Fill graphics slots
    if (data.posters && data.posters.length > 0) {
        data.posters.forEach((pUrl, idx) => {
            const slotNum = idx + 1;
            if (slotNum <= 4) {
                const urlInput = document.getElementById(`urlInputSlot${slotNum}`);
                if (urlInput) urlInput.value = pUrl;
                handleSlotUrl(slotNum, pUrl);
            }
        });
    }

    // Auto-check declaration for sample
    const decl = document.getElementById('inputDeclaration');
    if (decl) decl.checked = true;

    // Show toast
    const toast = document.getElementById('autofillToast');
    const toastTitle = document.getElementById('toastTitle');
    if (toast) {
        if (toastTitle) toastTitle.textContent = `Sample Loaded: "${data.event_name}"`;
        toast.classList.remove('hidden');
    }

    updateChecklistState();
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function clearFormFields() {
    const form = document.getElementById('eventSubmissionForm');
    if (!form) return;
    form.reset();
    for (let i = 1; i <= 4; i++) {
        clearSlot(i);
    }
    const toast = document.getElementById('autofillToast');
    if (toast) toast.classList.add('hidden');
    updateChecklistState();
}

// ============================================================================
// AI POSTER PICTURE UPLOAD & GEMINI 4 ARGON SCAN TERMINAL (1-BY-1 EXTRACTION)
// ============================================================================
let currentExtractedData = null;
let selectedAiFile = null;
let selectedAiFileUrl = 'https://ime.co/wp-content/uploads/2026/07/01_BND_1080x1350.jpg';

// Drag & Drop handlers for AI Poster Picture zone
function handleAiDragOver(e) {
    e.preventDefault();
    e.stopPropagation();
    const zone = document.getElementById('aiPictureDropzone');
    if (zone) zone.classList.add('border-purple-600', 'bg-purple-100/50');
}

function handleAiDragLeave(e) {
    e.preventDefault();
    e.stopPropagation();
    const zone = document.getElementById('aiPictureDropzone');
    if (zone) zone.classList.remove('border-purple-600', 'bg-purple-100/50');
}

function handleAiDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    const zone = document.getElementById('aiPictureDropzone');
    if (zone) zone.classList.remove('border-purple-600', 'bg-purple-100/50');

    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        setAiSelectedFile(e.dataTransfer.files[0]);
    }
}

function handleAiPosterFileSelect(input) {
    if (input.files && input.files.length > 0) {
        setAiSelectedFile(input.files[0]);
    }
}

function setAiSelectedFile(file) {
    if (!file || !file.type.startsWith('image/')) {
        alert('Please choose a valid image file (JPG, PNG, WebP).');
        return;
    }
    selectedAiFile = file;

    const reader = new FileReader();
    reader.onload = function(e) {
        selectedAiFileUrl = e.target.result;
        
        // Update dropzone UI
        const emptyState = document.getElementById('dropzoneEmptyState');
        const previewState = document.getElementById('dropzonePreviewState');
        const thumb = document.getElementById('aiPosterThumbPreview');
        const nameEl = document.getElementById('aiPosterFileName');
        const sizeEl = document.getElementById('aiPosterFileSize');

        if (emptyState) emptyState.classList.add('hidden');
        if (previewState) previewState.classList.remove('hidden');
        if (thumb) thumb.src = e.target.result;
        if (nameEl) nameEl.textContent = file.name;
        if (sizeEl) sizeEl.textContent = formatBytes(file.size);

        const urlInput = document.getElementById('aiPosterInput');
        if (urlInput) urlInput.value = `[Uploaded File: ${file.name}]`;
    };
    reader.readAsDataURL(file);
}

function clearAiSelectedPicture() {
    selectedAiFile = null;
    selectedAiFileUrl = '';
    const fileInput = document.getElementById('aiPosterFileInput');
    if (fileInput) fileInput.value = '';
    const emptyState = document.getElementById('dropzoneEmptyState');
    const previewState = document.getElementById('dropzonePreviewState');
    if (emptyState) emptyState.classList.remove('hidden');
    if (previewState) previewState.classList.add('hidden');
    const urlInput = document.getElementById('aiPosterInput');
    if (urlInput) urlInput.value = '';
}

function loadSampleAiPoster(key) {
    const samples = {
        boynextdoor: {
            name: 'boynextdoor_official_tour_poster.jpg',
            size: 1845200,
            url: 'https://ime.co/wp-content/uploads/2026/07/01_BND_1080x1350.jpg'
        },
        babymonster: {
            name: 'babymonster_choom_tour_kl.jpg',
            size: 2140500,
            url: 'https://images.unsplash.com/photo-1540039155733-5bb30b53aa14?w=800&auto=format&fit=crop'
        },
        aespa: {
            name: 'aespa_synk_parallel_line_poster.png',
            size: 2450800,
            url: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'
        },
        cupsleeve: {
            name: 'carat_seventeen_10th_cupsleeve.jpg',
            size: 1540300,
            url: 'https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=800&auto=format&fit=crop'
        }
    };

    const s = samples[key] || samples.boynextdoor;
    selectedAiFile = null;
    selectedAiFileUrl = s.url;

    const emptyState = document.getElementById('dropzoneEmptyState');
    const previewState = document.getElementById('dropzonePreviewState');
    const thumb = document.getElementById('aiPosterThumbPreview');
    const nameEl = document.getElementById('aiPosterFileName');
    const sizeEl = document.getElementById('aiPosterFileSize');

    if (emptyState) emptyState.classList.add('hidden');
    if (previewState) previewState.classList.remove('hidden');
    if (thumb) thumb.src = s.url;
    if (nameEl) nameEl.textContent = s.name;
    if (sizeEl) sizeEl.textContent = formatBytes(s.size);

    const urlInput = document.getElementById('aiPosterInput');
    if (urlInput) urlInput.value = s.url;
}

function formatBytes(bytes) {
    if (!bytes) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

async function runSmartFill() {
    const url = document.getElementById('smartUrlInput')?.value.trim();
    if (url) {
        selectedAiFile = null;
        selectedAiFileUrl = url;
    }
    launchAiScanTerminal();
}

async function runAiExtract(passedUrl) {
    if (passedUrl) {
        selectedAiFile = null;
        selectedAiFileUrl = passedUrl;
    }
    launchAiScanTerminal();
}

async function launchAiScanTerminal() {
    const modal = document.getElementById('aiScanTerminalModal');
    if (!modal) return;

    // Determine target poster image
    let posterTarget = selectedAiFileUrl;
    if (!posterTarget) {
        const inputUrl = document.getElementById('aiPosterInput')?.value.trim();
        if (inputUrl && !inputUrl.startsWith('[')) {
            posterTarget = inputUrl;
        } else {
            loadSampleAiPoster('boynextdoor');
            posterTarget = selectedAiFileUrl;
        }
    }

    // Set poster in terminal viewport
    const scannedImg = document.getElementById('terminalScannedPosterImg');
    if (scannedImg) scannedImg.src = posterTarget;

    // Reset Terminal UI & state
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');

    const streamBox = document.getElementById('terminalStreamOutput');
    const cardsList = document.getElementById('terminalExtractedCardsList');
    const counter = document.getElementById('terminalExtractedCounter');
    const statusText = document.getElementById('terminalStatusText');
    const statusPulse = document.getElementById('terminalStatusPulse');
    const laser = document.getElementById('terminalLaserBeam');
    const footerStatus = document.getElementById('terminalFooterStatus');
    const applyBtn = document.getElementById('btnApplyAiTerminalDetails');

    if (streamBox) streamBox.innerHTML = '';
    if (cardsList) cardsList.innerHTML = '';
    if (counter) counter.textContent = '0 / 7 Entities Found';
    if (statusText) statusText.textContent = 'SWEEPING POSTER';
    if (statusPulse) statusPulse.className = 'w-2 h-2 rounded-full bg-[#c6f03d] animate-pulse';
    if (laser) laser.className = 'absolute left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#c6f03d] to-transparent shadow-[0_0_15px_#c6f03d] pointer-events-none animate-laser';
    if (footerStatus) footerStatus.textContent = 'Gemini 4 Argon Multimodal Vision OCR running...';
    if (applyBtn) {
        applyBtn.disabled = true;
        applyBtn.classList.add('opacity-50', 'cursor-not-allowed');
        applyBtn.classList.remove('ring-4', 'ring-[#c6f03d]/30', 'animate-pulse');
    }

    // Hide bounding boxes
    ['bboxArtist', 'bboxTitle', 'bboxVenue'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    });

    function appendTerminalLog(prefix, message, color = 'text-slate-300') {
        if (!streamBox) return;
        const line = document.createElement('div');
        const now = (performance.now() / 1000).toFixed(2);
        line.className = `flex items-start gap-2 ${color} font-mono`;
        line.innerHTML = `<span class="text-slate-500">[${now}s]</span> <span class="text-purple-400 font-bold">${prefix}</span> <span>${message}</span>`;
        streamBox.appendChild(line);
        streamBox.scrollTop = streamBox.scrollHeight;
    }

    function appendExtractedCard(icon, title, value, matchRate, badgeColor = 'emerald') {
        if (!cardsList) return;
        const card = document.createElement('div');
        card.className = 'p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-start justify-between gap-3 transition-all animate-fade-in hover:border-slate-700';
        card.innerHTML = `
            <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-slate-800 flex items-center justify-center text-xs text-purple-400 shrink-0 mt-0.5">
                    <i class="${icon}"></i>
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">${title}</div>
                    <div class="text-xs font-black text-white mt-0.5 leading-snug">${value}</div>
                </div>
            </div>
            <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-${badgeColor}-950 text-${badgeColor}-400 border border-${badgeColor}-800/60 shrink-0">
                ${matchRate}
            </span>
        `;
        cardsList.appendChild(card);
        cardsList.scrollTop = cardsList.scrollHeight;
    }

    appendTerminalLog('[INIT]', 'Booting Gemini 4 Argon Multimodal Vision OCR Engine...', 'text-slate-300');

    // Trigger API extraction in background
    let apiPromise;
    if (selectedAiFile) {
        const fd = new FormData();
        fd.append('poster_image_file', selectedAiFile);
        apiPromise = fetch('/api/ai/extract-poster', {
            method: 'POST',
            body: fd
        }).then(r => r.json());
    } else {
        apiPromise = fetch('/api/ai/extract-poster', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ poster_url: posterTarget, caption_text: posterTarget })
        }).then(r => r.json());
    }

    let extractResult = null;
    try {
        const json = await apiPromise;
        if (json.status === 'success' && json.data) {
            extractResult = json.data;
        }
    } catch (e) {
        console.warn('API error, using fallback:', e);
    }

    if (!extractResult) {
        extractResult = SAMPLE_PRESETS.boynextdoor;
    }
    currentExtractedData = extractResult;

    // Run the staged 1-by-1 extraction sequence
    setTimeout(() => {
        appendTerminalLog('[INGEST]', `Ingested image payload (${selectedAiFile ? selectedAiFile.name : 'URL'}). Multimodal tensor tokenization active.`);
    }, 280);

    setTimeout(() => {
        appendTerminalLog('[OCR_SCAN]', 'Detected multilingual typography (Hangul & Latin). Resolving artist signature...');
        const bbox = document.getElementById('bboxArtist');
        if (bbox) bbox.classList.remove('hidden');
        appendExtractedCard('fas fa-microphone', 'Artist / Group', extractResult.artist_name || 'BOYNEXTDOOR', '99.8% EXACT MATCH', 'emerald');
        if (counter) counter.textContent = '1 / 7 Entities Found';
    }, 650);

    setTimeout(() => {
        appendTerminalLog('[ENTITY_MATCH]', `Matched Tour Title: "${extractResult.event_name}".`);
        const bbox = document.getElementById('bboxTitle');
        if (bbox) bbox.classList.remove('hidden');
        appendExtractedCard('fas fa-ticket-alt', 'Official Event / Tour Title', extractResult.event_name, '99.5% CONFIDENCE', 'purple');
        if (counter) counter.textContent = '2 / 7 Entities Found';
    }, 1000);

    setTimeout(() => {
        appendTerminalLog('[TEMPORAL]', `Extracted date: ${extractResult.event_date} at ${extractResult.start_time || '18:00'}.`);
        appendExtractedCard('fas fa-calendar-day', 'Show Date & Time', `${extractResult.event_date} \u2022 ${extractResult.start_time || '18:00'} MYT`, '99.2% MATCH', 'cyan');
        if (counter) counter.textContent = '3 / 7 Entities Found';
    }, 1350);

    setTimeout(() => {
        appendTerminalLog('[GEO_ZONE]', `Matched Venue: ${extractResult.venue_name}, ${extractResult.city}.`);
        const bbox = document.getElementById('bboxVenue');
        if (bbox) bbox.classList.remove('hidden');
        appendExtractedCard('fas fa-location-dot', 'Venue & Location', `${extractResult.venue_name}, ${extractResult.city}`, '98.9% MATCH', 'emerald');
        if (counter) counter.textContent = '4 / 7 Entities Found';
    }, 1700);

    setTimeout(() => {
        appendTerminalLog('[COMMERCE]', 'Parsed Ringgit Malaysia (MYR) ticket tiers and fan perks.');
        const shortTicket = (extractResult.ticket_info || 'VIP Soundcheck, CAT 1, CAT 2').split('\n')[0];
        appendExtractedCard('fas fa-tags', 'Ticketing & Price Tiers', shortTicket, '98.5% MATCH', 'amber');
        if (counter) counter.textContent = '5 / 7 Entities Found';
    }, 2050);

    setTimeout(() => {
        appendTerminalLog('[COMPLIANCE]', 'Extracted admission rules and lightstick guidelines.');
        const shortRules = (extractResult.event_rules || 'Official lightsticks permitted.').split('\n')[0];
        appendExtractedCard('fas fa-shield-halved', 'Event Safety & Rules', shortRules, '97.9% MATCH', 'emerald');
        if (counter) counter.textContent = '6 / 7 Entities Found';
    }, 2400);

    setTimeout(() => {
        appendTerminalLog('[GRAPHIC_SLOT]', 'Poster picture ready to auto-assign into Slot 1: Main Tour Poster.');
        appendExtractedCard('fas fa-image', 'Assigned Graphic Slot', 'Slot 1: Main Tour Poster (Auto-populate)', '100% READY', 'emerald');
        if (counter) counter.textContent = '7 / 7 Entities Found';

        // Terminal Complete State
        if (statusText) statusText.textContent = 'SWEEP COMPLETE';
        if (statusPulse) statusPulse.className = 'w-2 h-2 rounded-full bg-emerald-400';
        if (laser) laser.classList.remove('animate-laser');
        appendTerminalLog('[COMPLETE]', 'All 7 entities extracted via Gemini 4 Argon. Ready to apply into form.', 'text-emerald-400 font-bold');
        if (footerStatus) footerStatus.textContent = 'Extraction complete! Click "Apply Extracted Details" below.';

        if (applyBtn) {
            applyBtn.disabled = false;
            applyBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            applyBtn.classList.add('ring-4', 'ring-[#c6f03d]/30', 'animate-pulse');
        }
    }, 2750);
}

function closeAiScanTerminal() {
    const modal = document.getElementById('aiScanTerminalModal');
    if (modal) modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
}

function applyAiTerminalDetailsToForm() {
    closeAiScanTerminal();
    if (!currentExtractedData) return;

    const data = currentExtractedData;
    const form = document.getElementById('eventSubmissionForm');
    if (!form) return;

    // Apply values to inputs with sequential typewriter/glow animation
    const fieldsToFill = [
        { name: 'event_name', val: data.event_name },
        { name: 'artist_id', val: data.artist_id },
        { name: 'category_id', val: data.category_id },
        { name: 'event_date', val: data.event_date },
        { name: 'start_time', val: data.start_time },
        { name: 'end_time', val: data.end_time },
        { name: 'venue_name', val: data.venue_name },
        { name: 'city', val: data.city },
        { name: 'state', val: data.state },
        { name: 'address', val: data.address },
        { name: 'ticket_info', val: data.ticket_info },
        { name: 'event_rules', val: data.event_rules },
        { name: 'description', val: data.description },
        { name: 'official_url', val: data.official_url }
    ];

    fieldsToFill.forEach((f, idx) => {
        setTimeout(() => {
            const input = form.querySelector(`[name="${f.name}"]`);
            if (input && f.val) {
                input.value = f.val;
                input.classList.add('ring-2', 'ring-purple-400', 'bg-purple-50/40');
                setTimeout(() => input.classList.remove('ring-2', 'ring-purple-400', 'bg-purple-50/40'), 1500);
            }
        }, idx * 50);
    });

    // Populate Slot 1 with the scanned poster picture!
    const posterImg = selectedAiFileUrl || data.poster_url;
    if (posterImg) {
        if (selectedAiFile) {
            slotData[1].file = selectedAiFile;
            slotData[1].url = posterImg;
            updateSlotUI(1, posterImg);
        } else {
            const urlInput1 = document.getElementById('urlInputSlot1');
            if (urlInput1) urlInput1.value = posterImg;
            handleSlotUrl(1, posterImg);
        }
    }

    // Auto-check declaration
    const decl = document.getElementById('inputDeclaration');
    if (decl) decl.checked = true;

    // Toast feedback
    const toast = document.getElementById('autofillToast');
    const toastTitle = document.getElementById('toastTitle');
    if (toast) {
        if (toastTitle) toastTitle.textContent = `Applied via Gemini 4 Argon: "${data.event_name}"`;
        toast.classList.remove('hidden');
    }

    updateChecklistState();
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>

