                    <div id="bboxVenue" class="absolute bottom-6 left-4 right-4 h-14 border-2 border-dashed border-emerald-400/80 bg-emerald-500/10 rounded-lg hidden pointer-events-none transition-all animate-pulse flex items-center px-2">
                        <span class="text-[9px] font-mono font-bold bg-emerald-900/90 text-emerald-200 px-1.5 py-0.5 rounded">DETECTED: VENUE &amp; CITY (98.9%)</span>
