<%- include('../partials/header', { title: (isEdit ? 'Edit Event: ' + event.event_name : 'Submit K-Pop Event') + ' | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 min-w-0 max-w-full">

    <!-- Top Stepper Header (Comp 1) -->
    <div class="mb-8">
        <div class="flex items-center justify-between gap-3 mb-4">
            <a href="/organizer/dashboard" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition-all press-tactile">
                <i class="fas fa-arrow-left text-[11px] text-slate-500"></i>
                <span>Back to workspace</span>
            </a>
            
            <!-- 3-Step Pill Stepper -->
            <div class="hidden sm:flex items-center gap-2 text-xs font-bold">
                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full <%= !isEdit ? 'bg-slate-900 text-white shadow-2xs' : 'bg-slate-100 text-slate-600' %>">
                    <span class="w-4 h-4 rounded-full <%= !isEdit ? 'bg-[#c6f03d] text-slate-950' : 'bg-slate-300 text-slate-700' %> flex items-center justify-center text-[10px] font-black">1</span>
                    <span>Read evidence</span>
                </div>
                <i class="fas fa-chevron-right text-[10px] text-slate-300"></i>
                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full <%= isEdit ? 'bg-slate-900 text-white shadow-2xs' : 'bg-purple-100 text-purple-900 border border-purple-200' %>">
                    <span class="w-4 h-4 rounded-full <%= isEdit ? 'bg-[#c6f03d] text-slate-950' : 'bg-purple-700 text-white' %> flex items-center justify-center text-[10px] font-black">2</span>
                    <span>Check details</span>
                </div>
                <i class="fas fa-chevron-right text-[10px] text-slate-300"></i>
                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-500">
                    <span class="w-4 h-4 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px] font-black">3</span>
                    <span>Submit & verify</span>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">
                        <i class="fas fa-shield-halved me-1"></i> Organizer Portal
                    </span>
                    <% if (isEdit) { %>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
                            Editing Listing #<%= event.tracking_code || event.id %>
                        </span>
                    <% } %>
                </div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mt-2">
                    <%= isEdit ? 'Edit Event: ' + event.event_name : 'Submit K-Pop Event' %>
                </h1>
                <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl leading-relaxed">
                    <%= isEdit 
                        ? 'Update your official listing details, graphics, and ticketing links. Changes automatically re-run Autonomous Dual-AI verification.' 
                        : 'Submit your concert, fan meeting, or cupsleeve event. Autonomous Dual-AI verifies source announcements instantly with zero admin queues.' %>
                </p>
            </div>
        </div>
    </div>

    <% if (!isEdit) { %>
    <!-- Top Announcement Smart Fill Card (Comp 1) -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-slate-200/90 shadow-sm mb-8 relative overflow-hidden">
        <!-- Top Lime Accent Ribbon -->
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#c6f03d]"></div>

        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
            <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-[#c6f03d] text-slate-950 flex items-center gap-1.5 uppercase tracking-wider">
                        <i class="fas fa-wand-magic-sparkles text-xs"></i> Smart fill
                    </span>
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1">
                        <i class="fas fa-lock text-[10px] text-emerald-600"></i> Suggestions only
                    </span>
                </div>

                <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    Start with the announcement. We'll fill the form.
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed max-w-2xl">
                    Paste the official announcement link or scan the poster. K-Sync reads the event name, date, venue, organiser and poster, then puts them in the form for you to check. Nothing is saved until you submit.
                </p>

                <!-- Mode Toggles (Official link vs Scan poster AI) -->
                <div class="flex items-center gap-2 mt-4">
                    <button type="button" id="tabModeLink" onclick="switchSmartMode('link')" 
                            class="px-4 py-2 rounded-full text-xs font-extrabold bg-slate-900 text-white flex items-center gap-1.5 shadow-2xs transition-all cursor-pointer">
                        <i class="fas fa-link text-[11px] text-[#c6f03d]"></i>
                        <span>Official link</span>
                    </button>
                    <button type="button" id="tabModeScan" onclick="switchSmartMode('scan')" 
                            class="px-4 py-2 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center gap-1.5 transition-all cursor-pointer">
                        <i class="fas fa-image text-[11px] text-purple-600"></i>
                        <span>AI Scan</span>
                        <span class="px-1.5 py-0.5 rounded-full text-[9px] font-black bg-[#c6f03d] text-slate-950">Gemini 4 Argon</span>
                    </button>
                </div>

                <!-- Input Box Container -->
                <div class="mt-3.5">
                    <!-- 1. URL Mode Input -->
                    <div id="smartLinkContainer" class="flex flex-col sm:flex-row items-stretch gap-2.5">
                        <div class="relative flex-1">
                            <i class="fas fa-link absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="url" id="smartUrlInput" 
                                   placeholder="https://weverse.io/... or the organiser's official announcement link"
                                   class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all">
                        </div>
                        <button type="button" id="btnSmartFill" onclick="runSmartFill()" 
                                class="px-6 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-sm transition-all press-tactile cursor-pointer shrink-0">
                            <i class="fas fa-bolt text-[#c6f03d]"></i>
                            <span>Read & fill</span>
                        </button>
                    </div>

                    <!-- 2. AI Poster Scan Mode Input (Direct Picture Upload + Terminal) -->
                    <div id="smartScanContainer" class="hidden space-y-3.5">
                        <!-- Direct Poster Picture File Dropzone -->
                        <div id="aiPictureDropzone" 
                             onclick="document.getElementById('aiPosterFileInput').click()"
                             ondragover="handleAiDragOver(event)"
                             ondragleave="handleAiDragLeave(event)"
                             ondrop="handleAiDrop(event)"
                             class="border-2 border-dashed border-purple-200 hover:border-purple-400 bg-purple-50/40 hover:bg-purple-50/70 rounded-2xl p-4 sm:p-5 text-center cursor-pointer transition-all group relative">
                            <input type="file" id="aiPosterFileInput" accept="image/*" class="hidden" onchange="handleAiPosterFileSelect(this)">
                            
                            <!-- Dropzone Default / Empty State -->
                            <div id="dropzoneEmptyState">
                                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white flex items-center justify-center mx-auto mb-2.5 shadow-sm group-hover:scale-105 transition-transform">
                                    <i class="fas fa-camera text-lg text-[#c6f03d]"></i>
                                </div>
                                <div class="text-xs sm:text-sm font-black text-slate-900">
                                    Click to choose or drop event poster picture
                                </div>
                                <p class="text-[11px] text-slate-500 mt-1">
                                    Upload JPG, PNG, or WebP (up to 10MB). Multimodal OCR extracts text directly from picture.
                                </p>
                                <div class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-extrabold bg-white border border-purple-200 text-purple-700 shadow-2xs">
                                    <i class="fas fa-microchip text-amber-500"></i> Powered by Gemini 4 Argon Vision OCR
                                </div>
                            </div>

                            <!-- Selected Picture Active Preview Card -->
                            <div id="dropzonePreviewState" class="hidden flex flex-col sm:flex-row items-center gap-4 text-left">
                                <div class="relative w-20 h-24 rounded-xl overflow-hidden bg-slate-900 shrink-0 border border-purple-300 shadow-sm">
                                    <img id="aiPosterThumbPreview" src="" alt="Selected Poster" class="w-full h-full object-cover">
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                                    <span class="absolute bottom-1 left-1 px-1 rounded text-[8px] font-mono font-bold bg-purple-600 text-white">IMG</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-emerald-100 text-emerald-800 flex items-center gap-1">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Picture Loaded
                                        </span>
                                        <span id="aiPosterFileSize" class="text-[10px] font-mono text-slate-400">1.8 MB</span>
                                    </div>
                                    <div id="aiPosterFileName" class="text-xs font-black text-slate-900 truncate mt-1">
                                        boynextdoor_tour_poster.jpg
                                    </div>
                                    <div class="text-[11px] text-purple-700 font-semibold mt-0.5 flex items-center gap-1">
                                        <i class="fas fa-sparkles text-[10px] text-amber-500"></i> Ready for 1-by-1 terminal OCR extraction
                                    </div>
                                </div>
                                <button type="button" onclick="event.stopPropagation(); clearAiSelectedPicture();" 
                                        class="px-3 py-1.5 rounded-xl bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-600 border border-slate-200 text-xs font-bold transition-colors cursor-pointer shrink-0">
                                    <i class="fas fa-xmark me-1"></i> Change picture
                                </button>
                            </div>
                        </div>

                        <!-- Action Controls Row -->
                        <div class="flex flex-col sm:flex-row items-stretch gap-2.5">
                            <div class="relative flex-1">
                                <i class="fas fa-image absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="url" id="aiPosterInput" 
                                       placeholder="Or paste official poster image URL (e.g. https://.../poster.jpg)"
                                       value="https://ime.co/wp-content/uploads/2026/07/01_BND_1080x1350.jpg"
                                       class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all">
                            </div>
                            <button type="button" id="btnRunAiExtract" onclick="launchAiScanTerminal()" 
                                    class="px-6 py-3 rounded-2xl bg-gradient-to-r from-purple-600 via-indigo-600 to-slate-900 hover:from-purple-500 hover:via-indigo-500 hover:to-slate-800 text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-sm transition-all press-tactile cursor-pointer shrink-0">
                                <span id="aiBtnSpinner" class="hidden"><i class="fas fa-spinner fa-spin"></i></span>
                                <span id="aiBtnText" class="flex items-center gap-2">
                                    <i class="fas fa-terminal text-[#c6f03d]"></i>
                                    <span>AI Scan (Gemini 4 Argon)</span>
                                </span>
                            </button>
                        </div>

                        <!-- Sample Posters Row -->
                        <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
                            <span class="text-slate-500 font-semibold text-[11px] flex items-center gap-1">
                                <i class="fas fa-images text-purple-500 text-[10px]"></i> Quick sample posters:
                            </span>
                            <button type="button" onclick="loadSampleAiPoster('boynextdoor')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-700 font-bold text-[11px] border border-purple-200/60 transition-colors cursor-pointer">
                                📸 BOYNEXTDOOR Tour
                            </button>
                            <button type="button" onclick="loadSampleAiPoster('babymonster')" class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-[11px] border border-rose-200/60 transition-colors cursor-pointer">
                                📸 BABYMONSTER Choom
                            </button>
                            <button type="button" onclick="loadSampleAiPoster('aespa')" class="px-2.5 py-1 rounded-lg bg-pink-50 hover:bg-pink-100 text-pink-700 font-bold text-[11px] border border-pink-200/60 transition-colors cursor-pointer">
                                📸 aespa SYNK
                            </button>
                            <button type="button" onclick="loadSampleAiPoster('cupsleeve')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[11px] border border-slate-200 transition-colors cursor-pointer">
                                📸 SEVENTEEN Cupsleeve
                            </button>
                        </div>
                    </div>

                    <p class="text-[11px] text-slate-400 mt-2">
                        Works with Weverse, artist X/Twitter, Instagram, promoter websites, ticketing gateways and press releases.
                    </p>
                </div>

                <!-- 1-Click Fast Presets (Comp 1) -->
                <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-2 text-xs">
                    <span class="text-slate-500 font-medium text-[11px]">No announcement handy? Try a live demo:</span>
                    <button type="button" onclick="fillSampleData('boynextdoor')" class="font-extrabold text-purple-700 hover:text-purple-900 hover:underline cursor-pointer">
                        Use the BOYNEXTDOOR sample
                    </button>
                    <span class="text-slate-300">&bull;</span>
                    <button type="button" onclick="fillSampleData('aespa')" class="font-bold text-pink-600 hover:text-pink-800 hover:underline cursor-pointer">
                        aespa Concert
                    </button>
                    <span class="text-slate-300">&bull;</span>
                    <button type="button" onclick="fillSampleData('ive')" class="font-bold text-slate-700 hover:text-slate-900 hover:underline cursor-pointer">
                        IVE Tour
                    </button>
                    <span class="text-slate-300">&bull;</span>
                    <button type="button" onclick="fillSampleData('cupsleeve')" class="font-bold text-slate-700 hover:text-slate-900 hover:underline cursor-pointer">
                        Cupsleeve Cafe
                    </button>
                    <span class="text-slate-300">&bull;</span>
                    <button type="button" onclick="clearFormFields()" class="font-bold text-slate-400 hover:text-rose-600 ml-auto flex items-center gap-1 cursor-pointer">
                        <i class="fas fa-rotate-left text-[10px]"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Feedback -->
        <div id="autofillToast" class="mt-4 hidden p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-medium flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-check text-xs"></i>
                </div>
                <div>
                    <strong id="toastTitle" class="font-extrabold text-emerald-800">Sample event data populated!</strong>
                    <div class="text-[11px] text-emerald-700">Form fields and visual poster slots filled below. Review or adjust, then preview or submit!</div>
                </div>
            </div>
            <button type="button" onclick="document.getElementById('autofillToast').classList.add('hidden')" class="text-emerald-500 hover:text-emerald-800 font-bold text-base">&times;</button>
        </div>
    </div>
    <% } %>

    <!-- Main Two-Column Submission Layout (Comp 2 & 3) -->
    <form id="eventSubmissionForm" action="<%= isEdit ? '/organizer/events/' + event.id + '/edit' : '/organizer/events/new' %>" method="POST" enctype="multipart/form-data">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- LEFT COLUMN (8 Cols): Structured Modular Form Cards -->
            <div class="lg:col-span-8 space-y-6">

                <!-- CARD 1: Artist & Event (Comp 2) -->
                <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-5">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xs">
                                <i class="fas fa-microphone-lines"></i>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900">Artist & event</h3>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                            &bull; Required
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 -mt-2">
                        The basics fans will search for. Write the title the way the organiser announced it.
                    </p>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Event title <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" name="event_name" id="inputEventName" required 
                               value="<%= isEdit ? event.event_name : '' %>"
                               placeholder="e.g. SEVENTEEN [RIGHT HERE] WORLD TOUR IN KUALA LUMPUR"
                               class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 font-bold placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all">
                        <span class="text-[11px] text-slate-400 mt-1 block">The primary title fans search for, and how duplicate events are spotted.</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Event category <span class="text-rose-500">*</span>
                            </label>
                            <select name="category_id" id="inputCategoryId" required 
                                    class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 font-semibold focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all cursor-pointer">
                                <option value="">Select category</option>
                                <% categories.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= (isEdit && event.category_id == c.id) ? 'selected' : '' %>>
                                        <%= c.name %>
                                    </option>
                                <% }); %>
                            </select>
                            <span class="text-[11px] text-slate-400 mt-1 block">Concert, fan meeting, cupsleeve, birthday cafe, and so on.</span>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                K-Pop artist / group
                            </label>
                            <select name="artist_id" id="inputArtistId" 
                                    class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all cursor-pointer">
                                <option value="">Select artist / group (optional)</option>
                                <% artists.forEach(a => { %>
                                    <option value="<%= a.id %>" data-slug="<%= a.slug %>" <%= (isEdit && event.artist_id == a.id) ? 'selected' : '' %>>
                                        <%= a.name %> (<%= a.group_type %>)
                                    </option>
                                <% }); %>
                            </select>
                            <span class="text-[11px] text-slate-400 mt-1 block">Leave empty for festivals or line-ups with several acts.</span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Event description <span class="text-rose-500">*</span>
                        </label>
                        <textarea name="description" id="inputDescription" rows="4" required 
                                  placeholder="Provide an overview of the event, what it offers, itinerary, admission guidelines, fan projects, etc."
                                  class="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all leading-relaxed"><%= isEdit ? event.description : '' %></textarea>
                        <span class="text-[11px] text-slate-400 mt-1 block">Full details help fans decide and help the admin team judge authenticity. Mention any accessibility notes here.</span>
                    </div>
                </div>

                <!-- CARD 2: Schedule & Timing -->
                <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-5">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-xl bg-pink-100 text-pink-700 flex items-center justify-center text-xs">
                                <i class="fas fa-calendar-days"></i>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900">Schedule & timing</h3>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                            &bull; Required
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 -mt-2">
                        Official show dates and doors opening in Malaysia local time (MYT / UTC+8).
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Event date <span class="text-rose-500">*</span>
                            </label>
                            <input type="date" name="event_date" id="inputEventDate" required 
                                   value="<%= isEdit ? (event.event_date instanceof Date ? event.event_date.toISOString().split('T')[0] : event.event_date) : '' %>"
                                   class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Start time <span class="text-rose-500">*</span>
                            </label>
                            <input type="time" name="start_time" id="inputStartTime" required 
                                   value="<%= isEdit ? event.start_time : '18:00' %>"
                                   class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                End time (optional)
                            </label>
                            <input type="time" name="end_time" id="inputEndTime" 
                                   value="<%= isEdit ? event.end_time : '' %>"
                                   class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-purple-400 focus:bg-white transition-all">
                        </div>
                    </div>
                </div>

                <!-- CARD 3: Venue & Location -->
                <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-5">
