<%- include('../partials/header', { title: 'Organizer Event Dashboard | K-Sync Malaysia' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Top Header Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-purple-950 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-500/20 text-pink-300 border border-pink-500/30 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fas fa-building-user"></i> Organizer Workspace
                </span>
                <% if (organizer.is_verified_organizer === 1) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
                        <i class="fas fa-circle-check"></i> Verified Entity
                    </span>
                <% } %>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                <%= organizer.organization_name || organizer.full_name %>
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl leading-relaxed">
                Manage your K-Pop event listings. Submitted events undergo autonomous Dual-AI verification before entering the public discovery catalog.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/organizer/events/new" class="px-6 py-3 rounded-2xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-extrabold text-xs sm:text-sm shadow-lg shadow-pink-500/25 transition-all flex items-center gap-2">
                <i class="fas fa-plus"></i> Create New Event
            </a>
        </div>
    </div>

    <!-- 4 Metrics Counter Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-calendar-days"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase tracking-wider">Total Created</div>
                <div class="text-2xl font-black text-slate-900 mt-0.5"><%= stats.total %></div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-circle-check"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase tracking-wider">Dual-AI Verified</div>
                <div class="text-2xl font-black text-emerald-600 mt-0.5"><%= stats.verified %></div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase tracking-wider">Needs Evidence</div>
                <div class="text-2xl font-black text-amber-600 mt-0.5"><%= stats.pending %></div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl shrink-0">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase tracking-wider">Discrepancy / Flagged</div>
                <div class="text-2xl font-black text-rose-600 mt-0.5"><%= stats.flagged %></div>
            </div>
        </div>
    </div>

    <!-- Events Management Table / List -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <h3 class="text-lg font-bold text-slate-900">Your Managed Events (<%= events.length %>)</h3>
                <p class="text-xs text-slate-500 mt-0.5">Click any listing to edit details, update schedule status, or inspect Dual-AI verification telemetry.</p>
            </div>
            <a href="/organizer/events/new" class="text-xs font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1">
                <i class="fas fa-plus"></i> Add Event
            </a>
        </div>

        <% if (events.length === 0) { %>
            <div class="text-center py-16 px-4">
                <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-3">
                    <i class="fas fa-calendar-plus"></i>
                </div>
                <h4 class="text-base font-bold text-slate-900">No events published yet</h4>
                <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                    You haven't submitted any K-Pop events yet. Create your first event and our autonomous Dual-AI engine will evaluate it instantly!
                </p>
                <a href="/organizer/events/new" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow transition-all">
                    <i class="fas fa-plus"></i> Create First Event
                </a>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-4 px-6">Event & Poster</th>
                            <th class="py-4 px-4">Date & Venue</th>
                            <th class="py-4 px-4">Schedule Status</th>
                            <th class="py-4 px-4">Dual-AI Verification</th>
                            <th class="py-4 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs">
                        <% events.forEach(event => { %>
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <!-- Title & Poster -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" class="w-12 h-16 object-cover rounded-lg border border-slate-200 shrink-0">
                                        <div class="min-w-0 max-w-xs">
                                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-100 text-purple-700">
                                                <%= event.category_name || 'Event' %>
                                            </span>
                                            <div class="font-extrabold text-slate-900 truncate mt-1">
                                                <%= event.event_name %>
                                            </div>
                                            <div class="text-[11px] text-slate-500 truncate">
                                                <i class="fas fa-microphone-lines text-pink-500 me-1"></i> <%= event.artist_name || 'Multiple Artists' %>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Date & Venue -->
                                <td class="py-4 px-4">
                                    <div class="font-bold text-slate-800"><%= helpers.formatDate(event.event_date) %></div>
                                    <div class="text-[11px] text-slate-500"><%= helpers.formatTime(event.start_time) %></div>
                                    <div class="text-[11px] text-slate-600 truncate mt-0.5 max-w-[180px]">
                                        <i class="fas fa-location-dot text-rose-500 me-1"></i> <%= event.venue_name %>, <%= event.city %>
                                    </div>
                                </td>

                                <!-- Schedule Status -->
                                <td class="py-4 px-4">
                                    <form action="/organizer/events/<%= event.id %>/status" method="POST" class="inline-block">
                                        <select name="event_status" onchange="this.form.submit()" 
                                                class="text-xs font-bold rounded-lg px-2.5 py-1 border border-slate-200 bg-white shadow-sm focus:outline-none focus:ring-1 focus:ring-purple-400 cursor-pointer">
                                            <option value="UPCOMING" <%= event.event_status === 'UPCOMING' ? 'selected' : '' %>>Upcoming</option>
                                            <option value="ONGOING" <%= event.event_status === 'ONGOING' ? 'selected' : '' %>>Ongoing</option>
                                            <option value="COMPLETED" <%= event.event_status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                                            <option value="POSTPONED" <%= event.event_status === 'POSTPONED' ? 'selected' : '' %>>Postponed</option>
                                            <option value="CANCELLED" <%= event.event_status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                    </form>
                                </td>

                                <!-- Dual-AI Verification Status & Telemetry -->
                                <td class="py-4 px-4">
                                    <div class="space-y-1">
                                        <%- helpers.getVerificationBadge(event.verification_status) %>
                                        
                                        <% if (event.admin_verification_notes) { %>
                                            <div class="text-[10px] text-slate-500 max-w-[200px] truncate" title="<%= event.admin_verification_notes %>">
                                                <%= event.admin_verification_notes %>
                                            </div>
                                        <% } %>

                                        <div>
                                            <a href="/organizer/events/<%= event.id %>/verification" class="text-[10px] font-bold text-pink-600 hover:underline flex items-center gap-1">
                                                <i class="fas fa-robot text-purple-500"></i> AI Breakdown &rarr;
                                            </a>
                                        </div>
                                    </div>
                                </td>

                                <!-- Action Buttons -->
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <% if (event.verification_status === 'VERIFIED') { %>
                                            <a href="<%= helpers.getEventUrl(event) %>" target="_blank" class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700" title="View Public Listing">
                                                <i class="fas fa-arrow-up-right-from-square"></i>
                                            </a>
                                        <% } %>
                                        <a href="/organizer/events/<%= event.id %>/edit" class="p-2 rounded-lg bg-pink-50 hover:bg-pink-100 text-pink-700" title="Edit Event">
                                            <i class="fas fa-pen-to-square"></i>
                                        </a>
                                        <button data-event-id="<%= event.id %>" data-event-title="<%= event.event_name %>" onclick="confirmDelete(this.dataset.eventId, this.dataset.eventTitle)" class="p-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 cursor-pointer" title="Delete Event">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-slate-200">
        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl mb-4">
            <i class="fas fa-trash-can"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">Delete Event Listing?</h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
            Are you sure you want to permanently delete <strong id="deleteEventTitle" class="text-slate-800"></strong>? This action cannot be undone.
        </p>

        <form id="deleteForm" method="POST" action="" class="mt-6 flex items-center justify-end gap-3">
            <button type="button" onclick="closeDeleteModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
                Cancel
            </button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow transition-all">
                Delete Permanently
            </button>
        </form>
    </div>
</div>

<script>
function confirmDelete(id, title) {
    document.getElementById('deleteEventTitle').textContent = title;
    document.getElementById('deleteForm').action = '/organizer/events/' + id + '/delete';
    const modal = document.getElementById('deleteModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeDeleteModal() {
    const modal = document.getElementById('deleteModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>

<%- include('../partials/footer') %>
