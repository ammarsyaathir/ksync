<%- include('partials/header', { title: 'Log In | K-Sync Malaysia' }) %>

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl space-y-6">
        <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-xl mx-auto mb-3 shadow">
                <i class="fas fa-bolt text-pink-400"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900">Welcome Back</h1>
            <p class="text-xs text-slate-500 mt-1 font-medium">Log in to your K-Sync Malaysia account</p>
        </div>

        <form id="login-form" action="/login" method="POST" class="space-y-4">
            <input type="hidden" name="redirect" value="<%= redirect || '' %>">

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Username or Email</label>
                <div class="relative">
                    <i class="fas fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" name="username" required placeholder="admin or fan@ksync.my"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Password</label>
                <div class="relative">
                    <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="password" name="password" required placeholder="••••••••"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300">
                </div>
            </div>

            <button type="submit" id="login-submit-btn" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-extrabold shadow transition-all cursor-pointer">
                Sign In &rarr;
            </button>
        </form>

        <!-- Divider -->
        <div class="relative flex items-center justify-center">
            <div class="border-t border-slate-200 w-full"></div>
            <div class="bg-white px-3 text-[11px] font-bold text-slate-400 uppercase tracking-wider relative">OR</div>
        </div>

        <!-- Google Authentication Button -->
        <button type="button" id="google-signin-btn" onclick="handleFirebaseGoogleSignIn('Fan')"
                class="w-full py-2.5 px-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-xs flex items-center justify-center cursor-pointer">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4 me-2.5 inline" alt="Google">
            <span>Continue with Google</span>
        </button>

        <!-- Quick FYP Demo Accounts Box -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                <span><i class="fas fa-key text-pink-500 me-1.5"></i> FYP Demo Credentials:</span>
                <span class="text-[9px] text-emerald-600 font-extrabold uppercase">1-Click Instant Sign In</span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
                <button type="button" onclick="fillCreds('admin', 'admin123')" class="p-2.5 bg-white rounded-xl border border-slate-200 text-left hover:border-purple-400 hover:bg-purple-50/60 transition-all cursor-pointer shadow-xs group">
                    <div class="font-bold text-purple-700 flex items-center justify-between">
                        <span>👑 Admin</span>
                        <span class="text-[9px] px-1.5 py-0.2 rounded bg-purple-100 text-purple-700 font-bold group-hover:bg-purple-200">1-Click</span>
                    </div>
                    <div class="text-slate-500 text-[10px] mt-0.5">admin / admin123</div>
                </button>
                <button type="button" onclick="fillCreds('aiman_carat', 'fan123')" class="p-2.5 bg-white rounded-xl border border-slate-200 text-left hover:border-pink-400 hover:bg-pink-50/60 transition-all cursor-pointer shadow-xs group">
                    <div class="font-bold text-pink-700 flex items-center justify-between">
                        <span>💖 Fan</span>
                        <span class="text-[9px] px-1.5 py-0.2 rounded bg-pink-100 text-pink-700 font-bold group-hover:bg-pink-200">1-Click</span>
                    </div>
                    <div class="text-slate-500 text-[10px] mt-0.5">aiman_carat / fan123</div>
                </button>
            </div>
        </div>

        <div class="text-center text-xs text-slate-500">
            Don't have an account yet? 
            <a href="/register" class="font-bold text-pink-600 hover:underline">Join K-Sync</a>
        </div>
    </div>
</div>

<script>
    function fillCreds(u, p) {
        const uInput = document.querySelector('input[name="username"]');
        const pInput = document.querySelector('input[name="password"]');
        const submitBtn = document.getElementById('login-submit-btn');
        if (uInput && pInput) {
            uInput.value = u;
            pInput.value = p;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Signing in as @' + u + '...';
            }
            document.getElementById('login-form').submit();
        }
    }
</script>

<%- include('partials/google-auth') %>
<%- include('partials/footer') %>
