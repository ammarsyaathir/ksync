<% 
    const activeMode = (typeof initialMode !== 'undefined' && initialMode === 'register') ? 'register' : 'login';
    const redirectUrl = (typeof redirect !== 'undefined' && redirect) ? redirect : '';
    const pageTitle = activeMode === 'register' ? 'Register Account | K-Sync Malaysia' : 'Sign In / Register | K-Sync Malaysia';
%>
<%- include('partials/header', { title: pageTitle }) %>

<!-- Full Page K-Sync Stage Backdrop -->
<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center p-3 sm:p-6 lg:p-8 relative overflow-hidden bg-gradient-to-b from-slate-100/70 via-pink-50/20 to-slate-50">
    <!-- Ambient Stage Lighting Glows -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-60">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Double Slider Master Container (K-Sync Interactive System Design) -->
    <div class="auth-slider-card <%= activeMode === 'register' ? 'right-panel-active' : '' %>" id="auth-slider-card">
        
        <!-- ======================================================== -->
        <!-- MOBILE SEGMENTED TOGGLE (Visible only < 768px)           -->
        <!-- ======================================================== -->
        <div class="md:hidden p-3 bg-white border-b border-slate-100">
            <div class="flex items-center p-1 bg-slate-100 rounded-2xl">
                <button type="button" id="mobile-btn-signin" onclick="setAuthMode('login')"
                        class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center flex items-center justify-center gap-1.5 <%= activeMode === 'login' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                    <i class="fas fa-arrow-right-to-bracket text-pink-500"></i>
                    <span>Sign In</span>
                </button>
                <button type="button" id="mobile-btn-signup" onclick="setAuthMode('register')"
                        class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center flex items-center justify-center gap-1.5 <%= activeMode === 'register' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                    <i class="fas fa-user-plus text-purple-600"></i>
                    <span>Register</span>
                </button>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- 1. SIGN IN FORM PANEL (Left on Desktop)                  -->
        <!-- ======================================================== -->
        <div class="form-panel sign-in-panel">
            <form id="login-form" action="/login" method="POST" class="auth-form-content">
                <input type="hidden" name="redirect" value="<%= redirectUrl %>">

                <!-- Header / Brand Icon -->
                <div class="text-center mb-1">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-pink-500 to-purple-600 text-white flex items-center justify-center text-lg mx-auto mb-1.5 shadow-md">
                        <i class="fas fa-arrow-right-to-bracket"></i>
                    </div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Sign In to K-Sync</h1>
                    <p class="text-xs text-slate-500 mt-0.5 font-medium">Access your concerts, fan watchlist & radar</p>
                </div>

                <!-- Input: Username or Email -->
                <div class="w-full space-y-1">
                    <label class="block text-xs font-bold text-slate-700">Email or Username</label>
                    <div class="relative">
                        <i class="fas fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" name="username" required placeholder="Enter username or email" id="login-username"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                    </div>
                </div>

                <!-- Input: Password -->
                <div class="w-full space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold text-slate-700">Password</label>
                        <a href="/forgot-password" class="text-[11px] font-bold text-pink-600 hover:text-pink-700 hover:underline">
                            Forgot password?
                        </a>
                    </div>
                    <div class="relative">
                        <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="login-password" name="password" required placeholder="••••••••"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-10 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                        <button type="button" onclick="togglePasswordVisibility('login-password', 'login-eye-icon')" 
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs p-1 focus:outline-none cursor-pointer" 
                                aria-label="Toggle password visibility">
                            <i id="login-eye-icon" class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember Me & Security Status -->
                <div class="w-full flex items-center justify-between text-xs pt-0.5">
                    <label class="flex items-center gap-2 cursor-pointer select-none text-slate-600">
                        <input type="checkbox" name="remember_me" class="rounded border-slate-300 text-pink-600 focus:ring-pink-500 w-3.5 h-3.5 cursor-pointer">
                        <span class="text-xs font-medium">Remember me</span>
                    </label>
                    <span class="text-[10px] text-slate-400 font-medium flex items-center gap-1">
                        <i class="fas fa-lock text-[9px] text-emerald-500"></i> Secure Session
                    </span>
                </div>

                <!-- Main Login Submit Button -->
                <button type="submit" id="login-submit-btn" 
                        class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-black shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2 press-tactile">
                    <span>Sign In</span>
                    <i class="fas fa-arrow-right text-xs"></i>
                </button>

                <!-- Divider -->
                <div class="w-full relative flex items-center justify-center my-0.5">
                    <div class="border-t border-slate-200 w-full"></div>
                    <div class="bg-white px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider relative">OR</div>
                </div>

                <!-- Alternate Sign In Actions: Google & Passwordless OTP -->
                <div class="w-full space-y-1.5">
                    <button type="button" id="google-signin-btn" onclick="handleFirebaseGoogleSignIn('Fan')"
                            class="w-full py-2 px-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer press-tactile">
                        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                        <span>Continue with Google</span>
                    </button>

                    <a href="/login-otp" 
                       class="w-full py-2 px-3 rounded-xl border border-purple-200 bg-purple-50/70 hover:bg-purple-100/80 text-purple-900 text-xs font-bold transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer press-tactile">
                        <i class="fas fa-shield-halved text-purple-600 text-xs"></i>
                        <span>Sign In with 6-Digit Email OTP</span>
                    </a>
                </div>

                <!-- Quick FYP Demo 1-Click Credentials Helper (Familiar Icons, Zero Emojis) -->
                <div class="w-full pt-1">
                    <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                        <div class="text-[9px] font-bold text-slate-500 uppercase tracking-wider flex items-center justify-between">
                            <span class="flex items-center gap-1"><i class="fas fa-key text-pink-500"></i> Demo Accounts:</span>
                            <span class="text-[8px] text-emerald-600 font-extrabold uppercase">1-Click</span>
                        </div>
                        <div class="grid grid-cols-3 gap-1 text-[11px]">
                            <button type="button" onclick="fillCreds('admin', 'admin123')" class="p-1.5 bg-white rounded-lg border border-slate-200 hover:border-purple-400 text-purple-700 font-bold flex items-center justify-center gap-1 transition-all">
                                <i class="fas fa-crown text-[9px] text-amber-500"></i> Admin
                            </button>
                            <button type="button" onclick="fillCreds('starline', 'organizer123')" class="p-1.5 bg-white rounded-lg border border-slate-200 hover:border-emerald-400 text-emerald-700 font-bold flex items-center justify-center gap-1 transition-all">
                                <i class="fas fa-building-user text-[9px] text-emerald-600"></i> Host
                            </button>
                            <button type="button" onclick="fillCreds('aiman_carat', 'fan123')" class="p-1.5 bg-white rounded-lg border border-slate-200 hover:border-pink-400 text-pink-700 font-bold flex items-center justify-center gap-1 transition-all">
                                <i class="fas fa-heart text-[9px] text-pink-500"></i> Fan
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile Switch to Register Prompt -->
                <div class="text-center text-xs text-slate-500 pt-1 md:hidden">
                    Don't have an account yet? 
                    <button type="button" onclick="setAuthMode('register')" class="font-extrabold text-pink-600 hover:underline cursor-pointer">
                        Join K-Sync
                    </button>
                </div>
            </form>
        </div>

        <!-- ======================================================== -->
        <!-- 2. SIGN UP FORM PANEL (Right on Desktop)                 -->
        <!-- ======================================================== -->
        <div class="form-panel sign-up-panel">
            <form id="register-form" action="/register" method="POST" class="auth-form-content">
                <!-- Header / Brand Icon -->
                <div class="text-center mb-1">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-pink-500 to-purple-600 text-white flex items-center justify-center text-base mx-auto mb-1.5 shadow-md">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h2 class="text-2xl font-black text-slate-900 tracking-tight">Create Account</h2>
                    <p class="text-[11px] text-slate-500 font-medium">Join Malaysia's unified K-Pop fandom hub</p>
                </div>

                <!-- Account Type Selector (Familiar FontAwesome Icons, Zero Emojis) -->
                <div class="w-full">
                    <label class="block text-[10px] font-bold text-slate-700 mb-1">I am joining as:</label>
                    <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-xl">
                        <label class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg cursor-pointer transition-all text-xs font-bold bg-white text-slate-900 shadow-2xs" id="label-role-fan">
                            <input type="radio" name="account_type" value="fan" checked onchange="toggleAccountType(this.value)" class="sr-only">
                            <i class="fas fa-heart text-pink-500"></i>
                            <span>K-Pop Fan</span>
                        </label>
                        <label class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg cursor-pointer transition-all text-xs font-bold text-slate-600" id="label-role-org">
                            <input type="radio" name="account_type" value="organizer" onchange="toggleAccountType(this.value)" class="sr-only">
                            <i class="fas fa-building-user text-purple-600"></i>
                            <span>Fanclub / Host</span>
                        </label>
                    </div>
                </div>

                <!-- 2-Column: Full Name & Username -->
                <div class="w-full grid grid-cols-2 gap-2">
                    <div class="space-y-0.5">
                        <label class="block text-[11px] font-bold text-slate-700">Full Name</label>
                        <div class="relative">
                            <i class="fas fa-id-card absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
                            <input type="text" name="full_name" required placeholder="Aiman Danial"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-2 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                        </div>
                    </div>
                    <div class="space-y-0.5">
                        <label class="block text-[11px] font-bold text-slate-700">Username</label>
                        <div class="relative">
                            <i class="fas fa-at absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
                            <input type="text" name="username" required placeholder="aiman_carat"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-2 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                        </div>
                    </div>
                </div>

                <!-- Email -->
                <div class="w-full space-y-0.5">
                    <label class="block text-[11px] font-bold text-slate-700">Email Address (For Verification OTP)</label>
                    <div class="relative">
                        <i class="fas fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
                        <input type="email" name="email" required placeholder="fan@ksync.my"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                    </div>
                </div>

                <!-- Password -->
                <div class="w-full space-y-0.5">
                    <label class="block text-[11px] font-bold text-slate-700">Password (Min. 6 Characters)</label>
                    <div class="relative">
                        <i class="fas fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
                        <input type="password" id="register-password" name="password" required placeholder="••••••••" minlength="6"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-9 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                        <button type="button" onclick="togglePasswordVisibility('register-password', 'register-eye-icon')" 
                                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs p-1 focus:outline-none cursor-pointer" 
                                aria-label="Toggle password visibility">
                            <i id="register-eye-icon" class="fas fa-eye text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Fan Favorite Fandom Field (Visible when Fan role active) -->
                <div id="fan-fandom-box" class="w-full space-y-0.5">
                    <label class="block text-[10px] font-bold text-slate-700">Favorite Fandom / Group (Optional)</label>
                    <div class="relative">
                        <i class="fas fa-heart absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
                        <input type="text" name="bio" placeholder="e.g. SEVENTEEN Carat / TXT MOA"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-all">
                    </div>
                </div>

                <!-- Organizer Dedicated Drawer (Comfortably Fits - ZERO INNER SCROLL) -->
                <div id="organizer-fields-box" class="hidden w-full p-2.5 rounded-xl bg-purple-50/80 border border-purple-200/90 space-y-2 text-left">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5 text-[11px] font-bold text-purple-900">
                            <i class="fas fa-shield-halved text-purple-600"></i>
                            <span>Fanclub / Host Credentials:</span>
                        </div>
                        <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-200/70 text-purple-900">Verified</span>
                    </div>
                    <div>
                        <input type="text" name="organization_name" placeholder="Fanclub Name (e.g. MY MOA Union)"
                               class="w-full bg-white border border-purple-200 rounded-lg px-2.5 py-1 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-purple-400">
                    </div>
                    <div class="grid grid-cols-2 gap-1.5">
                        <select name="organization_type" class="w-full bg-white border border-purple-200 rounded-lg px-2 py-1 text-[11px] text-slate-900 focus:outline-none">
                            <option value="Fanclub" selected>Fandom Fanclub</option>
                            <option value="Promoter">Promoter</option>
                            <option value="Independent">Independent</option>
                        </select>
                        <input type="text" name="social_handle" placeholder="Telegram @handle"
                               class="w-full bg-white border border-purple-200 rounded-lg px-2.5 py-1 text-xs text-slate-900 focus:outline-none">
                    </div>
                    <div>
                        <input type="url" name="social_url" placeholder="Channel Link (https://t.me/...)"
                               class="w-full bg-white border border-purple-200 rounded-lg px-2.5 py-1 text-xs text-slate-900 focus:outline-none">
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btn-submit-register" 
                        class="w-full py-2.5 bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:opacity-95 text-white rounded-xl text-xs font-black shadow-md transition-all cursor-pointer flex items-center justify-center gap-2 press-tactile">
                    <span>Continue & Send 6-Digit Email OTP</span>
                    <i class="fas fa-arrow-right text-xs"></i>
                </button>

                <!-- Divider & Google Sign Up -->
                <div class="w-full relative flex items-center justify-center my-0.5">
                    <div class="border-t border-slate-200 w-full"></div>
                    <div class="bg-white px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider relative">OR</div>
                </div>

                <button type="button" onclick="handleFirebaseGoogleSignIn('Fan')"
                        class="w-full py-2 px-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer press-tactile">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                    <span>Sign Up with Google</span>
                </button>

                <!-- Mobile Switch to Login Prompt -->
                <div class="text-center text-xs text-slate-500 pt-1 md:hidden">
                    Already have an account? 
                    <button type="button" onclick="setAuthMode('login')" class="font-extrabold text-pink-600 hover:underline cursor-pointer">
                        Sign In here
                    </button>
                </div>
            </form>
        </div>

        <!-- ======================================================== -->
        <!-- 3. SLIDING OVERLAY CONTAINER (Desktop Only >= 768px)      -->
        <!-- ======================================================== -->
        <div class="overlay-slider-container hidden md:block">
            <div class="overlay-track">
                <!-- Left Overlay Panel (Shown when in Register mode to switch to Login) -->
                <div class="overlay-subpanel overlay-subpanel-left">
                    <div class="overlay-card-content max-w-xs text-center space-y-4">
                        <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white text-2xl mx-auto shadow-inner">
                            <i class="fas fa-heart text-pink-400"></i>
                        </div>
                        <h2 class="text-3xl font-black text-white tracking-tight leading-tight">Welcome Back!</h2>
                        <p class="text-xs text-slate-300 leading-relaxed font-normal">
                            To stay connected with your favorite K-Pop concerts, fan meetups, and radar alerts, sign in with your account.
                        </p>
                        <div class="pt-2">
                            <button type="button" id="btn-overlay-signin" onclick="setAuthMode('login')" class="ksync-ghost-btn">
                                <i class="fas fa-arrow-right-to-bracket me-2 text-pink-400"></i>
                                <span>Sign In</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Overlay Panel (Shown when in Login mode to switch to Register) -->
                <div class="overlay-subpanel overlay-subpanel-right">
                    <div class="overlay-card-content max-w-xs text-center space-y-4">
                        <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white text-2xl mx-auto shadow-inner">
                            <i class="fas fa-compact-disc text-purple-400"></i>
                        </div>
                        <h2 class="text-3xl font-black text-white tracking-tight leading-tight">New to K-Sync?</h2>
                        <p class="text-xs text-slate-300 leading-relaxed font-normal">
                            Discover verified concerts, cafe cupsleeves, and fan gatherings across Malaysia. Join our vibrant fandom community today!
                        </p>
                        <div class="pt-2">
                            <button type="button" id="btn-overlay-signup" onclick="setAuthMode('register')" class="ksync-ghost-btn">
                                <i class="fas fa-user-plus me-2 text-pink-400"></i>
                                <span>Create Account</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ======================================================== -->
<!-- STYLES: RESPONSIVE DOUBLE SLIDER (ZERO INNER SCROLL)     -->
<!-- ======================================================== -->
<style>
    /* Master Double Slider Shell */
    .auth-slider-card {
        background-color: #ffffff;
        border-radius: 1.75rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.15);
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 960px;
        min-height: 700px;
        margin: auto;
        display: flex;
        flex-direction: column;
    }

    /* Form Panels - ZERO INNER SCROLLBAR */
    .form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        background-color: #ffffff;
        padding: 1.75rem 1.5rem;
        overflow: visible; /* NO INNER SCROLL */
    }

    .auth-form-content {
        width: 100%;
        max-width: 390px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
    }

    /* Desktop Double Sliding Overlay Track */
    @media (min-width: 768px) {
        .auth-slider-card {
            min-height: 710px;
        }

        .form-panel {
            position: absolute;
            top: 0;
            height: 100%;
            width: 50%;
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.65s ease;
            padding: 2rem 2.25rem;
            overflow: visible;
        }

        .sign-in-panel {
            left: 0;
            z-index: 2;
        }

        .sign-up-panel {
            left: 0;
            opacity: 0;
            z-index: 1;
            pointer-events: none;
        }

        /* Register Active State */
        .auth-slider-card.right-panel-active .sign-in-panel {
            transform: translateX(100%);
            opacity: 0;
            pointer-events: none;
            z-index: 1;
        }

        .auth-slider-card.right-panel-active .sign-up-panel {
            transform: translateX(100%);
            opacity: 1;
            z-index: 5;
            pointer-events: auto;
            animation: showPanel 0.65s;
        }

        @keyframes showPanel {
            0%, 49.99% {
                opacity: 0;
                z-index: 1;
            }
            50%, 100% {
                opacity: 1;
                z-index: 5;
            }
        }

        /* Overlay Sliding Mechanism */
        .overlay-slider-container {
            position: absolute;
            top: 0;
            left: 50%;
            width: 50%;
            height: 100%;
            overflow: hidden;
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 100;
        }

        .auth-slider-card.right-panel-active .overlay-slider-container {
            transform: translateX(-100%);
        }

        /* K-Sync Stage Obsidian Overlay Backdrop */
        .overlay-track {
            background: linear-gradient(135deg, #090d16 0%, #1e1035 45%, #2e0854 80%, #4a044e 100%);
            color: #ffffff;
            position: relative;
            left: -100%;
            height: 100%;
            width: 200%;
            transform: translateX(0);
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .auth-slider-card.right-panel-active .overlay-track {
            transform: translateX(50%);
        }

        .overlay-subpanel {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 0 2.5rem;
            text-align: center;
            top: 0;
            height: 100%;
            width: 50%;
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .overlay-subpanel-left {
            transform: translateX(-20%);
        }

        .auth-slider-card.right-panel-active .overlay-subpanel-left {
            transform: translateX(0);
        }

        .overlay-subpanel-right {
            right: 0;
            transform: translateX(0);
        }

        .auth-slider-card.right-panel-active .overlay-subpanel-right {
            transform: translateX(20%);
        }

        /* K-Sync Ghost Button */
        .ksync-ghost-btn {
            border: 2px solid rgba(255, 255, 255, 0.85);
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            font-size: 0.8125rem;
            font-weight: 800;
            padding: 0.75rem 2.25rem;
            border-radius: 0.75rem;
            cursor: pointer;
            transition: all 0.2s ease;
            outline: none;
            backdrop-filter: blur(8px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .ksync-ghost-btn:hover {
            background-color: #ffffff;
            color: #090d16;
            transform: translateY(-1px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .ksync-ghost-btn:active {
            transform: scale(0.98);
        }
    }

    /* Mobile Rules (< 768px) */
    @media (max-width: 767px) {
        .auth-slider-card {
            border-radius: 1.5rem;
            min-height: auto;
        }
        .form-panel {
            padding: 1.5rem 1rem;
        }
        .auth-slider-card:not(.right-panel-active) .sign-up-panel {
            display: none !important;
        }
        .auth-slider-card.right-panel-active .sign-in-panel {
            display: none !important;
        }
    }
</style>

<!-- ======================================================== -->
<!-- SCRIPTS: SLIDER CONTROLLER, ROLE TOGGLE, PASSWORD EYE    -->
<!-- ======================================================== -->
<script>
    // State Controller: 'login' vs 'register'
    function setAuthMode(mode) {
        const container = document.getElementById('auth-slider-card');
        const mobileBtnIn = document.getElementById('mobile-btn-signin');
        const mobileBtnUp = document.getElementById('mobile-btn-signup');

        if (!container) return;

        if (mode === 'register') {
            container.classList.add('right-panel-active');
            if (mobileBtnIn) {
                mobileBtnIn.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-900';
            }
            if (mobileBtnUp) {
                mobileBtnUp.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs';
            }
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/register');
            }
            document.title = 'Register Account | K-Sync Malaysia';
        } else {
            container.classList.remove('right-panel-active');
            if (mobileBtnIn) {
                mobileBtnIn.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs';
            }
            if (mobileBtnUp) {
                mobileBtnUp.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-900';
            }
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/login');
            }
            document.title = 'Sign In | K-Sync Malaysia';
        }
    }

    // Role Toggle on Registration (Fan vs Organizer)
    function toggleAccountType(type) {
        const orgFields = document.getElementById('organizer-fields-box');
        const fanBox = document.getElementById('fan-fandom-box');
        const labelFan = document.getElementById('label-role-fan');
        const labelOrg = document.getElementById('label-role-org');
        const submitBtn = document.getElementById('btn-submit-register');

        if (type === 'organizer') {
            if (orgFields) orgFields.classList.remove('hidden');
            if (fanBox) fanBox.classList.add('hidden');
            if (labelFan) labelFan.className = 'flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg cursor-pointer transition-all text-xs font-bold text-slate-600';
            if (labelOrg) labelOrg.className = 'flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg cursor-pointer transition-all text-xs font-bold bg-white text-purple-900 shadow-2xs';
            if (submitBtn) submitBtn.innerHTML = '<span>Verify via 6-Digit Email OTP</span><i class="fas fa-arrow-right text-xs"></i>';
        } else {
            if (orgFields) orgFields.classList.add('hidden');
            if (fanBox) fanBox.classList.remove('hidden');
            if (labelFan) labelFan.className = 'flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg cursor-pointer transition-all text-xs font-bold bg-white text-slate-900 shadow-2xs';
            if (labelOrg) labelOrg.className = 'flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg cursor-pointer transition-all text-xs font-bold text-slate-600';
            if (submitBtn) submitBtn.innerHTML = '<span>Continue & Send 6-Digit Email OTP</span><i class="fas fa-arrow-right text-xs"></i>';
        }
    }

    // Password Visibility Toggle
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // 1-Click Demo Credentials
    function fillCreds(u, p) {
        const uInput = document.getElementById('login-username');
        const pInput = document.getElementById('login-password');
        const submitBtn = document.getElementById('login-submit-btn');
        if (uInput && pInput) {
            uInput.value = u;
            pInput.value = p;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Signing in...';
            }
            document.getElementById('login-form').submit();
        }
    }
</script>

