<% 
    const activeMode = (typeof initialMode !== 'undefined' && initialMode === 'register') ? 'register' : 'login';
    const redirectUrl = (typeof redirect !== 'undefined' && redirect) ? redirect : '';
    const pageTitle = activeMode === 'register' ? 'Register Account | K-Sync Malaysia' : 'Sign In / Register | K-Sync Malaysia';
%>
<%- include('partials/header', { title: pageTitle }) %>

<!-- Full Page Scenic Backdrop -->
<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
    <!-- Ambient Backdrop Lighting & Scenic Horizon -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-40">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:24px_24px] opacity-25"></div>
    </div>

    <!-- Double Slider Master Container -->
    <div class="auth-slider-card <%= activeMode === 'register' ? 'right-panel-active' : '' %>" id="auth-slider-card">
        
        <!-- ======================================================== -->
        <!-- MOBILE SEGMENTED SLIDER CONTROLLER (Visible only < 768px) -->
        <!-- ======================================================== -->
        <div class="md:hidden p-4 pb-0 bg-white border-b border-slate-100">
            <div class="flex items-center p-1 bg-slate-100 rounded-2xl relative">
                <button type="button" id="mobile-btn-signin" onclick="setAuthMode('login')"
                        class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center <%= activeMode === 'login' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                    <i class="fas fa-right-to-bracket me-1 text-teal-500"></i> Sign In
                </button>
                <button type="button" id="mobile-btn-signup" onclick="setAuthMode('register')"
                        class="flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center <%= activeMode === 'register' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                    <i class="fas fa-user-plus me-1 text-teal-500"></i> Register
                </button>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- 1. SIGN IN FORM PANEL (Left on Desktop) -->
        <!-- ======================================================== -->
        <div class="form-panel sign-in-panel">
            <form id="login-form" action="/login" method="POST" class="auth-form-content">
                <input type="hidden" name="redirect" value="<%= redirectUrl %>">

                <div class="text-center mb-6">
                    <div class="w-10 h-10 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg mx-auto mb-2 shadow-xs md:hidden">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">SIGN IN</h2>
                    <p class="text-xs text-slate-400 mt-1 font-medium">Access your K-Sync concerts & passport</p>
                </div>

                <!-- Input: Username or Email -->
                <div class="w-full space-y-1">
                    <div class="relative">
                        <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" name="username" required placeholder="Email or Username"
                               class="auth-input pl-11 pr-4" id="login-username">
                    </div>
                </div>

                <!-- Input: Password -->
                <div class="w-full space-y-1">
                    <div class="relative">
                        <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="login-password" name="password" required placeholder="Password"
                               class="auth-input pl-11 pr-11">
                        <button type="button" onclick="togglePasswordVisibility('login-password', 'login-eye-icon')" 
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs p-1 focus:outline-none cursor-pointer">
                            <i id="login-eye-icon" class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="w-full flex items-center justify-between text-xs pt-1">
                    <label class="flex items-center gap-2 cursor-pointer select-none text-slate-600">
                        <input type="checkbox" name="remember_me" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500 w-4 h-4 cursor-pointer">
                        <span class="text-[11px] sm:text-xs">Remember me</span>
                    </label>
                    <a href="/forgot-password" class="text-[11px] sm:text-xs text-slate-500 hover:text-teal-600 transition-colors font-medium">
                        Forgot password?
                    </a>
                </div>

                <!-- Main Login Action Button -->
                <button type="submit" id="login-submit-btn" class="auth-btn-primary">
                    Login
                </button>

                <!-- Alternate Social / Account Divider -->
                <div class="w-full flex items-center gap-3 my-1">
                    <div class="h-px bg-slate-200 flex-1"></div>
                    <span class="text-[11px] text-slate-400 font-medium">or use your account</span>
                    <div class="h-px bg-slate-200 flex-1"></div>
                </div>

                <!-- Social Round Buttons Row (Matching Image) -->
                <div class="flex items-center justify-center gap-3">
                    <!-- Google Button -->
                    <button type="button" onclick="handleFirebaseGoogleSignIn('Fan')" title="Sign in with Google"
                            class="social-circle-btn hover:border-teal-400 group cursor-pointer">
                        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                    </button>
                    <!-- Email OTP Passwordless Button -->
                    <a href="/login-otp" title="Passwordless Email OTP Sign In"
                       class="social-circle-btn hover:border-purple-400 text-purple-600 cursor-pointer">
                        <i class="fas fa-shield-alt text-sm"></i>
                    </a>
                    <!-- Demo Accounts Toggle -->
                    <button type="button" onclick="toggleDemoDropdown()" title="1-Click Demo Accounts"
                            class="social-circle-btn hover:border-pink-400 text-pink-600 cursor-pointer">
                        <i class="fas fa-key text-xs"></i>
                    </button>
                </div>

                <!-- 1-Click FYP Demo Credentials Drawer -->
                <div id="demo-creds-drawer" class="w-full p-3 rounded-2xl bg-slate-50 border border-slate-200 text-left space-y-2 mt-1">
                    <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                        <span><i class="fas fa-bolt text-pink-500 me-1"></i> FYP Demo Credentials:</span>
                        <span class="text-teal-600 font-extrabold">1-Click</span>
                    </div>
                    <div class="grid grid-cols-2 gap-1.5 text-[10px]">
                        <button type="button" onclick="fillCreds('admin', 'admin123')" class="p-2 bg-white rounded-xl border border-slate-200 hover:border-teal-400 transition-all text-left shadow-2xs cursor-pointer">
                            <span class="font-bold text-slate-900 block">👑 Admin</span>
                            <span class="text-slate-400 text-[9px]">admin123</span>
                        </button>
                        <button type="button" onclick="fillCreds('starline', 'organizer123')" class="p-2 bg-white rounded-xl border border-slate-200 hover:border-teal-400 transition-all text-left shadow-2xs cursor-pointer">
                            <span class="font-bold text-slate-900 block">🏢 Organizer</span>
                            <span class="text-slate-400 text-[9px]">organizer123</span>
                        </button>
                        <button type="button" onclick="fillCreds('aiman_carat', 'fan123')" class="p-2 bg-white rounded-xl border border-slate-200 hover:border-teal-400 transition-all text-left shadow-2xs cursor-pointer">
                            <span class="font-bold text-slate-900 block">💖 Fan</span>
                            <span class="text-slate-400 text-[9px]">fan123</span>
                        </button>
                        <button type="button" onclick="fillCreds('ammarsyaathir', 'admin123')" class="p-2 bg-white rounded-xl border border-slate-200 hover:border-teal-400 transition-all text-left shadow-2xs cursor-pointer">
                            <span class="font-bold text-slate-900 block">👑 Ammar</span>
                            <span class="text-slate-400 text-[9px]">admin123</span>
                        </button>
                    </div>
                </div>

                <!-- Mobile Switch to Register Prompt -->
                <div class="text-center text-xs text-slate-500 pt-2 md:hidden">
                    Don't have an account yet? 
                    <button type="button" onclick="setAuthMode('register')" class="font-extrabold text-teal-600 hover:underline cursor-pointer">
                        Register here
                    </button>
                </div>
            </form>
        </div>

        <!-- ======================================================== -->
        <!-- 2. SIGN UP FORM PANEL (Right on Desktop) -->
        <!-- ======================================================== -->
        <div class="form-panel sign-up-panel">
            <form id="register-form" action="/register" method="POST" class="auth-form-content">
                <div class="text-center mb-4">
                    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">CREATE ACCOUNT</h2>
                    <p class="text-xs text-slate-400 mt-0.5 font-medium">Join K-Sync Malaysia's fan community</p>
                </div>

                <!-- Account Type Selector (Fan vs Organizer) -->
                <div class="w-full">
                    <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-2xl">
                        <label class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl cursor-pointer transition-all text-xs font-bold" id="label-role-fan">
                            <input type="radio" name="account_type" value="fan" checked onchange="toggleAccountType(this.value)" class="sr-only">
                            <span>💖 Fan</span>
                        </label>
                        <label class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl cursor-pointer transition-all text-xs font-bold text-slate-600" id="label-role-org">
                            <input type="radio" name="account_type" value="organizer" onchange="toggleAccountType(this.value)" class="sr-only">
                            <span>🏢 Fanclub/Host</span>
                        </label>
                    </div>
                </div>

                <!-- Full Name -->
                <div class="w-full">
                    <div class="relative">
                        <i class="fas fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" name="full_name" required placeholder="Full Name (e.g. Aiman Danial)"
                               class="auth-input pl-11 pr-4">
                    </div>
                </div>

                <!-- Username -->
                <div class="w-full">
                    <div class="relative">
                        <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" name="username" required placeholder="Username (e.g. aiman_carat)"
                               class="auth-input pl-11 pr-4">
                    </div>
                </div>

                <!-- Email -->
                <div class="w-full">
                    <div class="relative">
                        <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="email" name="email" required placeholder="Email Address"
                               class="auth-input pl-11 pr-4">
                    </div>
                </div>

                <!-- Password -->
                <div class="w-full">
                    <div class="relative">
                        <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="register-password" name="password" required placeholder="Password (Min. 6 chars)" minlength="6"
                               class="auth-input pl-11 pr-11">
                        <button type="button" onclick="togglePasswordVisibility('register-password', 'register-eye-icon')" 
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs p-1 focus:outline-none cursor-pointer">
                            <i id="register-eye-icon" class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Fan Fandom Optional Input -->
                <div id="fan-fandom-box" class="w-full">
                    <div class="relative">
                        <i class="fas fa-heart absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" name="bio" placeholder="Favorite Fandom / Group (e.g. MOA, CARAT)"
                               class="auth-input pl-11 pr-4">
                    </div>
                </div>

                <!-- Dedicated Organizer Extra Fields (Smooth Drawer) -->
                <div id="organizer-fields-box" class="hidden w-full p-3 rounded-2xl bg-teal-50/70 border border-teal-200/80 space-y-2 text-left">
                    <div class="flex items-center gap-1.5 text-xs font-bold text-teal-900">
                        <i class="fas fa-building text-teal-600 text-[11px]"></i>
                        <span>Fanclub / Organization Details:</span>
                    </div>
                    <input type="text" name="organization_name" placeholder="Fanclub Name (e.g. MY MOA Union)"
                           class="w-full bg-white border border-teal-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-teal-400">
                    <div class="grid grid-cols-2 gap-2">
                        <select name="organization_type" class="w-full bg-white border border-teal-200 rounded-xl px-2 py-2 text-[11px] text-slate-800 focus:outline-none">
                            <option value="Fanclub" selected>Fandom Fanclub</option>
                            <option value="Promoter">Concert Promoter</option>
                            <option value="Independent">Independent Host</option>
                        </select>
                        <input type="text" name="social_handle" placeholder="@telegram_handle"
                               class="w-full bg-white border border-teal-200 rounded-xl px-3 py-2 text-xs text-slate-800 focus:outline-none">
                    </div>
                    <input type="url" name="social_url" placeholder="Official Channel / Telegram Link (e.g. https://t.me/...)"
                           class="w-full bg-white border border-teal-200 rounded-xl px-3 py-1.5 text-xs text-slate-800 focus:outline-none">
                </div>

                <!-- Main Register Button -->
                <button type="submit" id="btn-submit-register" class="auth-btn-primary">
                    Register
                </button>

                <!-- Divider & Google Sign Up -->
                <div class="w-full flex items-center gap-3 my-1">
                    <div class="h-px bg-slate-200 flex-1"></div>
                    <span class="text-[11px] text-slate-400 font-medium">or register with</span>
                    <div class="h-px bg-slate-200 flex-1"></div>
                </div>

                <div class="flex items-center justify-center gap-3">
                    <button type="button" onclick="handleFirebaseGoogleSignIn('Fan')" title="Sign up with Google"
                            class="social-circle-btn hover:border-teal-400 group cursor-pointer">
                        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                    </button>
                </div>

                <!-- Mobile Switch to Login Prompt -->
                <div class="text-center text-xs text-slate-500 pt-2 md:hidden">
                    Already have an account? 
                    <button type="button" onclick="setAuthMode('login')" class="font-extrabold text-teal-600 hover:underline cursor-pointer">
                        Sign In here
                    </button>
                </div>
            </form>
        </div>

        <!-- ======================================================== -->
        <!-- 3. SLIDING OVERLAY CONTAINER (Desktop Only >= 768px) -->
        <!-- ======================================================== -->
        <div class="overlay-slider-container hidden md:block">
            <div class="overlay-track">
                <!-- Left Overlay Panel (Revealed when in Register mode to switch to Login) -->
                <div class="overlay-subpanel overlay-subpanel-left">
                    <div class="overlay-card-content">
                        <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-white text-xl mx-auto mb-4 border border-white/20">
                            <i class="fas fa-heart"></i>
                        </div>
                        <h2 class="text-3xl font-black text-white tracking-tight mb-3">Welcome Back!</h2>
                        <p class="text-xs sm:text-sm text-teal-100/90 leading-relaxed max-w-xs mx-auto mb-8 font-medium">
                            To stay connected with your favorite K-Pop concerts and friends, please login with your personal account.
                        </p>
                        <button type="button" id="btn-overlay-signin" onclick="setAuthMode('login')" class="overlay-ghost-btn">
                            Sign In
                        </button>
                    </div>
                </div>

                <!-- Right Overlay Panel (Revealed when in Login mode to switch to Register) -->
                <div class="overlay-subpanel overlay-subpanel-right">
                    <div class="overlay-card-content">
                        <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-white text-xl mx-auto mb-4 border border-white/20">
                            <i class="fas fa-compass"></i>
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-3 leading-tight">
                            Start your<br>journey now
                        </h2>
                        <p class="text-xs sm:text-sm text-teal-100/90 leading-relaxed max-w-xs mx-auto mb-8 font-medium">
                            If you don't have an account yet, join us and start your journey with Malaysia's K-Pop fan community.
                        </p>
                        <button type="button" id="btn-overlay-signup" onclick="setAuthMode('register')" class="overlay-ghost-btn">
                            Register
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ======================================================== -->
<!-- STYLES: DOUBLE SLIDER ANIMATION & RESPONSIVENESS -->
<!-- ======================================================== -->
<style>
    /* Base Card Container */
    .auth-slider-card {
        background-color: #ffffff;
        border-radius: 2rem;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.45);
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 920px;
        min-height: 640px;
        margin: auto;
        display: flex;
        flex-direction: column;
    }

    /* Common Form Panel */
    .form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        background-color: #ffffff;
        padding: 2rem;
        overflow-y: auto;
    }

    .auth-form-content {
        width: 100%;
        max-width: 360px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.875rem;
    }

    /* Modern Rounded Inputs (Matching User Comp) */
    .auth-input {
        width: 100%;
        background-color: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 9999px;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
        font-size: 0.8125rem;
        color: #0f172a;
        transition: all 0.2s ease;
    }
    .auth-input:focus {
        background-color: #ffffff;
        border-color: #14b8a6;
        outline: none;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.2);
    }

    /* Pill Primary Action Button (Matching User Comp) */
    .auth-btn-primary {
        background-color: #0d9488;
        background-image: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
        color: #ffffff;
        font-size: 0.875rem;
        font-weight: 800;
        padding: 0.75rem 2.5rem;
        border-radius: 9999px;
        box-shadow: 0 10px 20px -5px rgba(13, 148, 136, 0.4);
        cursor: pointer;
        transition: transform 0.16s ease, box-shadow 0.16s ease, opacity 0.16s ease;
        border: none;
        width: auto;
        min-width: 160px;
        text-align: center;
    }
    .auth-btn-primary:hover {
        opacity: 0.95;
        box-shadow: 0 14px 24px -5px rgba(13, 148, 136, 0.5);
    }
    .auth-btn-primary:active {
        transform: scale(0.97);
    }

    /* Round Social Circle Buttons */
    .social-circle-btn {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        transition: all 0.2s ease;
    }
    .social-circle-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
    }

    /* Desktop Double Slider Transformation Rules */
    @media (min-width: 768px) {
        .auth-slider-card {
            min-height: 640px;
        }

        .form-panel {
            position: absolute;
            top: 0;
            height: 100%;
            width: 50%;
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.65s ease;
            padding: 3rem 2.5rem;
        }

        .sign-in-panel {
            left: 0;
            z-index: 2;
        }

        .sign-up-panel {
            left: 0;
            opacity: 0;
            z-index: 1;
            pointer-events: none;
        }

        /* When Right Panel is Active (Register Mode) */
        .auth-slider-card.right-panel-active .sign-in-panel {
            transform: translateX(100%);
            opacity: 0;
            pointer-events: none;
            z-index: 1;
        }

        .auth-slider-card.right-panel-active .sign-up-panel {
            transform: translateX(100%);
            opacity: 1;
            z-index: 5;
            pointer-events: auto;
            animation: showPanel 0.65s;
        }

        @keyframes showPanel {
            0%, 49.99% {
                opacity: 0;
                z-index: 1;
            }
            50%, 100% {
                opacity: 1;
                z-index: 5;
            }
        }

        /* Overlay Sliding Mechanism */
        .overlay-slider-container {
            position: absolute;
            top: 0;
            left: 50%;
            width: 50%;
            height: 100%;
            overflow: hidden;
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 100;
        }

        .auth-slider-card.right-panel-active .overlay-slider-container {
            transform: translateX(-100%);
        }

        .overlay-track {
            background: linear-gradient(135deg, rgba(15, 118, 110, 0.92), rgba(13, 148, 136, 0.88)), 
                        url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
            color: #ffffff;
            position: relative;
            left: -100%;
            height: 100%;
            width: 200%;
            transform: translateX(0);
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .auth-slider-card.right-panel-active .overlay-track {
            transform: translateX(50%);
        }

        .overlay-subpanel {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 0 2.5rem;
            text-align: center;
            top: 0;
            height: 100%;
            width: 50%;
            transition: transform 0.65s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .overlay-subpanel-left {
            transform: translateX(-20%);
        }

        .auth-slider-card.right-panel-active .overlay-subpanel-left {
            transform: translateX(0);
        }

        .overlay-subpanel-right {
            right: 0;
            transform: translateX(0);
        }

        .auth-slider-card.right-panel-active .overlay-subpanel-right {
            transform: translateX(20%);
        }

        .overlay-ghost-btn {
            border: 2px solid #ffffff;
            background: transparent;
            color: #ffffff;
            font-size: 0.875rem;
            font-weight: 800;
            padding: 0.7rem 2.75rem;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.2s ease;
            outline: none;
            backdrop-filter: blur(4px);
        }
        .overlay-ghost-btn:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: scale(1.03);
        }
        .overlay-ghost-btn:active {
            transform: scale(0.97);
        }
    }

    /* Mobile Fallback Rules (< 768px) */
    @media (max-width: 767px) {
        .auth-slider-card {
            border-radius: 1.5rem;
        }
        .form-panel {
            padding: 1.5rem;
        }
        /* Mobile: conditionally hide panel based on state */
        .auth-slider-card:not(.right-panel-active) .sign-up-panel {
            display: none !important;
        }
        .auth-slider-card.right-panel-active .sign-in-panel {
            display: none !important;
        }
    }
</style>

<!-- ======================================================== -->
<!-- INTERACTION SCRIPTS: SLIDER, OTP, DEMO ACCS & PASSWORDS -->
<!-- ======================================================== -->
<script>
    // State Controller: 'login' vs 'register'
    function setAuthMode(mode) {
        const container = document.getElementById('auth-slider-card');
        const mobileBtnIn = document.getElementById('mobile-btn-signin');
        const mobileBtnUp = document.getElementById('mobile-btn-signup');

        if (!container) return;

        if (mode === 'register') {
            container.classList.add('right-panel-active');
            if (mobileBtnIn) {
                mobileBtnIn.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center text-slate-500 hover:text-slate-900';
            }
            if (mobileBtnUp) {
                mobileBtnUp.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center bg-white text-slate-900 shadow-xs';
            }
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/register');
            }
        } else {
            container.classList.remove('right-panel-active');
            if (mobileBtnIn) {
                mobileBtnIn.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center bg-white text-slate-900 shadow-xs';
            }
            if (mobileBtnUp) {
                mobileBtnUp.className = 'flex-1 py-2.5 rounded-xl text-xs font-black transition-all text-center text-slate-500 hover:text-slate-900';
            }
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/login');
            }
        }
    }

    // Role Toggle on Registration
    function toggleAccountType(type) {
        const orgFields = document.getElementById('organizer-fields-box');
        const fanBox = document.getElementById('fan-fandom-box');
        const labelFan = document.getElementById('label-role-fan');
        const labelOrg = document.getElementById('label-role-org');
        const submitBtn = document.getElementById('btn-submit-register');

        if (type === 'organizer') {
            if (orgFields) orgFields.classList.remove('hidden');
            if (fanBox) fanBox.classList.add('hidden');
            if (labelFan) labelFan.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl cursor-pointer transition-all text-xs font-bold text-slate-600';
            if (labelOrg) labelOrg.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl cursor-pointer transition-all text-xs font-bold bg-white text-teal-800 shadow-2xs';
            if (submitBtn) submitBtn.innerHTML = 'Verify via 6-Digit Email OTP';
        } else {
            if (orgFields) orgFields.classList.add('hidden');
            if (fanBox) fanBox.classList.remove('hidden');
            if (labelFan) labelFan.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl cursor-pointer transition-all text-xs font-bold bg-white text-slate-900 shadow-2xs';
            if (labelOrg) labelOrg.className = 'flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl cursor-pointer transition-all text-xs font-bold text-slate-600';
            if (submitBtn) submitBtn.innerHTML = 'Register';
        }
    }

    // Show/Hide Password
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // 1-Click Instant Demo Credentials
    function fillCreds(u, p) {
        const uInput = document.getElementById('login-username');
        const pInput = document.getElementById('login-password');
        const submitBtn = document.getElementById('login-submit-btn');
        if (uInput && pInput) {
            uInput.value = u;
            pInput.value = p;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Signing in...';
            }
            document.getElementById('login-form').submit();
        }
    }

    // Toggle Demo Drawer
    function toggleDemoDropdown() {
        const drawer = document.getElementById('demo-creds-drawer');
        if (drawer) {
            drawer.classList.toggle('hidden');
        }
    }
</script>

