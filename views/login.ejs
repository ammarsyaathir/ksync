<% 
    const activeMode = (typeof initialMode !== 'undefined' && initialMode === 'register') ? 'register' : 'login';
    const redirectUrl = (typeof redirect !== 'undefined' && redirect) ? redirect : '';
    const pageTitle = activeMode === 'register' ? 'Register Account | K-Sync Malaysia' : 'Sign In | K-Sync Malaysia';
%>
<%- include('partials/header', { title: pageTitle }) %>

<!-- Full Page K-Sync Auth Container -->
<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center p-3 sm:p-6 lg:p-8 relative bg-gradient-to-b from-slate-100 via-pink-50/20 to-slate-50">
    <!-- Ambient Stage Lighting Glows -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-60">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Main Auth Master Card (Fluid, Zero Nested Scrollbars) -->
    <div class="w-full max-w-4xl bg-white rounded-3xl border border-slate-200/90 shadow-2xl relative z-10 overflow-hidden flex flex-col md:flex-row my-auto">
        
        <!-- ======================================================== -->
        <!-- LEFT: STAGE HERO BRANDING PANEL (Desktop & Tablet)       -->
        <!-- ======================================================== -->
        <div class="hidden md:flex md:w-5/12 bg-gradient-to-br from-slate-950 via-purple-950 to-indigo-950 text-white p-8 flex-col justify-between relative overflow-hidden">
            <!-- Ambient Stage Accents -->
            <div class="absolute -top-24 -left-24 w-64 h-64 bg-pink-500/20 rounded-full blur-2xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-purple-500/20 rounded-full blur-2xl pointer-events-none"></div>

            <!-- Top Brand Badge -->
            <div class="relative z-10">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-pink-300 text-xs font-bold mb-6">
                    <i class="fas fa-compact-disc text-pink-400"></i>
                    <span>K-Sync Malaysia</span>
                </div>
                
                <h1 class="text-2xl lg:text-3xl font-black text-white tracking-tight leading-snug">
                    Your Unified Gateway to K-Pop in Malaysia
                </h1>
                <p class="text-xs text-slate-300 mt-3 leading-relaxed">
                    Official concert schedules, verified community gatherings, and real-time fan radar all in one synchronized hub.
                </p>
            </div>

            <!-- Core Feature Pillars (Clean Familiar Icons, Zero Emojis) -->
            <div class="space-y-4 my-8 relative z-10">
                <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
                    <div class="w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fas fa-ticket text-xs"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-white">Verified Schedules & Venues</div>
                        <div class="text-[11px] text-slate-300 mt-0.5">Authentic concerts at Zepp KL, Bukit Jalil, Axiata & Mega Star Arena.</div>
                    </div>
                </div>

                <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
                    <div class="w-8 h-8 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fas fa-radar text-xs"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-white">360° Fan Radar & Cupsleeves</div>
                        <div class="text-[11px] text-slate-300 mt-0.5">Discover fan projects, birthday events, and same-weekend fandom clusters.</div>
                    </div>
                </div>

                <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
                    <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fas fa-shield-halved text-xs"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-white">Anti-Scalper & Scam Protection</div>
                        <div class="text-[11px] text-slate-300 mt-0.5">Community-verified ticketing links and automated promoter authenticity checks.</div>
                    </div>
                </div>
            </div>

            <!-- Bottom Community Stamp -->
            <div class="pt-4 border-t border-white/10 relative z-10 flex items-center justify-between text-[11px] text-slate-400">
                <span class="flex items-center gap-1.5 font-medium">
                    <i class="fas fa-users text-pink-400"></i>
                    <span>Malaysian Fandom Community</span>
                </span>
                <span class="flex items-center gap-1 text-emerald-400 font-semibold">
                    <i class="fas fa-circle-check text-[10px]"></i> Active
                </span>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- RIGHT: INTERACTIVE FORM CONTAINER (Fluid, No Inner Scroll)-->
        <!-- ======================================================== -->
        <div class="w-full md:w-7/12 p-5 sm:p-8 lg:p-10 flex flex-col justify-center bg-white">
            
            <!-- Segmented Mode Switcher (Sign In vs Create Account) -->
            <div class="flex items-center p-1 bg-slate-100 rounded-2xl border border-slate-200/80 mb-6">
                <button type="button" id="tab-btn-login" onclick="setAuthMode('login')"
                        class="flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold transition-all text-center flex items-center justify-center gap-2 cursor-pointer <%= activeMode === 'login' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-900' %>">
                    <i class="fas fa-arrow-right-to-bracket text-pink-500"></i>
                    <span>Sign In</span>
                </button>
                <button type="button" id="tab-btn-register" onclick="setAuthMode('register')"
                        class="flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold transition-all text-center flex items-center justify-center gap-2 cursor-pointer <%= activeMode === 'register' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-900' %>">
                    <i class="fas fa-user-plus text-purple-600"></i>
                    <span>Create Account</span>
                </button>
            </div>

            <!-- ======================================================== -->
            <!-- 1. SIGN IN FORM PANEL                                    -->
            <!-- ======================================================== -->
            <div id="panel-login" class="<%= activeMode === 'login' ? '' : 'hidden' %>">
                <div class="mb-5">
                    <h2 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                        <span>Sign In</span>
                        <i class="fas fa-sparkles text-pink-500 text-lg"></i>
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Access your concerts, watchlist & fan radar</p>
                </div>

                <form id="login-form" action="/login" method="POST" class="space-y-4">
                    <input type="hidden" name="redirect" value="<%= redirectUrl %>">

                    <!-- Username / Email -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-700">Email or Username</label>
                        <div class="relative">
                            <i class="fas fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" name="username" required placeholder="Enter username or email" id="login-username"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-xs sm:text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-1">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-bold text-slate-700">Password</label>
                            <a href="/forgot-password" class="text-[11px] font-bold text-pink-600 hover:text-pink-700 hover:underline">
                                Forgot password?
                            </a>
                        </div>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="password" id="login-password" name="password" required placeholder="••••••••"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-10 py-2.5 text-xs sm:text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                            <button type="button" onclick="togglePasswordVisibility('login-password', 'login-eye-icon')" 
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer" 
                                    aria-label="Toggle password visibility">
                                <i id="login-eye-icon" class="fas fa-eye text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me & Security -->
                    <div class="flex items-center justify-between text-xs pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none text-slate-600">
                            <input type="checkbox" name="remember_me" class="rounded border-slate-300 text-pink-600 focus:ring-pink-500 w-4 h-4 cursor-pointer">
                            <span class="text-xs font-medium">Remember me</span>
                        </label>
                        <span class="text-[11px] text-slate-400 font-medium flex items-center gap-1">
                            <i class="fas fa-lock text-[10px] text-emerald-500"></i>
                            <span>Secure Session</span>
                        </span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="login-submit-btn" 
                            class="w-full py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs sm:text-sm font-black shadow-md transition-all cursor-pointer flex items-center justify-center gap-2">
                        <span>Sign In</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </button>

                    <!-- Divider -->
                    <div class="relative flex items-center justify-center my-3">
                        <div class="border-t border-slate-200 w-full"></div>
                        <div class="bg-white px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider relative">OR</div>
                    </div>

                    <!-- Alternate Sign In Actions -->
                    <div class="space-y-2.5">
                        <button type="button" id="google-signin-btn" onclick="handleFirebaseGoogleSignIn('Fan')"
                                class="w-full py-2.5 px-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs sm:text-sm font-bold transition-all shadow-2xs flex items-center justify-center gap-2.5 cursor-pointer">
                            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                            <span>Continue with Google</span>
                        </button>

                        <a href="/login-otp" 
                           class="w-full py-2.5 px-4 rounded-xl border border-purple-200 bg-purple-50/70 hover:bg-purple-100/80 text-purple-900 text-xs sm:text-sm font-bold transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer">
                            <i class="fas fa-shield-halved text-purple-600"></i>
                            <span>Sign In with 6-Digit Email OTP</span>
                        </a>
                    </div>
                </form>
            </div>

            <!-- ======================================================== -->
            <!-- 2. REGISTER FORM PANEL (Fluid, Expands Naturally)        -->
            <!-- ======================================================== -->
            <div id="panel-register" class="<%= activeMode === 'register' ? '' : 'hidden' %>">
                <div class="mb-4">
                    <h2 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                        <span>Create Account</span>
                        <i class="fas fa-user-plus text-purple-600 text-lg"></i>
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Create your fan or verified host account in seconds</p>
                </div>

                <form id="register-form" action="/register" method="POST" class="space-y-3.5">
                    
                    <!-- Account Type Selector (Familiar Icons, Zero Emojis) -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-700">I am joining as:</label>
                        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-2xl border border-slate-200/80">
                            <!-- Role Option: Fan -->
                            <label id="label-role-fan" 
                                   class="flex flex-col items-center justify-center py-2 px-3 rounded-xl cursor-pointer transition-all border text-center bg-white border-pink-200 text-slate-900 shadow-xs">
                                <input type="radio" name="account_type" value="fan" checked onchange="toggleAccountType(this.value)" class="sr-only">
                                <div class="flex items-center gap-1.5 font-bold text-xs">
                                    <i class="fas fa-heart text-pink-500"></i>
                                    <span>K-Pop Fan</span>
                                </div>
                                <span class="text-[10px] text-slate-500 mt-0.5">Attendee / Enthusiast</span>
                            </label>

                            <!-- Role Option: Organizer / Fanclub -->
                            <label id="label-role-org" 
                                   class="flex flex-col items-center justify-center py-2 px-3 rounded-xl cursor-pointer transition-all border text-center border-transparent text-slate-600 hover:text-slate-900">
                                <input type="radio" name="account_type" value="organizer" onchange="toggleAccountType(this.value)" class="sr-only">
                                <div class="flex items-center gap-1.5 font-bold text-xs">
                                    <i class="fas fa-building-user text-purple-600"></i>
                                    <span>Fanclub / Event Host</span>
                                </div>
                                <span class="text-[10px] text-slate-500 mt-0.5">Publish Cupsleeves / Events</span>
                            </label>
                        </div>
                    </div>

                    <!-- Two Column Grid for Full Name & Username -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="block text-xs font-bold text-slate-700">Full Name</label>
                            <div class="relative">
                                <i class="fas fa-id-card absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" name="full_name" required placeholder="e.g. Aiman Danial"
                                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label class="block text-xs font-bold text-slate-700">Username</label>
                            <div class="relative">
                                <i class="fas fa-at absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" name="username" required placeholder="e.g. aiman_carat"
                                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                            </div>
                        </div>
                    </div>

                    <!-- Email Address -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-700">Email Address (For Verification OTP)</label>
                        <div class="relative">
                            <i class="fas fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="email" name="email" required placeholder="e.g. aiman@ksync.my"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-700">Password (Min. 6 Characters)</label>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="password" id="register-password" name="password" required placeholder="••••••••" minlength="6"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-10 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                            <button type="button" onclick="togglePasswordVisibility('register-password', 'register-eye-icon')" 
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer"
                                    aria-label="Toggle password visibility">
                                <i id="register-eye-icon" class="fas fa-eye text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Fan Favorite Group Field (Visible when Fan role active) -->
                    <div id="fan-fandom-box" class="space-y-1">
                        <label class="block text-[11px] font-bold text-slate-700">Favorite Fandom / Group (Optional)</label>
                        <div class="relative">
                            <i class="fas fa-heart absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" name="bio" placeholder="e.g. SEVENTEEN Carat / BABYMONSTER Monstiez"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                        </div>
                    </div>

                    <!-- ======================================================== -->
                    <!-- ORGANIZER DEDICATED FIELDS (NATURAL EXPANSION, NO SCROLL)-->
                    <!-- ======================================================== -->
                    <div id="organizer-fields-box" class="hidden p-4 rounded-2xl bg-purple-50/70 border border-purple-200/90 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5 text-xs font-extrabold text-purple-950">
                                <i class="fas fa-shield-halved text-purple-600"></i>
                                <span>Fanclub / Host Credentials</span>
                            </div>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-200/80 text-purple-900">
                                Verified Badge
                            </span>
                        </div>

                        <!-- Organization Name -->
                        <div class="space-y-1">
                            <label class="block text-[11px] font-bold text-slate-700">Fanclub or Organization Name</label>
                            <div class="relative">
                                <i class="fas fa-users absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" name="organization_name" placeholder="e.g. MY MOA Union (TXT Fanclub Malaysia)"
                                       class="w-full bg-white border border-purple-200 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-400">
                            </div>
                        </div>

                        <!-- Two Column Grid for Category & Telegram/Social -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <div class="space-y-1">
                                <label class="block text-[11px] font-bold text-slate-700">Organization Type</label>
                                <div class="relative">
                                    <i class="fas fa-tag absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                    <select name="organization_type" class="w-full bg-white border border-purple-200 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-400">
                                        <option value="Fanclub" selected>Fandom Fanclub</option>
                                        <option value="Promoter">Concert Promoter</option>
                                        <option value="Independent">Independent Host</option>
                                    </select>
                                </div>
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[11px] font-bold text-slate-700">Telegram / Social Handle</label>
                                <div class="relative">
                                    <i class="fab fa-telegram absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                    <input type="text" name="social_handle" placeholder="@mymoatxt"
                                           class="w-full bg-white border border-purple-200 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-400">
                                </div>
                            </div>
                        </div>

                        <!-- Official Channel URL -->
                        <div class="space-y-1">
                            <label class="block text-[11px] font-bold text-slate-700">Official Channel / Announcement Link</label>
                            <div class="relative">
                                <i class="fas fa-link absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="url" name="social_url" placeholder="https://t.me/mymoatxt"
                                       class="w-full bg-white border border-purple-200 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-400">
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="btn-submit-register" 
                            class="w-full py-3 px-4 bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:opacity-95 text-white rounded-xl text-xs sm:text-sm font-black shadow-md transition-all cursor-pointer flex items-center justify-center gap-2">
                        <span>Continue & Send 6-Digit Email OTP</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </button>

                    <!-- Divider -->
                    <div class="relative flex items-center justify-center my-2">
                        <div class="border-t border-slate-200 w-full"></div>
                        <div class="bg-white px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider relative">OR</div>
                    </div>

                    <!-- Google Sign Up -->
                    <button type="button" onclick="handleFirebaseGoogleSignIn('Fan')"
                            class="w-full py-2.5 px-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs sm:text-sm font-bold transition-all shadow-2xs flex items-center justify-center gap-2.5 cursor-pointer">
                        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                        <span>Sign Up with Google</span>
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<!-- ======================================================== -->
<!-- INTERACTIVE SCRIPTS: STATE TOGGLE & ACCESSIBILITY         -->
<!-- ======================================================== -->
<script>
    // Tab Controller: switch between 'login' and 'register'
    function setAuthMode(mode) {
        const panelLogin = document.getElementById('panel-login');
        const panelRegister = document.getElementById('panel-register');
        const tabBtnLogin = document.getElementById('tab-btn-login');
        const tabBtnRegister = document.getElementById('tab-btn-register');

        if (mode === 'register') {
            if (panelLogin) panelLogin.classList.add('hidden');
            if (panelRegister) panelRegister.classList.remove('hidden');

            if (tabBtnLogin) {
                tabBtnLogin.className = 'flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold transition-all text-center flex items-center justify-center gap-2 cursor-pointer text-slate-500 hover:text-slate-900';
            }
            if (tabBtnRegister) {
                tabBtnRegister.className = 'flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold transition-all text-center flex items-center justify-center gap-2 cursor-pointer bg-white text-slate-900 shadow-sm';
            }

            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/register');
            }
            document.title = 'Register Account | K-Sync Malaysia';
        } else {
            if (panelRegister) panelRegister.classList.add('hidden');
            if (panelLogin) panelLogin.classList.remove('hidden');

            if (tabBtnLogin) {
                tabBtnLogin.className = 'flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold transition-all text-center flex items-center justify-center gap-2 cursor-pointer bg-white text-slate-900 shadow-sm';
            }
            if (tabBtnRegister) {
                tabBtnRegister.className = 'flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold transition-all text-center flex items-center justify-center gap-2 cursor-pointer text-slate-500 hover:text-slate-900';
            }

            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/login');
            }
            document.title = 'Sign In | K-Sync Malaysia';
        }
    }

    // Role Toggle on Registration (Fan vs Organizer)
    function toggleAccountType(type) {
        const orgFields = document.getElementById('organizer-fields-box');
        const fanBox = document.getElementById('fan-fandom-box');
        const labelFan = document.getElementById('label-role-fan');
        const labelOrg = document.getElementById('label-role-org');
        const submitBtn = document.getElementById('btn-submit-register');

        if (type === 'organizer') {
            if (orgFields) orgFields.classList.remove('hidden');
            if (fanBox) fanBox.classList.add('hidden');
            
            if (labelFan) {
                labelFan.className = 'flex flex-col items-center justify-center py-2 px-3 rounded-xl cursor-pointer transition-all border text-center border-transparent text-slate-600 hover:text-slate-900';
            }
            if (labelOrg) {
                labelOrg.className = 'flex flex-col items-center justify-center py-2 px-3 rounded-xl cursor-pointer transition-all border text-center bg-white border-purple-300 text-purple-950 shadow-xs';
            }
            if (submitBtn) {
                submitBtn.innerHTML = '<span>Verify via 6-Digit Email OTP</span><i class="fas fa-arrow-right text-xs"></i>';
            }
        } else {
            if (orgFields) orgFields.classList.add('hidden');
            if (fanBox) fanBox.classList.remove('hidden');

            if (labelFan) {
                labelFan.className = 'flex flex-col items-center justify-center py-2 px-3 rounded-xl cursor-pointer transition-all border text-center bg-white border-pink-200 text-slate-900 shadow-xs';
            }
            if (labelOrg) {
                labelOrg.className = 'flex flex-col items-center justify-center py-2 px-3 rounded-xl cursor-pointer transition-all border text-center border-transparent text-slate-600 hover:text-slate-900';
            }
            if (submitBtn) {
                submitBtn.innerHTML = '<span>Continue & Send 6-Digit Email OTP</span><i class="fas fa-arrow-right text-xs"></i>';
            }
        }
    }

    // Password Visibility Toggle
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>

