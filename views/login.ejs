<%- include('partials/header', { title: 'Sign In | K-Sync Malaysia' }) %>

<!-- Full Page K-Sync Backdrop -->
<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-hidden bg-gradient-to-b from-slate-100/70 via-pink-50/20 to-slate-50">
    <!-- Ambient Stage Lighting Glows -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-60">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Sign In Dedicated Card -->
    <div class="w-full max-w-md bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-xl relative z-10 space-y-5 my-auto">
        <!-- Header -->
        <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-pink-500 to-purple-600 text-white flex items-center justify-center text-xl mx-auto mb-3 shadow-md">
                <i class="fas fa-arrow-right-to-bracket"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Sign In to K-Sync</h1>
            <p class="text-xs text-slate-500 mt-1 font-medium">Access your concerts, fan watchlist & radar</p>
        </div>

        <!-- Form -->
        <form id="login-form" action="/login" method="POST" class="space-y-4">
            <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">

            <!-- Username or Email -->
            <div class="space-y-1">
                <label class="block text-xs font-bold text-slate-700">Email or Username</label>
                <div class="relative">
                    <i class="fas fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" name="username" required placeholder="Enter username or email" id="login-username"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-xs sm:text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                </div>
            </div>

            <!-- Password -->
            <div class="space-y-1">
                <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold text-slate-700">Password</label>
                    <a href="/forgot-password" class="text-[11px] font-bold text-pink-600 hover:text-pink-700 hover:underline">
                        Forgot password?
                    </a>
                </div>
                <div class="relative">
                    <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="password" id="login-password" name="password" required placeholder="••••••••"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-10 py-2.5 text-xs sm:text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500 transition-colors">
                    <button type="button" onclick="togglePasswordVisibility('login-password', 'login-eye-icon')" 
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1.5 focus:outline-none cursor-pointer"
                            aria-label="Toggle password visibility">
                        <i id="login-eye-icon" class="fas fa-eye text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Remember Me & Security Status -->
            <div class="flex items-center justify-between text-xs pt-0.5">
                <label class="flex items-center gap-2 cursor-pointer select-none text-slate-600">
                    <input type="checkbox" name="remember_me" class="rounded border-slate-300 text-pink-600 focus:ring-pink-500 w-3.5 h-3.5 cursor-pointer">
                    <span class="text-xs font-medium">Remember me</span>
                </label>
                <span class="text-[11px] text-slate-400 font-medium flex items-center gap-1">
                    <i class="fas fa-lock text-[10px] text-emerald-500"></i> Secure Session
                </span>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="login-submit-btn" 
                    class="w-full py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs sm:text-sm font-black shadow-md transition-all cursor-pointer flex items-center justify-center gap-2 press-tactile">
                <span>Sign In</span>
                <i class="fas fa-arrow-right text-xs"></i>
            </button>

            <!-- Divider -->
            <div class="relative flex items-center justify-center my-2">
                <div class="border-t border-slate-200 w-full"></div>
                <div class="bg-white px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider relative">OR</div>
            </div>

            <!-- Alternate Sign In Actions -->
            <div class="space-y-2">
                <button type="button" id="google-signin-btn" onclick="handleFirebaseGoogleSignIn('Fan')"
                        class="w-full py-2.5 px-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs sm:text-sm font-bold transition-all shadow-2xs flex items-center justify-center gap-2.5 cursor-pointer press-tactile">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-4 h-4" alt="Google">
                    <span>Continue with Google</span>
                </button>

                <a href="/login-otp" 
                   class="w-full py-2.5 px-4 rounded-xl border border-purple-200 bg-purple-50/70 hover:bg-purple-100/80 text-purple-900 text-xs sm:text-sm font-bold transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer press-tactile">
                    <i class="fas fa-shield-halved text-purple-600 text-xs"></i>
                    <span>Sign In with 6-Digit Email OTP</span>
                </a>
            </div>

            <!-- Quick FYP Demo 1-Click Sign In Drawer (No Emojis!) -->
            <div class="pt-2">
                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
                    <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider flex items-center justify-between">
                        <span class="flex items-center gap-1.5"><i class="fas fa-key text-pink-500"></i> Demo Credentials:</span>
                        <span class="text-[9px] text-emerald-600 font-extrabold uppercase">1-Click Sign In</span>
                    </div>
                    <div class="grid grid-cols-3 gap-1.5 text-xs">
                        <button type="button" onclick="fillCreds('admin', 'admin123')" class="p-2 bg-white rounded-xl border border-slate-200 text-center hover:border-purple-400 hover:bg-purple-50/60 transition-all cursor-pointer shadow-2xs">
                            <div class="font-bold text-purple-700 flex items-center justify-center gap-1">
                                <i class="fas fa-crown text-[10px] text-amber-500"></i> Admin
                            </div>
                        </button>
                        <button type="button" onclick="fillCreds('starline', 'organizer123')" class="p-2 bg-white rounded-xl border border-slate-200 text-center hover:border-emerald-400 hover:bg-emerald-50/60 transition-all cursor-pointer shadow-2xs">
                            <div class="font-bold text-emerald-700 flex items-center justify-center gap-1">
                                <i class="fas fa-building-user text-[10px] text-emerald-600"></i> Host
                            </div>
                        </button>
                        <button type="button" onclick="fillCreds('aiman_carat', 'fan123')" class="p-2 bg-white rounded-xl border border-slate-200 text-center hover:border-pink-400 hover:bg-pink-50/60 transition-all cursor-pointer shadow-2xs">
                            <div class="font-bold text-pink-700 flex items-center justify-center gap-1">
                                <i class="fas fa-heart text-[10px] text-pink-500"></i> Fan
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Switch to Register Link -->
            <div class="text-center text-xs text-slate-500 pt-1">
                Don't have an account yet? 
                <a href="/register" class="font-extrabold text-pink-600 hover:text-pink-700 hover:underline">
                    Create Account
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function fillCreds(u, p) {
        const uInput = document.getElementById('login-username');
        const pInput = document.getElementById('login-password');
        const submitBtn = document.getElementById('login-submit-btn');
        if (uInput && pInput) {
            uInput.value = u;
            pInput.value = p;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Signing in...';
            }
            document.getElementById('login-form').submit();
        }
    }
</script>

<%- include('partials/google-auth') %>
<%- include('partials/footer') %>
