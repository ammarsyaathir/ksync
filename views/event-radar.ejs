<%- include('partials/header', { title: '360° Concert Sonar & Temporal Radar | K-Sync Malaysia' }) %>

<%
    const PRECINCT_METADATA = {
        'Bukit Jalil Hub': {
            transit: 'LRT Sri Petaling Line (Bukit Jalil Station - PH5)',
            walkTime: '5-10 mins covered pedestrian walkway',
            icon: 'fa-landmark',
            color: 'emerald',
            badge: 'Mega Stadium Precinct',
            venues: 'Axiata Arena, Bukit Jalil National Stadium, Unifi Arena',
            coords: [3.0583, 101.6917],
            capacity: '16,000 - 87,000',
            tips: 'Park-and-ride at LRT stations (Awan Besar / Sri Petaling) is highly recommended on massive concert nights. Rapid KL frequently extends operations to 12:30 AM.'
        },
        'BBCC & Downtown KL': {
            transit: 'Hang Tuah Station (LRT Ampang Line / KL Monorail) & Merdeka MRT',
            walkTime: 'Direct connection via Mitsui Shopping Park LaLaport BBCC',
            icon: 'fa-building-columns',
            color: 'purple',
            badge: 'Zepp KL & Lifestyle Precinct',
            venues: 'Zepp Kuala Lumpur, LaLaport BBCC Central Rooftop',
            coords: [3.1408, 101.7088],
            capacity: '2,500',
            tips: 'Direct undercover transit link from Hang Tuah station directly into Zepp KL floor level.'
        },
        'Mega Star Arena & Bukit Bintang': {
            transit: 'MRT / Monorail Bukit Bintang & Imbi Monorail',
            walkTime: 'Inside Sungei Wang Plaza (Level 4)',
            icon: 'fa-compact-disc',
            color: 'pink',
            badge: 'City Center Indoor Arena',
            venues: 'Mega Star Arena KL (Level 4 Sungei Wang)',
            coords: [3.1451, 101.7114],
            capacity: '5,000',
            tips: 'Located right in central Bukit Bintang; ample food options in Sungei Wang and Lot 10 before queuing.'
        },
        'KL Sentral & Brickfields': {
            transit: 'KL Sentral Hub (LRT / MRT / KTM / ERL Airport Express)',
            walkTime: '5-15 mins via connected transit skybridges',
            icon: 'fa-train-subway',
            color: 'blue',
            badge: 'Central Transit Interchange Hub',
            venues: 'Idea Convention Centre, Menara PGRM / Cheras link',
            coords: [3.1342, 101.6865],
            capacity: '3,000',
            tips: 'Ideal hub for interstate and overseas fans arriving from KLIA 1/2 via KLIA Ekspres.'
        },
        'Petaling Jaya & Sunway': {
            transit: 'BRT Sunway Line / LRT Kelana Jaya line (Taman Paramount / Asia Jaya)',
            walkTime: 'BRT direct to Sunway Pyramid; Feeder bus to JioSpace PJ',
            icon: 'fa-map-pin',
            color: 'amber',
            badge: 'Suburban Indie & Gathering Hub',
            venues: 'Sunway Pyramid Convention Centre, JioSpace PJ',
            coords: [3.0729, 101.6074],
            capacity: '4,000',
            tips: 'Great for cupsleeve cafe hops, fanclub exhibition gatherings, and medium-scale showcase tours.'
        },
        'Penang & Northern Region': {
            transit: 'Rapid Penang Bus / Penang Airport Link',
            walkTime: 'Direct access from Jalan Tun Dr Awang',
            icon: 'fa-water',
            color: 'cyan',
            badge: 'Northern Tour Stop',
            venues: 'Setia SPICE Arena, Gurney Paragon Mall',
            coords: [5.3283, 100.2825],
            capacity: '10,000',
            tips: 'Main concert hub for northern Malaysian fans with direct airport highway access.'
        }
    };

    function resolveFandomColor(artistName) {
        const name = (artistName || '').toLowerCase();
        if (name.includes('seventeen')) return { primary: '#F7CAC9', secondary: '#92A8D1', name: 'Rose Quartz & Serenity', quadrant: 'bg', label: 'CARAT Beacon' };
        if (name.includes('twice')) return { primary: '#FF5FA2', secondary: '#FFA400', name: 'Apricot & Neon Magenta', quadrant: 'gg', label: 'ONCE Beacon' };
        if (name.includes('stray kids')) return { primary: '#E11D48', secondary: '#0F172A', name: 'Compass Crimson', quadrant: 'bg', label: 'STAY Beacon' };
        if (name.includes('aespa')) return { primary: '#A855F7', secondary: '#38BDF8', name: 'Aurora Ultraviolet', quadrant: 'gg', label: 'MY Beacon' };
        if (name.includes('ive')) return { primary: '#EC4899', secondary: '#F43F5E', name: 'Prism Magenta', quadrant: 'gg', label: 'DIVE Beacon' };
        if (name.includes('day6')) return { primary: '#0284C7', secondary: '#38BDF8', name: 'EveryDAY Sky', quadrant: 'band', label: 'My Day Beacon' };
        if (name.includes('enhypen')) return { primary: '#F97316', secondary: '#EA580C', name: 'Vampire Amber', quadrant: 'bg', label: 'ENGENE Beacon' };
        if (name.includes('txt') || name.includes('tomorrow')) return { primary: '#06B6D4', secondary: '#3B82F6', name: 'Star Cyan', quadrant: 'bg', label: 'MOA Beacon' };
        if (name.includes('taeyeon') || name.includes('iu') || name.includes('baekhyun')) return { primary: '#F472B6', secondary: '#C084FC', name: 'Vocalist Aura', quadrant: 'solo', label: 'Soloist Beacon' };
        if (name.includes('band') || name.includes('wave') || name.includes('fest')) return { primary: '#10B981', secondary: '#06B6D4', name: 'Live Band Green', quadrant: 'band', label: 'Band Beacon' };
        return { primary: '#EC4899', secondary: '#06B6D4', name: 'Cyber Stage Neon', quadrant: 'bg', label: 'Live Echo' };
    }

    // Serialize events for the 360° Acoustic Sonar Scope
    const mappedEventsData = events.map(e => {
        let coords = [3.1408, 101.7088]; // default KL
        const vName = (e.venue_name || '').toLowerCase();
        const aName = (e.cluster_area || '');

        if (vName.includes('axiata') || vName.includes('bukit jalil')) coords = [3.0583, 101.6917];
        else if (vName.includes('zepp') || vName.includes('lalaport')) coords = [3.1408, 101.7088];
        else if (vName.includes('mega star') || vName.includes('sungei wang')) coords = [3.1451, 101.7114];
        else if (vName.includes('sunway') || vName.includes('jiospace') || vName.includes('petaling')) coords = [3.0729, 101.6074];
        else if (vName.includes('spice') || vName.includes('penang') || vName.includes('gurney')) coords = [5.3283, 100.2825];
        else if (vName.includes('austin') || vName.includes('johor')) coords = [1.5542, 103.7766];
        else if (PRECINCT_METADATA[aName]) coords = PRECINCT_METADATA[aName].coords;

        const fandom = resolveFandomColor(e.artist_name);
        const eventDate = e.event_date instanceof Date ? e.event_date : new Date(e.event_date || Date.now());
        const daysAway = Math.max(0, Math.round((eventDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)));

        return {
            id: e.id,
            title: e.event_name,
            artist: e.artist_name || 'K-Pop Artist',
            venue: e.venue_name || e.venue_display || 'Malaysian Venue',
            date: eventDate.toISOString().split('T')[0],
            time: e.start_time || '8:00 PM',
            poster: e.poster_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800',
            area: e.cluster_area || 'Kuala Lumpur Metro Hub',
            ticketUrl: e.official_ticket_url || '',
            status: e.verification_status || 'VERIFIED',
            coords: coords,
            fandom: fandom,
            daysAway: daysAway,
            slug: helpers.slugify(e.event_name) || e.id
        };
    });
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Header Stage Header (Impeccable: Bold display voice, no generic kickers) -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-200/80 pb-6">
        <div>
            <div class="flex items-center space-x-2.5 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-slate-900 text-white shadow-xs">
                    <span class="w-2 h-2 rounded-full bg-pink-500 animate-pulse"></span>
                    360° ACOUSTIC CONCERT SONAR
                </span>
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200/80">
                    Temporal Signal Matrix
                </span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-[-0.035em] leading-tight">
                K-Pop Event Radar
            </h1>
            <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl font-medium leading-relaxed">
                Autonomous concert sonar tracking Malaysian tour stops across time horizons, lightstick frequencies, and Klang Valley metro corridors.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <span class="px-4 py-2.5 rounded-2xl text-xs font-black bg-slate-900 text-white shadow-sm flex items-center gap-2">
                <i class="fas fa-satellite-dish text-pink-400 animate-spin" style="animation-duration: 8s;"></i>
                <span><%= events.length %> Active Stage Echoes</span>
            </span>
        </div>
    </div>

    <!-- Quad-View Navigation Dock -->
    <div class="bg-white rounded-3xl p-3 sm:p-4 shadow-xs border border-slate-200 mb-8">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <!-- View Selector Tabs -->
            <div class="inline-flex rounded-2xl bg-slate-100 p-1.5 border border-slate-200/80 shrink-0 overflow-x-auto max-w-full">
                <button type="button" id="tab-sonar-btn" onclick="switchRadarMode('sonar')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-radar text-pink-400"></i>
                    <span>360° Concert Sonar</span>
                </button>
                <button type="button" id="tab-transit-btn" onclick="switchRadarMode('transit')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-train-subway text-emerald-500"></i>
                    <span>Transit Corridor Schematic</span>
                </button>
                <button type="button" id="tab-weekend-btn" onclick="switchRadarMode('weekend')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-calendar-week text-purple-500"></i>
                    <span>Weekend Clash Matrix (<%= weekendClusters.length %>)</span>
                </button>
                <button type="button" id="tab-precinct-btn" onclick="switchRadarMode('precinct')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-landmark text-amber-500"></i>
                    <span>Precinct Dossiers (<%= Object.keys(areaClusters).length %>)</span>
                </button>
            </div>

            <!-- Telemetry Indicator -->
            <div class="flex items-center gap-2 text-xs text-slate-500 font-semibold px-2">
                <span class="flex items-center gap-1.5 text-pink-700 bg-pink-50 px-3 py-1 rounded-full border border-pink-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-pink-500 animate-ping"></span>
                    Lightstick Beacon Sync Active
                </span>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 1: 360° CONCERT SONAR SCOPE & TARGET ACQUISITION CONSOLE (PRIMARY)   -->
    <!-- ========================================================================= -->
    <div id="view-sonar" class="space-y-6">
        <!-- Command Console Container -->
        <div class="bg-slate-950 rounded-3xl border border-slate-800 p-5 sm:p-7 shadow-2xl relative overflow-hidden text-white">
            <!-- Background Cyber Grid Mesh -->
            <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

            <!-- Top Telemetry Ribbon -->
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800/80 pb-5 mb-6">
                <div class="space-y-1 font-mono text-[11px]">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded bg-pink-500/20 text-pink-400 border border-pink-500/40 font-bold uppercase tracking-widest text-[10px]">
                            SONAR AZIMUTH SCANNER
                        </span>
                        <span class="text-slate-400">GROUND ZERO: KLANG VALLEY [3.1390° N, 101.6869° E]</span>
                    </div>
                    <div class="text-xs text-slate-300 font-sans font-bold flex items-center gap-2">
                        <span>Range Horizons: Today (Center) · 7D (Inner) · 30D · 90D · Season 2026/27</span>
                    </div>
                </div>

                <!-- Sonar Control Docks -->
                <div class="flex items-center gap-2 shrink-0">
                    <!-- Sweep Speed Selector -->
                    <div class="inline-flex rounded-xl bg-slate-900 border border-slate-800 p-1 text-[11px] font-mono">
                        <button type="button" id="btn-speed-1" onclick="setSweepSpeed(1)" class="px-2.5 py-1 rounded-lg bg-pink-600 text-white font-bold cursor-pointer">1x Scan</button>
                        <button type="button" id="btn-speed-2" onclick="setSweepSpeed(2)" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer">2x Rapid</button>
                        <button type="button" id="btn-speed-0" onclick="setSweepSpeed(0)" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer">Freeze</button>
                    </div>

                    <!-- Audio Ping Toggle -->
                    <button type="button" id="btn-audio-ping" onclick="toggleAudioPing()" 
                            class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white text-xs font-mono font-bold flex items-center gap-1.5 cursor-pointer transition-all"
                            title="Toggle Acoustic Sonar Beep Sound">
                        <i class="fas fa-volume-xmark text-slate-400" id="audio-icon"></i>
                        <span id="audio-label">Muted</span>
                    </button>
                </div>
            </div>

            <!-- Sonar Stage: Two-Column Interactive Layout -->
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- Left/Center: 360° Circular Sonar Canvas -->
                <div class="lg:col-span-7 flex flex-col items-center justify-center">
                    <div class="relative w-full max-w-[520px] aspect-square flex items-center justify-center">
                        <!-- Canvas Element -->
                        <canvas id="sonar-canvas" class="w-full h-full cursor-crosshair rounded-full shadow-[0_0_50px_rgba(236,72,153,0.15)]"></canvas>

                        <!-- Quadrant Overlay Badges (Absolute around canvas) -->
                        <div class="absolute top-2 left-2 text-[10px] font-mono text-cyan-400/80 bg-slate-950/80 px-2 py-0.5 rounded border border-cyan-500/20 pointer-events-none">
                            NW · BOY GROUPS
                        </div>
                        <div class="absolute top-2 right-2 text-[10px] font-mono text-pink-400/80 bg-slate-950/80 px-2 py-0.5 rounded border border-pink-500/20 pointer-events-none">
                            NE · GIRL GROUPS
                        </div>
                        <div class="absolute bottom-2 left-2 text-[10px] font-mono text-emerald-400/80 bg-slate-950/80 px-2 py-0.5 rounded border border-emerald-500/20 pointer-events-none">
                            SW · K-BANDS & FESTS
                        </div>
                        <div class="absolute bottom-2 right-2 text-[10px] font-mono text-purple-400/80 bg-slate-950/80 px-2 py-0.5 rounded border border-purple-500/20 pointer-events-none">
                            SE · SOLOISTS & VOCALS
                        </div>
                    </div>

                    <!-- Canvas Telemetry Helper -->
                    <div class="mt-4 text-center text-xs text-slate-400 font-mono">
                        <span class="text-pink-400 font-bold"><i class="fas fa-hand-pointer me-1"></i> CLICK ANY ECHO BEACON</span> TO LOCK CONCERT DOSSIER
                    </div>
                </div>

                <!-- Right Column: Real-Time Target Acquisition HUD -->
                <div class="lg:col-span-5">
                    <div id="target-hud-container" class="bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-800 p-5 space-y-4 shadow-xl">
                        <!-- Target Lock Status Header -->
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span id="hud-status" class="text-xs font-mono font-bold text-emerald-400 tracking-wider">TARGET ACQUIRED · #01</span>
                            </div>
                            <span id="hud-dday" class="px-2.5 py-0.5 rounded-full text-xs font-black bg-pink-500 text-white font-mono">D-DAY</span>
                        </div>

                        <!-- Artist & Tour Dossier Info -->
                        <div class="flex gap-4 items-start">
                            <img id="hud-poster" src="" alt="Poster" class="w-20 h-28 object-cover rounded-xl border border-slate-700 shrink-0 bg-slate-950">
                            <div class="space-y-1.5 flex-grow">
                                <div id="hud-artist" class="text-xs font-bold text-pink-400 uppercase tracking-wider flex items-center gap-1.5">Artist</div>
                                <h3 id="hud-title" class="text-base font-black text-white leading-tight line-clamp-2">Concert Title</h3>
                                <p id="hud-venue" class="text-xs text-slate-300 flex items-center gap-1">
                                    <i class="fas fa-location-dot text-slate-400"></i>
                                    <span>Venue</span>
                                </p>
                                <p id="hud-date" class="text-xs text-slate-400 font-mono">Date</p>
                            </div>
                        </div>

                        <!-- Fandom Lightstick Hue Beacon -->
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <span id="hud-lightstick-swatch" class="w-4 h-4 rounded-full border border-white/20 shadow-xs"></span>
                                <div class="text-xs">
                                    <div class="text-slate-400 text-[10px] uppercase font-mono">Fandom Lightstick Hue</div>
                                    <div id="hud-lightstick-name" class="font-bold text-white">Lightstick Colors</div>
                                </div>
                            </div>
                            <span id="hud-verified" class="px-2 py-0.5 rounded text-[10px] font-black bg-emerald-950 text-emerald-400 border border-emerald-800/80">
                                98% VERIFIED
                            </span>
                        </div>

                        <!-- Transit Quick Advisory -->
                        <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/60 text-xs space-y-1">
                            <div class="text-slate-400 font-mono text-[10px] flex items-center gap-1">
                                <i class="fas fa-train text-emerald-400"></i>
                                <span>RAPID KL TRANSIT INTEL</span>
                            </div>
                            <p id="hud-transit-tip" class="text-slate-300 text-[11px] leading-relaxed">
                                Direct connection via LRT Sri Petaling Line.
                            </p>
                        </div>

                        <!-- Direct Action Buttons -->
                        <div class="pt-2 flex flex-col sm:flex-row gap-2">
                            <a id="hud-link-dossier" href="#" class="flex-1 px-4 py-2.5 rounded-xl text-xs font-black bg-pink-600 hover:bg-pink-500 text-white press-tactile text-center transition-all shadow-xs flex items-center justify-center gap-1.5">
                                <span>Open Full Dossier</span>
                                <i class="fas fa-arrow-right text-[10px]"></i>
                            </a>
                            <a id="hud-link-ticket" href="#" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 press-tactile text-center transition-all flex items-center justify-center gap-1.5">
                                <span>Tickets</span>
                                <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Temporal Range Filter Slider -->
            <div class="relative z-10 mt-8 pt-6 border-t border-slate-800/80 space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono">
                    <span class="text-slate-400 flex items-center gap-1.5">
                        <i class="fas fa-sliders text-pink-400"></i>
                        <span>TIME HORIZON FILTER:</span>
                        <span id="slider-label" class="text-white font-bold px-2 py-0.5 rounded bg-slate-900 border border-slate-800">All 2026/2027 Concert Season</span>
                    </span>
                    <span id="active-marker-count" class="text-pink-400 font-bold">
                        <%= events.length %> Echoes Detected
                    </span>
                </div>
                <input type="range" id="time-scrubber" min="0" max="4" step="1" value="4" 
                       oninput="handleTimeScrubberChange(this.value)"
                       class="w-full h-2.5 bg-slate-900 rounded-lg appearance-none cursor-pointer accent-pink-500 focus:outline-none border border-slate-800">
                <div class="flex justify-between text-[11px] text-slate-400 font-mono pt-1">
                    <span>Now / 48H</span>
                    <span>This Weekend</span>
                    <span>Next 30 Days</span>
                    <span>Next 90 Days</span>
                    <span class="text-pink-400 font-bold">Full Tour Season</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 2: KLANG VALLEY TRANSIT CORRIDOR SCHEMATIC (TRANSIT RADAR)          -->
    <!-- ========================================================================= -->
    <div id="view-transit" class="space-y-6 hidden">
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-8">
            <div>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                    <i class="fas fa-train-subway text-emerald-600"></i>
                    <span>Klang Valley Concert Metro Corridors</span>
                </h2>
                <p class="text-slate-600 text-sm mt-1">
                    Schematic public transit pathways linking Kuala Lumpur's primary K-Pop arenas to Rapid KL rail interchanges.
                </p>
            </div>

            <!-- Corridor 1: LRT Sri Petaling Line (Bukit Jalil Mega Hub) -->
            <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-4">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-red-600 text-white font-black text-xs flex items-center justify-center shadow-xs">PH</span>
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900">LRT Sri Petaling Line · Bukit Jalil Mega Hub</h3>
                            <p class="text-xs text-slate-500">Serves Axiata Arena (16,000) & National Stadium Bukit Jalil (87,000)</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-200">
                        Rapid KL Service Extensions Active
                    </span>
                </div>

                <!-- Schematic Metro Line Diagram -->
                <div class="py-4 overflow-x-auto">
                    <div class="flex items-center min-w-[620px] justify-between relative px-4">
                        <!-- Horizontal Connecting Track -->
                        <div class="absolute left-6 right-6 top-1/2 -translate-y-1/2 h-2 bg-red-600 rounded-full z-0"></div>

                        <!-- Station 1 -->
                        <div class="relative z-10 flex flex-col items-center">
                            <span class="w-6 h-6 rounded-full bg-white border-4 border-red-600 shadow-xs"></span>
                            <span class="text-xs font-bold text-slate-700 mt-2">Plaza Rakyat</span>
                            <span class="text-[10px] text-slate-400 font-mono">Interchange</span>
                        </div>

                        <!-- Station 2 -->
