<%- include('partials/header', { title: '4D Geospatial Event Radar & Transit Matrix | K-Sync Malaysia' }) %>

<%
    const PRECINCT_METADATA = {
        'Bukit Jalil Hub': {
            transit: 'LRT Sri Petaling Line (Bukit Jalil Station - PH5)',
            walkTime: '5-10 mins covered pedestrian walkway',
            icon: 'fa-landmark',
            color: 'emerald',
            badge: 'Mega Stadium Precinct',
            venues: 'Axiata Arena, Bukit Jalil National Stadium, Unifi Arena',
            coords: [3.0583, 101.6917],
            capacity: '16,000 - 87,000',
            tips: 'Park-and-ride at LRT stations (Awan Besar / Sri Petaling) is highly recommended on massive concert nights.'
        },
        'BBCC & Downtown KL': {
            transit: 'Hang Tuah Station (LRT Ampang Line / KL Monorail) & Merdeka MRT',
            walkTime: 'Direct connection via Mitsui Shopping Park LaLaport BBCC',
            icon: 'fa-building-columns',
            color: 'purple',
            badge: 'Zepp KL & Lifestyle Precinct',
            venues: 'Zepp Kuala Lumpur, LaLaport BBCC Central Rooftop',
            coords: [3.1408, 101.7088],
            capacity: '2,500',
            tips: 'Direct undercover transit link from Hang Tuah station directly into Zepp KL floor level.'
        },
        'Mega Star Arena & Bukit Bintang': {
            transit: 'MRT / Monorail Bukit Bintang & Imbi Monorail',
            walkTime: 'Inside Sungei Wang Plaza (Level 4)',
            icon: 'fa-compact-disc',
            color: 'pink',
            badge: 'City Center Indoor Arena',
            venues: 'Mega Star Arena KL (Level 4 Sungei Wang)',
            coords: [3.1451, 101.7114],
            capacity: '5,000',
            tips: 'Located right in central Bukit Bintang; ample food options in Sungei Wang and Lot 10 before queuing.'
        },
        'KL Sentral & Brickfields': {
            transit: 'KL Sentral Hub (LRT / MRT / KTM / ERL Airport Express)',
            walkTime: '5-15 mins via connected transit skybridges',
            icon: 'fa-train-subway',
            color: 'blue',
            badge: 'Central Transit Interchange Hub',
            venues: 'Idea Convention Centre, Menara PGRM / Cheras link',
            coords: [3.1342, 101.6865],
            capacity: '3,000',
            tips: 'Ideal hub for interstate and overseas fans arriving from KLIA 1/2 via KLIA Ekspres.'
        },
        'Petaling Jaya & Sunway': {
            transit: 'BRT Sunway Line / LRT Kelana Jaya line (Taman Paramount / Asia Jaya)',
            walkTime: 'BRT direct to Sunway Pyramid; Feeder bus to JioSpace PJ',
            icon: 'fa-map-pin',
            color: 'amber',
            badge: 'Suburban Indie & Gathering Hub',
            venues: 'Sunway Pyramid Convention Centre, JioSpace PJ',
            coords: [3.0729, 101.6074],
            capacity: '4,000',
            tips: 'Great for cupsleeve cafe hops, fanclub exhibition gatherings, and medium-scale showcase tours.'
        },
        'Penang & Northern Region': {
            transit: 'Rapid Penang Bus / Penang Airport Link',
            walkTime: 'Direct access from Jalan Tun Dr Awang',
            icon: 'fa-water',
            color: 'cyan',
            badge: 'Northern Tour Stop',
            venues: 'Setia SPICE Arena, Gurney Paragon Mall',
            coords: [5.3283, 100.2825],
            capacity: '10,000',
            tips: 'Main concert hub for northern Malaysian fans with direct airport highway access.'
        }
    };

    // Serialize events with coordinates for 4D Map Radar
    const mappedEventsData = events.map(e => {
        let coords = [3.1408, 101.7088]; // default KL
        const vName = (e.venue_name || '').toLowerCase();
        const aName = (e.cluster_area || '');

        if (vName.includes('axiata') || vName.includes('bukit jalil')) coords = [3.0583, 101.6917];
        else if (vName.includes('zepp') || vName.includes('lalaport')) coords = [3.1408, 101.7088];
        else if (vName.includes('mega star') || vName.includes('sungei wang')) coords = [3.1451, 101.7114];
        else if (vName.includes('sunway') || vName.includes('jiospace') || vName.includes('petaling')) coords = [3.0729, 101.6074];
        else if (vName.includes('spice') || vName.includes('penang') || vName.includes('gurney')) coords = [5.3283, 100.2825];
        else if (vName.includes('austin') || vName.includes('johor')) coords = [1.5542, 103.7766];
        else if (PRECINCT_METADATA[aName]) coords = PRECINCT_METADATA[aName].coords;

        return {
            id: e.id,
            title: e.event_name,
            artist: e.artist_name || 'K-Pop Artist',
            venue: e.venue_name || e.venue_display || 'Malaysian Venue',
            date: e.event_date instanceof Date ? e.event_date.toISOString().split('T')[0] : String(e.event_date || ''),
            time: e.start_time || '8:00 PM',
            poster: e.poster_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800',
            area: e.cluster_area || 'Kuala Lumpur Metro Hub',
            ticketUrl: e.official_ticket_url || '',
            status: e.verification_status || 'VERIFIED',
            coords: coords
        };
    });
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Header Stage Header (Impeccable: No kickers, bold display voice) -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-200/80 pb-6">
        <div>
            <div class="flex items-center space-x-2.5 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-slate-900 text-white shadow-xs">
                    <span class="w-2 h-2 rounded-full bg-pink-500 animate-pulse"></span>
                    4D GEOSPATIAL INTELLIGENCE
                </span>
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200/80">
                    Live Telemetry
                </span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-[-0.035em] leading-tight">
                K-Pop Event Radar
            </h1>
            <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl font-medium leading-relaxed">
                Interactive geospatial mapping and 4D temporal transit analysis across Malaysian concert precincts. Explore venue corridors, crowd convergence warnings, and transit routing.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <span class="px-4 py-2.5 rounded-2xl text-xs font-black bg-slate-900 text-white shadow-sm flex items-center gap-2">
                <i class="fas fa-satellite-dish text-pink-400 animate-spin" style="animation-duration: 8s;"></i>
                <span><%= events.length %> Active Stage Nodes</span>
            </span>
        </div>
    </div>

    <!-- Triple View Mode Switcher -->
    <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-xs border border-slate-200 mb-8 space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <!-- View Selector Buttons -->
            <div class="inline-flex rounded-2xl bg-slate-100 p-1.5 border border-slate-200/80 shrink-0">
                <button type="button" id="tab-map-btn" onclick="switchRadarMode('map')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-earth-asia text-cyan-400"></i>
                    <span>4D Map Radar & Sweep</span>
                </button>
                <button type="button" id="tab-precinct-btn" onclick="switchRadarMode('precinct')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-landmark text-pink-500"></i>
                    <span>Precinct Corridors (<%= Object.keys(areaClusters).length %>)</span>
                </button>
                <button type="button" id="tab-weekend-btn" onclick="switchRadarMode('weekend')"
                        class="px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-calendar-week text-purple-500"></i>
                    <span>Weekend Cohorts (<%= weekendClusters.length %>)</span>
                </button>
            </div>

            <!-- Quick Telemetry Indicator -->
            <div class="flex items-center gap-3 text-xs text-slate-500 font-semibold">
                <span class="flex items-center gap-1.5 text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                    <i class="fas fa-train text-emerald-600"></i> LRT Sri Petaling & Monorail Linked
                </span>
                <span class="hidden sm:inline-block text-slate-400">·</span>
                <span class="hidden sm:inline-block">60fps Hardware Accelerated</span>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 1: 4D GEOSPATIAL MAP RADAR & TEMPORAL ANALYSIS ENGINE -->
    <!-- ========================================================================= -->
    <div id="view-map" class="space-y-6">
        <!-- 4D Control Deck (Time Scrubber + Temporal Controls) -->
        <div class="bg-slate-900 text-white rounded-3xl p-5 sm:p-6 shadow-xl border border-slate-800 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[10px] font-black bg-cyan-500 text-slate-950 uppercase tracking-widest">
                            Dimension 4: Time (t)
                        </span>
                        <span class="text-xs text-slate-400 font-mono">TEMPORAL SCRUBBER ACTIVE</span>
                    </div>
                    <h2 class="text-lg sm:text-xl font-black text-white tracking-tight flex items-center gap-2">
                        <i class="fas fa-clock-rotate-left text-pink-400"></i>
                        <span>Showtime Timeline Continuum</span>
                    </h2>
                </div>

                <!-- Play/Pause 4D Sweep Button -->
                <div class="flex items-center gap-2">
                    <button type="button" id="play-sweep-btn" onclick="toggleTemporalSweep()" 
                            class="px-4 py-2 rounded-xl text-xs font-black bg-pink-600 hover:bg-pink-500 text-white press-tactile shadow-xs flex items-center gap-2 cursor-pointer">
                        <i class="fas fa-play text-xs" id="play-icon"></i>
                        <span id="play-text">Play 4D Temporal Sweep</span>
                    </button>
                    <button type="button" onclick="resetTemporalFilter()" 
                            class="px-3 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 press-tactile border border-slate-700" title="Reset Timeline Filter">
                        <i class="fas fa-rotate-left"></i>
                    </button>
                </div>
            </div>

            <!-- 4D Interactive Timeline Slider -->
            <div class="space-y-3">
                <div class="flex items-center justify-between text-xs font-bold">
                    <span class="text-slate-400 flex items-center gap-1.5">
                        <i class="fas fa-calendar-day text-pink-400"></i> Filter Scope:
                        <span id="slider-label" class="text-white font-mono text-sm px-2 py-0.5 rounded bg-slate-800 border border-slate-700">All 2026/2027 Concert Season</span>
                    </span>
                    <span id="active-marker-count" class="text-emerald-400 font-mono text-xs">
                        <%= events.length %> Venues Illuminated
                    </span>
                </div>
                <input type="range" id="time-scrubber" min="0" max="4" step="1" value="4" 
                       oninput="handleTimeScrubberChange(this.value)"
                       class="w-full h-2.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-pink-500 focus:outline-none">
                <div class="flex justify-between text-[11px] text-slate-400 font-mono pt-1">
                    <span>Now / 48H</span>
                    <span>This Weekend</span>
                    <span>Next 30 Days</span>
                    <span>Next 90 Days</span>
                    <span class="text-pink-400 font-bold">Full Tour Season</span>
                </div>
            </div>
        </div>

        <!-- 4D Fandom Collision & Transit Congestion Matrix Alert -->
        <div class="bg-gradient-to-r from-amber-500/10 via-pink-500/10 to-purple-500/10 rounded-3xl p-5 border border-amber-300/40 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-2xl bg-amber-500 text-slate-950 flex items-center justify-center shrink-0 text-base font-black shadow-xs">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>
                <div>
                    <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                        <span>4D Fandom Collision & Transit Load Warning</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-200 text-amber-900 uppercase">Automated Alert</span>
                    </h3>
                    <p class="text-xs text-slate-600 mt-1 leading-relaxed font-medium">
                        High weekend density detected in <strong class="text-slate-900">Bukit Jalil Hub</strong> and <strong class="text-slate-900">BBCC / Zepp KL</strong>. Peak LRT Sri Petaling Line passenger volume estimated at <span class="font-mono font-bold text-pink-600">30,000+ Fans</span>. Pre-purchasing Touch 'n Go reload credits is strongly recommended.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <a href="#precinct-bukit-jalil-hub" onclick="switchRadarMode('precinct')" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 press-tactile shadow-xs flex items-center gap-1.5">
                    <i class="fas fa-train-subway text-emerald-600"></i>
                    <span>Inspect Transit Corridor</span>
                </a>
            </div>
        </div>

        <!-- Interactive Map Canvas Container -->
        <div class="relative bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-2xl" style="height: 580px;">
            <!-- Leaflet Map Mount Point -->
            <div id="radar-leaflet-map" class="w-full h-full z-10"></div>

            <!-- Radar Telemetry Scope HUD Overlay -->
            <div class="absolute top-4 left-4 z-20 pointer-events-none hidden sm:block">
                <div class="bg-slate-950/85 backdrop-blur-md rounded-2xl p-3 border border-slate-800/80 text-white font-mono text-[11px] space-y-1 shadow-lg">
                    <div class="text-pink-400 font-bold flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-pink-500 animate-ping"></span>
                        KLANG VALLEY RADAR BEACON
                    </div>
                    <div class="text-slate-400">LAT: 3.1390° N · LNG: 101.6869° E</div>
                    <div class="text-slate-400">RANGE: 75 KM METRO CORRIDOR</div>
                    <div class="text-emerald-400 font-bold">STATUS: SATELLITE SYNCED</div>
                </div>
            </div>

            <!-- Radar Control Overlay (Zoom Presets) -->
            <div class="absolute top-4 right-4 z-20 flex flex-col gap-2">
                <button type="button" onclick="focusRadarCoordinate(3.0583, 101.6917, 13)" 
                        class="px-3 py-1.5 rounded-xl bg-slate-900/90 backdrop-blur-md hover:bg-slate-800 text-white text-[11px] font-bold border border-slate-700 press-tactile shadow-md flex items-center gap-1.5 cursor-pointer">
                    <i class="fas fa-bullseye text-pink-400"></i>
                    <span>Bukit Jalil</span>
                </button>
                <button type="button" onclick="focusRadarCoordinate(3.1408, 101.7088, 14)" 
                        class="px-3 py-1.5 rounded-xl bg-slate-900/90 backdrop-blur-md hover:bg-slate-800 text-white text-[11px] font-bold border border-slate-700 press-tactile shadow-md flex items-center gap-1.5 cursor-pointer">
                    <i class="fas fa-bullseye text-purple-400"></i>
                    <span>BBCC / Zepp</span>
                </button>
                <button type="button" onclick="focusRadarCoordinate(5.3283, 100.2825, 12)" 
                        class="px-3 py-1.5 rounded-xl bg-slate-900/90 backdrop-blur-md hover:bg-slate-800 text-white text-[11px] font-bold border border-slate-700 press-tactile shadow-md flex items-center gap-1.5 cursor-pointer">
                    <i class="fas fa-bullseye text-cyan-400"></i>
                    <span>Penang SPICE</span>
                </button>
                <button type="button" onclick="resetRadarView()" 
                        class="px-3 py-1.5 rounded-xl bg-slate-900/90 backdrop-blur-md hover:bg-slate-800 text-white text-[11px] font-bold border border-slate-700 press-tactile shadow-md flex items-center gap-1.5 cursor-pointer">
                    <i class="fas fa-expand text-slate-400"></i>
                    <span>All Malaysia</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 2: GEOGRAPHIC PRECINCT CORRIDORS VIEW -->
    <!-- ========================================================================= -->
    <div id="view-precinct" class="space-y-10 hidden">
        <!-- Filter Pills by Cluster Area -->
        <div class="bg-white rounded-2xl p-3 border border-slate-200 shadow-xs flex items-center space-x-2 overflow-x-auto pb-1 scrollbar-none">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider shrink-0 me-1">Filter Corridor:</span>
            <a href="/events/radar" 
               class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all <%= !selectedArea ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
                All Precincts
            </a>
            <% allAreas.forEach(function(area) { %>
                <% const count = areaClusters[area] ? areaClusters[area].length : 0; %>
                <% const isSelected = selectedArea === area; %>
                <a href="/events/radar?area=<%= encodeURIComponent(area) %>" 
                   class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all flex items-center gap-1.5 <%= isSelected ? 'bg-pink-600 text-white shadow-xs' : 'bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
                    <span><%= area %></span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= isSelected ? 'bg-pink-800 text-white' : 'bg-slate-200 text-slate-700' %>"><%= count %></span>
                </a>
            <% }); %>
        </div>

        <% 
            const displayAreas = selectedArea ? [selectedArea] : allAreas;
        %>

        <% displayAreas.forEach(function(area) { %>
            <% 
                const clusterEvents = areaClusters[area] || []; 
                const meta = PRECINCT_METADATA[area] || {
                    transit: 'Public Transit & Ride-hailing available',
                    walkTime: 'Check local venue maps',
                    icon: 'fa-location-dot',
                    color: 'slate',
                    badge: 'Malaysian Venue Hub',
                    venues: area,
                    capacity: '3,000+',
                    tips: 'Plan your arrival 60-90 minutes before gate opening.'
                };
            %>
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden" id="precinct-<%= helpers.slugify(area) %>">
                <!-- Precinct Header Card -->
                <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-900 text-white p-6 sm:p-7 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-2">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-pink-500 text-white uppercase tracking-wider">
                                <%= meta.badge %>
                            </span>
                            <span class="text-xs text-slate-300 font-semibold flex items-center gap-1">
                                <i class="fas fa-train text-emerald-400"></i>
                                <%= meta.transit %>
                            </span>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white flex items-center gap-2.5">
                            <i class="fas <%= meta.icon %> text-pink-400"></i>
                            <span><%= area %></span>
                        </h2>
                        <p class="text-xs text-slate-300 flex items-center gap-1.5 pt-0.5">
                            <i class="fas fa-building text-slate-400"></i>
                            <span class="font-medium">Venues: <%= meta.venues %> (Capacity: <%= meta.capacity %>)</span>
                        </p>
                    </div>

                    <div class="bg-slate-800/80 rounded-2xl p-3.5 border border-slate-700/80 max-w-sm text-xs text-slate-300 shrink-0">
                        <div class="font-bold text-amber-400 flex items-center gap-1 mb-1">
                            <i class="fas fa-lightbulb"></i> Transit & Crowd Navigation Tip
                        </div>
                        <p class="text-[11px] leading-relaxed text-slate-300"><%= meta.tips %></p>
                    </div>
                </div>

                <!-- Events in this Precinct -->
                <div class="p-6">
                    <% if (clusterEvents.length === 0) { %>
                        <div class="text-center py-8 text-xs text-slate-400">
                            No active events currently listed in this precinct corridor.
                        </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% clusterEvents.forEach(function(event) { %>
                                <% const calcStatus = helpers.getCalculatedEventStatus(event); %>
                                <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                                <div class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden flex flex-col hover-lift transition-all group">
                                    <div class="relative h-44 overflow-hidden bg-slate-900">
                                        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                                        
                                        <div class="absolute top-3 left-3 z-10">
                                            <%- helpers.getStatusBadge(calcStatus) %>
                                        </div>

                                        <div class="absolute bottom-3 left-3 right-3 z-10 flex items-center justify-between text-white text-xs font-bold">
                                            <span><i class="fas fa-calendar-day me-1 text-pink-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                                            <% if (event.start_time) { %>
                                                <span><i class="fas fa-clock me-1 text-purple-400"></i> <%= helpers.formatTime(event.start_time) %></span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="p-4 flex-grow flex flex-col justify-between space-y-3">
                                        <div>
                                            <div class="text-[11px] font-bold text-pink-600 mb-1 flex items-center gap-1">
                                                <i class="fas fa-microphone"></i>
                                                <span><%= event.artist_name || 'K-Pop Artist' %></span>
                                            </div>
                                            <h3 class="text-sm font-bold text-slate-900 line-clamp-1 group-hover:text-pink-600 transition-colors">
                                                <%= event.event_name %>
                                            </h3>
                                            <p class="text-xs text-slate-500 mt-1 flex items-center gap-1">
                                                <i class="fas fa-map-marker-alt text-slate-400"></i>
                                                <span class="truncate"><%= event.venue_display || event.venue_name %></span>
                                            </p>
                                        </div>

                                        <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between">
                                            <a href="/events/<%= eventSlug %>" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white press-tactile shadow-xs flex items-center gap-1">
                                                <span>View Dossier</span>
                                                <i class="fas fa-arrow-right text-[10px]"></i>
                                            </a>
                                            <% if (event.official_ticket_url) { %>
                                                <a href="<%= event.official_ticket_url %>" target="_blank" rel="noopener noreferrer" 
                                                   class="text-xs font-bold text-pink-600 hover:text-pink-700 flex items-center gap-1">
                                                    <span>Tickets</span>
                                                    <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 3: SAME-WEEKEND TIMELINE COHORTS VIEW -->
    <!-- ========================================================================= -->
    <div id="view-weekend" class="space-y-8 hidden">
        <% if (weekendClusters.length === 0) { %>
            <div class="bg-white rounded-3xl p-10 text-center border border-slate-200">
                <i class="fas fa-calendar-xmark text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-base font-bold text-slate-800">No Upcoming Weekend Clusters</h3>
                <p class="text-xs text-slate-500 mt-1">Check the list directory for individual weekday events.</p>
            </div>
        <% } else { %>
            <% weekendClusters.forEach(function(cluster) { %>
                <div class="bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden">
                    <div class="bg-gradient-to-r from-purple-950 via-slate-900 to-slate-900 text-white p-5 sm:p-6 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-purple-500 text-white flex items-center justify-center font-bold text-base shadow-xs">
                                <i class="fas fa-calendar-week"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-white tracking-tight"><%= cluster.label %></h3>
                                <p class="text-xs text-purple-300 font-medium">
                                    <%= cluster.events.length %> Shows occurring on the same weekend
                                </p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-black bg-purple-500 text-white">
                            Weekend Cohort
                        </span>
                    </div>

                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% cluster.events.forEach(function(event) { %>
                            <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                            <div class="bg-slate-50 rounded-2xl border border-slate-200 p-4 flex flex-col justify-between hover-lift transition-all">
                                <div>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-pink-100 text-pink-700">
                                        <%= event.cluster_area || 'KL Metro' %>
                                    </span>
                                    <h4 class="text-sm font-bold text-slate-900 mt-2 line-clamp-1"><%= event.event_name %></h4>
                                    <p class="text-xs text-slate-500 mt-0.5"><%= event.artist_name %> · <%= event.venue_display || event.venue_name %></p>
                                    <div class="text-xs font-mono font-bold text-slate-700 mt-2">
                                        <i class="fas fa-calendar-day text-pink-500 me-1"></i> <%= helpers.formatDate(event.event_date) %>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between">
                                    <a href="/events/<%= eventSlug %>" class="text-xs font-bold text-slate-900 hover:text-pink-600 flex items-center gap-1">
                                        <span>Details</span>
                                        <i class="fas fa-arrow-right text-[10px]"></i>
                                    </a>
                                    <% if (event.official_ticket_url) { %>
                                        <a href="<%= event.official_ticket_url %>" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-pink-600">
                                            Tickets <i class="fas fa-arrow-up-right-from-square text-[9px]"></i>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<!-- Raw Injected Event Data for 4D Map Engine -->
<script id="radar-events-json" type="application/json">
    <%- JSON.stringify(mappedEventsData) %>
</script>

<!-- 4D Geospatial Radar Engine Logic -->
<script>
    let map = null;
    let markersLayer = null;
    let rawEvents = [];
    let sweepInterval = null;
    let isSweeping = false;

    document.addEventListener('DOMContentLoaded', () => {
        try {
            const rawDataEl = document.getElementById('radar-events-json');
            if (rawDataEl) {
                rawEvents = JSON.parse(rawDataEl.textContent || '[]');
            }
        } catch (e) {
            console.error('Failed to parse radar events:', e);
        }

        initLeafletMap();
    });

    function initLeafletMap() {
        const mapContainer = document.getElementById('radar-leaflet-map');
        if (!mapContainer || map) return;

        // Initialize Leaflet Map centered on Klang Valley
        map = L.map('radar-leaflet-map', {
            center: [3.1390, 101.6869],
            zoom: 11,
            zoomControl: false,
            attributionControl: false
        });

        // Add sleek CartoDB Dark Matter tile layer
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            subdomains: 'abcd'
        }).addTo(map);

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        markersLayer = L.layerGroup().addTo(map);

        // Plot initial events
        renderEventMarkers(rawEvents);
    }

    function renderEventMarkers(eventsList) {
        if (!markersLayer) return;
        markersLayer.clearLayers();

        const countEl = document.getElementById('active-marker-count');
        if (countEl) countEl.textContent = `${eventsList.length} Venues Illuminated`;

        eventsList.forEach(e => {
            const [lat, lng] = e.coords;

            // Custom Glowing HTML Icon
            const customIcon = L.divIcon({
                className: 'custom-radar-pin',
                html: `
                    <div class="relative cursor-pointer group" style="transform: translate(-50%, -50%);">
                        <div class="w-8 h-8 rounded-2xl bg-slate-900 border-2 border-pink-500 shadow-stage-glow flex items-center justify-center text-white text-xs font-bold transition-transform group-hover:scale-125">
                            <i class="fas fa-bolt text-pink-400 text-[11px]"></i>
                        </div>
                        <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-pink-500 rounded-full animate-ping"></div>
                    </div>
                `,
                iconSize: [32, 32],
                iconAnchor: [16, 16]
            });

            const marker = L.marker([lat, lng], { icon: customIcon }).addTo(markersLayer);

            // Popover Card (Origin-Aware styling)
            const popupHtml = `
                <div class="p-4 space-y-3 bg-slate-950 text-white min-w-[240px] max-w-[280px]">
                    <div class="flex items-center justify-between gap-2 border-b border-slate-800 pb-2">
                        <span class="px-2 py-0.5 rounded text-[10px] font-black bg-pink-600 text-white uppercase">${e.area}</span>
                        <span class="text-[10px] font-mono text-slate-400">${e.date}</span>
                    </div>
                    <div>
                        <div class="text-[11px] font-bold text-pink-400">${e.artist}</div>
                        <div class="text-sm font-black text-white leading-tight mt-0.5">${e.title}</div>
                        <div class="text-xs text-slate-300 mt-1 flex items-center gap-1">
                            <i class="fas fa-map-pin text-slate-400"></i> ${e.venue}
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
                        <a href="/events/${e.id}" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-slate-950 hover:bg-slate-200 transition-colors">
                            View Details
                        </a>
                        ${e.ticketUrl ? `
                            <a href="${e.ticketUrl}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-pink-400 hover:text-pink-300">
                                Tickets <i class="fas fa-external-link text-[10px]"></i>
                            </a>
                        ` : ''}
                    </div>
                </div>
            `;

            marker.bindPopup(popupHtml);
        });
    }

    // 4D Temporal Scrubber Logic
    function handleTimeScrubberChange(val) {
        const sliderLabel = document.getElementById('slider-label');
        const now = new Date();
        const valueNum = Number(val);

        let filtered = rawEvents;

        if (valueNum === 0) {
            sliderLabel.textContent = "Now / Next 48 Hours";
            const threshold = new Date(now.getTime() + 48 * 3600 * 1000);
            filtered = rawEvents.filter(e => new Date(e.date) <= threshold);
        } else if (valueNum === 1) {
            sliderLabel.textContent = "This Weekend Cohort";
            const threshold = new Date(now.getTime() + 7 * 24 * 3600 * 1000);
            filtered = rawEvents.filter(e => new Date(e.date) <= threshold);
        } else if (valueNum === 2) {
            sliderLabel.textContent = "Next 30 Days Scope";
            const threshold = new Date(now.getTime() + 30 * 24 * 3600 * 1000);
            filtered = rawEvents.filter(e => new Date(e.date) <= threshold);
        } else if (valueNum === 3) {
            sliderLabel.textContent = "Next 90 Days Scope";
            const threshold = new Date(now.getTime() + 90 * 24 * 3600 * 1000);
            filtered = rawEvents.filter(e => new Date(e.date) <= threshold);
        } else {
            sliderLabel.textContent = "All 2026/2027 Concert Season";
            filtered = rawEvents;
        }

        renderEventMarkers(filtered);
    }

    // 4D Temporal Sweep Simulation
    function toggleTemporalSweep() {
        const btn = document.getElementById('play-sweep-btn');
        const icon = document.getElementById('play-icon');
        const text = document.getElementById('play-text');
        const slider = document.getElementById('time-scrubber');

        if (isSweeping) {
            clearInterval(sweepInterval);
            isSweeping = false;
            icon.className = 'fas fa-play text-xs';
            text.textContent = 'Play 4D Temporal Sweep';
        } else {
            isSweeping = true;
            icon.className = 'fas fa-pause text-xs';
            text.textContent = 'Pause Temporal Sweep';

            let cur = 0;
            slider.value = cur;
            handleTimeScrubberChange(cur);

            sweepInterval = setInterval(() => {
                cur++;
                if (cur > 4) cur = 0;
                slider.value = cur;
                handleTimeScrubberChange(cur);
            }, 1800);
        }
    }

    function resetTemporalFilter() {
        if (isSweeping) toggleTemporalSweep();
        const slider = document.getElementById('time-scrubber');
        slider.value = 4;
        handleTimeScrubberChange(4);
    }

    function focusRadarCoordinate(lat, lng, zoom) {
        if (map) {
            map.flyTo([lat, lng], zoom, { duration: 1.2, easeLinearity: 0.25 });
        }
    }

    function resetRadarView() {
        if (map) {
            map.flyTo([3.1390, 101.6869], 10, { duration: 1.2 });
        }
    }

    // Mode Switcher between Map, Precincts, and Weekend tabs
    function switchRadarMode(mode) {
        const viewMap = document.getElementById('view-map');
        const viewPrecinct = document.getElementById('view-precinct');
        const viewWeekend = document.getElementById('view-weekend');

        const btnMap = document.getElementById('tab-map-btn');
        const btnPrecinct = document.getElementById('tab-precinct-btn');
        const btnWeekend = document.getElementById('tab-weekend-btn');

        // Hide all
        viewMap.classList.add('hidden');
        viewPrecinct.classList.add('hidden');
        viewWeekend.classList.add('hidden');

        btnMap.className = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer';
        btnPrecinct.className = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer';
        btnWeekend.className = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer';

        if (mode === 'map') {
            viewMap.classList.remove('hidden');
            btnMap.className = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer';
            if (map) map.invalidateSize();
        } else if (mode === 'precinct') {
            viewPrecinct.classList.remove('hidden');
            btnPrecinct.className = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer';
        } else if (mode === 'weekend') {
            viewWeekend.classList.remove('hidden');
            btnWeekend.className = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer';
        }
    }
</script>

