<!-- Raw Injected Event Data for Sonar Engine -->
<script id="sonar-events-json" type="application/json">
    <%- JSON.stringify(mappedEventsData) %>
</script>

<!-- ========================================================================= -->
<!-- 360° ACOUSTIC CONCERT SONAR ENGINE CLIENT SCRIPT                          -->
<!-- ========================================================================= -->
<script>
    let rawEvents = [];
    let currentFilteredEvents = [];
    let selectedEventId = null;
    let sweepAngle = 0; // In radians
    let sweepSpeedMultiplier = 1; // 1 = 1x, 2 = 2x, 0 = freeze
    let audioPingEnabled = false;
    let audioCtx = null;
    let hoveredEvent = null;

    document.addEventListener('DOMContentLoaded', () => {
        try {
            const rawDataEl = document.getElementById('sonar-events-json');
            if (rawDataEl) {
                rawEvents = JSON.parse(rawDataEl.textContent || '[]');
                currentFilteredEvents = rawEvents;
            }
        } catch (e) {
            console.error('Failed to parse sonar events:', e);
        }

        // Initialize Sonar Canvas Engine
        initSonarCanvas();

        // Lock onto first event by default
        if (rawEvents.length > 0) {
            selectEvent(rawEvents[0].id);
        }
    });

    // Web Audio Synthesizer for Sonar Ping
    function playAcousticPing(freq = 880) {
        if (!audioPingEnabled) return;
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(freq * 0.5, audioCtx.currentTime + 0.18);

            gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.22);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            osc.stop(audioCtx.currentTime + 0.25);
        } catch (err) {
            // Audio not allowed or error
        }
    }

    function toggleAudioPing() {
        audioPingEnabled = !audioPingEnabled;
        const icon = document.getElementById('audio-icon');
        const label = document.getElementById('audio-label');
        if (audioPingEnabled) {
            icon.className = 'fas fa-volume-high text-pink-400';
            label.textContent = 'Audio Active';
            playAcousticPing(920);
        } else {
            icon.className = 'fas fa-volume-xmark text-slate-400';
            label.textContent = 'Muted';
        }
    }

    function setSweepSpeed(multiplier) {
        sweepSpeedMultiplier = multiplier;
        const b1 = document.getElementById('btn-speed-1');
        const b2 = document.getElementById('btn-speed-2');
        const b0 = document.getElementById('btn-speed-0');
        
        [b1, b2, b0].forEach(b => b.className = 'px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer');
        if (multiplier === 1) b1.className = 'px-2.5 py-1 rounded-lg bg-pink-600 text-white font-bold cursor-pointer';
        else if (multiplier === 2) b2.className = 'px-2.5 py-1 rounded-lg bg-pink-600 text-white font-bold cursor-pointer';
        else b0.className = 'px-2.5 py-1 rounded-lg bg-slate-700 text-white font-bold cursor-pointer';
    }

    // -------------------------------------------------------------------------
    // Sonar Canvas Renderer
    // -------------------------------------------------------------------------
    function initSonarCanvas() {
        const canvas = document.getElementById('sonar-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        function resize() {
            const rect = canvas.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);
        }
        window.addEventListener('resize', resize);
        resize();

        // Mouse move and click handling
        canvas.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            const mouseX = e.clientX - rect.left;
            const mouseY = e.clientY - rect.top;
            const center = rect.width / 2;
            const R = center - 24;

            hoveredEvent = null;
            currentFilteredEvents.forEach(ev => {
                const pt = getEventPoint(ev, center, R);
                const dx = mouseX - pt.x;
                const dy = mouseY - pt.y;
                if (Math.hypot(dx, dy) < 16) {
                    hoveredEvent = ev;
                }
            });
            canvas.style.cursor = hoveredEvent ? 'pointer' : 'crosshair';
        });

        canvas.addEventListener('click', (e) => {
            if (hoveredEvent) {
                selectEvent(hoveredEvent.id);
                playAcousticPing(1040);
            }
        });

        // Main Animation Loop
        let lastTime = performance.now();
        function draw(time) {
            const dt = (time - lastTime) / 1000;
            lastTime = time;

            if (sweepSpeedMultiplier > 0) {
                sweepAngle += (0.8 * sweepSpeedMultiplier) * dt;
                if (sweepAngle > Math.PI * 2) sweepAngle -= Math.PI * 2;
            }

            const rect = canvas.getBoundingClientRect();
            const width = rect.width;
            const height = rect.height;
            const center = width / 2;
            const R = center - 24;

            ctx.clearRect(0, 0, width, height);

            // 1. Draw Outer Bezel
            ctx.beginPath();
            ctx.arc(center, center, R, 0, Math.PI * 2);
            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 2;
            ctx.stroke();

            // 2. Draw Degree Markings
            for (let deg = 0; deg < 360; deg += 30) {
                const rad = (deg * Math.PI) / 180;
                const isMajor = deg % 90 === 0;
                const tickLen = isMajor ? 10 : 5;
                const x1 = center + (R - tickLen) * Math.cos(rad);
                const y1 = center + (R - tickLen) * Math.sin(rad);
                const x2 = center + R * Math.cos(rad);
                const y2 = center + R * Math.sin(rad);

                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.strokeStyle = isMajor ? '#ec4899' : '#475569';
                ctx.lineWidth = isMajor ? 2 : 1;
                ctx.stroke();
            }

            // 3. Draw Concentric Range Rings (Temporal Scope)
            const ringRatios = [0.25, 0.50, 0.75, 1.0];
            const ringLabels = ['< 7D', '< 30D', '< 90D', 'SEASON'];
            ringRatios.forEach((ratio, idx) => {
                const r = R * ratio;
                ctx.beginPath();
                ctx.arc(center, center, r, 0, Math.PI * 2);
                ctx.strokeStyle = idx === 0 ? 'rgba(236,72,153,0.35)' : 'rgba(51,65,85,0.45)';
                ctx.setLineDash([4, 4]);
                ctx.lineWidth = 1;
                ctx.stroke();
                ctx.setLineDash([]);

                // Ring Label
                ctx.fillStyle = '#64748b';
                ctx.font = '10px ui-monospace, monospace';
                ctx.fillText(ringLabels[idx], center + 4, center - r + 12);
            });

            // 4. Draw Azimuth Crosshairs
            ctx.beginPath();
            ctx.moveTo(center - R, center);
            ctx.lineTo(center + R, center);
            ctx.moveTo(center, center - R);
            ctx.lineTo(center, center + R);
            ctx.strokeStyle = 'rgba(71,85,105,0.35)';
            ctx.lineWidth = 1;
            ctx.stroke();

            // 5. Draw 360° Rotating Sweep Beam with Gradient Tail
            const sweepGradient = ctx.createConicGradient(sweepAngle, center, center);
            sweepGradient.addColorStop(0, 'rgba(236, 72, 153, 0.45)');
            sweepGradient.addColorStop(0.12, 'rgba(236, 72, 153, 0.08)');
            sweepGradient.addColorStop(0.25, 'rgba(236, 72, 153, 0.0)');
            sweepGradient.addColorStop(1, 'rgba(236, 72, 153, 0.0)');

            ctx.beginPath();
            ctx.arc(center, center, R, 0, Math.PI * 2);
            ctx.fillStyle = sweepGradient;
            ctx.fill();

            // Sweep Leading Line
            ctx.beginPath();
            ctx.moveTo(center, center);
            ctx.lineTo(center + R * Math.cos(sweepAngle), center + R * Math.sin(sweepAngle));
            ctx.strokeStyle = '#f472b6';
            ctx.lineWidth = 2;
            ctx.shadowColor = '#ec4899';
            ctx.shadowBlur = 8;
            ctx.stroke();
            ctx.shadowBlur = 0; // Reset

            // Center Ground Zero Beacon
            ctx.beginPath();
            ctx.arc(center, center, 4, 0, Math.PI * 2);
            ctx.fillStyle = '#f43f5e';
            ctx.fill();

            // 6. Draw Event Blip Echoes
            currentFilteredEvents.forEach(ev => {
                const pt = getEventPoint(ev, center, R);
                const isSelected = ev.id === selectedEventId;
                const isHovered = hoveredEvent && ev.id === hoveredEvent.id;
                const primaryColor = ev.fandom.primary || '#ec4899';

                // Distance angle from sweep line
                const ptAngle = Math.atan2(pt.y - center, pt.x - center);
                let diffAngle = sweepAngle - ptAngle;
                while (diffAngle < 0) diffAngle += Math.PI * 2;
                while (diffAngle > Math.PI * 2) diffAngle -= Math.PI * 2;

                const isJustSwept = diffAngle < 0.25;

                // Ping Ripple effect if just swept
                if (isJustSwept) {
                    ctx.beginPath();
                    ctx.arc(pt.x, pt.y, 14, 0, Math.PI * 2);
                    ctx.strokeStyle = primaryColor;
                    ctx.lineWidth = 1;
                    ctx.stroke();
                }

                // Selected Reticle Brackets [ + ]
                if (isSelected || isHovered) {
                    const reticleSize = 16;
                    ctx.strokeStyle = isSelected ? '#38bdf8' : '#f472b6';
                    ctx.lineWidth = 1.8;

                    // Corner brackets
                    ctx.beginPath();
                    ctx.moveTo(pt.x - reticleSize, pt.y - 6);
                    ctx.lineTo(pt.x - reticleSize, pt.y - reticleSize);
                    ctx.lineTo(pt.x - 6, pt.y - reticleSize);

                    ctx.moveTo(pt.x + 6, pt.y - reticleSize);
                    ctx.lineTo(pt.x + reticleSize, pt.y - reticleSize);
                    ctx.lineTo(pt.x + reticleSize, pt.y - 6);

                    ctx.moveTo(pt.x + reticleSize, pt.y + 6);
                    ctx.lineTo(pt.x + reticleSize, pt.y + reticleSize);
                    ctx.lineTo(pt.x + 6, pt.y + reticleSize);

                    ctx.moveTo(pt.x - 6, pt.y + reticleSize);
                    ctx.lineTo(pt.x - reticleSize, pt.y + reticleSize);
                    ctx.lineTo(pt.x - reticleSize, pt.y + 6);
                    ctx.stroke();
                }

                // Core Beacon Dot
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, isSelected ? 6 : 4.5, 0, Math.PI * 2);
                ctx.fillStyle = primaryColor;
                ctx.shadowColor = primaryColor;
                ctx.shadowBlur = 10;
                ctx.fill();
                ctx.shadowBlur = 0;

                // Artist Label Callout
                ctx.fillStyle = isSelected ? '#ffffff' : '#cbd5e1';
                ctx.font = isSelected ? 'bold 11px ui-sans-serif, sans-serif' : '10px ui-sans-serif, sans-serif';
                ctx.fillText(ev.artist, pt.x + 10, pt.y + 3);
            });

            requestAnimationFrame(draw);
        }

        requestAnimationFrame(draw);
    }

    // Mathematical coordinate projection: Days Away -> Radius, Category -> Quadrant Angle
    function getEventPoint(ev, center, R) {
        // Distance mapping (closer = sooner!)
        const days = ev.daysAway;
        let normR = 0.85;
        if (days <= 7) normR = 0.15 + (days / 7) * 0.15; // 0.15 to 0.30
        else if (days <= 30) normR = 0.30 + ((days - 7) / 23) * 0.25; // 0.30 to 0.55
        else if (days <= 90) normR = 0.55 + ((days - 30) / 60) * 0.25; // 0.55 to 0.80
        else normR = 0.80 + Math.min(0.18, ((days - 90) / 180) * 0.18); // 0.80 to 0.98

        // Azimuth Angle by Quadrant
        // NW: Boy Groups (180° to 270°)
        // NE: Girl Groups (270° to 360°)
        // SE: Soloists (0° to 90°)
        // SW: Bands & Fests (90° to 180°)
        let baseAngle = 225; // default NW
        const q = ev.fandom.quadrant;
        if (q === 'bg') baseAngle = 225;
        else if (q === 'gg') baseAngle = 315;
        else if (q === 'solo') baseAngle = 45;
        else if (q === 'band') baseAngle = 135;

        // Spread events in same quadrant based on ID hash
        const angleSpread = ((ev.id * 37) % 50) - 25;
        const finalAngleRad = ((baseAngle + angleSpread) * Math.PI) / 180;

        const x = center + (R * normR) * Math.cos(finalAngleRad);
        const y = center + (R * normR) * Math.sin(finalAngleRad);

        return { x, y };
    }

    // -------------------------------------------------------------------------
    // Target Lock HUD Controller
    // -------------------------------------------------------------------------
    function selectEvent(eventId) {
        selectedEventId = eventId;
        const ev = rawEvents.find(e => e.id === eventId);
        if (!ev) return;

        // Update HUD card elements
        document.getElementById('hud-status').textContent = `TARGET LOCKED · #${String(ev.id).padStart(2, '0')}`;
        document.getElementById('hud-dday').textContent = ev.daysAway === 0 ? 'D-DAY TODAY' : `D-${ev.daysAway} DAYS`;
        document.getElementById('hud-poster').src = ev.poster;
        document.getElementById('hud-poster').onerror = function() {
            this.src = 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800';
        };
        document.getElementById('hud-artist').textContent = ev.artist;
        document.getElementById('hud-title').textContent = ev.title;
        document.getElementById('hud-venue').innerHTML = `<i class="fas fa-location-dot text-pink-400 me-1"></i> ${ev.venue} (${ev.area})`;
        document.getElementById('hud-date').textContent = `${ev.date} · ${ev.time}`;

        // Lightstick
        document.getElementById('hud-lightstick-swatch').style.background = ev.fandom.primary;
        document.getElementById('hud-lightstick-swatch').style.boxShadow = `0 0 10px ${ev.fandom.primary}`;
        document.getElementById('hud-lightstick-name').textContent = ev.fandom.name;

        // Transit advice
        const precinctMeta = {
            'Bukit Jalil': 'LRT Sri Petaling Line (Bukit Jalil PH5). 5-min covered walkway directly into Axiata Arena.',
            'BBCC': 'Direct undercover connection from Hang Tuah station (LRT/Monorail) via LaLaport into Zepp KL floor.',
            'Mega Star': 'Inside Sungei Wang Plaza Level 4. Direct walkway from MRT Bukit Bintang.',
            'Sunway': 'BRT Sunway Line direct to Sunway Pyramid & Surf Beach.',
            'Penang': 'Setia SPICE Arena. Direct Rapid Penang bus & Bayan Lepas highway access.'
        };
        let tip = 'Public transit or ride-hailing dropoff available at main gate.';
        for (const [key, t] of Object.entries(precinctMeta)) {
            if ((ev.venue + ' ' + ev.area).includes(key)) {
                tip = t;
                break;
            }
        }
        document.getElementById('hud-transit-tip').textContent = tip;

        // Action links
        document.getElementById('hud-link-dossier').href = `/events/${ev.slug}`;
        const ticketBtn = document.getElementById('hud-link-ticket');
        if (ev.ticketUrl) {
            ticketBtn.href = ev.ticketUrl;
            ticketBtn.style.display = 'inline-flex';
        } else {
            ticketBtn.style.display = 'none';
        }
    }

    // -------------------------------------------------------------------------
    // Temporal Continuum Filter Scrubber
    // -------------------------------------------------------------------------
    function handleTimeScrubberChange(value) {
        const val = Number(value);
        const sliderLabel = document.getElementById('slider-label');
        const countBadge = document.getElementById('active-marker-count');

        let filtered = rawEvents;
        if (val === 0) {
            sliderLabel.textContent = "Now / Next 48 Hours Scope";
            filtered = rawEvents.filter(e => e.daysAway <= 2);
        } else if (val === 1) {
            sliderLabel.textContent = "This Weekend Scope (< 7 Days)";
            filtered = rawEvents.filter(e => e.daysAway <= 7);
        } else if (val === 2) {
            sliderLabel.textContent = "Next 30 Days Scope";
            filtered = rawEvents.filter(e => e.daysAway <= 30);
        } else if (val === 3) {
            sliderLabel.textContent = "Next 90 Days Scope";
            filtered = rawEvents.filter(e => e.daysAway <= 90);
        } else {
            sliderLabel.textContent = "All 2026/2027 Concert Season";
            filtered = rawEvents;
        }

        currentFilteredEvents = filtered;
        countBadge.textContent = `${filtered.length} Echoes Detected`;

        if (filtered.length > 0 && !filtered.some(e => e.id === selectedEventId)) {
            selectEvent(filtered[0].id);
        }
    }

    // -------------------------------------------------------------------------
    // Radar Mode Navigation Switcher
    // -------------------------------------------------------------------------
    function switchRadarMode(mode) {
        const vSonar = document.getElementById('view-sonar');
        const vTransit = document.getElementById('view-transit');
        const vWeekend = document.getElementById('view-weekend');
        const vPrecinct = document.getElementById('view-precinct');

        const bSonar = document.getElementById('tab-sonar-btn');
        const bTransit = document.getElementById('tab-transit-btn');
        const bWeekend = document.getElementById('tab-weekend-btn');
        const bPrecinct = document.getElementById('tab-precinct-btn');

        // Hide all views
        [vSonar, vTransit, vWeekend, vPrecinct].forEach(v => v.classList.add('hidden'));

        // Reset button states
        const inactive = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer';
        const active = 'px-4 sm:px-5 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer';

        [bSonar, bTransit, bWeekend, bPrecinct].forEach(b => b.className = inactive);

        if (mode === 'sonar') {
            vSonar.classList.remove('hidden');
            bSonar.className = active;
        } else if (mode === 'transit') {
            vTransit.classList.remove('hidden');
            bTransit.className = active;
        } else if (mode === 'weekend') {
            vWeekend.classList.remove('hidden');
            bWeekend.className = active;
        } else if (mode === 'precinct') {
            vPrecinct.classList.remove('hidden');
            bPrecinct.className = active;
        }
    }
</script>

