<%- include('partials/header', { title: 'Event Radar & Area Clusters | K-Sync Malaysia' }) %>

<%
    const PRECINCT_METADATA = {
        'Bukit Jalil Hub': {
            transit: 'LRT Sri Petaling Line (Bukit Jalil Station - PH5)',
            walkTime: '5-10 mins covered pedestrian walkway',
            icon: 'fa-landmark',
            color: 'emerald',
            badge: 'Mega Stadium Precinct',
            venues: 'Axiata Arena, Bukit Jalil National Stadium',
            tips: 'Park-and-ride at LRT stations (Awan Besar / Sri Petaling) is highly recommended on massive concert nights.'
        },
        'BBCC & Downtown KL': {
            transit: 'Hang Tuah Station (LRT Ampang Line / KL Monorail) & Merdeka MRT',
            walkTime: 'Direct connection via Mitsui Shopping Park LaLaport BBCC',
            icon: 'fa-building-columns',
            color: 'purple',
            badge: 'Zepp KL & Lifestyle Precinct',
            venues: 'Zepp Kuala Lumpur, LaLaport BBCC Rooftop & Central Rooftop Garden',
            tips: 'Direct undercover transit link from Hang Tuah station directly into Zepp KL floor level.'
        },
        'Mega Star Arena & Bukit Bintang': {
            transit: 'MRT / Monorail Bukit Bintang & Imbi Monorail',
            walkTime: 'Inside Sungei Wang Plaza (Level 4)',
            icon: 'fa-compact-disc',
            color: 'pink',
            badge: 'City Center Indoor Arena',
            venues: 'Mega Star Arena KL (Level 4 Sungei Wang)',
            tips: 'Located right in central Bukit Bintang; ample food options in Sungei Wang and Lot 10 before queuing.'
        },
        'KL Sentral & Brickfields': {
            transit: 'KL Sentral Hub (LRT / MRT / KTM / ERL Airport Express)',
            walkTime: '5-15 mins via connected transit skybridges',
            icon: 'fa-train-subway',
            color: 'blue',
            badge: 'Central Transit Interchange Hub',
            venues: 'Idea Convention Centre, Menara PGRM / Cheras link',
            tips: 'Ideal hub for interstate and overseas fans arriving from KLIA 1/2 via KLIA Ekspres.'
        },
        'Petaling Jaya & Sunway': {
            transit: 'BRT Sunway Line / LRT Kelana Jaya line (Taman Paramount / Asia Jaya)',
            walkTime: 'BRT direct to Sunway Pyramid; Feeder bus to JioSpace PJ',
            icon: 'fa-map-pin',
            color: 'amber',
            badge: 'Suburban Indie & Gathering Hub',
            venues: 'Sunway Pyramid Convention Centre, JioSpace PJ',
            tips: 'Great for cupsleeve cafe hops, fanclub exhibition gatherings, and medium-scale showcase tours.'
        }
    };
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Banner -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200/80 pb-6">
        <div>
            <div class="flex items-center space-x-2 mb-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-xs">
                    <i class="fas fa-radar me-1 text-yellow-300 animate-pulse"></i> UC005: Event Radar & Area Clustering
                </span>
            </div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                K-Pop Event Radar
            </h1>
            <p class="text-slate-600 text-sm mt-1 font-medium">
                Geographic venue precincts & same-weekend concert clusters in Malaysia. Coordinate trips, cafe hops, and transit connections with ease.
            </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <a href="/events" class="px-4 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all shadow-xs flex items-center gap-1.5">
                <i class="fas fa-list text-slate-400"></i>
                <span>List Directory</span>
            </a>
            <span class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 text-white shadow-sm flex items-center">
                <i class="fas fa-bullseye me-2 text-pink-400"></i> <%= events.length %> Clustered Shows
            </span>
        </div>
    </div>

    <!-- Mode Selector & Area Filter Bar -->
    <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200 mb-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <!-- View Mode Switch -->
            <div class="inline-flex rounded-2xl bg-slate-100 p-1 border border-slate-200 shrink-0">
                <button type="button" id="tab-precinct-btn" onclick="switchRadarTab('precinct')"
                        class="px-5 py-2 rounded-xl text-xs font-extrabold transition-all shadow-xs bg-white text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-map-location-dot text-pink-500"></i>
                    <span>Geographic Precincts (<%= Object.keys(areaClusters).length %>)</span>
                </button>
                <button type="button" id="tab-weekend-btn" onclick="switchRadarTab('weekend')"
                        class="px-5 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-calendar-week text-purple-500"></i>
                    <span>Same-Weekend Timeline (<%= weekendClusters.length %>)</span>
                </button>
            </div>

            <!-- Quick Tip -->
            <div class="text-xs text-slate-500 flex items-center gap-2 font-medium">
                <i class="fas fa-circle-info text-pink-500"></i>
                <span>Events are automatically grouped by LRT/MRT venue proximity and weekend schedules.</span>
            </div>
        </div>

        <!-- Filter Pills by Cluster Area -->
        <div class="flex items-center space-x-2 overflow-x-auto pb-1 scrollbar-none">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider shrink-0 me-1">Jump to Precinct:</span>
            <a href="/events/radar" 
               class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all <%= !selectedArea ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
                All Precincts
            </a>
            <% allAreas.forEach(function(area) { %>
                <% const count = areaClusters[area] ? areaClusters[area].length : 0; %>
                <% const isSelected = selectedArea === area; %>
                <a href="/events/radar?area=<%= encodeURIComponent(area) %>" 
                   class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all flex items-center gap-1.5 <%= isSelected ? 'bg-pink-600 text-white shadow-xs' : 'bg-slate-50 border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
                    <span><%= area %></span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= isSelected ? 'bg-pink-800 text-white' : 'bg-slate-200 text-slate-700' %>"><%= count %></span>
                </a>
            <% }); %>
        </div>
    </div>

    <!-- TAB 1: Geographic Precincts View -->
    <div id="view-precinct" class="space-y-10">
        <% 
            const displayAreas = selectedArea ? [selectedArea] : allAreas;
        %>

        <% displayAreas.forEach(function(area) { %>
            <% 
                const clusterEvents = areaClusters[area] || []; 
                const meta = PRECINCT_METADATA[area] || {
                    transit: 'Public Transit & Ride-hailing available',
                    walkTime: 'Check local venue maps',
                    icon: 'fa-location-dot',
                    color: 'slate',
                    badge: 'Malaysian Venue Hub',
                    venues: area,
                    tips: 'Plan your arrival 60-90 minutes before gate opening.'
                };
            %>
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden" id="precinct-<%= helpers.slugify(area) %>">
                <!-- Precinct Header Card -->
                <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white p-6 sm:p-7 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-pink-500 text-white uppercase tracking-wider">
                                <%= meta.badge %>
                            </span>
                            <span class="text-xs text-slate-300 font-semibold flex items-center gap-1">
                                <i class="fas fa-train text-purple-400"></i>
                                <%= meta.transit %>
                            </span>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white flex items-center gap-2.5">
                            <i class="fas <%= meta.icon %> text-pink-400"></i>
                            <span><%= area %></span>
                        </h2>
                        <p class="text-xs text-slate-300 flex items-center gap-1.5 pt-0.5">
                            <i class="fas fa-building text-slate-400"></i>
                            <span class="font-medium">Venues: <%= meta.venues %></span>
                        </p>
                    </div>

                    <div class="bg-slate-800/80 rounded-2xl p-3 border border-slate-700 max-w-sm text-xs text-slate-300 shrink-0">
                        <div class="font-bold text-amber-400 flex items-center gap-1 mb-1">
                            <i class="fas fa-lightbulb"></i> Transit & Crowd Tip
                        </div>
                        <p class="text-[11px] leading-relaxed text-slate-300"><%= meta.tips %></p>
                    </div>
                </div>

                <!-- Events in this Precinct -->
                <div class="p-6">
                    <% if (clusterEvents.length === 0) { %>
                        <div class="text-center py-8 text-xs text-slate-400">
                            No active events currently listed in this precinct.
                        </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% clusterEvents.forEach(function(event) { %>
                                <% const calcStatus = helpers.getCalculatedEventStatus(event); %>
                                <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                                <div class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden flex flex-col hover:border-pink-300 hover:shadow-md transition-all group">
                                    <div class="relative h-44 overflow-hidden bg-slate-900">
                                        <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                             onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                                        
                                        <div class="absolute top-3 left-3 z-10">
                                            <%- helpers.getStatusBadge(calcStatus) %>
                                        </div>

                                        <div class="absolute bottom-3 left-3 right-3 z-10 flex items-center justify-between text-white text-xs font-bold">
                                            <span><i class="fas fa-calendar-day me-1 text-pink-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                                            <% if (event.start_time) { %>
                                                <span><i class="fas fa-clock me-1 text-purple-400"></i> <%= helpers.formatTime(event.start_time) %></span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="p-4 flex-grow flex flex-col justify-between space-y-3">
                                        <div>
                                            <div class="flex items-center gap-1.5 mb-1.5">
                                                <span class="text-xs font-bold text-purple-600"><%= event.artist_name || 'K-Pop Showcase' %></span>
                                                <span class="text-slate-300">•</span>
                                                <span class="text-[10px] font-bold text-slate-500"><%= event.category_name %></span>
                                            </div>

                                            <h3 class="text-sm font-bold text-slate-900 group-hover:text-pink-600 transition-colors line-clamp-2">
                                                <a href="/events/<%= event.id %>-<%= eventSlug %>">
                                                    <%= event.event_name %>
                                                </a>
                                            </h3>

                                            <div class="mt-2 text-xs text-slate-600 space-y-1">
                                                <div class="flex items-center gap-1.5">
                                                    <i class="fas fa-location-dot text-rose-500 w-3.5"></i>
                                                    <span class="truncate font-medium"><%= event.venue_name || event.venue_display %></span>
                                                </div>
                                                <div class="flex items-center gap-1.5 text-slate-400 text-[11px]">
                                                    <i class="fas fa-person-walking text-slate-400 w-3.5"></i>
                                                    <span><%= meta.walkTime %></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="pt-3 border-t border-slate-200 flex items-center gap-2">
                                            <a href="/events/<%= event.id %>-<%= eventSlug %>" 
                                               class="flex-1 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs text-center transition-all">
                                                View Event
                                            </a>
                                            <% if (event.ticket_url) { %>
                                                <a href="<%= event.ticket_url %>" target="_blank" rel="noopener noreferrer" 
                                                   class="px-3 py-2 rounded-xl bg-pink-50 hover:bg-pink-100 text-pink-700 font-bold text-xs border border-pink-200 transition-all" title="Official Ticketing URL">
                                                    <i class="fas fa-ticket text-xs"></i>
                                                </a>
                                            <% } %>
                                            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent((event.venue_name || event.venue_display) + ' ' + (event.city || 'Kuala Lumpur')) %>" 
                                               target="_blank" rel="noopener noreferrer" 
                                               class="px-3 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs border border-slate-200 transition-all" title="Open Venue Map">
                                                <i class="fas fa-map-location-dot text-xs text-slate-500"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>
    </div>

    <!-- TAB 2: Same-Weekend Timeline View -->
    <div id="view-weekend" class="hidden space-y-8">
        <div class="p-4 rounded-2xl bg-purple-50 border border-purple-200 text-purple-900 text-xs font-semibold flex items-center gap-3">
            <i class="fas fa-calendar-check text-purple-600 text-base"></i>
            <div>
                <strong>Same-Weekend Grouping Active:</strong> Perfect for fans planning weekend trips, attending multiple concerts, or joining fanclub gatherings and cupsleeve events on the same weekend.
            </div>
        </div>

        <% weekendClusters.forEach(function(cluster) { %>
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="bg-slate-900 text-white px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-purple-600 flex items-center justify-center text-white text-base font-black">
                            <i class="fas fa-calendar-days"></i>
                        </div>
                        <div>
                            <h3 class="text-base sm:text-lg font-black text-white"><%= cluster.label %></h3>
                            <div class="text-xs text-slate-400 font-medium">Friday to Sunday Weekend Cohort</div>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-500/20 text-pink-300 border border-pink-400/30 self-start sm:self-auto">
                        <%= cluster.events.length %> Event<%= cluster.events.length > 1 ? 's' : '' %> Scheduled
                    </span>
                </div>

                <div class="p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% cluster.events.forEach(function(event) { %>
                        <% const calcStatus = helpers.getCalculatedEventStatus(event); %>
                        <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                        <div class="bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden flex flex-col hover:border-purple-300 hover:shadow-md transition-all group">
                            <div class="relative h-40 overflow-hidden bg-slate-900">
                                <img src="<%= event.poster_image %>" alt="<%= event.event_name %>" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                     onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800&auto=format&fit=crop'">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
                                
                                <div class="absolute top-3 left-3 z-10">
                                    <%- helpers.getStatusBadge(calcStatus) %>
                                </div>
                                <div class="absolute top-3 right-3 z-10">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-black bg-white/90 text-slate-900 shadow-xs">
                                        <%= event.cluster_area || 'Venue' %>
                                    </span>
                                </div>

                                <div class="absolute bottom-3 left-3 right-3 z-10 flex items-center justify-between text-white text-xs font-bold">
                                    <span><i class="fas fa-calendar-day me-1 text-pink-400"></i> <%= helpers.formatDate(event.event_date) %></span>
                                    <span><%= helpers.formatTime(event.start_time) %></span>
                                </div>
                            </div>

                            <div class="p-4 flex-grow flex flex-col justify-between space-y-3">
                                <div>
                                    <div class="text-xs font-bold text-pink-600 mb-1"><%= event.artist_name || 'K-Pop Event' %></div>
                                    <h4 class="text-sm font-bold text-slate-900 group-hover:text-purple-600 transition-colors line-clamp-2">
                                        <a href="/events/<%= event.id %>-<%= eventSlug %>">
                                            <%= event.event_name %>
                                        </a>
                                    </h4>
                                    <div class="text-xs text-slate-500 mt-2 flex items-center gap-1.5 truncate">
                                        <i class="fas fa-location-dot text-rose-500"></i>
                                        <span><%= event.venue_name || event.venue_display %></span>
                                    </div>
                                </div>

                                <div class="pt-3 border-t border-slate-200 flex items-center gap-2">
                                    <a href="/events/<%= event.id %>-<%= eventSlug %>" 
                                       class="flex-1 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs text-center transition-all">
                                        View Details
                                    </a>
                                    <% if (event.ticket_url) { %>
                                        <a href="<%= event.ticket_url %>" target="_blank" rel="noopener noreferrer" 
                                           class="px-2.5 py-1.5 rounded-xl bg-pink-50 hover:bg-pink-100 text-pink-700 font-bold text-xs border border-pink-200" title="Ticket Link">
                                            <i class="fas fa-ticket"></i>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<script>
    function switchRadarTab(tab) {
        const precinctBtn = document.getElementById('tab-precinct-btn');
        const weekendBtn = document.getElementById('tab-weekend-btn');
        const precinctView = document.getElementById('view-precinct');
        const weekendView = document.getElementById('view-weekend');

        if (tab === 'precinct') {
            precinctView.classList.remove('hidden');
            weekendView.classList.add('hidden');

            precinctBtn.className = "px-5 py-2 rounded-xl text-xs font-extrabold transition-all shadow-xs bg-white text-slate-900 flex items-center gap-2 cursor-pointer";
            weekendBtn.className = "px-5 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer";
        } else {
            weekendView.classList.remove('hidden');
            precinctView.classList.add('hidden');

            weekendBtn.className = "px-5 py-2 rounded-xl text-xs font-extrabold transition-all shadow-xs bg-white text-slate-900 flex items-center gap-2 cursor-pointer";
            precinctBtn.className = "px-5 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer";
        }
    }
</script>

<%- include('partials/footer') %>
