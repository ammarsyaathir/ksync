<%- include('partials/header', { title: 'K-Pop Event Radar & Calendar Matrix | K-Sync Malaysia' }) %>

<%
    const PRECINCT_METADATA = {
        'Bukit Jalil Hub': {
            transit: 'LRT Sri Petaling Line (Bukit Jalil Station - PH5)',
            walkTime: '5-10 mins covered pedestrian walkway',
            icon: 'fa-landmark',
            color: 'emerald',
            badge: 'Mega Stadium Precinct',
            venues: 'Axiata Arena, Bukit Jalil National Stadium, Unifi Arena',
            coords: [3.0583, 101.6917],
            capacity: '16,000 - 87,000',
            tips: 'Park-and-ride at LRT stations (Awan Besar / Sri Petaling) is highly recommended on concert nights. Rapid KL regularly extends operations.'
        },
        'BBCC & Downtown KL': {
            transit: 'Hang Tuah Station (LRT Ampang Line / KL Monorail) & Merdeka MRT',
            walkTime: 'Direct connection via Mitsui Shopping Park LaLaport BBCC',
            icon: 'fa-building-columns',
            color: 'purple',
            badge: 'Zepp KL & Lifestyle Precinct',
            venues: 'Zepp Kuala Lumpur, LaLaport BBCC Central Rooftop',
            coords: [3.1408, 101.7088],
            capacity: '2,500',
            tips: 'Direct undercover transit link from Hang Tuah station directly into Zepp KL floor level.'
        },
        'Mega Star Arena & Bukit Bintang': {
            transit: 'MRT / Monorail Bukit Bintang & Imbi Monorail',
            walkTime: 'Inside Sungei Wang Plaza (Level 4)',
            icon: 'fa-compact-disc',
            color: 'pink',
            badge: 'City Center Indoor Arena',
            venues: 'Mega Star Arena KL (Level 4 Sungei Wang)',
            coords: [3.1451, 101.7114],
            capacity: '5,000',
            tips: 'Located right in central Bukit Bintang; ample food options in Sungei Wang and Lot 10 before queuing.'
        },
        'KL Sentral & Brickfields': {
            transit: 'KL Sentral Hub (LRT / MRT / KTM / ERL Airport Express)',
            walkTime: '5-15 mins via connected transit skybridges',
            icon: 'fa-train-subway',
            color: 'blue',
            badge: 'Central Transit Interchange Hub',
            venues: 'Idea Convention Centre, Menara PGRM / Cheras link',
            coords: [3.1342, 101.6865],
            capacity: '3,000',
            tips: 'Ideal hub for interstate and overseas fans arriving from KLIA 1/2 via KLIA Ekspres.'
        },
        'Petaling Jaya & Sunway': {
            transit: 'BRT Sunway Line / LRT Kelana Jaya line (Taman Paramount / Asia Jaya)',
            walkTime: 'BRT direct to Sunway Pyramid; Feeder bus to JioSpace PJ',
            icon: 'fa-map-pin',
            color: 'amber',
            badge: 'Suburban Gathering Hub',
            venues: 'Sunway Pyramid Convention Centre, JioSpace PJ',
            coords: [3.0729, 101.6074],
            capacity: '4,000',
            tips: 'Great for cupsleeve cafe hops, fanclub gatherings, and medium-scale showcase tours.'
        },
        'Penang & Northern Region': {
            transit: 'Rapid Penang Bus / Penang Airport Link',
            walkTime: 'Direct access from Jalan Tun Dr Awang',
            icon: 'fa-water',
            color: 'cyan',
            badge: 'Northern Tour Stop',
            venues: 'Setia SPICE Arena, Gurney Paragon Mall',
            coords: [5.3283, 100.2825],
            capacity: '10,000',
            tips: 'Main concert hub for northern Malaysian fans with direct airport highway access.'
        }
    };

    function resolveFandomColor(artistName) {
        const name = (artistName || '').toLowerCase();
        if (name.includes('seventeen')) return { primary: '#F7CAC9', secondary: '#92A8D1', name: 'Rose Quartz & Serenity', quadrant: 'bg', label: 'CARAT Beacon' };
        if (name.includes('twice')) return { primary: '#FF5FA2', secondary: '#FFA400', name: 'Apricot & Neon Magenta', quadrant: 'gg', label: 'ONCE Beacon' };
        if (name.includes('stray kids')) return { primary: '#E11D48', secondary: '#0F172A', name: 'Compass Crimson', quadrant: 'bg', label: 'STAY Beacon' };
        if (name.includes('aespa')) return { primary: '#A855F7', secondary: '#38BDF8', name: 'Aurora Ultraviolet', quadrant: 'gg', label: 'MY Beacon' };
        if (name.includes('ive')) return { primary: '#EC4899', secondary: '#F43F5E', name: 'Prism Magenta', quadrant: 'gg', label: 'DIVE Beacon' };
        if (name.includes('day6')) return { primary: '#0284C7', secondary: '#38BDF8', name: 'EveryDAY Sky', quadrant: 'band', label: 'My Day Beacon' };
        if (name.includes('enhypen')) return { primary: '#F97316', secondary: '#EA580C', name: 'Vampire Amber', quadrant: 'bg', label: 'ENGENE Beacon' };
        if (name.includes('txt') || name.includes('tomorrow')) return { primary: '#06B6D4', secondary: '#3B82F6', name: 'Star Cyan', quadrant: 'bg', label: 'MOA Beacon' };
        if (name.includes('taeyeon') || name.includes('iu') || name.includes('baekhyun')) return { primary: '#F472B6', secondary: '#C084FC', name: 'Vocalist Aura', quadrant: 'solo', label: 'Soloist Beacon' };
        if (name.includes('band') || name.includes('wave') || name.includes('fest')) return { primary: '#10B981', secondary: '#06B6D4', name: 'Live Band Green', quadrant: 'band', label: 'Band Beacon' };
        return { primary: '#EC4899', secondary: '#06B6D4', name: 'Cyber Stage Neon', quadrant: 'bg', label: 'Live Echo' };
    }

    // Prepare events data for interactive radar canvas
    const mappedEventsData = events.map(e => {
        let coords = [3.1408, 101.7088];
        const vName = (e.venue_name || '').toLowerCase();
        const aName = (e.cluster_area || '');

        if (vName.includes('axiata') || vName.includes('bukit jalil')) coords = [3.0583, 101.6917];
        else if (vName.includes('zepp') || vName.includes('lalaport')) coords = [3.1408, 101.7088];
        else if (vName.includes('mega star') || vName.includes('sungei wang')) coords = [3.1451, 101.7114];
        else if (vName.includes('sunway') || vName.includes('jiospace') || vName.includes('petaling')) coords = [3.0729, 101.6074];
        else if (vName.includes('spice') || vName.includes('penang') || vName.includes('gurney')) coords = [5.3283, 100.2825];
        else if (vName.includes('austin') || vName.includes('johor')) coords = [1.5542, 103.7766];
        else if (PRECINCT_METADATA[aName]) coords = PRECINCT_METADATA[aName].coords;

        const fandom = resolveFandomColor(e.artist_name);
        const eventDate = e.event_date instanceof Date ? e.event_date : new Date(e.event_date || Date.now());
        const daysAway = Math.max(0, Math.round((eventDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)));

        return {
            id: e.id,
            title: e.event_name,
            artist: e.artist_name || 'K-Pop Artist',
            venue: e.venue_name || e.venue_display || 'Malaysian Venue',
            date: eventDate.toISOString().split('T')[0],
            time: e.start_time || '8:00 PM',
            poster: e.poster_image || 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800',
            area: e.cluster_area || 'Kuala Lumpur Metro Hub',
            category: e.category_name || 'Concert',
            ticketUrl: e.official_ticket_url || '',
            status: e.verification_status || 'VERIFIED',
            coords: coords,
            fandom: fandom,
            daysAway: daysAway,
            slug: helpers.slugify(e.event_name) || e.id
        };
    });
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Header Banner (Consistent with K-Sync Design System) -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-200/80 pb-6">
        <div>
            <div class="flex items-center space-x-2.5 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-slate-900 text-white shadow-xs">
                    <span class="w-2 h-2 rounded-full bg-pink-500 animate-pulse"></span>
                    EVENT RADAR
                </span>
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200/80">
                    Malaysia Tour Stops
                </span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-[-0.035em] leading-tight font-sans">
                K-Pop Event Radar
            </h1>
            <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl font-medium leading-relaxed">
                Explore Malaysian concert stops, cupsleeve meetups, and fan tours on the interactive 360° radar and schedule calendar.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <span class="px-4 py-2.5 rounded-2xl text-xs font-black bg-slate-900 text-white shadow-xs flex items-center gap-2">
                <i class="fas fa-satellite-dish text-pink-400"></i>
                <span><%= events.length %> Verified Listings</span>
            </span>
        </div>
    </div>

    <!-- Dual Navigation Dock & Time Filter Bar -->
    <div class="bg-white rounded-3xl p-3 sm:p-4 shadow-xs border border-slate-200 mb-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <!-- View Selector Tabs -->
            <div class="inline-flex rounded-2xl bg-slate-100 p-1.5 border border-slate-200/80 shrink-0">
                <button type="button" id="tab-sonar-btn" onclick="switchRadarMode('sonar')"
                        class="px-4 sm:px-6 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-radar text-pink-400"></i>
                    <span>360° Event Radar</span>
                </button>
                <button type="button" id="tab-weekend-btn" onclick="switchRadarMode('weekend')"
                        class="px-4 sm:px-6 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-calendar-week text-purple-600"></i>
                    <span>Calendar Matrix (<%= weekendClusters.length %> Weekends)</span>
                </button>
            </div>

            <!-- Precinct Area Highlights -->
            <div class="flex items-center gap-2 text-xs text-slate-600 font-semibold overflow-x-auto pb-1 sm:pb-0">
                <span class="text-slate-400 font-bold uppercase text-[10px] tracking-wider shrink-0">Top Hubs:</span>
                <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-[11px] font-bold shrink-0">
                    <i class="fas fa-location-dot text-pink-500 me-1"></i>Bukit Jalil Hub
                </span>
                <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-[11px] font-bold shrink-0">
                    <i class="fas fa-building text-purple-500 me-1"></i>BBCC & Zepp KL
                </span>
            </div>
        </div>

        <!-- Quick Time Filter Strip -->
        <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-1.5 overflow-x-auto py-1 scrollbar-none">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider me-1 text-[11px]">Filter by Horizon:</span>
                <button type="button" onclick="setTimeFilter(4)" id="filter-btn-4" class="time-filter-btn px-3 py-1.5 rounded-full text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-pointer">
                    All Shows (<%= events.length %>)
                </button>
                <button type="button" onclick="setTimeFilter(1)" id="filter-btn-1" class="time-filter-btn px-3 py-1.5 rounded-full text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer">
                    This Weekend (< 7d)
                </button>
                <button type="button" onclick="setTimeFilter(2)" id="filter-btn-2" class="time-filter-btn px-3 py-1.5 rounded-full text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer">
                    Next 30 Days
                </button>
                <button type="button" onclick="setTimeFilter(3)" id="filter-btn-3" class="time-filter-btn px-3 py-1.5 rounded-full text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer">
                    Next 90 Days
                </button>
            </div>
            <div class="text-xs text-slate-500 font-medium">
                Showing <span id="filtered-count-badge" class="font-bold text-slate-900"><%= events.length %></span> events
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 1: 360° CONCERT RADAR & EVENT SPOTLIGHT CONSOLE (PRIMARY)            -->
    <!-- ========================================================================= -->
    <div id="view-sonar" class="space-y-6">
        <!-- Main Radar Stage Console -->
        <div class="bg-slate-950 rounded-3xl border border-slate-800 p-5 sm:p-7 shadow-2xl relative overflow-hidden text-white">
            <!-- Background Stage Glow -->
            <div class="absolute -top-32 -left-32 w-80 h-80 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Top Header Inside Radar -->
            <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800/80 pb-4 mb-6">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded bg-pink-500/20 text-pink-400 border border-pink-500/40 font-bold uppercase tracking-widest text-[10px]">
                            360° RADAR CONSOLE
                        </span>
                        <span class="text-xs text-slate-400 font-medium">Malaysia Event Horizon</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-1">
                        Events closer to the center are happening sooner (Center = Today, Outer Ring = Later this season).
                    </p>
                </div>

                <!-- Radar Controls: Speed & Sound -->
                <div class="flex items-center gap-2 shrink-0">
                    <div class="inline-flex rounded-xl bg-slate-900 border border-slate-800 p-1 text-[11px]">
                        <button type="button" id="btn-speed-1" onclick="setSweepSpeed(1)" class="px-2.5 py-1 rounded-lg bg-pink-600 text-white font-bold cursor-pointer">1x Scan</button>
                        <button type="button" id="btn-speed-2" onclick="setSweepSpeed(2)" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer">2x Fast</button>
                        <button type="button" id="btn-speed-0" onclick="setSweepSpeed(0)" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer">Pause</button>
                    </div>

                    <button type="button" id="btn-audio-ping" onclick="toggleAudioPing()" 
                            class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white text-xs font-bold flex items-center gap-1.5 cursor-pointer transition-all">
                        <i class="fas fa-volume-xmark text-slate-400" id="audio-icon"></i>
                        <span id="audio-label">Muted</span>
                    </button>
                </div>
            </div>

            <!-- Interactive Radar Layout: Canvas + Spotlight Card -->
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- Left Column: 360° Radar Canvas -->
                <div class="lg:col-span-7 flex flex-col items-center justify-center">
                    <div class="relative w-full max-w-[320px] xs:max-w-[360px] sm:max-w-[440px] md:max-w-[480px] aspect-square flex items-center justify-center mx-auto">
                        <canvas id="sonar-canvas" class="w-full h-full cursor-crosshair rounded-full shadow-[0_0_40px_rgba(236,72,153,0.12)]"></canvas>

                        <!-- Quadrant Labels -->
                        <div class="absolute top-2 left-2 text-[10px] font-bold text-cyan-400/90 bg-slate-950/80 px-2.5 py-1 rounded-full border border-cyan-500/30 pointer-events-none">
                            ✨ BOY GROUPS
                        </div>
                        <div class="absolute top-2 right-2 text-[10px] font-bold text-pink-400/90 bg-slate-950/80 px-2.5 py-1 rounded-full border border-pink-500/30 pointer-events-none">
                            💖 GIRL GROUPS
                        </div>
                        <div class="absolute bottom-2 left-2 text-[10px] font-bold text-emerald-400/90 bg-slate-950/80 px-2.5 py-1 rounded-full border border-emerald-500/30 pointer-events-none">
                            🎸 K-BANDS & FESTS
                        </div>
                        <div class="absolute bottom-2 right-2 text-[10px] font-bold text-purple-400/90 bg-slate-950/80 px-2.5 py-1 rounded-full border border-purple-500/30 pointer-events-none">
                            🎤 SOLOISTS
                        </div>
                    </div>

                    <!-- Canvas Helper Text -->
                    <div class="mt-4 text-center text-xs text-slate-400">
                        <span class="text-pink-400 font-bold"><i class="fas fa-hand-pointer me-1"></i> Tap or click any beacon</span> to view event details
                    </div>
                </div>

                <!-- Right Column: Selected Event Spotlight HUD Card -->
                <div class="lg:col-span-5">
                    <div id="target-hud-container" class="bg-slate-900/90 backdrop-blur-md rounded-3xl border border-slate-800 p-5 space-y-4 shadow-xl">
                        <!-- Card Header: Status & D-Day -->
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span id="hud-status" class="text-xs font-bold text-emerald-400 tracking-wider">EVENT SELECTED</span>
                            </div>
                            <span id="hud-dday" class="px-2.5 py-0.5 rounded-full text-xs font-black bg-pink-500 text-white font-mono">D-DAY</span>
                        </div>

                        <!-- Event Info -->
                        <div class="flex gap-4 items-start">
                            <img id="hud-poster" src="" alt="Poster" class="w-20 h-28 object-cover rounded-2xl border border-slate-700 shrink-0 bg-slate-950 shadow-md">
                            <div class="space-y-1 flex-grow min-w-0">
                                <div id="hud-artist" class="text-xs font-extrabold text-pink-400 uppercase tracking-wider truncate">Artist</div>
                                <h3 id="hud-title" class="text-base font-black text-white leading-snug line-clamp-2">Concert Title</h3>
                                <p id="hud-venue" class="text-xs text-slate-300 flex items-center gap-1 mt-1 truncate">
                                    <i class="fas fa-location-dot text-pink-400 shrink-0"></i>
                                    <span class="truncate">Venue</span>
                                </p>
                                <p id="hud-date" class="text-xs text-slate-400 font-mono mt-0.5">Date & Time</p>
                            </div>
                        </div>

                        <!-- Fandom Lightstick Color Badge -->
                        <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <span id="hud-lightstick-swatch" class="w-4 h-4 rounded-full border border-white/20 shadow-xs"></span>
                                <div class="text-xs">
                                    <div class="text-slate-400 text-[10px] uppercase font-bold">Fandom Lightstick Color</div>
                                    <div id="hud-lightstick-name" class="font-bold text-white">Lightstick Hue</div>
                                </div>
                            </div>
                            <span id="hud-verified" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-950 text-emerald-400 border border-emerald-800/80">
                                Verified Event
                            </span>
                        </div>

                        <!-- Tour Anthem Audio Preview -->
                        <div class="p-3.5 rounded-2xl bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border border-pink-500/30 shadow-md space-y-2.5">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-pink-400">
                                    <i class="fas fa-compact-disc text-pink-500"></i>
                                    <span>Tour Anthem Preview</span>
                                </div>
                                <div id="hud-audio-bars" class="flex items-end gap-1 h-3.5 opacity-40">
                                    <span class="w-1 bg-pink-400 rounded-full h-1.5 transition-all"></span>
                                    <span class="w-1 bg-pink-500 rounded-full h-3 transition-all"></span>
                                    <span class="w-1 bg-pink-400 rounded-full h-2 transition-all"></span>
                                    <span class="w-1 bg-pink-300 rounded-full h-3.5 transition-all"></span>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <div class="relative w-11 h-11 rounded-full overflow-hidden shrink-0 border-2 border-slate-700 shadow-md bg-slate-950">
                                    <img id="hud-song-art" src="" alt="Album Art" class="w-full h-full object-cover">
                                    <div class="absolute inset-0 m-auto w-2.5 h-2.5 rounded-full bg-slate-950 border border-white/50"></div>
                                </div>

                                <div class="flex-grow min-w-0">
                                    <div id="hud-song-title" class="text-xs font-bold text-white truncate">Loading Anthem...</div>
                                    <div id="hud-song-album" class="text-[10px] text-slate-400 truncate">Official Tour Hit</div>
                                </div>

                                <button type="button" id="hud-play-btn" onclick="toggleSongPlayback()" 
                                        class="w-8 h-8 rounded-full bg-pink-600 hover:bg-pink-500 text-white flex items-center justify-center shrink-0 shadow-md press-tactile transition-all cursor-pointer"
                                        title="Play/Pause 30s Audio Preview">
                                    <i class="fas fa-play text-[11px] ps-0.5" id="hud-play-icon"></i>
                                </button>
                            </div>

                            <div class="space-y-1">
                                <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                                    <div id="hud-song-progress" class="h-full bg-gradient-to-r from-pink-500 to-rose-400 w-0 transition-all duration-100"></div>
                                </div>
                                <div class="flex justify-between text-[10px] text-slate-400 font-mono">
                                    <span id="hud-song-current-time">0:00</span>
                                    <span>0:30 Audio Preview</span>
                                </div>
                            </div>

                            <audio id="hud-audio-player" preload="none"></audio>
                        </div>

                        <!-- Transit & Venue Guide -->
                        <div class="p-3 rounded-2xl bg-slate-950/70 border border-slate-800/80 text-xs space-y-1">
                            <div class="text-slate-400 font-bold text-[10px] flex items-center gap-1 uppercase">
                                <i class="fas fa-train text-emerald-400"></i>
                                <span>Transit & Venue Guide</span>
                            </div>
                            <p id="hud-transit-tip" class="text-slate-300 text-[11px] leading-relaxed">
                                Direct connection via LRT Sri Petaling Line.
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="pt-1 flex flex-col sm:flex-row gap-2">
                            <a id="hud-link-dossier" href="#" class="flex-1 px-4 py-2.5 rounded-xl text-xs font-black bg-pink-600 hover:bg-pink-500 text-white press-tactile text-center transition-all shadow-xs flex items-center justify-center gap-1.5">
                                <span>View Event Details</span>
                                <i class="fas fa-arrow-right text-[10px]"></i>
                            </a>
                            <a id="hud-link-ticket" href="#" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 press-tactile text-center transition-all flex items-center justify-center gap-1.5">
                                <span>Official Tickets</span>
                                <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 2: CALENDAR & TOUR SCHEDULE MATRIX                                   -->
    <!-- ========================================================================= -->
    <div id="view-weekend" class="space-y-8 hidden">
        <% if (weekendClusters.length === 0) { %>
            <div class="bg-white rounded-3xl p-12 text-center border border-slate-200 shadow-xs">
                <i class="fas fa-calendar-xmark text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-base font-bold text-slate-800">No Upcoming Weekend Clusters</h3>
                <p class="text-xs text-slate-500 mt-1">Check individual tour listings in the events directory.</p>
            </div>
        <% } else { %>
            <% weekendClusters.forEach(function(cluster) { %>
                <div class="bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden">
                    <!-- Weekend Cohort Header -->
                    <div class="bg-gradient-to-r from-slate-900 via-purple-950 to-slate-900 text-white p-5 sm:p-6 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-purple-600 text-white flex items-center justify-center font-bold text-base shadow-xs">
                                <i class="fas fa-calendar-week"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-white tracking-tight"><%= cluster.label %></h3>
                                <p class="text-xs text-purple-200 font-medium">
                                    <%= cluster.events.length %> Shows scheduled on this weekend
                                </p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-purple-500/30 text-purple-200 border border-purple-400/40">
                            Weekend Cohort
                        </span>
                    </div>

                    <!-- Events Cards Inside Weekend Cohort -->
                    <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        <% cluster.events.forEach(function(event) { %>
                            <% const eventSlug = helpers.slugify(event.event_name) || event.id; %>
                            <div class="bg-slate-50 rounded-2xl border border-slate-200 p-4 flex flex-col justify-between hover:border-pink-300 hover:shadow-sm transition-all">
                                <div>
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-pink-100 text-pink-700">
                                            <%= event.cluster_area || 'KL Metro' %>
                                        </span>
                                        <span class="text-[10px] font-bold text-slate-400 uppercase">
                                            <%= event.category_name || 'Concert' %>
                                        </span>
                                    </div>
                                    <h4 class="text-sm font-bold text-slate-900 mt-2 line-clamp-1"><%= event.event_name %></h4>
                                    <p class="text-xs text-slate-500 mt-0.5"><%= event.artist_name %> · <%= event.venue_display || event.venue_name %></p>
                                    <div class="text-xs font-bold text-slate-700 mt-2 flex items-center gap-1">
                                        <i class="fas fa-calendar-day text-pink-500"></i>
                                        <span><%= helpers.formatDate(event.event_date) %></span>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between">
                                    <a href="/events/<%= eventSlug %>" class="text-xs font-bold text-slate-900 hover:text-pink-600 flex items-center gap-1">
                                        <span>Details</span>
                                        <i class="fas fa-arrow-right text-[10px]"></i>
                                    </a>
                                    <% if (event.official_ticket_url) { %>
                                        <a href="<%= event.official_ticket_url %>" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-pink-600 hover:underline flex items-center gap-1">
                                            <span>Tickets</span>
                                            <i class="fas fa-arrow-up-right-from-square text-[9px]"></i>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<!-- Raw Injected Event Data for Radar Engine -->
<script id="sonar-events-json" type="application/json">
    <%- JSON.stringify(mappedEventsData) %>
</script>

<!-- ========================================================================= -->
<!-- 360° CONCERT RADAR ENGINE JAVASCRIPT                                      -->
<!-- ========================================================================= -->
<script>
    let rawEvents = [];
    let currentFilteredEvents = [];
    let selectedEventId = null;
    let sweepAngle = 0;
    let sweepSpeedMultiplier = 1;
    let audioPingEnabled = false;
    let audioCtx = null;
    let hoveredEvent = null;

    document.addEventListener('DOMContentLoaded', () => {
        try {
            const rawDataEl = document.getElementById('sonar-events-json');
            if (rawDataEl) {
                rawEvents = JSON.parse(rawDataEl.textContent || '[]');
                currentFilteredEvents = rawEvents;
            }
        } catch (e) {
            console.error('Failed to parse radar events:', e);
        }

        // Initialize Canvas Engine
        initSonarCanvas();

        // Select first event by default
        if (rawEvents.length > 0) {
            selectEvent(rawEvents[0].id);
        }
    });

    // Web Audio Synthesizer for Radar Ping
    function playAcousticPing(freq = 880) {
        if (!audioPingEnabled) return;
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(freq * 0.5, audioCtx.currentTime + 0.16);

            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            osc.stop(audioCtx.currentTime + 0.22);
        } catch (err) {
            // Audio not allowed or error
        }
    }

    function toggleAudioPing() {
        audioPingEnabled = !audioPingEnabled;
        const icon = document.getElementById('audio-icon');
        const label = document.getElementById('audio-label');
        if (audioPingEnabled) {
            icon.className = 'fas fa-volume-high text-pink-400';
            label.textContent = 'Sound On';
            playAcousticPing(920);
        } else {
            icon.className = 'fas fa-volume-xmark text-slate-400';
            label.textContent = 'Muted';
        }
    }

    function setSweepSpeed(multiplier) {
        sweepSpeedMultiplier = multiplier;
        const b1 = document.getElementById('btn-speed-1');
        const b2 = document.getElementById('btn-speed-2');
        const b0 = document.getElementById('btn-speed-0');
        
        [b1, b2, b0].forEach(b => {
            if (b) b.className = 'px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer';
        });
        if (multiplier === 1 && b1) b1.className = 'px-2.5 py-1 rounded-lg bg-pink-600 text-white font-bold cursor-pointer';
        else if (multiplier === 2 && b2) b2.className = 'px-2.5 py-1 rounded-lg bg-pink-600 text-white font-bold cursor-pointer';
        else if (multiplier === 0 && b0) b0.className = 'px-2.5 py-1 rounded-lg bg-slate-700 text-white font-bold cursor-pointer';
    }

    // Canvas Engine Setup with Clean Reticle & Event Beacons
    function initSonarCanvas() {
        const canvas = document.getElementById('sonar-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        function resize() {
            const rect = canvas.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        window.addEventListener('resize', resize);
        resize();

        // Mouse & Touch Interactivity
        function getCoordsFromEvent(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: clientX - rect.left,
                y: clientY - rect.top,
                width: rect.width,
                height: rect.height
            };
        }

        canvas.addEventListener('mousemove', (e) => {
            const pos = getCoordsFromEvent(e);
            const center = pos.width / 2;
            const R = center - 20;

            hoveredEvent = null;
            currentFilteredEvents.forEach(ev => {
                const pt = getEventPoint(ev, center, R);
                const dx = pos.x - pt.x;
                const dy = pos.y - pt.y;
                if (Math.hypot(dx, dy) < 18) {
                    hoveredEvent = ev;
                }
            });
            canvas.style.cursor = hoveredEvent ? 'pointer' : 'crosshair';
        });

        function handlePointerSelect(e) {
            const pos = getCoordsFromEvent(e);
            const center = pos.width / 2;
            const R = center - 20;

            let clickedEv = null;
            currentFilteredEvents.forEach(ev => {
                const pt = getEventPoint(ev, center, R);
                const dx = pos.x - pt.x;
                const dy = pos.y - pt.y;
                if (Math.hypot(dx, dy) < 22) {
                    clickedEv = ev;
                }
            });

            if (clickedEv) {
                selectEvent(clickedEv.id);
                playAcousticPing(1040);
            }
        }

        canvas.addEventListener('click', handlePointerSelect);
        canvas.addEventListener('touchstart', handlePointerSelect, { passive: true });

        // Animation Loop
        let lastTime = performance.now();
        function draw(time) {
            const dt = (time - lastTime) / 1000;
            lastTime = time;

            if (sweepSpeedMultiplier > 0) {
                sweepAngle += (0.8 * sweepSpeedMultiplier) * dt;
                if (sweepAngle > Math.PI * 2) sweepAngle -= Math.PI * 2;
            }

            const rect = canvas.getBoundingClientRect();
            const width = rect.width;
            const height = rect.height;
            const center = width / 2;
            const R = center - 20;

            ctx.clearRect(0, 0, width, height);

            // Outer Bezel
            ctx.beginPath();
            ctx.arc(center, center, R, 0, Math.PI * 2);
            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Concentric Range Rings
            const ringRatios = [0.25, 0.50, 0.75, 1.0];
            const ringLabels = ['< 7D', '< 30D', '< 90D', 'SEASON'];
            ringRatios.forEach((ratio, idx) => {
                const r = R * ratio;
                ctx.beginPath();
                ctx.arc(center, center, r, 0, Math.PI * 2);
                ctx.strokeStyle = idx === 0 ? 'rgba(236,72,153,0.35)' : 'rgba(51,65,85,0.45)';
                ctx.setLineDash([4, 4]);
                ctx.lineWidth = 1;
                ctx.stroke();
                ctx.setLineDash([]);

                // Label
                ctx.fillStyle = '#64748b';
                ctx.font = '10px ui-monospace, monospace';
                ctx.fillText(ringLabels[idx], center + 4, center - r + 12);
            });

            // Crosshairs
            ctx.beginPath();
            ctx.moveTo(center - R, center);
            ctx.lineTo(center + R, center);
            ctx.moveTo(center, center - R);
            ctx.lineTo(center, center + R);
            ctx.strokeStyle = 'rgba(71,85,105,0.35)';
            ctx.lineWidth = 1;
            ctx.stroke();

            // Rotating Sweep Beam with Gradient Tail
            const sweepGradient = ctx.createConicGradient(sweepAngle, center, center);
            sweepGradient.addColorStop(0, 'rgba(236, 72, 153, 0.4)');
            sweepGradient.addColorStop(0.12, 'rgba(236, 72, 153, 0.08)');
            sweepGradient.addColorStop(0.25, 'rgba(236, 72, 153, 0.0)');
            sweepGradient.addColorStop(1, 'rgba(236, 72, 153, 0.0)');

            ctx.beginPath();
            ctx.arc(center, center, R, 0, Math.PI * 2);
            ctx.fillStyle = sweepGradient;
            ctx.fill();

            // Leading Sweep Line
            ctx.beginPath();
            ctx.moveTo(center, center);
            ctx.lineTo(center + R * Math.cos(sweepAngle), center + R * Math.sin(sweepAngle));
            ctx.strokeStyle = '#f472b6';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Center Origin Point
            ctx.beginPath();
            ctx.arc(center, center, 4, 0, Math.PI * 2);
            ctx.fillStyle = '#f43f5e';
            ctx.fill();

            // Render Event Blips
            currentFilteredEvents.forEach(ev => {
                const pt = getEventPoint(ev, center, R);
                const isSelected = ev.id === selectedEventId;
                const isHovered = hoveredEvent && ev.id === hoveredEvent.id;
                const primaryColor = ev.fandom.primary || '#ec4899';

                // Distance angle from sweep line
                const ptAngle = Math.atan2(pt.y - center, pt.x - center);
                let diffAngle = sweepAngle - ptAngle;
                while (diffAngle < 0) diffAngle += Math.PI * 2;
                while (diffAngle > Math.PI * 2) diffAngle -= Math.PI * 2;

                const isJustSwept = diffAngle < 0.25;

                // Ping Ripple effect if just swept
                if (isJustSwept) {
                    ctx.beginPath();
                    ctx.arc(pt.x, pt.y, 14, 0, Math.PI * 2);
                    ctx.strokeStyle = primaryColor;
                    ctx.lineWidth = 1;
                    ctx.stroke();
                }

                // Selected Reticle Target Brackets
                if (isSelected || isHovered) {
                    const reticleSize = 14;
                    ctx.strokeStyle = isSelected ? '#38bdf8' : '#f472b6';
                    ctx.lineWidth = 1.8;

                    ctx.beginPath();
                    ctx.moveTo(pt.x - reticleSize, pt.y - 5);
                    ctx.lineTo(pt.x - reticleSize, pt.y - reticleSize);
                    ctx.lineTo(pt.x - 5, pt.y - reticleSize);

                    ctx.moveTo(pt.x + 5, pt.y - reticleSize);
                    ctx.lineTo(pt.x + reticleSize, pt.y - reticleSize);
                    ctx.lineTo(pt.x + reticleSize, pt.y - 5);

                    ctx.moveTo(pt.x + reticleSize, pt.y + 5);
                    ctx.lineTo(pt.x + reticleSize, pt.y + reticleSize);
                    ctx.lineTo(pt.x + 5, pt.y + reticleSize);

                    ctx.moveTo(pt.x - 5, pt.y + reticleSize);
                    ctx.lineTo(pt.x - reticleSize, pt.y + reticleSize);
                    ctx.lineTo(pt.x - reticleSize, pt.y + 5);
                    ctx.stroke();
                }

                // Core Beacon Dot
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, isSelected ? 5.5 : 4, 0, Math.PI * 2);
                ctx.fillStyle = primaryColor;
                ctx.fill();

                // Artist Label Callout
                ctx.fillStyle = isSelected ? '#ffffff' : '#cbd5e1';
                ctx.font = isSelected ? 'bold 11px ui-sans-serif, sans-serif' : '10px ui-sans-serif, sans-serif';
                ctx.fillText(ev.artist, pt.x + 8, pt.y + 3);
            });

            requestAnimationFrame(draw);
        }

        requestAnimationFrame(draw);
    }

    // Map Event to Polar Radius and Quadrant Angle
    function getEventPoint(ev, center, R) {
        const days = ev.daysAway;
        let normR = 0.85;
        if (days <= 7) normR = 0.15 + (days / 7) * 0.15;
        else if (days <= 30) normR = 0.30 + ((days - 7) / 23) * 0.25;
        else if (days <= 90) normR = 0.55 + ((days - 30) / 60) * 0.25;
        else normR = 0.80 + Math.min(0.18, ((days - 90) / 180) * 0.18);

        let baseAngle = 225; // default NW: Boy Groups
        const q = ev.fandom.quadrant;
        if (q === 'bg') baseAngle = 225;
        else if (q === 'gg') baseAngle = 315;
        else if (q === 'solo') baseAngle = 45;
        else if (q === 'band') baseAngle = 135;

        const angleSpread = ((ev.id * 37) % 50) - 25;
        const finalAngleRad = ((baseAngle + angleSpread) * Math.PI) / 180;

        const x = center + (R * normR) * Math.cos(finalAngleRad);
        const y = center + (R * normR) * Math.sin(finalAngleRad);

        return { x, y };
    }

    // Select and Highlight Event in Spotlight Card
    function selectEvent(eventId) {
        selectedEventId = eventId;
        const ev = rawEvents.find(e => e.id === eventId);
        if (!ev) return;

        const statusEl = document.getElementById('hud-status');
        const ddayEl = document.getElementById('hud-dday');
        const posterEl = document.getElementById('hud-poster');
        const artistEl = document.getElementById('hud-artist');
        const titleEl = document.getElementById('hud-title');
        const venueEl = document.getElementById('hud-venue');
        const dateEl = document.getElementById('hud-date');
        const swatchEl = document.getElementById('hud-lightstick-swatch');
        const nameEl = document.getElementById('hud-lightstick-name');
        const tipEl = document.getElementById('hud-transit-tip');
        const linkDossier = document.getElementById('hud-link-dossier');
        const linkTicket = document.getElementById('hud-link-ticket');

        if (statusEl) statusEl.textContent = `EVENT SELECTED · #${String(ev.id).padStart(2, '0')}`;
        if (ddayEl) ddayEl.textContent = ev.daysAway === 0 ? 'D-DAY TODAY' : `D-${ev.daysAway} DAYS`;
        if (posterEl) {
            posterEl.src = ev.poster;
            posterEl.onerror = function() {
                this.src = 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800';
            };
        }
        if (artistEl) artistEl.textContent = ev.artist;
        if (titleEl) titleEl.textContent = ev.title;
        if (venueEl) venueEl.innerHTML = `<i class="fas fa-location-dot text-pink-400 me-1"></i> ${ev.venue} (${ev.area})`;
        if (dateEl) dateEl.textContent = `${ev.date} · ${ev.time}`;

        if (swatchEl) {
            swatchEl.style.background = ev.fandom.primary;
            swatchEl.style.boxShadow = `0 0 10px ${ev.fandom.primary}`;
        }
        if (nameEl) nameEl.textContent = ev.fandom.name;

        // Transit advice
        const precinctMeta = {
            'Bukit Jalil': 'LRT Sri Petaling Line (Bukit Jalil PH5). 5-min covered walkway directly into Axiata Arena.',
            'BBCC': 'Direct undercover connection from Hang Tuah station (LRT/Monorail) via LaLaport into Zepp KL floor.',
            'Mega Star': 'Inside Sungei Wang Plaza Level 4. Direct walkway from MRT Bukit Bintang.',
            'Sunway': 'BRT Sunway Line direct to Sunway Pyramid & Surf Beach.',
            'Penang': 'Setia SPICE Arena. Direct Rapid Penang bus & Bayan Lepas highway access.'
        };
        let tip = 'Public transit or ride-hailing dropoff available at main gate.';
        for (const [key, t] of Object.entries(precinctMeta)) {
            if ((ev.venue + ' ' + ev.area).includes(key)) {
                tip = t;
                break;
            }
        }
        if (tipEl) tipEl.textContent = tip;

        if (linkDossier) linkDossier.href = `/events/${ev.slug}`;

        if (linkTicket) {
            if (ev.ticketUrl) {
                linkTicket.href = ev.ticketUrl;
                linkTicket.style.display = 'inline-flex';
            } else {
                linkTicket.style.display = 'none';
            }
        }

        // Load Anthem
        loadAnthemForEvent(ev);
    }

    // Anthem Audio Player
    let isAnthemPlaying = false;

    async function loadAnthemForEvent(ev) {
        const titleEl = document.getElementById('hud-song-title');
        const albumEl = document.getElementById('hud-song-album');
        const artEl = document.getElementById('hud-song-art');
        const playIcon = document.getElementById('hud-play-icon');
        const progressEl = document.getElementById('hud-song-progress');
        const timeEl = document.getElementById('hud-song-current-time');
        const audio = document.getElementById('hud-audio-player');
        const bars = document.getElementById('hud-audio-bars');

        if (!titleEl || !audio) return;

        audio.pause();
        audio.currentTime = 0;
        isAnthemPlaying = false;
        if (playIcon) playIcon.className = 'fas fa-play text-[11px] ps-0.5';
        if (bars) bars.classList.add('opacity-40');
        if (progressEl) progressEl.style.width = '0%';
        if (timeEl) timeEl.textContent = '0:00';

        titleEl.textContent = 'Loading Tour Anthem...';
        albumEl.textContent = 'Preview Audio';

        try {
            const res = await fetch(`/api/music/preview?artist=${encodeURIComponent(ev.artist)}&title=${encodeURIComponent(ev.title)}`);
            const json = await res.json();
            if (json.status === 'success' && json.data) {
                const anthem = json.data;
                titleEl.textContent = anthem.trackName;
                albumEl.textContent = anthem.collectionName || ev.artist;
                if (artEl) artEl.src = anthem.artworkUrl || ev.poster;
                audio.src = anthem.previewUrl;

                audio.ontimeupdate = () => {
                    if (audio.duration) {
                        const pct = (audio.currentTime / audio.duration) * 100;
                        if (progressEl) progressEl.style.width = `${pct}%`;
                        const mins = Math.floor(audio.currentTime / 60);
                        const secs = Math.floor(audio.currentTime % 60);
                        if (timeEl) timeEl.textContent = `${mins}:${String(secs).padStart(2, '0')}`;
                    }
                };

                audio.onended = () => {
                    isAnthemPlaying = false;
                    if (playIcon) playIcon.className = 'fas fa-play text-[11px] ps-0.5';
                    if (bars) bars.classList.add('opacity-40');
                    if (progressEl) progressEl.style.width = '0%';
                    if (timeEl) timeEl.textContent = '0:00';
                };
            }
        } catch (err) {
            titleEl.textContent = ev.artist + ' Live Tour Hit';
            albumEl.textContent = 'Tour Preview';
        }
    }

    function toggleSongPlayback() {
        const audio = document.getElementById('hud-audio-player');
        const playIcon = document.getElementById('hud-play-icon');
        const bars = document.getElementById('hud-audio-bars');

        if (!audio || !audio.src) return;

        if (isAnthemPlaying) {
            audio.pause();
            isAnthemPlaying = false;
            if (playIcon) playIcon.className = 'fas fa-play text-[11px] ps-0.5';
            if (bars) bars.classList.add('opacity-40');
        } else {
            audio.play().then(() => {
                isAnthemPlaying = true;
                if (playIcon) playIcon.className = 'fas fa-pause text-[11px]';
                if (bars) bars.classList.remove('opacity-40');
            }).catch(e => console.warn('Playback error:', e));
        }
    }

    // Time Filter Buttons
    function setTimeFilter(val) {
        let filtered = rawEvents;
        if (val === 1) {
            filtered = rawEvents.filter(e => e.daysAway <= 7);
        } else if (val === 2) {
            filtered = rawEvents.filter(e => e.daysAway <= 30);
        } else if (val === 3) {
            filtered = rawEvents.filter(e => e.daysAway <= 90);
        } else {
            filtered = rawEvents;
        }

        currentFilteredEvents = filtered;

        const countBadge = document.getElementById('filtered-count-badge');
        if (countBadge) countBadge.textContent = filtered.length;

        // Update button states
        [1, 2, 3, 4].forEach(i => {
            const btn = document.getElementById(`filter-btn-${i}`);
            if (btn) {
                if (i === val) {
                    btn.className = 'time-filter-btn px-3 py-1.5 rounded-full text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-pointer';
                } else {
                    btn.className = 'time-filter-btn px-3 py-1.5 rounded-full text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer';
                }
            }
        });

        if (filtered.length > 0 && !filtered.some(e => e.id === selectedEventId)) {
            selectEvent(filtered[0].id);
        }
    }

    // Switch between 360° Radar and Calendar Matrix
    function switchRadarMode(mode) {
        const vSonar = document.getElementById('view-sonar');
        const vWeekend = document.getElementById('view-weekend');

        const bSonar = document.getElementById('tab-sonar-btn');
        const bWeekend = document.getElementById('tab-weekend-btn');

        if (vSonar) vSonar.classList.add('hidden');
        if (vWeekend) vWeekend.classList.add('hidden');

        const inactive = 'px-4 sm:px-6 py-2.5 rounded-xl text-xs font-bold transition-all press-tactile text-slate-600 hover:text-slate-900 flex items-center gap-2 cursor-pointer';
        const active = 'px-4 sm:px-6 py-2.5 rounded-xl text-xs font-black transition-all press-tactile bg-slate-900 text-white shadow-xs flex items-center gap-2 cursor-pointer';

        if (bSonar) bSonar.className = inactive;
        if (bWeekend) bWeekend.className = inactive;

        if (mode === 'sonar') {
            if (vSonar) vSonar.classList.remove('hidden');
            if (bSonar) bSonar.className = active;
        } else if (mode === 'weekend') {
            if (vWeekend) vWeekend.classList.remove('hidden');
            if (bWeekend) bWeekend.className = active;
        }
    }
</script>

