<mxfile host="app.diagrams.net" type="device"><diagram id="bp1" name="Current business process"><mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1" value="How fans currently find, discuss and confirm K-pop event information" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="n1" value="Event organizer or fan community&lt;br&gt;publishes an announcement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#eef3f9;strokeColor=#8296ad;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="250" y="18" width="420" height="56" as="geometry"/></mxCell><mxCell id="n2" value="Information appears across separate platforms&lt;br&gt;(X, Instagram, TikTok, Telegram and websites)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#eef3f9;strokeColor=#8296ad;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="250" y="104" width="420" height="56" as="geometry"/></mxCell><mxCell id="n3" value="Fan searches and compares event details&lt;br&gt;across sources" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#eef3f9;strokeColor=#8296ad;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="420" height="56" as="geometry"/></mxCell><mxCell id="n4" value="Fan uses group chats or community posts to ask&lt;br&gt;questions and look for previous answers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#eef3f9;strokeColor=#8296ad;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="250" y="276" width="420" height="56" as="geometry"/></mxCell><mxCell id="n5" value="Are complete and current details&lt;br&gt;easy to find and confirm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf6e4;strokeColor=#c9a227;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="270" y="344" width="380" height="124" as="geometry"/></mxCell><mxCell id="n6" value="Fan searches other posts, revisits sources,&lt;br&gt;or asks the same question again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fdeeee;strokeColor=#c98b8b;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="90" y="506" width="330" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Fan uses the information found&lt;br&gt;to plan attendance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#eef7ee;strokeColor=#7fa87f;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="490" y="506" width="330" height="64" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="406"/></Array></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n7"><mxGeome