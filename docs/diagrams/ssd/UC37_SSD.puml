@startuml UC37_SSD
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
title UC37: System Sequence Diagram - View Artist Catalog

actor Admin
participant ":System" as System

Admin -> System : openArtistsCatalog()
System --> Admin : displayArtistsTable(artists)
System -> System : queryAllArtists()
@enduml
