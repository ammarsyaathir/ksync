@startuml KSync_Malaysia_Use_Case_Diagram_30UC
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam roundcorner 10

title K-Sync Malaysia: System Use Case Diagram (30 Core Use Cases)\nA Centralized Platform for K-Pop Event Information and Fan Community Discussions

' ==============================================================================
' ACTORS (Human Actors Only - Zero Artificial Internal System Actors)
' ==============================================================================
actor "Visitor\n(Guest)" as Visitor #LightSkyBlue
actor "Registered Fan" as Fan #DeepSkyBlue
actor "Public Submitter\n(No Account)" as Submitter #SandyBrown
actor "System Administrator" as Admin #MediumOrchid

' Inheritance Hierarchy: Registered Fan inherits public browsing abilities from Visitor
Visitor <|-- Fan

' ==============================================================================
' SYSTEM BOUNDARY
' ==============================================================================
rectangle "K-Sync Malaysia System (ksync.my)" {

    ' --------------------------------------------------------------------------
    ' Module A: Account & Profile Management (3 UCs)
    ' --------------------------------------------------------------------------
    package "A. Account & Profile Management" {
        usecase "UC01: Register Account" as UC01
        usecase "UC02: Log In" as UC02
        usecase "UC03: Manage Profile" as UC03
    }

    ' --------------------------------------------------------------------------
    ' Module B: Event Discovery & Information (4 UCs)
    ' --------------------------------------------------------------------------
    package "B. Event Discovery & Information" {
        usecase "UC04: Browse Events" as UC04
        usecase "UC05: Search Events" as UC05
        usecase "UC06: Filter Events" as UC06
        usecase "UC07: View Event Details" as UC07
    }

    ' --------------------------------------------------------------------------
    ' Module C: Saved & Shared Events (3 UCs)
    ' --------------------------------------------------------------------------
    package "C. Saved & Shared Events" {
        usecase "UC08: Save / Unsave Event" as UC08
        usecase "UC09: View Saved Events" as UC09
        usecase "UC10: Share Event" as UC10
    }

    ' --------------------------------------------------------------------------
    ' Module D: Public Event Submission (Model 2: Without Account) (3 UCs)
    ' --------------------------------------------------------------------------
    package "D. Public Event Submission (Without Account)" {
        usecase "UC11: Submit Event" as UC11
        usecase "UC12: Check Submission Status" as UC12
        usecase "UC13: Correct and Resubmit Event" as UC13
    }

    ' --------------------------------------------------------------------------
    ' Module E: Submission Review & Verification (5 UCs)
    ' --------------------------------------------------------------------------
    package "E. Submission Review & Verification" {
        usecase "UC14: View Pending Submissions" as UC14
        usecase "UC15: Review Event Submission" as UC15
        usecase "UC16: Approve & Publish Submission" as UC16
        usecase "UC17: Reject Submission" as UC17
        usecase "UC18: Manage Verified Organizer Status" as UC18
    }

    ' --------------------------------------------------------------------------
    ' Module F: Published Event Management (6 UCs)
    ' --------------------------------------------------------------------------
    package "F. Published Event Management" {
        usecase "UC19: Edit Event Information" as UC19
        usecase "UC20: Update Event Status" as UC20
        usecase "UC21: Unpublish / Delete Event" as UC21
        usecase "UC22: Manage Event Categories" as UC22
        usecase "UC23: Manage Venues" as UC23
        usecase "UC24: Manage Artists & Member Profiles" as UC24
    }

    ' --------------------------------------------------------------------------
    ' Module G: Fan Community Discussions (4 UCs)
    ' --------------------------------------------------------------------------
    package "G. Fan Community Discussions" {
        usecase "UC25: View Event Discussion" as UC25
        usecase "UC26: Create Discussion Post" as UC26
        usecase "UC27: Reply to Discussion" as UC27
        usecase "UC28: Delete Own Comment" as UC28
    }

    ' --------------------------------------------------------------------------
    ' Module H: Content Moderation & Governance (2 UCs)
    ' --------------------------------------------------------------------------
    package "H. Content Moderation & Governance" {
        usecase "UC29: Report Content or Event" as UC29
        usecase "UC30: Investigate & Moderate Report" as UC30
    }
}

' ==============================================================================
' ACTOR TO USE CASE ASSOCIATIONS
' ==============================================================================

' 1. Visitor Associations (Public Access)
Visitor --> UC01
Visitor --> UC02
Visitor --> UC04
Visitor --> UC05
Visitor --> UC06
Visitor --> UC07
Visitor --> UC10
Visitor --> UC25

' 2. Registered Fan Associations (Authenticated Privileges)
Fan --> UC03
Fan --> UC08
Fan --> UC09
Fan --> UC26
Fan --> UC27
Fan --> UC28
Fan --> UC29

' 3. Public Submitter Associations (Model 2: Frictionless Public Submissions)
Submitter --> UC11
Submitter --> UC12

' 4. System Administrator Associations (Full Moderation & Catalog Governance)
Admin --> UC02
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19
Admin --> UC20
Admin --> UC21
Admin --> UC22
Admin --> UC23
Admin --> UC24
Admin --> UC28
Admin --> UC30

' ==============================================================================
' UML «extend» RELATIONSHIPS (Conditional Optional Flows)
' In strict UML, the dashed arrow points FROM extending usecase TO base usecase.
' ==============================================================================
UC13 ..> UC12 : <<extend>>
UC29 ..> UC07 : <<extend>>
UC29 ..> UC25 : <<extend>>

@enduml
