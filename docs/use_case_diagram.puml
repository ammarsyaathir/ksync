@startuml KSync_Malaysia_Complete_System_Use_Cases
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName "Outfit, Arial, sans-serif"
skinparam defaultFontSize 11
skinparam roundcorner 12

title K-Sync Malaysia: Complete Redesigned Use Case Architecture (42 Use Cases)\nAutonomous Verification Engine, Event Radar, Artist Profiles & Fan Command Center

' ==============================================================================
' ACTORS HIERARCHY
' ==============================================================================
actor "Guest\n(Public Visitor)" as Guest #LightSkyBlue
actor "Fan\n(Authenticated Member)" as Fan #LightPink
actor "Organizer / Submitter\n(Verified Event Host)" as Organizer #SandyBrown
actor "System Maintainer\n(Administrator)" as Maintainer #MediumOrchid
actor "Autonomous Verification\nEngine (AI / Heuristic)" as AutoVerifier <<Application Engine>> #MediumSeaGreen

Fan -up-|> Guest
Organizer -up-|> Fan

' ==============================================================================
' SYSTEM BOUNDARY
' ==============================================================================
rectangle "K-Sync Malaysia System Platform (ksync.my)" {

    ' --------------------------------------------------------------------------
    ' MODULE 1: PUBLIC DISCOVERY & OUTBOUND CONNECTIONS (Guest Actor)
    ' --------------------------------------------------------------------------
    package "1. Public Discovery & Outbound Experience (Guest)" {
        usecase "UC001: Register Account\n(Email / Google OAuth)" as UC001
        usecase "UC002: Browse Events Directory" as UC002
        usecase "UC003: Search Events\n(Artist, Venue, Title, City)" as UC003
        usecase "UC004: Filter Events\n(Category, State, Date)" as UC004
        usecase "UC005: View Event Radar\n(Precinct Clusters & Weekends)" as UC005
        usecase "UC006: View Event Details\n(Countdown, Evidence, Updates)" as UC006
        usecase "UC007: Open Official Ticket Link\n(Whitelisted Partner URL)" as UC007
        usecase "UC008: Open Venue Map & Transit\n(Google Maps & LRT Directions)" as UC008
        usecase "UC009: Open Organizer Social Link\n(Official X / Instagram)" as UC009
        usecase "UC010: Share Event\n(WhatsApp, X, Telegram, Link)" as UC010
        usecase "UC011: Export Event to Calendar\n(Google Calendar / .ics)" as UC011
        usecase "UC012: Browse Artists Directory\n(Boy/Girl Groups & Soloists)" as UC012
        usecase "UC013: View Artist & Member Profiles\n(Biodata & MY Tour Archive)" as UC013
        usecase "UC014: View Event Discussions\n(Public Read Q&A Comments)" as UC014
    }

    ' --------------------------------------------------------------------------
    ' MODULE 2: PERSONAL MANAGEMENT & COMMUNITY VALIDATION (Fan Actor)
    ' --------------------------------------------------------------------------
    package "2. Personal Management & Community Validation (Fan)" {
        usecase "UC015: Manage Personal Profile" as UC015
        usecase "UC016: View Personalized Dashboard\n('My K-Sync' Command Center)" as UC016
        usecase "UC017: Bookmark / Save Event\n(Wishlist Toggle)" as UC017
        usecase "UC018: Recommend / Upvote Event\n(Crowdsourced Reliability Voting)" as UC018
        usecase "UC019: Report Suspicious Listing\n(Scam / Fake Ticket Alert)" as UC019
        usecase "UC020: Post Discussion Comment\n(Logistical Inquiries)" as UC020
        usecase "UC021: Reply to Discussion Comment\n(1-Level Threaded Q&A)" as UC021
        usecase "UC022: Delete Own Comment\n(Anti-Scalper Immutability)" as UC022
        usecase "UC023: View In-App Notifications\n(Schedule Shifts & Countdowns)" as UC023
        usecase "UC024: Mark Notification as Read" as UC024
        usecase "UC025: Manage Notification Settings\n(Email & In-App Preferences)" as UC025
    }

    ' --------------------------------------------------------------------------
    ' MODULE 3: EVENT HOSTING & VERIFICATION (Organizer Actor)
    ' --------------------------------------------------------------------------
    package "3. Event Publishing & Verification (Organizer)" {
        usecase "UC026: View Organizer Dashboard\n(Listings & Metrics)" as UC026
        usecase "UC027: Submit Event Listing\n(AI Vision OCR Scanner)" as UC027
        usecase "UC028: Edit Event Listing\n(Draft / Correct Flagged Listing)" as UC028
        usecase "UC029: View Verification Breakdown\n(Attribute Match & Evidence Audit)" as UC029
        usecase "UC030: Post Logistical Event Update\n(Gate Times / Notice Alert)" as UC030
        usecase "UC031: Request Organizer Badge\n(Official Fanclub Credentials)" as UC031
    }

    ' --------------------------------------------------------------------------
    ' MODULE 4: PLATFORM GOVERNANCE & STEWARDSHIP (System Maintainer Actor)
    ' --------------------------------------------------------------------------
    package "4. Platform Governance & Stewardship (System Maintainer)" {
        usecase "UC032: View Maintainer Portal\n(System Analytics & Logs)" as UC032
        usecase "UC033: Manage Event Categories\n(Concert, Fanmeet, Cafe)" as UC033
        usecase "UC034: Manage Venues Database\n(Transit Links, Capacity)" as UC034
        usecase "UC035: Manage Artists & Member Roster\n(Normalized Biodata)" as UC035
        usecase "UC036: Audit Scam Reports\n(Enforce Suspension Overrides)" as UC036
    }

    ' --------------------------------------------------------------------------
    ' MODULE 5: AUTONOMOUS VERIFICATION ENGINE (Automated Engine)
    ' --------------------------------------------------------------------------
    package "5. Autonomous Verification Engine" {
        usecase "AV01: Audit Whitelisted Ticketing Domain" as AV01
        usecase "AV02: Resolve Evidence URL & Readability" as AV02
        usecase "AV03: Verify Date & Time Validity" as AV03
        usecase "AV04: Check Duplicate Event Listings" as AV04
        usecase "AV05: Multimodal OCR Vision Extraction\n(OpenRouter Gemini 4 Argon)" as AV05
        usecase "AV06: Cross-Model AI Consensus Audit\n(Argon -> Gemma -> Dots)" as AV06
    }
}

' ==============================================================================
' ACTOR ASSOCIATIONS
' ==============================================================================

' Guest Connections
Guest --> UC001
Guest --> UC002
Guest --> UC003
Guest --> UC004
Guest --> UC005
Guest --> UC006
Guest --> UC007
Guest --> UC008
Guest --> UC009
Guest --> UC010
Guest --> UC011
Guest --> UC012
Guest --> UC013
Guest --> UC014

' Fan Connections (inherits Guest)
Fan --> UC015
Fan --> UC016
Fan --> UC017
Fan --> UC018
Fan --> UC019
Fan --> UC020
Fan --> UC021
Fan --> UC022
Fan --> UC023
Fan --> UC024
Fan --> UC025

' Organizer Connections (inherits Fan)
Organizer --> UC026
Organizer --> UC027
Organizer --> UC028
Organizer --> UC029
Organizer --> UC030
Organizer --> UC031

' Maintainer Connections
Maintainer --> UC032
Maintainer --> UC033
Maintainer --> UC034
Maintainer --> UC035
Maintainer --> UC036

' Autonomous Engine Connections
AutoVerifier --> AV01
AutoVerifier --> AV02
AutoVerifier --> AV03
AutoVerifier --> AV04
AutoVerifier --> AV05
AutoVerifier --> AV06

UC027 ..> AV05 : <<include>>
UC027 ..> AV01 : <<include>>
UC029 ..> AV06 : <<include>>

@enduml
