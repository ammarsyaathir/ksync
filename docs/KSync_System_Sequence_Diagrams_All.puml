@startuml KSync_System_Sequence_Diagrams_All
skinparam defaultFontName "Outfit, Arial, sans-serif"
skinparam roundcorner 10
skinparam shadowing true
skinparam monochrome false

' ==============================================================================
' SSD 1: MULTIMODAL POSTER OCR & AUTONOMOUS SUBMISSION (UC027 & AV01 - AV06)
' ==============================================================================
@startuml SSD01_MultimodalSubmission
title System Sequence Diagram: UC027 & AV01-AV06 - Multimodal Poster OCR & Autonomous Submission
actor "Organizer\n(Event Host)" as Organizer
boundary "Browser UI\n(ksync.my)" as UI
control "Event Controller\n(/submit-event)" as Controller
entity "AI Service\n(OpenRouter)" as AIService
entity "Autonomous\nVerifier" as Verifier
database "SQLite Database\n(ksync.db)" as DB

Organizer -> UI: Pastes poster image URL & clicks "AI Auto-Extract"
UI -> Controller: POST /api/events/extract-poster { poster_url }
activate Controller

Controller -> AIService: POST https://openrouter.ai/api/v1/chat/completions\n(model: "google/gemini-4-argon", image_url)
activate AIService
AIService --> Controller: Return extracted JSON (artist, title, venue, date, city)
deactivate AIService

Controller --> UI: 200 OK { extractedFields }
deactivate Controller
UI --> Organizer: Pre-fill event submission form fields

Organizer -> UI: Reviews details, enters ticketing URL & evidence URL, clicks "Publish"
UI -> Controller: POST /submit-event { title, artist, venue, date, ticket_url, evidence_url }
activate Controller

Controller -> Verifier: executeAuditPipeline(listingPayload)
activate Verifier

Verifier -> Verifier: AV01: Audit ticket_url against verified provider whitelist\n(GoLive, BookMyShow, Ticket2U)
Verifier -> Verifier: AV02: Resolve evidence_url (HTTP 200 check, readable text bytes)
Verifier -> Verifier: AV03: Verify start_date >= CURRENT_DATE
Verifier -> DB: AV04: Query events where start_date = :date (duplicate check)
DB --> Verifier: Return matching events count

alt Hard Gates Passed
  Verifier -> Verifier: Calculate token overlap (title, artist, venue, city)
  Verifier -> AIService: AV06: Request cross-model consensus audit
  AIService --> Verifier: Return consensus decision (PASSED, 22 pts)
  Verifier -> Verifier: Calculate total Trust Score (e.g. 88/100) & assign Badge
  Verifier --> Controller: VerificationResult { score: 88, badge: "VERIFIED_OFFICIAL", telemetry }
  deactivate Verifier

  Controller -> DB: INSERT INTO events (status = 'PUBLISHED', trust_score = 88, verification_details)
  activate DB
  DB --> Controller: Event created (id: 104)
  deactivate DB

  Controller --> UI: 302 Redirect /events/104/verification
  UI --> Organizer: Display 14-point Verification Breakdown & Trust Badge
else Hard Gate Failed (e.g. Unreachable Evidence URL)
  Verifier --> Controller: VerificationResult { passed: false, failedGate: "AV02_UNREACHABLE" }
  Controller -> DB: INSERT INTO events (status = 'DRAFT_FLAGGED')
  Controller --> UI: 400 Bad Request { error: "Evidence URL unreachable (HTTP 404)" }
  UI --> Organizer: Display specific diagnostic remediation prompt
end
deactivate Controller
@enduml

' ==============================================================================
' SSD 2: EVENT RADAR & TRANSIT CORRIDORS (UC005 & UC008)
' ==============================================================================
@startuml SSD02_EventRadar
title System Sequence Diagram: UC005 & UC008 - Event Radar Precinct Clustering & Transit Route
actor "Guest / Fan" as User
boundary "Browser UI\n(ksync.my)" as UI
control "Radar Controller\n(/events/radar)" as Controller
database "SQLite Database\n(ksync.db)" as DB
boundary "Google Maps\nTransit Navigation" as GoogleMaps

User -> UI: Navigates to "/events/radar"
UI -> Controller: GET /events/radar
activate Controller

Controller -> DB: SELECT * FROM events WHERE status = 'PUBLISHED' ORDER BY start_date ASC
activate DB
DB --> Controller: Return events list
deactivate DB

Controller -> Controller: Group events by cluster_area (Bukit Jalil, BBCC, Mega Star, PJ/Sunway)
Controller -> Controller: Group events by same-weekend cohorts (strftime('%Y-W%W', start_date))
Controller --> UI: Render Event Radar View with precinct metrics & weekend cohorts
deactivate Controller

User -> UI: Clicks target precinct (e.g. "Bukit Jalil Hub") & selects event
UI --> User: Displays event dossier with venue transit guidelines

User -> UI: Clicks "Transit Directions / Open Map" (UC008)
UI -> GoogleMaps: Open external web intent: maps.google.com/search/?api=1&query={venue_coordinates}
GoogleMaps --> User: Presents live LRT/MRT public transit route (Sri Petaling Line)
@enduml

' ==============================================================================
' SSD 3: PERSONALIZED FAN DASHBOARD & COUNTDOWN SYNC (UC016)
' ==============================================================================
@startuml SSD03_PersonalDashboard
title System Sequence Diagram: UC016 - Personalized Fan Dashboard & Live Countdown Sync
actor "Fan\n(Member)" as Fan
boundary "Browser UI\n(ksync.my)" as UI
control "Dashboard Controller\n(/dashboard)" as Controller
database "SQLite Database\n(ksync.db)" as DB

Fan -> UI: Clicks "My K-Sync" / Dashboard in header
UI -> Controller: GET /dashboard (Session Cookie)
activate Controller

Controller -> DB: SELECT e.* FROM saved_events s JOIN events e ON s.event_id = e.id WHERE s.user_id = :userId ORDER BY e.start_date ASC
activate DB
DB --> Controller: Return saved upcoming events
deactivate DB

Controller -> DB: SELECT count(*) AS unread FROM notifications WHERE user_id = :userId AND is_read = 0
activate DB
DB --> Controller: Return unread count
deactivate DB

Controller -> Controller: Identify nearest upcoming showtime
Controller --> UI: Render Dashboard View (events, nearestShowtime, unreadCount)
deactivate Controller

UI -> UI: Initialize client-side ticking digital countdown timer (Days:Hours:Mins:Secs)
UI --> Fan: Display personal command center with live ticking concert clock
@enduml

' ==============================================================================
' SSD 4: ANTI-SCALPER IMMUTABLE DISCUSSION Q&A (UC020, UC021, UC022)
' ==============================================================================
@startuml SSD04_DiscussionForum
title System Sequence Diagram: UC020 - UC022 - Anti-Scalper Discussion Q&A Flow
actor "Fan A" as FanA
actor "Fan B" as FanB
boundary "Browser UI\n(ksync.my)" as UI
control "Chat Controller\n(/api/chat/:eventId)" as Controller
database "SQLite Database\n(ksync.db)" as DB

FanA -> UI: Types logistical inquiry & clicks "Post Comment" (UC020)
UI -> Controller: POST /api/chat/104 { message: "What time does Axiata gate open for CAT 1?" }
activate Controller

Controller -> Controller: Sanitize message HTML & validate length
Controller -> DB: INSERT INTO event_chat_messages (event_id, user_id, message, parent_id=NULL)
activate DB
DB --> Controller: Created message (id: 501)
deactivate DB
Controller --> UI: 201 Created { messageId: 501, author: "FanA", timestamp }
deactivate Controller
UI --> FanA: Display comment card in discussion thread

== Threaded Reply Flow ==
FanB -> UI: Clicks "Reply" on comment #501 & submits answer (UC021)
UI -> Controller: POST /api/chat/104 { message: "Gates open at 4:30 PM for soundcheck!", parent_id: 501 }
activate Controller

Controller -> Controller: Enforce strictly 1-level deep threading (parent_id = 501)
Controller -> DB: INSERT INTO event_chat_messages (event_id, user_id, message, parent_id=501)
activate DB
DB --> Controller: Created reply (id: 502)
deactivate DB

Controller -> DB: INSERT INTO notifications (user_id = FanA.id, type = 'REPLY', title = "Fan B replied to your inquiry")
Controller --> UI: 201 Created { replyId: 502, parent_id: 501 }
deactivate Controller
UI --> FanB: Display nested reply under comment #501

== Anti-Scalper Immutability Enforcement ==
note over FanA, Controller
  **ANTI-SCALPER SECURITY POLICY:**
  PUT / PATCH routes are deliberately unexposed.
  Comments can NEVER be edited after posting.
  Only DELETE (UC022) is supported.
end note

FanA -> UI: Clicks delete trash icon on comment #501
UI -> Controller: DELETE /api/chat/501
activate Controller
Controller -> DB: DELETE FROM event_chat_messages WHERE id = 501 AND user_id = :FanA_Id
DB --> Controller: 1 row affected
Controller --> UI: 200 OK { success: true }
deactivate Controller
UI --> FanA: Remove comment from UI
@enduml

' ==============================================================================
' SSD 5: CROWDSOURCED RELIABILITY VOTING (UC018)
' ==============================================================================
@startuml SSD05_CrowdUpvote
title System Sequence Diagram: UC018 - Crowdsourced Reliability Voting
actor "Fan" as Fan
boundary "Browser UI\n(ksync.my)" as UI
control "Event API\n(/api/events/:id/recommend)" as Controller
database "SQLite Database\n(ksync.db)" as DB

Fan -> UI: Clicks "Recommend Event" (thumbs up) on event dossier
UI -> Controller: POST /api/events/104/recommend (Session Cookie)
activate Controller

Controller -> DB: SELECT id FROM event_recommendations WHERE user_id = :userId AND event_id = 104
activate DB
DB --> Controller: Return existing vote record (if any)
deactivate DB

alt No Vote Exists (Upvote)
  Controller -> DB: INSERT INTO event_recommendations (user_id, event_id, vote_type) VALUES (:userId, 104, 'UP')
  activate DB
  DB --> Controller: Insert successful
  deactivate DB
else Vote Already Exists (Toggle Off)
  Controller -> DB: DELETE FROM event_recommendations WHERE user_id = :userId AND event_id = 104
  activate DB
  DB --> Controller: Delete successful
  deactivate DB
end

Controller -> DB: SELECT count(*) AS total FROM event_recommendations WHERE event_id = 104
activate DB
DB --> Controller: Return total recommendations count
deactivate DB

Controller --> UI: 200 OK { recommended: boolean, count: total }
deactivate Controller
UI --> Fan: Update thumbs-up button state and increment tally
@enduml

' ==============================================================================
' SSD 6: LOGISTICAL BROADCAST & PUSH ALERTS (UC030)
' ==============================================================================
@startuml SSD06_LogisticalBroadcast
title System Sequence Diagram: UC030 - Logistical Broadcast & Push Alerts to Ticket Holders
actor "Organizer" as Organizer
boundary "Browser UI\n(ksync.my)" as UI
control "Updates Controller\n(/api/events/:id/updates)" as Controller
database "SQLite Database\n(ksync.db)" as DB

Organizer -> UI: Inputs urgent notice ("Soundcheck queue closes at 3:00 PM") & clicks "Broadcast Update"
UI -> Controller: POST /api/events/104/updates { title, content, urgency: 'URGENT' }
activate Controller

Controller -> DB: Verify organizer owns event #104
DB --> Controller: Authorized

Controller -> DB: INSERT INTO event_updates (event_id, title, content, urgency)
activate DB
DB --> Controller: Update created (id: 201)
deactivate DB

Controller -> DB: SELECT user_id FROM saved_events WHERE event_id = 104
activate DB
DB --> Controller: Return list of fan user IDs who wishlisted this event
deactivate DB

loop For each saved fan
  Controller -> DB: INSERT INTO notifications (user_id, event_id, type = 'EVENT_UPDATE', title, message)
end

Controller --> UI: 201 Created { updateId: 201, notifiedFansCount }
deactivate Controller
UI --> Organizer: Confirmation toast ("Update posted & push alerts dispatched to fans")
@enduml

' ==============================================================================
' SSD 7: SCAM REPORT AUDITING & MAINTAINER OVERRIDE (UC036)
' ==============================================================================
@startuml SSD07_ScamReport
title System Sequence Diagram: UC036 - Scam Report Auditing & Maintainer Override
actor "Fan\n(Reporter)" as Fan
actor "System Maintainer\n(Admin)" as Maintainer
boundary "Browser UI\n(ksync.my)" as UI
control "Report Controller\n(/admin/reports)" as Controller
database "SQLite Database\n(ksync.db)" as DB

Fan -> UI: Submits scam flag ("Fake scalper ticket link on event #99")
UI -> Controller: POST /api/events/99/report { reason, details }
Controller -> DB: INSERT INTO reports (event_id=99, user_id, reason, details, status='PENDING')
Controller --> UI: 200 OK { message: "Report logged" }

Maintainer -> UI: Navigates to Maintainer Portal (`/admin/reports`)
UI -> Controller: GET /admin/reports
Controller -> DB: SELECT r.*, e.title, u.email FROM reports r JOIN events e ON r.event_id = e.id JOIN users u ON r.user_id = u.id WHERE r.status = 'PENDING'
DB --> Controller: Return pending reports queue
Controller --> UI: Render reports management dashboard

Maintainer -> UI: Reviews evidence, confirms scam, clicks "Enforce Take Down"
UI -> Controller: POST /admin/reports/12/action { action: 'TAKE_DOWN_EVENT' }
activate Controller

Controller -> DB: UPDATE events SET status = 'CANCELLED' WHERE id = 99
Controller -> DB: UPDATE reports SET status = 'RESOLVED' WHERE id = 12
Controller -> DB: INSERT INTO activity_logs (user_id = Maintainer.id, action = 'EVENT_TAKEDOWN', details = "Event #99 cancelled due to confirmed scam")
Controller --> UI: 200 OK { success: true }
deactivate Controller
UI --> Maintainer: Display confirmation badge and update queue
@enduml

@enduml
