@startuml KSync_Business_Activity_Diagrams_All
skinparam defaultFontName "Outfit, Arial, sans-serif"
skinparam roundcorner 10
skinparam shadowing true
skinparam monochrome false

' ==============================================================================
' ACTIVITY 1: USER REGISTRATION & ROLE ASSIGNMENT (UC001)
' ==============================================================================
@startuml AD01_Registration
title Activity Diagram: UC001 - Register Account & Role Assignment
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Guest|
start
:Click "Register" in navigation bar;
:Choose registration method;
if (Registration Type?) then (Email & Password)
  :Enter Name, Username, Email, Password;
  :Select Role Preference (Fan / Organizer);
  :Submit registration form;
  |System|
  :Validate email format (RFC 5322);
  :Check uniqueness in `users` table;
  if (Email or Username exists?) then (Yes)
    :Return validation conflict error;
    |Guest|
    :Display error feedback;
    stop
  else (No)
    |System|
    :Hash password via Bcrypt (cost 10);
    :Insert record into `users` (status='ACTIVE');
  endif
else (Google OAuth 2.0)
  |Guest|
  :Click "Continue with Google";
  |Google OAuth Service|
  :Authenticate user & issue OAuth ID token;
  |System|
  :Verify token & extract verified email, name, avatar;
  :Check if Google account is linked;
  if (User exists?) then (Yes)
    :Retrieve existing user profile;
  else (No)
    :Create new user record with Google profile;
  endif
endif

|System|
:Establish HTTP-only session cookie;
:Initialize default notification preferences;
:Redirect to Personalized Dashboard (/dashboard);
|Guest|
:View welcome notification;
stop
@enduml

' ==============================================================================
' ACTIVITY 2: EVENT RADAR & PRECINCT CLUSTERING (UC005)
' ==============================================================================
@startuml AD02_EventRadar
title Activity Diagram: UC005 - Event Radar Corridor Clustering & Same-Weekend Exploration
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Guest / Fan|
start
:Navigate to "/events/radar";
|System|
:Query all confirmed and active Malaysian events;
:Map venues to predefined Malaysian precincts\n(Bukit Jalil Hub, BBCC & Downtown KL, Mega Star Arena, PJ/Sunway);
:Calculate same-weekend cohorts using strftime('%Y-W%W', start_date);
:Render interactive Event Radar view;
|Guest / Fan|
:Browse clustered corridor overview;
if (Select corridor filter?) then (Yes)
  :Click target precinct card (e.g. "Bukit Jalil Hub");
  |System|
  :Filter and display only events located within that precinct;
  :Highlight transit connectivity (e.g. Sri Petaling LRT);
else (No)
  :Browse chronological same-weekend timeline cards;
endif
|Guest / Fan|
:Select event to view detailed dossier;
stop
@enduml

' ==============================================================================
' ACTIVITY 3: EVENT DOSSIER & OUTBOUND HANDSHAKES (UC006 - UC011)
' ==============================================================================
@startuml AD03_EventDossier
title Activity Diagram: UC006 - UC011 - Event Dossier & Interactive Outbound Handshakes
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Guest / Fan|
start
:Select event card from Directory or Radar;
|System|
:Fetch event details, venue transit guidelines, verified evidence, and updates;
:Calculate remaining time to showtime;
:Render event dossier with live digital countdown clock;
|Guest / Fan|
:Review concert details, venue guidelines, and organizer trust badge;
fork
  :Click "Buy Official Tickets" (UC007);
  |System|
  :Verify ticketing domain against partner whitelist\n(GoLive Asia, BookMyShow, Ticket2U, BigTix);
  :Open external ticketing portal in secure tab (rel="noopener noreferrer");
  detach
fork again
  :Click "Transit Directions / Open Map" (UC008);
  |System|
  :Format destination query with venue coordinates and LRT/MRT stops;
  :Open Google Maps transit routing interface;
  detach
fork again
  :Click "Organizer Social Profile" (UC009);
  |System|
  :Open verified promoter X / Instagram profile in new tab;
  detach
fork again
  :Click "Share Event" (UC010);
  |System|
  :Open Share Modal (WhatsApp, X, Telegram, Clipboard);
  |Guest / Fan|
  :Select sharing channel or copy formatted link to clipboard;
  detach
fork again
  :Click "Add to Calendar" (UC011);
  |System|
  if (Platform chosen?) then (Google Calendar)
    :Build web intent URL with ISO 8601 showtime & venue;
    :Open Google Calendar scheduling interface;
  else (iCal / Outlook)
    :Generate and stream RFC 5545 .ics file;
    :Trigger browser file download;
  endif
  detach
end fork
stop
@enduml

' ==============================================================================
' ACTIVITY 4: PERSONALIZED FAN DASHBOARD ("MY K-SYNC") (UC016)
' ==============================================================================
@startuml AD04_PersonalDashboard
title Activity Diagram: UC016 - Personalized Fan Dashboard & Live Countdown Sync
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Fan|
start
:Click "Dashboard" or "My K-Sync" in header;
|System|
:Verify active fan session;
:Query `saved_events` joined with `events`;
:Sort by `start_date ASC` to identify nearest upcoming concert;
if (Upcoming saved events exist?) then (Yes)
  :Calculate time delta to showtime;
  :Initialize live ticking digital countdown clock (Days:Hours:Mins:Secs);
  :Query user's recommendation votes and discussion history;
  :Retrieve unread in-app notification count;
  :Render command center view with active concert countdown;
else (No)
  :Render empty-state guide with "Explore Upcoming Events" CTA;
endif
|Fan|
:Manage saved concerts, review schedule alerts, or jump to event discussions;
stop
@enduml

' ==============================================================================
' ACTIVITY 5: ANTI-SCALPER DISCUSSION FORUM (UC020, UC021, UC022)
' ==============================================================================
@startuml AD05_DiscussionForum
title Activity Diagram: UC020 - UC022 - Anti-Scalper Immutable Discussion Q&A Forum
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Fan|
start
:Scroll to "Community Discussions & Q&A" section;
if (Action?) then (Post Top-Level Comment - UC020)
  :Type inquiry into comment textarea;
  :Click "Post Comment";
  |System|
  :Sanitize HTML entities to prevent XSS attacks;
  :Validate length (1 to 1000 characters);
  :INSERT INTO `event_chat_messages` (parent_id = NULL);
  :Render comment card with author avatar;
else if (Reply to Comment - UC021)
  :Click "Reply" underneath target comment;
  :Type response into inline reply form;
  :Click "Submit Reply";
  |System|
  :Sanitize text content;
  :Flatten `parent_id` to enforce strictly 1-level deep threading;
  :INSERT INTO `event_chat_messages` (parent_id = target_id);
  :Dispatch in-app notification to parent comment author;
  :Render nested reply card under parent comment;
else if (Delete Comment - UC022)
  :Click trash icon on own comment;
  |System|
  :Prompt deletion confirmation dialog;
  |Fan|
  :Confirm deletion;
  |System|
  :Verify session user owns the comment (or is Maintainer);
  :DELETE FROM `event_chat_messages` WHERE id = :id;
  :Remove comment card from UI;
endif

|System|
note right
  **ANTI-SCALPER DIRECTIVE:**
  Comment EDITING is strictly prohibited.
  Prevent scalpers from posting innocent queries
  and subsequently swapping text for unauthorized
  ticketing links or illegal phone contacts.
end note
stop
@enduml

' ==============================================================================
' ACTIVITY 6: AUTONOMOUS VERIFICATION ENGINE PIPELINE (UC027 & AV01 - AV06)
' ==============================================================================
@startuml AD06_AutonomousVerification
title Activity Diagram: UC027 & AV01 - AV06 - Multimodal Poster OCR & Autonomous Verification Pipeline
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Organizer|
start
:Navigate to "/submit-event";
:Provide official announcement poster image URL;
:Click "AI Auto-Extract from Poster" (UC027);

|Autonomous Verification Engine|
:Execute AV05 (Multimodal OCR Vision Extraction);
:Send image to OpenRouter Gemini 4 Argon (`google/gemini-4-argon`);
:Parse structured JSON (Tour Name, Artist, Venue, Date, City);
:Pre-fill event submission form fields;

|Organizer|
:Review and confirm extracted details;
:Input official ticketing URL and source evidence URL;
:Click "Publish Event Listing";

|Autonomous Verification Engine|
partition "Hard Gates Audit" {
  :AV01: Audit Ticketing Domain against Whitelist (BookMyShow, GoLive, Ticket2U);
  :AV02: Resolve Evidence URL (HTTP 200 check, readable text byte measurement);
  :AV03: Verify Date Validity (Future date, chronological end date);
  :AV04: Check Duplicate Listings (Fuzzy match artist + venue + date);
}

if (All Hard Gates Passed?) then (Yes)
  partition "14-Point Attribute Match & Consensus" {
    :Compute Token Overlap (Title, Artist, Venue, City, Date);
    :AV06: Cross-Model AI Consensus Audit (Gemini 4 Argon vs Local Rules);
    :Compute Total Verification Score (0 - 100);
    if (Score >= 75 AND Ticketing Whitelisted?) then (Official Tier)
      :Assign Badge: `VERIFIED_OFFICIAL`;
    else (Community Tier)
      :Assign Badge: `COMMUNITY_UNVERIFIED`;
    endif
  }
  |System|
  :INSERT INTO `events` (status = 'PUBLISHED');
  :Store full audit telemetry in `verification_details` JSON;
  :Redirect organizer to Verification Breakdown view;
  |Organizer|
  :Review 14-point score breakdown & diagnostic tips;
  stop
else (Hard Gate Failed)
  |System|
  :Flag listing with specific gate failure reason\n(e.g. Unreachable Evidence URL or Duplicate Event);
  :Save as `DRAFT_FLAGGED`;
  |Organizer|
  :Display actionable remediation prompt;
  stop
endif
@enduml

' ==============================================================================
' ACTIVITY 7: SCAM REPORT AUDITING & MAINTAINER OVERRIDE (UC036)
' ==============================================================================
@startuml AD07_ScamReport
title Activity Diagram: UC036 - Community Scam Report Auditing & Maintainer Override
skinparam defaultFontName "Outfit, Arial, sans-serif"

|Fan|
start
:Discover suspicious listing (fake ticket link / fraudulent fanmeet);
:Click "Report Event" (UC019);
:Select reason ("Scam / Fake Ticket Link") and provide details;
:Submit report;

|System|
:INSERT INTO `reports` (status = 'PENDING');
if (Report count on event >= 3?) then (Yes)
  :Automatically tag listing with amber Community Caution warning;
endif

|System Maintainer|
:Navigate to Maintainer Portal (`/admin/reports`);
:Review pending reports queue;
:Inspect reported listing dossier and submitted evidence;
if (Scam / Fraud Confirmed?) then (Yes)
  :Select "Enforce Take Down";
  |System|
  :UPDATE `events` SET status = 'CANCELLED';
  :UPDATE `reports` SET status = 'RESOLVED';
  :Log administrative override in `activity_logs`;
  :Dispatch notification to affected fans;
  |System Maintainer|
  :Optionally suspend submitter account;
else (False Alarm)
  |System Maintainer|
  :Select "Dismiss Report";
  |System|
  :UPDATE `reports` SET status = 'DISMISSED';
endif
stop
@enduml

@enduml
